{
  "name": "blocko-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "blocko-api", "database_id": "<your-d1-database-id>", "migrations_dir": "migrations" }
  ],
  "vars": { "DEV_SKIP_SIGNATURE": "0" }
}
