{%- comment -%} Generated by Blocko. Design tokens come from theme settings; typography tokens and rules are in assets/blko-theme.css. {%- endcomment -%}
<style>
@font-face{font-family:"Familjen Grotesk";src:url({{ 'familjen-grotesk.woff2' | asset_url }}) format("woff2");font-weight:400 700;font-display:swap}
@font-face{font-family:"DM Mono";src:url({{ 'dm-mono.woff2' | asset_url }}) format("woff2");font-weight:400 500;font-display:swap}
.blko-theme{--color-bg:{{ settings.color_bg }};--color-bg-alt:{{ settings.color_bg_alt }};--color-text:{{ settings.color_text }};--color-text-muted:{{ settings.color_text_muted }};--color-border:{{ settings.color_border }};--color-button:{{ settings.color_button }};--color-button-text:{{ settings.color_button_text }};--color-button-hover:{{ settings.color_button_hover }};--color-accent:{{ settings.color_accent }};--color-sale:{{ settings.color_sale }};--color-announcement-bg:{{ settings.color_announcement_bg }};--color-announcement-text:{{ settings.color_announcement_text }};--color-footer-bg:{{ settings.color_footer_bg }};--color-footer-text:{{ settings.color_footer_text }};--color-success:{{ settings.color_success }};--color-error:{{ settings.color_error }};--color-overlay:#00000066;--color-input-bg:{{ settings.color_input_bg }};--color-input-text:{{ settings.color_input_text }};--color-swatch-light:{{ settings.color_swatch_light }};--color-swatch-medium:{{ settings.color_swatch_medium }};--color-swatch-deep:{{ settings.color_swatch_deep }};--color-swatch-rose-beige:{{ settings.color_swatch_rose_beige }};--color-swatch-honey-sand:{{ settings.color_swatch_honey_sand }};--color-swatch-soft-caramel:{{ settings.color_swatch_soft_caramel }};--color-swatch-golden-tan:{{ settings.color_swatch_golden_tan }};--color-swatch-cocoa-deep:{{ settings.color_swatch_cocoa_deep }};--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-sand:var(--color-bg-alt);--color-clay:var(--color-accent);--color-line:var(--color-border)}
{%- for scheme in settings.color_schemes -%}
.blko-theme .blko-{{ scheme.id }}{--color-bg:{{ scheme.settings.background }};--color-text:{{ scheme.settings.text }};--color-button:{{ scheme.settings.button }};--color-button-text:{{ scheme.settings.button_label }};--color-button-hover:{{ scheme.settings.button_hover }};--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-sand:var(--color-bg-alt);--color-clay:var(--color-accent);--color-line:var(--color-border)}
{%- endfor -%}
</style>
