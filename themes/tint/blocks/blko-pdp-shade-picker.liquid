{%- comment -%} Generated by Blocko from tools/themes/tint/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-pdp><fieldset class="blko-pdp-shades" data-pdp-shades><legend>{{ product.options_with_values.first.name | escape }}: <strong data-pdp-shade-name>{{ product.selected_or_first_available_variant.option1 | escape }}</strong></legend><div>{% for shade in product.options_with_values.first.values %}<button{% if shade.selected %} class="is-active"{% else %}{% endif %} type="button" data-pdp-shade="{{ shade.name | escape }}" data-pdp-value="{{ shade.name | escape }}"{% if shade.swatch.color != blank %} style="--pdp-shade:{{ shade.swatch.color | escape }}"{% else %} style="--pdp-shade:var(--color-swatch-medium)"{% endif %} aria-label="{{ shade.name | escape }}"></button>{% endfor %}</div></fieldset></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--tracking-label:.075rem;--font-mono:var(--font-accent);--font-accent:"DM Mono",ui-monospace,Menlo,monospace;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--color-bg:Canvas;--color-line:var(--color-border);--color-border:ButtonFace;--color-ink:var(--color-text);--color-text:CanvasText;--text-small:.75rem;--color-paper:var(--color-bg);--font-body:"Familjen Grotesk",Helvetica Neue,Arial,sans-serif}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-pdp-shades{border:0;padding:0;margin:1.7rem 0}
.blko-theme .blko-pdp-shades legend{margin-bottom:.7rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-pdp-size legend{margin-bottom:.7rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-pdp-plan legend{margin-bottom:.7rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-pdp-shades>div{display:flex;gap:.7rem;flex-wrap:wrap}
.blko-theme .blko-pdp-shades button{width:2.2rem;height:2.2rem;border:3px solid var(--color-paper);border-radius:50%;outline:1px solid transparent;background:var(--pdp-shade);cursor:pointer}
.blko-theme .blko-pdp-shades button.is-active{outline-color:var(--color-ink)}
.blko-theme .blko-pdp-size button{color:var(--color-text);border:1px solid var(--color-line);padding:.7rem .8rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
.blko-theme .blko-pdp-plan button{color:var(--color-text);display:grid;grid-template-columns:1fr auto;gap:.25rem;padding:1rem;border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);text-align:left;cursor:pointer}
.blko-theme .blko-pdp-review-filters button{color:var(--color-text);border:1px solid var(--color-line);padding:.45rem .6rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);font-size:var(--text-small);cursor:pointer}
.blko-theme .blko-pdp-review>div{display:flex;justify-content:space-between;font-size:var(--text-small)}
.blko-theme .blko-pdp-bundle-item>button{border:1px solid var(--color-ink);padding:.65rem .9rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
@media(max-width:760px){.blko-theme .blko-pdp-bundle-item>button{grid-column:1/-1}}
.blko-theme .blko-search-blog-tabs button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-tag-filter button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-filters button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-pagination button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-share button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-filters button{text-align:left}
.blko-theme .blko-search-blog-inline-products>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
@media(max-width:760px){.blko-theme .blko-search-blog-inline-products>div{grid-template-columns:1fr}}
.blko-theme .blko-home-collection-filter-group legend{padding:0;margin-bottom:.5rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase}
