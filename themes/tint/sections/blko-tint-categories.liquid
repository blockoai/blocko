{%- comment -%} Generated by Blocko from tools/themes/tint/groups/tint-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-tint-categories"><div class="blko-tint-head"><h2>{{ section.settings.heading | escape }}</h2><a href="{{ section.settings.link_url | default: '#shop' }}">{{ section.settings.link_label | escape }}</a></div><div class="blko-tint-category-row">{% for block in section.blocks %}<a class="blko-tint-tile" href="{{ block.settings.url | default: '#shop' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240, 360, 480', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span>{{ block.settings.label | escape }}</span></a>{% endfor %}</div></section></div>
