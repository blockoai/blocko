{%- comment -%} Generated by Blocko from tools/themes/tint/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-global><section class="blko-global-page blko-global-compare" data-global-compare><div class="blko-global-page__intro"><p class="blko-global-kicker">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p></div><div class="blko-global-compare__scroll"><table><thead><tr><th scope="col">{{ section.settings.details_label | escape }}</th>{% for block in section.blocks %}<th scope="col" data-global-compare-column {{ block.shopify_attributes }}>{{ block.settings.name | escape }} <button type="button" data-global-compare-remove>{{ section.settings.remove_label | escape }}</button></th>{% endfor %}</tr></thead><tbody><tr><th scope="row">{{ section.settings.finish_label | escape }}</th>{% for block in section.blocks %}<td>{{ block.settings.finish | escape }}</td>{% endfor %}</tr><tr><th scope="row">{{ section.settings.coverage_label | escape }}</th>{% for block in section.blocks %}<td>{{ block.settings.coverage | escape }}</td>{% endfor %}</tr><tr><th scope="row">{{ section.settings.best_for_label | escape }}</th>{% for block in section.blocks %}<td>{{ block.settings.best_for | escape }}</td>{% endfor %}</tr><tr><th scope="row">{{ section.settings.price_label | escape }}</th>{% for block in section.blocks %}<td>{{ block.settings.price | escape }}</td>{% endfor %}</tr></tbody></table></div><div class="blko-global-empty-state" data-global-compare-empty hidden><p class="blko-global-kicker">{{ section.settings.empty_kicker | escape }}</p><h2>{{ section.settings.empty_heading | escape }}</h2><a class="blko-button" href="{{ routes.all_products_collection_url | escape }}">{{ section.settings.button_label | escape }}</a></div></section></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
