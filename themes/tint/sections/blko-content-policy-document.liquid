{% schema %}
{
  "name": "Policy document",
  "settings": [
    {
      "type": "text",
      "id": "toc_label",
      "label": "Toc label",
      "default": "Table of contents"
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Toc heading",
      "default": "On this page"
    }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Policy section",
      "settings": [
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor id",
          "default": "content-policy-intro"
        },
        {
          "type": "text",
          "id": "toc",
          "label": "Toc",
          "default": "Introduction"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "1. Introduction"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>[Organization name] respects your privacy. This placeholder explains the headings a reviewed privacy policy commonly covers; it is not legal advice and must be replaced with approved copy before publication.</p><p>This policy applies to the website, customer support, and related services identified by your organization.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy document",
      "blocks": [
        {
          "type": "section",
          "settings": {
            "anchor": "policy-processing",
            "toc": "Processing",
            "heading": "1. Processing",
            "body": "<p>Orders are packed within two to three business days. You can edit or cancel an order only in the first hour after checkout.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "policy-shipping",
            "toc": "Shipping rates",
            "heading": "2. Shipping rates",
            "body": "<p>Standard US delivery takes about five to seven days: free from $50, otherwise $5. Three-day expedited shipping is $15. International parcels arrive with duties and taxes prepaid.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "policy-returns",
            "toc": "Returns",
            "heading": "3. Returns and exchanges",
            "body": "<p>Return or swap any full-size item within 30 days of delivery, or 60 days over the holidays. Samples and gift cards are final sale. Refunds go to the original payment method or become store credit.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "policy-missing",
            "toc": "Missing parcels",
            "heading": "4. Delivered but missing",
            "body": "<p>If tracking says delivered and nothing is there, wait a day, check with neighbours, then contact us and we will open a claim.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
