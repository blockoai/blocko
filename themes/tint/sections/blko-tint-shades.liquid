{%- comment -%} Generated by Blocko from tools/themes/tint/groups/tint-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-tint-shades"><div class="blko-tint-head"><div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a class="blko-tint-pill" href="{{ section.settings.pill_url | default: '#shade-quiz' }}">{{ section.settings.pill_label | escape }}</a></div><ul class="blko-tint-shade-row">{% for block in section.blocks %}<li class="blko-tint-shade" style="--tint-shade:var(--color-swatch-{{ block.settings.tone | escape }})" {{ block.shopify_attributes }}><span class="blko-tint-shade-dot"></span><strong>{{ block.settings.name | escape }}</strong><small>{{ block.settings.count | escape }}</small></li>{% endfor %}</ul></section></div>
