{%- comment -%} Generated by Blocko from tools/themes/tint/chrome.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><aside id="cart-drawer" class="blko-mobile-menu" aria-hidden="true"><button type="button" data-cart-close>{{ 'blko.general.close' | t }}</button><h2>{{ section.settings.heading | escape }}</h2>{% for line in cart.items %}<div class="blko-cart-line">{% if line.image != blank %}{{ line.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '225, 300', alt: line.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3>{{ line.product.title | escape }}</h3>{% if line.variant.title != blank and line.variant.title != 'Default Title' %}<p>{{ line.variant.title | escape }}</p>{% else %}{% endif %}</div><strong>{{ line.final_line_price | money_without_trailing_zeros }}</strong></div>{% else %}<p>{{ 'blko.cart.empty' | t }}</p>{% endfor %}{% form 'cart', cart, action: routes.cart_url, method: 'post' %}<button class="blko-button" type="submit" name="checkout">{{ section.settings.checkout_label | escape }}</button>{% endform %}</aside></div>
