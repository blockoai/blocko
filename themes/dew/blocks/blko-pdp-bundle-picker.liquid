{%- comment -%} Generated by Blocko from tools/themes/dew/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-pdp><article class="blko-pdp-bundle-item" data-pdp-bundle-item data-pdp-price-cents="{{ product.price | escape }}" data-pdp-variant="{{ product.selected_or_first_available_variant.id | escape }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: product.featured_image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h2>{{ product.title | escape }}</h2><strong>{{ product.price | money_without_trailing_zeros }}</strong></div><button type="button" data-pdp-bundle-toggle aria-pressed="false">{{ 'blko.pdp.add' | t }}</button></article></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-text:CanvasText;--color-bg:Canvas;--color-bg-alt:Canvas;--color-footer-bg:CanvasText;--color-accent:GrayText;--color-sale:GrayText;--color-border:ButtonFace;--kit-heading-tracking:-0.02em;--kit-radius:8px;--kit-radius-image:12px;--kit-radius-button:999px;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Manrope",Arial,sans-serif;--text-h2:1.75rem;--kit-radius-card:12px;--text-title:1.75rem;--text-display:2.5rem;--color-button-text:Canvas;--color-ink:var(--color-text);--color-line:var(--color-border);--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:1.125rem;--weight-medium:500;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--font-body:"DM Sans",Arial,sans-serif;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:1.875rem;--text-title:1.875rem;--text-display:3.25rem;--text-card-title:1.25rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-pdp-bundle-item{display:grid;grid-template-columns:130px 1fr auto;gap:1rem;align-items:center;padding:1rem;border:1px solid var(--color-line);transition:border .2s,background .2s}
.blko-theme .blko-pdp-bundle-item.is-selected{border-color:var(--color-ink);background:var(--color-bg-alt)}
.blko-theme .blko-pdp-bundle-item img{width:130px;height:150px}
.blko-theme .blko-pdp-bundle-item h2{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);margin:.3rem 0}
.blko-theme .blko-pdp-bundle-item>button{border:1px solid var(--color-ink);padding:.65rem .9rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
.blko-theme .blko-pdp-bundle-item.is-selected>button{background:var(--color-ink);color:var(--color-button-text)}
@media(max-width:760px){.blko-theme .blko-pdp-bundle-item{grid-template-columns:92px 1fr}
.blko-theme .blko-pdp-bundle-item img{width:92px;height:112px}
.blko-theme .blko-pdp-bundle-item>button{grid-column:1/-1}}
.blko-theme .blko-search-blog-tabs button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
