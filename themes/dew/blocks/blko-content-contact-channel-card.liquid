{% schema %}
{
  "name": "Contact channel card",
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "✉"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Email support"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Questions answered by a helpful human."
    },
    {
      "type": "url",
      "id": "url",
      "label": "Url"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "hello@example.com"
    }
  ],
  "presets": [
    {
      "name": "Contact channel card"
    }
  ]
}
{% endschema %}
