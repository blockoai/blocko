    "brand-logo-usage": {
      "type": "blko-brand-logo-usage",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "do",
          "settings": {
            "text": "Use the primary wordmark on light surfaces and the inverse on dark ones."
          }
        },
        "block-2": {
          "type": "do",
          "settings": {
            "text": "Keep the drop in the accent colour or in the text colour, never a third colour."
          }
        },
        "block-3": {
          "type": "do",
          "settings": {
            "text": "Always set the name in lowercase, exactly as drawn."
          }
        },
        "block-4": {
          "type": "dont",
          "settings": {
            "text": "Do not stretch, rotate or outline the wordmark."
          }
        },
        "block-5": {
          "type": "dont",
          "settings": {
            "text": "Do not move the drop or add more drops."
          }
        },
        "block-6": {
          "type": "dont",
          "settings": {
            "text": "Do not set the logo on a busy pattern or low-contrast photograph."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6"
      ]
    },
    "brand-voice": {
      "type": "blko-brand-voice",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "principle",
          "settings": {
            "title": "Plain and lowercase",
            "text": "Short words, short lines, headings in lowercase. Sound like a note from a friend, not an advert."
          }
        },
        "block-2": {
          "type": "principle",
          "settings": {
            "title": "Say what is inside",
            "text": "Name the ingredient and the job it does. If we cannot explain it in a sentence, it is not in the bottle."
          }
        },
        "block-3": {
          "type": "principle",
          "settings": {
            "title": "Never push",
            "text": "Offer the next step, do not demand it. No countdowns, no fear, no exclamation marks."
          }
        },
        "block-4": {
          "type": "write",
          "settings": {
            "text": "One serum, one cream, one sunscreen. That is the routine."
          }
        },
        "block-5": {
          "type": "write",
          "settings": {
            "text": "Hyaluronic acid and glycerin. Nothing else needed."
          }
        },
        "block-6": {
          "type": "write",
          "settings": {
            "text": "Use it morning and night, or only when you remember."
          }
        },
        "block-7": {
          "type": "avoid",
          "settings": {
            "text": "Transform your skin in 7 days!!!"
          }
        },
        "block-8": {
          "type": "avoid",
          "settings": {
            "text": "Unlock the secret to flawless, glass-like skin"
          }
        },
        "block-9": {
          "type": "avoid",
          "settings": {
            "text": "Don't miss out, only 2 left"
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6",
        "block-7",
        "block-8",
        "block-9"
      ]
    },
    "brand-imagery": {
      "type": "blko-brand-imagery",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "direction",
          "settings": {
            "title": "Clean and bright",
            "text": "Even daylight, pale grounds, true colour. Skin keeps its texture and a little dewy shine."
          }
        },
        "block-2": {
          "type": "direction",
          "settings": {
            "title": "One thing at a time",
            "text": "A single bottle, jar or hand. Generous empty space and no props that need explaining."
          }
        },
        "block-3": {
          "type": "direction",
          "settings": {
            "title": "Bare and natural",
            "text": "Fresh faces, little make-up, unposed. Moments after washing rather than before a party."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3"
      ]
    }
  },
