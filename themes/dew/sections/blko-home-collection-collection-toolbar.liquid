eyebrow">{{ section.settings.filter_eyebrow | escape }}</p><h2>{{ section.settings.filter_heading | escape }}</h2>{% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by | escape }}">{% else %}{% endif %}{% for filter in collection.filters %}{% if filter.type == 'price_range' %}<fieldset class="blko-home-collection-filter-group"><legend>{{ filter.label | escape }}</legend><div class="blko-home-collection-filter-price"><label>{{ section.settings.price_from | escape }}<input type="number" name="{{ filter.min_value.param_name | escape }}" min="0" max="{{ filter.range_max | money_without_currency }}" placeholder="0"{% if filter.min_value.value != blank %} value="{{ filter.min_value.value | money_without_currency }}"{% else %}{% endif %}></label><label>{{ section.settings.price_to | escape }}<input type="number" name="{{ filter.max_value.param_name | escape }}" min="0" max="{{ filter.range_max | money_without_currency }}" placeholder="{{ filter.range_max | money_without_currency }}"{% if filter.max_value.value != blank %} value="{{ filter.max_value.value | money_without_currency }}"{% else %}{% endif %}></label></div></fieldset>{% else %}<fieldset class="blko-home-collection-filter-group"><legend>{{ filter.label | escape }}</legend>{% for filter_value in filter.values %}<label class="blko-home-collection-filter-option"><input type="checkbox" name="{{ filter_value.param_name | escape }}" value="{{ filter_value.value | escape }}"{% if filter_value.active %} checked{% else %}{% endif %}{% if filter_value.count == 0 %} disabled{% else %}{% endif %}><span>{{ filter_value.label | escape }}</span><small>({{ filter_value.count | escape }})</small></label>{% endfor %}</fieldset>{% endif %}{% endfor %}<button type="submit" class="blko-button">{{ section.settings.apply_label | escape }}</button></form></aside></section></blko-tabs></blko-home-collection></div>
