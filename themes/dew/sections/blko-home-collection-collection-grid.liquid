.blko-theme .blko-search-blog-tag-filter a{display:inline-block;border:1px solid var(--color-line);padding:.55rem .75rem;text-decoration:none}
.blko-theme .blko-search-blog-filters a{display:inline-block;border:1px solid var(--color-line);padding:.55rem .75rem;text-decoration:none}
.blko-theme .blko-search-blog-pagination a{display:inline-block;border:1px solid var(--color-line);padding:.55rem .75rem;text-decoration:none}
.blko-theme .blko-search-blog-comment p{margin:.25rem 0}
.blko-theme .blko-search-blog-comment-form .blko-button{justify-self:start}
{% endstylesheet %}
{% schema %}
{
  "name": "Collection catalog grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 4
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "No products match these filters."
    },
    {
      "type": "text",
      "id": "quick_label",
      "label": "Quick label",
      "default": "Quick view"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Promo image"
    },
    {
      "type": "text",
      "id": "promo_image_alt",
      "label": "Promo image alt text",
      "default": "Bronzer swatches from light to deep on a forearm"
    },
    {
      "type": "text",
      "id": "promo_eyebrow",
      "label": "Promo eyebrow",
      "default": "Bronzer unsure?"
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Promo heading",
      "default": "Match your depth in four taps."
    },
    {
      "type": "url",
      "id": "promo_url",
      "label": "Promo url"
    },
    {
      "type": "text",
      "id": "promo_label",
      "label": "Promo label",
      "default": "Try the shade finder"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more label",
      "default": "Load more"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous label",
      "default": "Previous page"
    }
  ],
  "presets": [
    {
      "name": "Collection catalog grid"
    }
  ]
}
{% endschema %}
