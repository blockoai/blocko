{% schema %}
{
  "name": "Refreshed not-found page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "404 / Page not found"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page has slipped away."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Try a search, or return to a known part of the shop."
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search the shop"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search the shop"
    },
    {
      "type": "text",
      "id": "search_button_label",
      "label": "Search button label",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Nav label",
      "default": "Popular destinations"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Person with natural makeup"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Destination link",
      "limit": 6,
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refreshed not-found page",
      "blocks": [
        {
          "type": "link",
          "settings": {}
        },
        {
          "type": "link",
          "settings": {
            "label": "Skin",
            "url": "#complexion"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "On the go",
            "url": "#care"
          }
        }
      ]
    }
  ]
}
