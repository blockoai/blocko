{%- comment -%} Generated by Blocko from tools/themes/dew/groups/signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-signature><section class="blko-dew-shades" data-dew-shades><div class="blko-dew-shades-head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-dew-shades-chips" role="group" aria-label="Tints">{% for block in section.blocks %}<button type="button" class="blko-dew-chip" data-tone="{{ block.settings.tone | escape }}" data-label="{{ block.settings.label | escape }}" aria-pressed="false" {{ block.shopify_attributes }}><span class="blko-dew-chip-dot" aria-hidden="true"></span><span class="blko-dew-chip-name">{{ block.settings.label | escape }}</span></button>{% endfor %}</div><p class="blko-dew-shades-live" aria-live="polite" data-dew-shade-label>{{ section.settings.default_label | escape }}</p><a class="blko-button" href="{{ section.settings.button_url | default: '#shop' }}">{{ section.settings.button_label | escape }}</a></section></blko-signature></div>
<script type="module" src="{{ 'blko-signature.js' | asset_url }}"></script>
