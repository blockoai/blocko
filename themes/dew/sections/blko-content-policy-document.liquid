{% schema %}
{
  "name": "Policy document",
  "settings": [
    {
      "type": "text",
      "id": "toc_label",
      "label": "Toc label",
      "default": "Table of contents"
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Toc heading",
      "default": "On this page"
    }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Policy section",
      "settings": [
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor id",
          "default": "content-policy-intro"
        },
        {
          "type": "text",
          "id": "toc",
          "label": "Toc",
          "default": "Introduction"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "1. Introduction"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>[Organization name] respects your privacy. This placeholder explains the headings a reviewed privacy policy commonly covers; it is not legal advice and must be replaced with approved copy before publication.</p><p>This policy applies to the website, customer support, and related services identified by your organization.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy document",
      "blocks": [
        {
          "type": "section",
          "settings": {}
        },
        {
          "type": "section",
          "settings": {
            "anchor": "content-policy-data",
            "toc": "Information we collect",
            "heading": "2. Information we collect",
            "body": "<p>Describe the categories of information collected when someone visits, purchases, contacts support, or subscribes. Be specific about information provided directly and information collected automatically.</p><ul><li>Account, contact, and order details</li><li>Device, browser, and usage information</li><li>Support communications and voluntary feedback</li></ul>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "content-policy-use",
            "toc": "How we use information",
            "heading": "3. How we use information",
            "body": "<p>Explain the purposes for processing, such as providing services, improving the experience, communicating about an order, preventing misuse, and meeting legal obligations.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "content-policy-sharing",
            "toc": "When we share information",
            "heading": "4. When we share information",
            "body": "<p>Identify the limited circumstances in which information is shared with service providers, professional advisers, authorities, or another party at a person’s direction.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "content-policy-choices",
            "toc": "Your choices",
            "heading": "5. Your choices",
            "body": "<p>Explain available access, correction, deletion, marketing preference, cookie, and region-specific privacy choices. Include a workable method to submit a request.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "content-policy-security",
            "toc": "Security and retention",
            "heading": "6. Security and retention",
            "body": "<p>Describe reasonable safeguards and the factors used to determine how long information is retained. Avoid absolute claims about security.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "content-policy-contact",
            "toc": "Contact",
            "heading": "7. Contact",
            "body": "<p>For privacy questions, write to <a href=\"mailto:privacy@example.com\">privacy@example.com</a>. Replace this placeholder and all policy text with approved legal copy before use.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
