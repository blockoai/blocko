<section class="blko-soda-mission" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <p class="blko-soda-mission__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h2>{{ section.settings.statement | escape }}</h2>
  <p>{{ section.settings.subtext | escape }}</p>
</section>

{% stylesheet %}
.blko-soda-mission{display:grid;justify-items:center;gap:1rem;padding:clamp(3rem,8vw,6rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif);text-align:center}
.blko-soda-mission__eyebrow{margin:0;font-size:.8rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.blko-soda-mission h2{max-width:46rem;margin:0;font:900 clamp(2rem,5vw,3.75rem)/1.05 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-mission p:last-child{margin:0;font-size:1.1rem}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda story mission",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#fff3b0"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0f3b2e"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our mission"},
    {"type": "textarea", "id": "statement", "label": "Statement", "default": "Make the fridge door the fun part of your day."},
    {"type": "text", "id": "subtext", "label": "Subtext", "default": "Yes, we said fun and fiber in the same breath."}
  ],
  "presets": [{"name": "Soda story mission"}]
}
{% endschema %}
