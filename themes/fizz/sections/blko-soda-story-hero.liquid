<section class="blko-soda-story" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <h1>{{ section.settings.heading | escape }}</h1>
  <p>{{ section.settings.text | escape }}</p>
  {%- if section.settings.footnote != blank -%}<small>{{ section.settings.footnote | escape }}</small>{%- endif -%}
</section>

{% stylesheet %}
.blko-soda-story{display:grid;justify-items:center;gap:1.1rem;padding:clamp(3.5rem,9vw,7rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif);text-align:center}
.blko-soda-story h1{margin:0;font:900 clamp(2.8rem,7vw,5.5rem)/.95 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-story p{max-width:44rem;margin:0;font-size:1.2rem;line-height:1.55}
.blko-soda-story small{opacity:.8}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda story hero",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#0f3b2e"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#f3e8cd"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Our story"},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Fizz started in a garage with a juicer, a few botanicals and one stubborn idea: soda can taste like summer and still be kind to your gut."},
    {"type": "text", "id": "footnote", "label": "Footnote", "default": "*Per 12 fl oz can."}
  ],
  "presets": [{"name": "Soda story hero"}]
}
{% endschema %}
