<div class="blko-theme"><blko-content><section class="blko-content-policy-document">{%- if shop.privacy_policy != blank -%}<article><section><h2>{{ shop.privacy_policy.title | escape }}</h2>{{ shop.privacy_policy.body }}</section></article>{%- else -%}<article><section><h2>{{ section.settings.fallback_heading | escape }}</h2><p>{{ shop.name | escape }} collects the details you give us, such as your name, email address, shipping address and order information, to process orders, answer questions and send updates you ask for. We share them only with the partners needed to deliver your order and run the shop, and we do not sell them.</p><p>You can ask to see, correct or delete your information at any time. Write to <a href="mailto:{{ shop.email | default: shop.customer_email | escape }}">{{ shop.email | default: shop.customer_email | escape }}</a>.</p></section></article>{%- endif -%}</section></blko-content></div>
