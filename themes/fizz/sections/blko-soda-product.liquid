{%- assign current = product.selected_or_first_available_variant -%}
{%- assign tile_bg = product.metafields.fizz.tile_bg.value | default: section.settings.tile_bg -%}
{%- assign flavor_accent = product.metafields.fizz.accent.value | default: section.settings.accent -%}
<div class="blko-soda-pdpwrap" data-flavor-scope style="--tile-bg:{{ tile_bg }};--flv-accent:{{ flavor_accent }}">
<blko-soda-product class="blko-soda-pdp">
  <div class="blko-soda-pdp__gallery">
    {%- if product.featured_image -%}
      {% render 'blko-soda-tile', product: product, size: 'gallery', loading: 'eager', attrs: 'data-main-image' %}
    {%- endif -%}
    {%- if product.images.size > 1 -%}
      <div class="blko-soda-pdp__thumbs">
        {%- for image in product.images -%}
          <button type="button" data-thumb="{{ image | image_url: width: 1200 }}" class="{% if forloop.first %}is-active{% endif %}" aria-label="{{ section.settings.image_label | escape }} {{ forloop.index }}">
            {% render 'blko-soda-tile', product: product, image: image, size: 'thumb' %}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <div class="blko-soda-pdp__info">
    <p class="blko-soda-pdp__line">{{ product.type }}</p>
    {%- assign flavors = collections[section.settings.flavor_collection].products -%}
    {%- if flavors.size > 1 -%}
      <details class="blko-soda-flavor">
        <summary><span class="blko-soda-flavor__dot">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 80 }}" alt="" width="24" height="24" loading="lazy">{% endif %}</span><span>{{ section.settings.flavor_label | escape }}: <b>{{ product.title }}</b></span></summary>
        <ul>
          {%- for f in flavors -%}
            <li><a href="{{ f.url }}"{% if f.id == product.id %} aria-current="true"{% endif %}><span class="blko-soda-flavor__dot" style="--tile-bg:{{ f.metafields.fizz.tile_bg.value | default: section.settings.tile_bg }}">{% if f.featured_image %}<img src="{{ f.featured_image | image_url: width: 80 }}" alt="" width="24" height="24" loading="lazy">{% endif %}</span>{{ f.title }}</a></li>
          {%- endfor -%}
        </ul>
      </details>
    {%- endif -%}
    <h1>{{ product.title }}</h1>
    {%- capture stars -%}{% render 'blko-soda-stars', product: product %}{%- endcapture -%}
    {%- if stars != blank -%}<p class="blko-soda-pdp__rating">{{ stars }}</p>{%- endif -%}
    <p class="blko-soda-pdp__price"><span data-price>{{ current.price | money }}</span> <s data-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money }}</s></p>
    <div class="blko-soda-pdp__desc">{{ product.description | strip_html | truncatewords: 40 }}</div>
    {%- form 'product', product, data-product-form: '' -%}
      {%- capture variants_json -%}[
        {%- for v in product.variants -%}
          {"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available | json }},"price":{{ v.price | money | json }},"compare":{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %},"plans":{
            {%- for a in v.selling_plan_allocations -%}
              {%- assign unit_price = a.per_delivery_price | default: a.price -%}
              {%- assign pct = 0 -%}
              {%- if v.price > 0 and unit_price < v.price -%}{%- assign pct = v.price | minus: unit_price | times: 100.0 | divided_by: v.price | round -%}{%- endif -%}
              "{{ a.selling_plan.id }}":{"price":{{ unit_price | money | json }},"pct":{{ pct }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]{%- endcapture -%}
      <script type="application/json" data-variants>{{ variants_json }}</script>
      <input type="hidden" name="id" value="{{ current.id }}">
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <fieldset class="blko-soda-pdp__option">
            <legend>{{ option.name }}</legend>
            <div>
              {%- for value in option.values -%}
                <input type="radio" data-option id="blko-o{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                <label for="blko-o{{ option.position }}-{{ forloop.index }}">{{ value }}</label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}
      {%- if product.selling_plan_groups.size > 0 -%}
        {%- assign first_alloc = current.selling_plan_allocations.first -%}
        {%- assign first_unit = first_alloc.per_delivery_price | default: first_alloc.price | default: current.price -%}
        {%- assign save_pct = current.price | minus: first_unit | times: 100.0 | divided_by: current.price | round -%}
        {%- assign sub_default = section.settings.default_subscribe | default: false -%}
        {%- if product.requires_selling_plan %}{% assign sub_default = true %}{% endif -%}
        <div class="blko-soda-purchase" data-purchase data-save-label="{{ section.settings.save_label | escape }}" data-required="{{ product.requires_selling_plan }}"{% if current.selling_plan_allocations.size == 0 %} hidden{% endif %}>
          {%- unless product.requires_selling_plan -%}
          <label class="blko-soda-purchase__opt">
            <span class="blko-soda-purchase__row"><input type="radio" name="purchase_type" value="once" {% unless sub_default %}checked{% endunless %} data-purchase-type> {{ section.settings.one_time_label }}<span class="blko-soda-purchase__price" data-once-price>{{ current.price | money }}</span></span>
          </label>
          {%- endunless -%}
          <label class="blko-soda-purchase__opt">
            <span class="blko-soda-purchase__row"><input type="radio" name="purchase_type" value="sub" {% if sub_default %}checked{% endif %} data-purchase-type> {{ section.settings.subscribe_label }} <span class="blko-soda-purchase__save" data-save{% unless save_pct > 0 %} hidden{% endunless %}>{{ section.settings.save_label }} {{ save_pct }}%</span><span class="blko-soda-purchase__price" data-sub-price>{{ first_unit | money }}</span></span>
            <span class="blko-soda-purchase__freq" data-freq {% unless sub_default %}hidden{% endunless %}>
              <label for="blko-plan">{{ section.settings.frequency_label }}</label>
              <select id="blko-plan" data-plan-select>
                {%- for group in product.selling_plan_groups -%}
                  <optgroup label="{{ group.name | escape }}">
                    {%- for plan in group.selling_plans -%}<option value="{{ plan.id }}" data-name="{{ plan.name | escape }}">{{ plan.name | escape }}</option>{%- endfor -%}
                  </optgroup>
                {%- endfor -%}
              </select>
            </span>
          </label>
          <input type="hidden" name="selling_plan" value="" data-selling-plan disabled>
        </div>
      {%- endif -%}
      <button type="submit" class="blko-soda-pdp__add" data-submit data-add="{{ section.settings.add_label }}" data-sold="{{ section.settings.sold_label }}" {% unless current.available %}disabled{% endunless %}>{% if current.available %}{{ section.settings.add_label }}{% else %}{{ section.settings.sold_label }}{% endif %}</button>
      {{ form | payment_button }}
    {%- endform -%}
    <p class="blko-soda-pdp__ship">{{ section.settings.shipping_note }}</p>
    {%- assign perks = section.blocks | where: 'type', 'perk' -%}
    {%- if perks.size > 0 -%}
      <div class="blko-soda-perks">
        <h2>{{ section.settings.perks_heading | escape }}</h2>
        <ul>{%- for perk in perks -%}<li {{ perk.shopify_attributes }}>{{ perk.settings.text | escape }}</li>{%- endfor -%}</ul>
      </div>
    {%- endif -%}
  </div>
  <div class="blko-soda-sticky" data-sticky aria-hidden="true">
    <div class="blko-soda-sticky__in">
      <span class="blko-soda-sticky__thumb" style="--tile-bg:{{ tile_bg }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="40" height="40" loading="lazy">{% endif %}</span>
      <b class="blko-soda-sticky__name">{{ product.title }}</b>
      <span class="blko-soda-sticky__opt" data-sticky-opt>{{ current.title }}</span>
      <span class="blko-soda-sticky__price"><s data-sticky-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money }}</s><b data-sticky-price>{{ current.price | money }}</b></span>
      <button type="button" class="blko-soda-sticky__btn" data-sticky-add tabindex="-1"{% unless current.available %} disabled{% endunless %}>{% if current.available %}{{ section.settings.add_label }}{% else %}{{ section.settings.sold_label }}{% endif %}</button>
    </div>
  </div>
</blko-soda-product>
</div>
<script type="module" src="{{ 'blko-soda.js' | asset_url }}"></script>

{% stylesheet %}
.blko-soda-pdp{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(1.5rem,5vw,4rem);max-width:75rem;margin:0 auto;padding:clamp(1.5rem,4vw,3rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif);color:var(--color-text, #0f3b2e)}
.blko-soda-pdp__gallery{min-width:0}
.blko-soda-pdp__gallery>img{display:block;width:100%;max-width:100%;height:auto;aspect-ratio:1;border-radius:2rem;object-fit:cover;background:var(--color-bg-alt, #f3e8cd)}
.blko-soda-pdp__thumbs{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.8rem}
.blko-soda-pdp__thumbs button{padding:0;border:2px solid transparent;border-radius:.8rem;background:none;overflow:hidden;cursor:pointer}
.blko-soda-pdp__thumbs button.is-active{border-color:var(--color-text, #0f3b2e)}
.blko-soda-pdp__thumbs img{display:block;width:4.5rem;height:4.5rem;object-fit:cover}
.blko-soda-pdp__line{margin:0;font-size:.8rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.blko-soda-pdp__info h1{margin:.2rem 0 .4rem;font:900 clamp(2.2rem,4.5vw,3.5rem)/1 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-pdp__price{margin:0 0 .8rem;font:900 1.6rem var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-pdp__price s{margin-left:.4rem;color:var(--color-text-muted, #4a6a5c);font-size:1.1rem}
.blko-soda-pdp__desc{margin-bottom:1.25rem;font-size:1.05rem;line-height:1.55}
.blko-soda-pdp__option{margin:0 0 1rem;padding:0;border:0}
.blko-soda-pdp__option legend{padding:0;margin-bottom:.4rem;font-weight:800}
.blko-soda-pdp__option div{display:flex;flex-wrap:wrap;gap:.5rem}
.blko-soda-pdp__option input{position:absolute;opacity:0;pointer-events:none}
.blko-soda-pdp__option label{padding:.55rem 1.1rem;border:2px solid var(--color-text, #0f3b2e);border-radius:999px;font-weight:700;cursor:pointer}
.blko-soda-pdp__option input:checked+label{background:var(--color-text, #0f3b2e);color:var(--color-bg-alt, #f3e8cd)}
.blko-soda-pdp__option input:focus-visible+label{outline:3px solid var(--color-accent, #ff6b8b);outline-offset:2px}
.blko-soda-purchase{display:grid;gap:.6rem;margin:1.2rem 0}
.blko-soda-purchase__opt{display:block;padding:.9rem 1.1rem;border:2px solid var(--color-text, #0f3b2e);border-radius:1.1rem;background:var(--color-bg-alt, #f3e8cd);font-weight:700;cursor:pointer}
.blko-soda-purchase__opt:has(input:checked){background:var(--color-announcement-bg, #cdf26b)}
.blko-soda-purchase__row{display:flex;align-items:center;gap:.6rem}
.blko-soda-purchase__price{margin-left:auto;font-weight:800}
.blko-soda-purchase__save{padding:.1rem .5rem;border-radius:999px;background:var(--color-accent, #ff6b8b);font-size:.78rem;font-weight:800}
.blko-soda-purchase__freq{display:grid;gap:.3rem;margin-top:.7rem;font-size:.9rem}
.blko-soda-purchase[hidden],.blko-soda-purchase__freq[hidden],.blko-soda-purchase__save[hidden]{display:none}
.blko-soda-purchase__freq select{padding:.5rem .7rem;border:2px solid var(--color-text, #0f3b2e);border-radius:.7rem;background:#fff;color:inherit}
.blko-soda-pdp__add{display:block;width:100%;margin:.4rem 0 .6rem;padding:1rem 1.5rem;border:0;border-radius:999px;background:var(--color-button, #0f3b2e);color:var(--color-button-text, #fff);font:900 1.15rem var(--font-heading, "Fraunces", Georgia, serif);cursor:pointer}
.blko-soda-pdp__add:disabled{opacity:.5;cursor:not-allowed}
.blko-soda-pdp__ship{margin:.8rem 0 0;font-size:.9rem}
.blko-soda-perks{margin-top:1.2rem;padding:1rem 1.2rem;border:2px dashed var(--color-text, #0f3b2e);border-radius:1.1rem}
.blko-soda-perks h2{margin:0 0 .6rem;font:900 1.1rem var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-perks ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.4rem .8rem;margin:0;padding:0;list-style:none;font-size:.92rem;font-weight:700}
.blko-soda-perks li::before{content:"\2713";margin-right:.4rem;color:var(--color-accent, #ff6b8b)}
@media(max-width:800px){.blko-soda-pdp{grid-template-columns:1fr}}
/* pdp */
.blko-soda-pdpwrap{--tile-bg:#fde1e3;--flv:#c8203a;--flv-accent:#ffd0d6;background:color-mix(in srgb,var(--tile-bg) 45%,#fffaf0);transition:background-color .25s ease-in-out}
.blko-soda-pdp{align-items:start;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr)}
.blko-soda-pdp__gallery{position:sticky;top:1.5rem}
.blko-soda-pdp .blko-soda-pdp__gallery>.blko-soda-tile{border-radius:20px}
.blko-soda-pdp .blko-soda-pdp__thumbs button{width:72px;height:72px;padding:0;border:2px solid transparent;border-radius:14px;overflow:hidden}
.blko-soda-pdp .blko-soda-pdp__thumbs .blko-soda-tile{width:100%;height:100%;border-radius:12px}
.blko-soda-pdp .blko-soda-pdp__thumbs img{width:78%;height:78%}
.blko-soda-pdp .blko-soda-pdp__thumbs .is-full img{width:100%;height:100%}
.blko-soda-pdp .blko-soda-pdp__thumbs button.is-active{border-color:var(--color-text,#0f3b2e)}
.blko-soda-pdp__info{position:sticky;top:1.5rem;text-align:center}
.blko-soda-pdp__line{font:700 18px/1.4 var(--font-body,"Outfit",sans-serif);letter-spacing:0;text-decoration:underline;text-transform:none}
.blko-soda-pdp__info h1{margin:.6rem 0;font:900 clamp(2.4rem,4.5vw,3rem)/1.05 var(--font-heading,"Fraunces",Georgia,serif)}
.blko-soda-pdp__price s{margin-left:.4rem}
.blko-soda-pdp__rating{margin:0 0 .6rem}
.blko-soda-flavor{position:relative;margin:.8rem 0 0;text-align:left}
.blko-soda-flavor summary{display:flex;align-items:center;gap:.6rem;height:48px;padding:0 1rem;border:1px solid var(--color-text,#0f3b2e);border-radius:24px;background:#fff;font:700 14px/1 var(--font-body,"Outfit",sans-serif);cursor:pointer;list-style:none;transition:box-shadow .2s ease}
.blko-soda-flavor summary::-webkit-details-marker{display:none}
.blko-soda-flavor summary::after{content:"";width:8px;height:8px;margin-left:auto;border:solid currentColor;border-width:0 2px 2px 0;transform:rotate(45deg) translateY(-2px)}
.blko-soda-flavor summary:hover{box-shadow:4px 4px 0 0 var(--flv-accent)}
.blko-soda-flavor__dot{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:50%;background:var(--tile-bg);flex:none}
.blko-soda-flavor__dot img{width:auto;height:24px}
.blko-soda-flavor ul::-webkit-scrollbar{display:none}
.blko-soda-flavor ul{position:absolute;left:0;right:0;top:calc(100% + 6px);z-index:15;margin:0;padding:.4rem;max-height:20rem;overflow:auto;scrollbar-width:none;border:1px solid var(--color-text,#0f3b2e);border-radius:16px;background:#fff;list-style:none}
.blko-soda-flavor li a{display:flex;align-items:center;gap:.6rem;padding:.4rem .6rem;border-radius:12px;color:inherit;font:700 14px/1.2 var(--font-body,"Outfit",sans-serif);text-decoration:none;transition:background-color .25s ease-in-out}
.blko-soda-flavor li a:hover,.blko-soda-flavor li a[aria-current]{background:#d6f1ea}
.blko-soda-pdp__option{text-align:left}
.blko-soda-pdp__option div{justify-content:flex-start}
.blko-soda-pdp__option label{padding:.6rem 1.2rem;border:1.5px solid var(--color-text,#0f3b2e);font:700 14px/1.2 var(--font-body,"Outfit",sans-serif);transition:box-shadow .2s ease,background-color .25s ease}
.blko-soda-pdp__option label:hover{box-shadow:4px 4px 0 0 var(--flv-accent)}
.blko-soda-purchase{text-align:left}
.blko-soda-purchase__opt{border:1.5px solid var(--color-text,#0f3b2e);border-radius:16px;font-size:14px;transition:box-shadow .2s ease,background-color .25s ease}
.blko-soda-purchase__opt:hover,.blko-soda-purchase__opt:has(input:checked){box-shadow:4px 4px 0 0 var(--flv-accent)}
.blko-soda-pdp .blko-soda-pdp__add{height:48px;padding:0 2rem;border:3px solid var(--color-text,#0f3b2e);font:700 18px/1 var(--font-body,"Outfit",sans-serif);transition:background-color .25s ease,color .25s ease,box-shadow .2s ease}
.blko-soda-pdp .blko-soda-pdp__add:hover:not(:disabled){box-shadow:4px 4px 0 0 var(--flv-accent)}
.blko-soda-sticky{position:fixed;left:0;right:0;bottom:0;z-index:40;height:73px;background:#fffbf5;border-top:1px solid #f3e4cd;transform:translateY(100%);opacity:0;visibility:hidden;transition:transform .28s ease,opacity .28s ease,visibility 0s linear .28s}
.blko-soda-sticky.is-visible{transform:none;opacity:1;visibility:visible;transition:transform .28s ease,opacity .28s ease,visibility 0s}
.blko-soda-sticky__in{display:flex;align-items:center;gap:1rem;height:100%;max-width:75rem;margin:0 auto;padding:0 1.25rem;font-family:var(--font-body,"Outfit",sans-serif);color:var(--color-text,#0f3b2e)}
.blko-soda-sticky__thumb{display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--tile-bg);overflow:hidden;flex:none}
.blko-soda-sticky__thumb img{width:auto;height:40px}
.blko-soda-sticky__name{font:900 1.4rem/1 var(--font-heading,"Fraunces",Georgia,serif)}
.blko-soda-sticky__opt{font-size:1rem;color:var(--color-text-muted,#4a6a5c)}
.blko-soda-sticky__price{margin-left:auto;display:flex;align-items:baseline;gap:.5rem;font-weight:800}
.blko-soda-sticky__price s{font-weight:600;color:var(--color-text-muted,#4a6a5c)}
.blko-soda-sticky__btn{height:48px;padding:0 2rem;border:3px solid var(--color-text,#0f3b2e);border-radius:999px;background:var(--color-button,#0f3b2e);color:#fff;font:700 18px/1 var(--font-body,"Outfit",sans-serif);cursor:pointer;transition:background-color .25s ease,box-shadow .2s ease}
.blko-soda-sticky__btn:hover:not(:disabled){box-shadow:4px 4px 0 0 var(--flv-accent,#ffd0d6)}
.blko-soda-sticky__btn:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:800px){.blko-soda-pdp{grid-template-columns:1fr}.blko-soda-pdp__gallery,.blko-soda-pdp__info{position:static}.blko-soda-sticky__opt,.blko-soda-sticky__thumb{display:none}.blko-soda-sticky__name{font-size:1.1rem}.blko-soda-sticky__btn{padding:0 1.25rem;font-size:16px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda product",
  "settings": [
    {"type": "color", "id": "tile_bg", "label": "Page and tile tint (fallback)", "default": "#fde1e3", "info": "Per product: metafield fizz.tile_bg (color)."},
    {"type": "color", "id": "accent", "label": "Hover shadow color (fallback)", "default": "#ffd0d6", "info": "Per product: metafield fizz.accent (color)."},
    {"type": "text", "id": "flavor_collection", "label": "Flavor switcher collection handle", "default": "drinks", "info": "Lists this collection's products in the flavor dropdown."},
    {"type": "text", "id": "flavor_label", "label": "Flavor switcher label", "default": "Flavor"},
    {"type": "text", "id": "image_label", "label": "Thumbnail label", "default": "Image"},
    {"type": "text", "id": "one_time_label", "label": "One-time label", "default": "One-time purchase"},
    {"type": "text", "id": "subscribe_label", "label": "Subscribe label", "default": "Subscribe & Save"},
    {"type": "text", "id": "save_label", "label": "Save label", "default": "Save"},
    {"type": "text", "id": "frequency_label", "label": "Frequency label", "default": "Delivery frequency"},
    {"type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart"},
    {"type": "text", "id": "sold_label", "label": "Sold out label", "default": "Sold out"},
    {"type": "text", "id": "shipping_note", "label": "Shipping note", "default": "Free shipping over $35. Pause or cancel any time."},
    {"type": "checkbox", "id": "default_subscribe", "label": "Default to subscription", "default": false, "info": "Preselects Subscribe & Save when the product has a selling plan. Plans, prices and percentages come from the product's selling plan groups (Shopify Subscriptions); the selector hides itself when there are none."},
    {"type": "text", "id": "perks_heading", "label": "Perks heading", "default": "How subscription works"}
  ],
  "blocks": [
    {"type": "perk", "name": "Subscription perk", "limit": 6, "settings": [{"type": "text", "id": "text", "label": "Text", "default": "Skip any delivery"}]}
  ],
  "presets": [
    {"name": "Soda product"}
  ]
}
{% endschema %}
