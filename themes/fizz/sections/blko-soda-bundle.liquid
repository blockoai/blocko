{%- assign current = product.selected_or_first_available_variant -%}
{%- assign cans = section.settings.cans_per_unit | default: 1 -%}
{%- assign pack_discount = section.settings.pack_discount | default: 10 -%}
{%- assign pack_size = section.settings.pack_size | default: 3 -%}
{%- assign tiers = section.blocks | where: 'type', 'tier' -%}
<blko-soda-bundle class="blko-soda-bundle" data-price="{{ current.price }}" data-cans="{{ cans }}" data-currency="{{ cart.currency.iso_code | default: 'USD' }}" data-pack="{{ pack_size }}" data-discount="{{ pack_discount }}" data-product-id="{{ product.id }}" data-save-label="{{ section.settings.save_label | escape }}" data-buy-label="{{ section.settings.buy_label | escape }}" data-can-label="{{ section.settings.can_label | escape }}" data-note-aov="{{ section.settings.note_aov | escape }}">
  <script type="application/json" data-aov-offers>{{ shop.metafields.avada_bundle.offer | json }}</script>
  <div class="blko-soda-bundle__block" data-tier-block{% if tiers.size == 0 %} hidden{% endif %}>
    <p class="blko-soda-bundle__eyebrow">{{ section.settings.tiers_eyebrow | escape }}</p>
    <h2>{{ section.settings.tiers_heading | escape }}</h2>
    {%- if request.design_mode -%}<p class="blko-soda-bundle__note" data-note="tiers" hidden>{{ section.settings.note_tiers | escape }}</p>{%- endif -%}
    {%- form 'product', product, data-tier-form: '' -%}
      <input type="hidden" name="id" value="{{ current.id }}">
      <input type="hidden" name="quantity" value="1" data-tier-qty>
      <div class="blko-soda-tiers" data-tiers role="radiogroup" aria-label="{{ section.settings.tiers_heading | escape }}">
        {%- for tier in tiers -%}
          <label class="blko-soda-tier" {{ tier.shopify_attributes }}>
            <input type="radio" name="tier" value="{{ tier.settings.quantity }}" data-tier data-off="{{ tier.settings.discount }}" {% if forloop.first %}checked{% endif %}>
            <span class="blko-soda-tier__badge" {% if tier.settings.badge == blank %}hidden{% endif %}>{{ tier.settings.badge | escape }}</span>
            <span class="blko-soda-tier__name">{{ section.settings.buy_label | escape }} {{ tier.settings.quantity }}</span>
            <span class="blko-soda-tier__save">{% if tier.settings.discount > 0 %}{{ section.settings.save_label | escape }} {{ tier.settings.discount }}%{% else %}&nbsp;{% endif %}</span>
            <span class="blko-soda-tier__per" data-tier-per></span>
          </label>
        {%- endfor -%}
      </div>
      <div class="blko-soda-buy"><button type="submit" class="blko-soda-bundle__add" data-tier-add data-label="{{ section.settings.tier_add_label | escape }}" {% unless current.available %}disabled{% endunless %}>{{ section.settings.tier_add_label | escape }}</button>{% render 'blko-soda-wish', product: product %}</div>
    {%- endform -%}
  </div>

  <div class="blko-soda-bundle__block" id="build">
    <p class="blko-soda-bundle__eyebrow">{{ section.settings.pack_eyebrow | escape }}</p>
    <h2>{{ section.settings.pack_heading | escape }}</h2>
    {%- if request.design_mode -%}<p class="blko-soda-bundle__note" data-note="pack" hidden>{{ section.settings.note_pack | escape }}</p>{%- endif -%}
    {%- if section.settings.pack_collection == blank -%}
      <p class="blko-soda-bundle__empty">{{ section.settings.empty_text | escape }}</p>
    {%- else -%}
      {%- form 'product', product, data-pack-form: '' -%}
        <div class="blko-soda-pick">
          {%- for p in section.settings.pack_collection.products limit: 12 -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <div class="blko-soda-pick__item" data-pick data-id="{{ v.id }}" data-price="{{ v.price }}" {% unless v.available %}data-soldout{% endunless %}>
              {% render 'blko-soda-tile', product: p, size: 'pick' %}
              <b>{{ p.title | escape }}</b>
              <span class="blko-soda-pick__qty">
                <button type="button" data-minus aria-label="{{ section.settings.remove_label | escape }} {{ p.title | escape }}" disabled>&minus;</button>
                <output data-count>0</output>
                <button type="button" data-plus aria-label="{{ section.settings.add_label | escape }} {{ p.title | escape }}" {% unless v.available %}disabled{% endunless %}>+</button>
              </span>
            </div>
          {%- endfor -%}
        </div>
        <div class="blko-soda-pick__bar">
          <div class="blko-soda-pick__progress"><span data-bar></span></div>
          <p data-progress data-template="{{ section.settings.progress_label | escape }}" aria-live="polite"></p>
          <p class="blko-soda-pick__price"><s data-was hidden></s> <b data-total></b> <span class="blko-soda-pick__off" data-off hidden>{{ section.settings.save_label | escape }} {{ pack_discount }}%</span></p>
          <p class="blko-soda-pick__hint" data-hint data-template="{{ section.settings.hint_label | escape }}" aria-live="polite"></p>
        </div>
        <input type="hidden" data-bundle-items value="">
        <button type="submit" class="blko-soda-bundle__add" data-pack-add data-label="{{ section.settings.pack_add_label | escape }}" disabled>{{ section.settings.pack_add_label | escape }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</blko-soda-bundle>
<script type="module" src="{{ 'blko-soda.js' | asset_url }}"></script>

{% stylesheet %}
.blko-soda-bundle{display:grid;gap:clamp(1.5rem,4vw,3rem);max-width:75rem;margin:0 auto;padding:clamp(1.5rem,4vw,3rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif);color:var(--color-text, #0f3b2e)}
.blko-soda-bundle__block{padding:clamp(1.25rem,3vw,2.25rem);border:2px solid var(--color-text, #0f3b2e);border-radius:2rem;background:var(--color-bg-alt, #f3e8cd)}
.blko-soda-bundle__eyebrow{margin:0;font-size:.8rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.blko-soda-bundle__block h2{margin:.2rem 0 1.2rem;font:900 clamp(1.6rem,3vw,2.3rem)/1.05 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-bundle__empty{margin:0}
.blko-soda-tiers{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.8rem}
.blko-soda-tier{position:relative;display:grid;gap:.15rem;padding:1.1rem 1rem;border:2px solid var(--color-text, #0f3b2e);border-radius:1.2rem;background:#fff;text-align:center;font-weight:700;cursor:pointer}
.blko-soda-tier input{position:absolute;opacity:0;pointer-events:none}
.blko-soda-tier:has(input:checked){background:var(--color-announcement-bg, #cdf26b)}
.blko-soda-tier:has(input:focus-visible){outline:3px solid var(--color-accent, #ff6b8b);outline-offset:2px}
.blko-soda-tier__badge{position:absolute;top:-.8rem;left:50%;transform:translateX(-50%);padding:.1rem .7rem;border-radius:999px;background:var(--color-accent, #ff6b8b);font-size:.75rem;font-weight:800;white-space:nowrap}
.blko-soda-tier__name{font:900 1.4rem var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-tier__save{font-size:.85rem}
.blko-soda-tier__per{font-size:1.05rem;font-weight:800}
.blko-soda-bundle__add{display:block;width:100%;max-width:26rem;margin:1.2rem 0 0;padding:1rem 1.5rem;border:0;border-radius:999px;background:var(--color-button, #0f3b2e);color:var(--color-button-text, #fff);font:900 1.1rem var(--font-heading, "Fraunces", Georgia, serif);cursor:pointer}
.blko-soda-bundle__add:disabled{opacity:.5;cursor:not-allowed}
.blko-soda-pick{display:grid;grid-template-columns:repeat(auto-fill,minmax(9rem,1fr));gap:.8rem}
.blko-soda-pick__item{display:grid;gap:.4rem;justify-items:center;padding:.7rem;border:2px solid transparent;border-radius:1.2rem;background:#fff;text-align:center}
.blko-soda-pick__item.is-picked{border-color:var(--color-text, #0f3b2e)}
.blko-soda-pick__item img{width:100%;height:auto;aspect-ratio:1;border-radius:.9rem;object-fit:cover}
.blko-soda-pick__item[data-soldout]{opacity:.5}
.blko-soda-pick__qty{display:inline-flex;align-items:center;gap:.6rem}
.blko-soda-pick__qty button{width:2.2rem;height:2.2rem;border:2px solid var(--color-text, #0f3b2e);border-radius:50%;background:none;color:inherit;font-size:1.2rem;font-weight:800;line-height:1;cursor:pointer}
.blko-soda-pick__qty button:disabled{opacity:.35;cursor:not-allowed}
.blko-soda-pick__qty output{min-width:1.2rem;font-weight:800;text-align:center}
.blko-soda-pick__bar{margin-top:1.2rem}
.blko-soda-pick__bar p{margin:.4rem 0 0;font-weight:700}
.blko-soda-pick__progress{height:.8rem;border-radius:999px;background:#fff;overflow:hidden}
.blko-soda-pick__progress span{display:block;width:0;height:100%;border-radius:999px;background:var(--color-accent, #ff6b8b);transition:width .2s}
.blko-soda-pick__price b{font:900 1.5rem var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-pick__price s{color:var(--color-text-muted, #4a6a5c)}
.blko-soda-pick__price s[hidden],.blko-soda-pick__off[hidden],.blko-soda-pick__hint[hidden],.blko-soda-bundle__block[hidden],.blko-soda-bundle__note[hidden]{display:none}
.blko-soda-pick__hint{font-size:.95rem}
.blko-soda-bundle__note{margin:0 0 1rem;padding:.7rem .9rem;border:2px dashed var(--color-text, #0f3b2e);border-radius:1rem;background:#fff;font-size:.85rem;font-weight:700}
.blko-soda-pick__off{padding:.1rem .5rem;border-radius:999px;background:var(--color-announcement-bg, #cdf26b);font-size:.78rem;font-weight:800}
/* bundle picker */
.blko-soda-pick{grid-template-columns:repeat(auto-fill,minmax(9rem,1fr))}
.blko-soda-pick__item .blko-soda-tile{width:100%;height:auto;border-radius:20px}
.blko-soda-pick__item{border-radius:20px;transition:box-shadow .2s ease,border-color .25s ease}
.blko-soda-pick__item:hover{box-shadow:4px 4px 0 0 var(--color-announcement-bg,#cdf26b)}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda bundle",
  "tag": "section",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {"type": "header", "content": "Volume tiers"},
    {"type": "text", "id": "tiers_eyebrow", "label": "Eyebrow", "default": "Stock the fridge"},
    {"type": "text", "id": "tiers_heading", "label": "Heading", "default": "Buy more, save more"},
    {"type": "range", "id": "cans_per_unit", "label": "Cans per unit", "min": 1, "max": 48, "step": 1, "default": 12, "info": "Used for the per-can price. A 12-pack variant is 12. Tiers and discounts come from the AOV.ai volume offer when one covers this product."},
    {"type": "text", "id": "buy_label", "label": "Buy label", "default": "Buy"},
    {"type": "text", "id": "save_label", "label": "Save label", "default": "Save"},
    {"type": "text", "id": "can_label", "label": "Per-unit label", "default": "can"},
    {"type": "text", "id": "note_tiers", "label": "Editor note: section tiers", "default": "No active AOV.ai volume offer covers this product, so these section tiers are display only. Create a Shopify automatic discount that matches each tier."},
    {"type": "text", "id": "note_pack", "label": "Editor note: variety pack", "default": "No active AOV.ai mix-and-match offer found. The pack discount is display only; create a matching Shopify automatic discount for items with the _bundle property."},
    {"type": "text", "id": "note_aov", "label": "Editor note: AOV.ai offer in use", "default": "Using the active AOV.ai offer. Its code is applied to the cart after add."},
    {"type": "text", "id": "tier_add_label", "label": "Add tier button label", "default": "Add to cart"},
    {"type": "header", "content": "Variety pack picker"},
    {"type": "text", "id": "pack_eyebrow", "label": "Eyebrow", "default": "Build your own"},
    {"type": "text", "id": "pack_heading", "label": "Heading", "default": "Build your own variety pack"},
    {"type": "collection", "id": "pack_collection", "label": "Flavor collection"},
    {"type": "range", "id": "pack_size", "label": "Flavors to pick", "min": 2, "max": 12, "step": 1, "default": 3},
    {"type": "range", "id": "pack_discount", "label": "Pack discount (%)", "min": 0, "max": 50, "step": 1, "default": 10, "info": "Used when no AOV.ai mix-and-match offer is active. Create a matching Shopify automatic discount for items with the _bundle property."},
    {"type": "text", "id": "hint_label", "label": "Hint text", "default": "Pick {left} more to save {discount}", "info": "Shown until the pack is full. Use {left} and {discount}."},
    {"type": "text", "id": "progress_label", "label": "Progress text", "default": "{picked} of {total} picked", "info": "Use {picked} and {total}."},
    {"type": "text", "id": "add_label", "label": "Add flavor label", "default": "Add"},
    {"type": "text", "id": "remove_label", "label": "Remove flavor label", "default": "Remove"},
    {"type": "text", "id": "pack_add_label", "label": "Add bundle button label", "default": "Add bundle to cart"},
    {"type": "text", "id": "empty_text", "label": "Empty text", "default": "Choose a flavor collection in the section settings."}
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Volume tier",
      "limit": 6,
      "settings": [
        {"type": "range", "id": "quantity", "label": "Quantity", "min": 1, "max": 12, "step": 1, "default": 1},
        {"type": "range", "id": "discount", "label": "Discount (%)", "min": 0, "max": 50, "step": 1, "default": 0},
        {"type": "text", "id": "badge", "label": "Badge"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Soda bundle",
      "blocks": [
        {"type": "tier", "settings": {"quantity": 1, "discount": 0}},
        {"type": "tier", "settings": {"quantity": 2, "discount": 10, "badge": "Popular"}},
        {"type": "tier", "settings": {"quantity": 3, "discount": 15, "badge": "Best value"}}
      ]
    }
  ]
}
{% endschema %}
