<section class="blko-soda-twoup" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <div class="blko-soda-twoup__grid">
    {%- for block in section.blocks -%}
      <article {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
        {%- else -%}
          <div class="blko-soda-fan" style="--tile-bg:{{ block.settings.tile_bg }}">
            {%- assign fan_cans = block.settings.cans | split: ',' -%}
            {%- for can in fan_cans limit: 3 -%}
              <img class="blko-soda-fan__can is-{{ forloop.index0 }}" src="{{ 'fizz-can-' | append: can | strip | append: '.svg' | asset_url }}" alt="" width="200" height="360" loading="lazy">
            {%- endfor -%}
          </div>
        {%- endif -%}
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
        <a href="{{ block.settings.button_url }}">{{ block.settings.button_label | escape }}</a>
      </article>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.blko-soda-twoup{padding:clamp(2.5rem,6vw,5rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-twoup__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1.25rem,3vw,2.5rem);max-width:70rem;margin:0 auto}
.blko-soda-twoup article{display:grid;justify-items:center;gap:.8rem;text-align:center}
.blko-soda-twoup img{width:100%;height:auto;aspect-ratio:1;border-radius:1.75rem;object-fit:cover}
.blko-soda-twoup h3{margin:.4rem 0 0;font:900 clamp(1.5rem,3vw,2.25rem)/1 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-twoup p{max-width:26rem;margin:0;line-height:1.5}
.blko-soda-twoup a{padding:.85rem 1.8rem;border-radius:999px;background:var(--color-button, #0f3b2e);color:var(--color-button-text, #fff);font:700 1rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
@media(max-width:700px){.blko-soda-twoup__grid{grid-template-columns:1fr}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda 2-up",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#f3e8cd"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0f3b2e"}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 2,
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image (optional, replaces the can fan)"},
        {"type": "text", "id": "cans", "label": "Can fan: 3 flavor handles, comma separated", "default": "cherry-pop,orange-burst,grape-soda", "info": "Uses fizz-can-HANDLE.svg theme assets."},
        {"type": "color", "id": "tile_bg", "label": "Fan background", "default": "#fde9d2"},
                {"type": "text", "id": "title", "label": "Title", "default": "Classic cans"},
        {"type": "textarea", "id": "text", "label": "Text", "default": "The original lineup: bright fruit, 2g of sugar and fiber that keeps up."},
        {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop classics"},
        {"type": "url", "id": "button_url", "label": "Button link"}
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Soda 2-up",
      "blocks": [
        {"type": "item", "settings": {"title": "Classic cans", "button_label": "Shop classics"}},
        {"type": "item", "settings": {"cans": "strawberry-lime,mint-mojito,mango-tango", "tile_bg": "#d6f1ea", "title": "Fruit punch line", "text": "Louder fruit, same short ingredient list. Built for sharing.", "button_label": "Shop fruit punch"}}
      ]
    }
  ]
}
{% endschema %}
