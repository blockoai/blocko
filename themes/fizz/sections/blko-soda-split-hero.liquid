<section class="blko-soda-hero" style="--hero-bg:{{ section.settings.bg }};--hero-text:{{ section.settings.text_color }}">
  <div class="blko-soda-hero__text">
    {%- if section.settings.eyebrow != blank -%}<p class="blko-soda-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.subtext | escape }}</p>
    <a class="blko-soda-hero__btn" href="{{ section.settings.button_url }}" style="background:{{ section.settings.button_bg }};color:{{ section.settings.button_color }}">{{ section.settings.button_label | escape }}</a>
  </div>
  <div class="blko-soda-hero__media">
    <picture>
      {%- if section.settings.image_wide != blank -%}
        <source media="(min-width: 801px)" srcset="{{ section.settings.image_wide | image_url: width: 1600 }}">
      {%- else -%}
        <source media="(min-width: 801px)" srcset="{{ 'fizz-banner-hero-cherry-pop-wide.svg' | asset_url }}">
      {%- endif -%}
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.image_alt }}
      {%- else -%}
        <img src="{{ 'fizz-banner-hero-cherry-pop.svg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1200" height="1200" loading="eager">
      {%- endif -%}
    </picture>
  </div>
</section>
{%- if section.settings.wave_to != blank -%}{% render 'blko-soda-divider', from: section.settings.bg, to: section.settings.wave_to %}{%- endif -%}

{% stylesheet %}
.blko-soda-hero{display:grid;grid-template-columns:1fr 1fr;min-height:34rem;background:var(--hero-bg, #ff6b8b);color:var(--hero-text, #0f3b2e);font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-hero__text{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:1.1rem;padding:clamp(2rem,6vw,5rem)}
.blko-soda-hero__eyebrow{margin:0;font:800 .8rem var(--font-body, "Outfit", sans-serif);letter-spacing:.14em;text-transform:uppercase}
.blko-soda-hero__text h1{margin:0;font:900 clamp(2.6rem,6vw,5rem)/.95 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-hero__text p:not(.blko-soda-hero__eyebrow){max-width:30rem;margin:0;font-size:1.15rem;line-height:1.5}
.blko-soda-hero__btn{display:inline-block;padding:.95rem 2rem;border-radius:999px;font:900 1.05rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
.blko-soda-hero__media{position:relative;min-height:20rem;overflow:hidden;background:var(--color-bg, #fbf3e2)}
.blko-soda-hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
@media(max-width:800px){.blko-soda-hero{grid-template-columns:1fr}.blko-soda-hero__media{order:-1;min-height:18rem}}
/* hero */
.blko-soda-hero{grid-template-columns:5fr 7fr;height:650px;min-height:0;background:var(--hero-bg,#c8203a);color:var(--hero-text,#fff6ea)}
.blko-soda-hero .blko-soda-hero__text{align-items:center;justify-content:center;gap:1.25rem;padding:2rem clamp(1.5rem,4vw,4rem);text-align:center}
.blko-soda-hero .blko-soda-hero__text h1{font:900 clamp(3rem,5.6vw,5rem)/1.05 var(--font-heading,"Fraunces",Georgia,serif);letter-spacing:.01em;color:inherit}
.blko-soda-hero .blko-soda-hero__text p:not(.blko-soda-hero__eyebrow){max-width:28rem;font-size:1.25rem;line-height:1.55}
.blko-soda-hero .blko-soda-hero__btn{padding:15px 32px;font:700 18px/1.1 var(--font-body,"Outfit",sans-serif);transition:background-color .25s ease-in-out,box-shadow .25s ease-in-out}
.blko-soda-hero .blko-soda-hero__btn:hover{box-shadow:4px 4px 0 0 rgba(255,246,234,.55)}
.blko-soda-hero .blko-soda-hero__media{height:650px;min-height:0}
.blko-soda-hero__media picture{display:block;position:absolute;inset:0}
.blko-soda-hero .blko-soda-hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
/* hero mobile */
@media(max-width:800px){.blko-soda-hero{grid-template-columns:1fr;height:auto}.blko-soda-hero .blko-soda-hero__text{padding:2.5rem 1.25rem}.blko-soda-hero .blko-soda-hero__media{order:0;height:420px}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda split hero",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#c8203a"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#fff6ea"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow (optional)", "default": ""},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Big fizz. Small sugar."},
    {"type": "textarea", "id": "subtext", "label": "Subtext", "default": "Prebiotic soda with real fruit flavor, 2g of sugar and a lot of attitude. Stock up and save on every case."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop flavors"},
    {"type": "url", "id": "button_url", "label": "Button link"},
    {"type": "color", "id": "button_bg", "label": "Button background", "default": "#cdf26b"},
    {"type": "color", "id": "button_color", "label": "Button text", "default": "#0f3b2e"},
    {"type": "image_picker", "id": "image", "label": "Square image (mobile, 1:1)"},
    {"type": "image_picker", "id": "image_wide", "label": "Wide image (desktop, 16:9)"},
    {"type": "color", "id": "wave_to", "label": "Wavy bottom edge: next section color", "info": "Leave empty for a straight edge."},
    {"type": "text", "id": "image_alt", "label": "Image alt text", "default": "Three cans of Cherry Pop with fresh cherries"}
  ],
  "presets": [{"name": "Soda split hero"}]
}
{% endschema %}
