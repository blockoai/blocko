<section class="blko-soda-cols" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <div class="blko-soda-cols__inner{% if section.settings.reverse %} is-reverse{% endif %}">
    <div class="blko-soda-cols__img">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" width="1000" height="1000" loading="lazy">
      {%- endif -%}
    </div>
    <div class="blko-soda-cols__copy">
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.text | escape }}</p>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_url }}" style="background:{{ section.settings.button_bg }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.blko-soda-cols{padding:clamp(2.5rem,6vw,5rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-cols__inner{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(1.5rem,5vw,4rem);max-width:70rem;margin:0 auto}
.blko-soda-cols__inner.is-reverse .blko-soda-cols__img{order:2}
.blko-soda-cols__img img{width:100%;aspect-ratio:1;border-radius:2rem;object-fit:cover}
.blko-soda-cols__copy{display:grid;justify-items:start;gap:1rem}
.blko-soda-cols__copy h2{margin:0;font:900 clamp(2rem,4.5vw,3.5rem)/1 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-cols__copy p{margin:0;font-size:1.15rem;line-height:1.55}
.blko-soda-cols__copy a{padding:.9rem 1.9rem;border-radius:999px;color:var(--color-button-text, #fff);font:700 1.05rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
@media(max-width:800px){.blko-soda-cols__inner{grid-template-columns:1fr}.blko-soda-cols__inner.is-reverse .blko-soda-cols__img{order:0}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda two columns",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#ffc9d6"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0f3b2e"},
    {"type": "color", "id": "button_bg", "label": "Button", "default": "#0f3b2e"},
    {"type": "checkbox", "id": "reverse", "label": "Image on the right", "default": true},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "image_url", "label": "Fallback image URL (Unsplash)", "default": "https://images.unsplash.com/photo-1464965911861-746a04b4bca6?auto=format&fit=crop&w=1000&q=80"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Real fruit. Real short label."},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Fizz is built from fruit juice, prebiotic fiber and sparkling water. No fake colors, no sugar bomb, no ingredient you need to Google."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "What's in Fizz?"},
    {"type": "url", "id": "button_url", "label": "Button link"}
  ],
  "presets": [{"name": "Soda two columns"}]
}
{% endschema %}
