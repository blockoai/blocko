<section class="blko-soda-tabs" style="background:{{ section.settings.bg }}">
  <blko-soda-tabs>
    <h2 class="blko-soda-tabs__heading" style="color:{{ section.settings.heading_color }}">{{ section.settings.heading | escape }}</h2>
    <div class="blko-soda-tabs__bar" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" role="tab" class="blko-soda-tabs__tab{% if forloop.first %} is-active{% endif %}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab="{{ block.id }}" {{ block.shopify_attributes }}>{{ block.settings.tab_label | escape }}</button>
      {%- endfor -%}
    </div>
    {%- for block in section.blocks -%}
      {%- assign coll = collections[block.settings.collection] -%}
      <div class="blko-soda-tabs__panel{% if forloop.first %} is-active{% endif %}" data-panel="{{ block.id }}" role="tabpanel">
        <p class="blko-soda-tabs__note">{{ block.settings.note | escape }}</p>
        <div class="blko-soda-tabs__track">
          {%- for product in coll.products limit: block.settings.limit -%}
            {% render 'blko-soda-product-card', product: product, line: block.settings.tab_label, add_label: section.settings.add_label, view_label: section.settings.view_label, sale_label: section.settings.sale_label %}
          {%- else -%}
            <p class="blko-soda-tabs__empty">{{ section.settings.empty_text }}</p>
          {%- endfor -%}
        </div>
        <p class="blko-soda-tabs__cta"><a href="{{ coll.url | default: routes.collections_url }}">{{ block.settings.cta_label | escape }}</a></p>
      </div>
    {%- endfor -%}
  </blko-soda-tabs>
</section>
<script type="module" src="{{ 'blko-soda.js' | asset_url }}"></script>

{% stylesheet %}
.blko-soda-tabs{padding:clamp(2.5rem,6vw,4.5rem) 0;font-family:var(--font-body, "Outfit", sans-serif);color:var(--color-text, #0f3b2e)}
.blko-soda-tabs__heading{margin:0 0 1.5rem;padding:0 1.25rem;font:900 clamp(2rem,4.5vw,3.25rem)/1 var(--font-heading, "Fraunces", Georgia, serif);text-align:center}
.blko-soda-tabs__bar{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;padding:0 1.25rem}
.blko-soda-tabs__tab{padding:.6rem 1.25rem;border:2px solid var(--color-text, #0f3b2e);border-radius:999px;background:transparent;color:inherit;font:700 1rem var(--font-heading, "Fraunces", Georgia, serif);cursor:pointer}
.blko-soda-tabs__tab.is-active{background:var(--color-text, #0f3b2e);color:var(--color-bg-alt, #f3e8cd)}
.blko-soda-tabs__panel{display:none;padding-top:1.5rem}
.blko-soda-tabs__panel.is-active{display:block}
.blko-soda-tabs__note{margin:0 0 1.25rem;padding:0 1.25rem;font-weight:700;text-align:center}
.blko-soda-tabs__track{display:flex;gap:1.25rem;overflow-x:auto;padding:0 1.25rem 1rem;scroll-snap-type:x mandatory;scrollbar-width:thin}
.blko-soda-tabs__track>.blko-soda-card{flex:0 0 min(17rem,72vw);scroll-snap-align:start}
.blko-soda-tabs__cta{margin:1.25rem 0 0;text-align:center}
.blko-soda-tabs__cta a{display:inline-block;padding:.85rem 1.8rem;border:2px solid currentColor;border-radius:999px;color:inherit;font:700 1rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda collection tabs",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Shop our flavors"},
    {"type": "color", "id": "bg", "label": "Background", "default": "#f3e8cd"},
    {"type": "color", "id": "heading_color", "label": "Heading color", "default": "#0f3b2e"},
    {"type": "text", "id": "add_label", "label": "Quick add label", "default": "Quick add"},
    {"type": "text", "id": "view_label", "label": "Card button label", "default": "Shop now"},
    {"type": "text", "id": "sale_label", "label": "Sale badge", "default": "Sale"},
    {"type": "text", "id": "empty_text", "label": "Empty text", "default": "Flavors coming soon."}
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection tab",
      "settings": [
        {"type": "text", "id": "tab_label", "label": "Tab label", "default": "Classics"},
        {"type": "text", "id": "collection", "label": "Collection handle", "default": "drinks", "info": "Handle of a real store collection, for example drinks or variety-packs."},
        {"type": "text", "id": "note", "label": "Note", "default": "2g sugar. Ice cold or room temp."},
        {"type": "text", "id": "cta_label", "label": "Button label", "default": "Shop all"},
        {"type": "range", "id": "limit", "label": "Products", "min": 2, "max": 24, "step": 1, "default": 12}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Soda collection tabs",
      "blocks": [
        {"type": "collection", "settings": {"tab_label": "Drinks", "collection": "drinks"}},
        {"type": "collection", "settings": {"tab_label": "Variety packs", "collection": "variety-packs", "note": "Can't pick? Don't."}},
        {"type": "collection", "settings": {"tab_label": "Single flavor packs", "collection": "single-flavor-packs", "note": "Stock up on your favorite."}},
        {"type": "collection", "settings": {"tab_label": "9g fiber", "collection": "shop-9g-fiber", "note": "Classic cans, 9g of fiber."}},
        {"type": "collection", "settings": {"tab_label": "6g fiber", "collection": "shop-6g-fiber", "note": "Lighter on fiber, same fizz."}}
      ]
    }
  ]
}
{% endschema %}
