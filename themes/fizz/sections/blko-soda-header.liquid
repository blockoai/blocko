{%- assign menu = linklists[section.settings.menu] -%}
<blko-soda-nav class="blko-soda-header">
  <div class="blko-soda-header__inner">
    <div class="blko-soda-header__left">
      <button type="button" class="blko-soda-header__toggle" data-toggle aria-expanded="false" aria-label="Menu">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <nav class="blko-soda-header__nav" aria-label="Primary">
        <ul>
          {%- for link in menu.links -%}
            {%- assign is_mega = false -%}
            {%- if link.links.size > 0 and link.title == section.settings.mega_title -%}{%- assign is_mega = true -%}{%- endif -%}
            <li class="blko-soda-header__item{% if is_mega %} has-mega{% elsif link.links.size > 0 %} has-drop{% endif %}">
              <a href="{{ link.url }}"{% if link.active or link.child_active %} class="is-active" aria-current="page"{% endif %}>{{ link.title }}</a>
              {%- if is_mega -%}
                <blko-soda-mega class="blko-soda-mega">
                  <div class="blko-soda-mega__rail">
                    <ul class="blko-soda-mega__rows">
                      {%- for child in link.links -%}
                        <li><a class="blko-soda-mega__row{% if forloop.first %} is-active{% endif %}" href="{{ child.url }}" data-mega-row="{{ forloop.index0 }}">{{ child.title }}<svg width="8" height="14" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 1l6 6-6 6"/></svg></a></li>
                      {%- endfor -%}
                    </ul>
                    <a class="blko-soda-mega__all" href="{{ link.url }}">{{ section.settings.shop_all_label }}</a>
                  </div>
                  <div class="blko-soda-mega__panels">
                    {%- for child in link.links -%}
                      {%- assign coll = collections.all -%}
                      {%- if child.type == 'collection_link' -%}{%- assign coll = child.object -%}{%- endif -%}
                      <section class="blko-soda-mega__panel{% if forloop.first %} is-active{% endif %}" data-mega-panel="{{ forloop.index0 }}">
                        <div class="blko-soda-mega__top">
                          <div class="blko-soda-mega__copy">
                            <h3 class="blko-soda-mega__title">{{ section.settings.heading_prefix }} {{ child.title }}</h3>
                            {%- if section.settings.tagline != blank -%}<p class="blko-soda-mega__tag">{{ section.settings.tagline }}</p>{%- endif -%}
                            {%- assign body = coll.description | strip_html | truncate: 120 -%}
                            {%- if body == blank -%}{%- assign body = section.settings.body -%}{%- endif -%}
                            {%- if body != blank -%}<p class="blko-soda-mega__body">{{ body }}</p>{%- endif -%}
                          </div>
                          <div class="blko-soda-mega__ctl">
                            <a class="blko-soda-mega__cta" href="{{ child.url }}">{{ section.settings.heading_prefix }} {{ child.title }}</a>
                            <div class="blko-soda-mega__arrows">
                              <button type="button" class="blko-soda-mega__arrow" data-mega-prev aria-label="Previous"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l-6 6 6 6"/></svg></button>
                              <button type="button" class="blko-soda-mega__arrow" data-mega-next aria-label="Next"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 4l6 6-6 6"/></svg></button>
                            </div>
                          </div>
                        </div>
                        <ul class="blko-soda-mega__track" data-mega-track>
                          {%- for product in coll.products limit: 12 -%}
                            <li class="blko-soda-mega__item">
                              <a class="blko-soda-mega__can" href="{{ product.url }}">
                                <span class="blko-soda-mega__media">
                                  {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: height: 272 }}" alt="" width="120" height="136" loading="lazy">{%- endif -%}
                                  {%- if product.compare_at_price > product.price -%}<img class="blko-soda-mega__badge" src="{{ 'blko-badge-sale.svg' | asset_url }}" alt="{{ section.settings.sale_label | escape }}" width="56" height="56" loading="lazy">{%- endif -%}
                                </span>
                                <span class="blko-soda-mega__name">{{ product.title | escape }}</span>
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </section>
                    {%- endfor -%}
                  </div>
                </blko-soda-mega>
              {%- elsif link.links.size > 0 -%}
                <ul class="blko-soda-drop">
                  {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
    <a class="blko-soda-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.brand_logo != blank -%}
        {{ settings.brand_logo | image_url: width: 480 | image_tag: alt: shop.name, width: 120, height: 48 }}
      {%- else -%}
        <img src="{{ 'brand-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="120" height="48">
      {%- endif -%}
    </a>
    <div class="blko-soda-header__tools">
      {%- if section.settings.find_label != blank -%}<a class="blko-soda-header__find" href="{{ section.settings.find_url }}">{{ section.settings.find_label | escape }}</a>{%- endif -%}
      <a class="blko-soda-header__acct" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></a>
      <a href="{{ routes.cart_url }}" data-cart-open aria-controls="CartDrawer" aria-label="Cart"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 7h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg><span class="blko-soda-header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a>
    </div>
  </div>
  <nav class="blko-soda-header__mobile" data-menu aria-label="Mobile">
    {%- for link in menu.links -%}
      {%- if link.links.size > 0 -%}
        <details class="blko-soda-header__sub">
          <summary>{{ link.title }}</summary>
          <a href="{{ link.url }}">{{ section.settings.shop_all_label }}</a>
          {%- for child in link.links -%}
            <a href="{{ child.url }}">{{ child.title }}</a>
            {%- for grand in child.links -%}<a class="is-grand" href="{{ grand.url }}">{{ grand.title }}</a>{%- endfor -%}
          {%- endfor -%}
        </details>
      {%- else -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
    {%- if section.settings.find_label != blank and section.settings.find_url != blank -%}<a href="{{ section.settings.find_url }}">{{ section.settings.find_label | escape }}</a>{%- endif -%}
    <a href="{{ routes.account_url }}">Account</a>
  </nav>
</blko-soda-nav>
<script type="module" src="{{ 'blko-soda.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-soda-chrome.js' | asset_url }}"></script>

{% stylesheet %}
.blko-theme{--color-brand-green:#0f6e4f;--color-mint:#b8f0d8;--color-yellow:#f7ee6b;--color-cream-light:#fffaf0}
.blko-soda-header{display:block;position:relative;z-index:20;border-bottom:1px solid rgba(15,59,46,.08);background:var(--color-header-bg, #fdf6ea);color:var(--color-text, #0f3b2e);font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-header__inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;max-width:1320px;min-height:70px;margin:0 auto;padding:0 20px}
.blko-soda-header__left{display:flex;align-items:center;gap:1rem}
.blko-soda-header__tools svg{width:26px;height:26px}
.blko-soda-header__toggle{display:none;border:0;background:none;color:inherit;cursor:pointer}
.blko-soda-header__nav>ul{display:flex;gap:2.5rem;margin:0;padding:0;list-style:none}
.blko-soda-header__item{display:flex;align-items:center;position:static;height:70px}
.blko-soda-header__item>a{display:inline-flex;align-items:center;gap:.4rem;padding:0 0 6px;border-bottom:2px solid transparent;color:inherit;font:500 1.0625rem/1.2 var(--font-body, "Outfit", sans-serif);text-decoration:none;transition:border-color .25s ease-in-out}
.blko-soda-header__item>a:hover,.blko-soda-header__item>a.is-active,.blko-soda-header__item.has-mega:hover>a,.blko-soda-header__item.has-mega:focus-within>a{border-bottom-color:currentColor}
.blko-soda-header__logo img{display:block;width:auto;max-width:100%;height:48px}
.blko-soda-header__tools{display:flex;align-items:center;justify-content:flex-end;gap:1.1rem}
.blko-soda-header__tools a{position:relative;display:inline-flex;color:inherit;text-decoration:none;transition:color .25s ease-in-out}
.blko-soda-header__tools a:hover{color:#1f7369}
.blko-soda-header__tools .blko-soda-header__find{align-items:center;padding-bottom:6px;border-bottom:2px solid transparent;font:500 1.0625rem/1.2 var(--font-body, "Outfit", sans-serif);transition:border-color .25s ease-in-out}
.blko-soda-header__tools .blko-soda-header__find:hover{border-bottom-color:currentColor;color:inherit}
.blko-soda-header__count{position:absolute;top:-.45rem;right:-.6rem;min-width:1.1rem;height:1.1rem;padding:0 .2rem;border-radius:999px;background:var(--color-brand-green, #0f6e4f);color:#fff;font:800 .7rem/1.15rem var(--font-body, "Outfit", sans-serif);text-align:center}
.blko-soda-mega{position:absolute;left:0;right:0;top:100%;display:flex;height:451px;border-top:0;border-bottom:1px solid var(--color-border, #dccfae);background:var(--color-header-bg, #fdf6ea);box-shadow:none;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s ease-in-out,visibility 0s linear .3s}
.blko-soda-header__item.has-mega:hover .blko-soda-mega,.blko-soda-header__item.has-mega:focus-within .blko-soda-mega{display:flex;opacity:1;visibility:visible;pointer-events:auto;transition-delay:0s}
.blko-soda-mega__rail{display:flex;flex:0 0 min(30%,372px);flex-direction:column;min-height:0;background:var(--color-cream-light, #fffaf0);border-right:1px solid var(--color-border, #dccfae)}
.blko-soda-header .blko-soda-mega__rows{display:block;gap:0;flex:1;min-height:0;margin:0;padding:0;overflow-y:auto;list-style:none;scrollbar-width:thin}
.blko-soda-mega__row{display:flex;align-items:center;justify-content:space-between;gap:12px;height:62px;padding:0 20px 0 60px;border-bottom:1px solid var(--color-border, #dccfae);background:transparent;color:var(--color-text, #0f3b2e);font:900 1.25rem/1.1 var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none;transition:background-color .25s ease-in-out}
.blko-soda-mega__row:hover,.blko-soda-mega__row.is-active{background:var(--color-mint, #b8f0d8)}
.blko-soda-mega__all{display:flex;align-items:center;justify-content:center;flex:none;width:291px;max-width:calc(100% - 80px);height:48px;margin:20px 0 24px 60px;border-radius:50px;background:var(--color-text, #0f3b2e);color:#fff;font:700 1.125rem/1 var(--font-body, "Outfit", sans-serif);text-decoration:none;transition:background-color .15s ease,color .15s ease}
.blko-soda-mega__all:hover{background:#1f5a44;color:var(--color-bg, #fbf3e2)}
.blko-soda-mega__panels{flex:1;min-width:0;padding:32px 60px 0 36px}
.blko-soda-mega__panel{display:none}
.blko-soda-mega__panel.is-active{display:block;animation:blko-mega-in .25s ease-in-out}
@keyframes blko-mega-in{from{opacity:0}to{opacity:1}}
.blko-soda-mega__top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}
.blko-soda-mega__copy{max-width:36rem}
.blko-soda-mega__title{margin:0;font:900 2.5rem/1.1 var(--font-heading, "Fraunces", Georgia, serif);color:var(--color-text, #0f3b2e)}
.blko-soda-mega__tag{margin:6px 0 0;color:var(--color-brand-green, #0f6e4f);font:700 .875rem/1.4 var(--font-body, "Outfit", sans-serif)}
.blko-soda-mega__body{margin:4px 0 0;font:400 1rem/1.6 var(--font-body, "Outfit", sans-serif)}
.blko-soda-mega__ctl{display:grid;justify-items:end;gap:10px;flex:none}
.blko-soda-mega__cta{display:inline-flex;align-items:center;height:31px;padding:0 20px;border:1px solid var(--color-text, #0f3b2e);border-radius:50px;color:var(--color-text, #0f3b2e);font:600 .875rem/1 var(--font-body, "Outfit", sans-serif);text-decoration:none;white-space:nowrap;transition:background-color .25s ease-in-out}
.blko-soda-mega__cta:hover{background:rgba(15,59,46,.07)}
.blko-soda-mega__arrows{display:flex;gap:4px}
.blko-soda-mega__arrow{display:grid;place-items:center;width:40px;height:40px;padding:0;border:0;background:none;color:var(--color-text, #0f3b2e);cursor:pointer;transition:opacity .25s ease-in-out}
.blko-soda-mega__arrow:hover{opacity:.8}
.blko-soda-mega__arrow:disabled{opacity:.3;cursor:default}
.blko-soda-header .blko-soda-mega__track{display:flex;gap:2px;margin:14px 0 0;padding:0;overflow-x:auto;list-style:none;scroll-behavior:smooth;scrollbar-width:none}
.blko-soda-mega__track::-webkit-scrollbar{display:none}
.blko-soda-mega__item{flex:0 0 136px}
.blko-soda-mega__can{display:block;color:var(--color-text, #0f3b2e);text-align:center;text-decoration:none}
.blko-soda-mega__media{position:relative;display:flex;align-items:flex-end;justify-content:center;height:148px;padding:8px 8px 0}
.blko-soda-mega__media img{width:auto;height:136px;max-width:120px;object-fit:contain;transform-origin:center bottom;transition:transform .25s cubic-bezier(.4,0,.2,1)}
.blko-soda-mega__can:hover .blko-soda-mega__media img,.blko-soda-mega__can:focus-visible .blko-soda-mega__media img{transform:scale(1.12)}
.blko-soda-mega__media .blko-soda-mega__badge{position:absolute;top:0;right:0;width:56px;height:56px;max-width:none;object-fit:contain;pointer-events:none;transform:none;transition:none}
.blko-soda-mega__name{display:block;padding:6px 6px 8px;font:700 .875rem/1.35 var(--font-body, "Outfit", sans-serif)}
.blko-soda-header .blko-soda-drop{display:block;gap:0;position:absolute;top:calc(100% - 12px);left:-16px;min-width:13rem;margin:0;padding:.6rem;border:1px solid rgba(15,59,46,.08);border-radius:16px;background:var(--color-header-bg, #fdf6ea);box-shadow:0 14px 30px -12px rgba(15,59,46,.3);list-style:none;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .3s ease-in-out,visibility 0s linear .3s}
.blko-soda-header__item.has-drop{position:relative}
.blko-soda-header__item.has-drop:hover .blko-soda-drop,.blko-soda-header__item.has-drop:focus-within .blko-soda-drop{opacity:1;visibility:visible;pointer-events:auto;transition-delay:0s}
.blko-soda-header__item.has-drop:hover>a,.blko-soda-header__item.has-drop:focus-within>a{border-bottom-color:currentColor}
.blko-soda-drop a{display:block;padding:.6rem .8rem;border-radius:10px;color:inherit;font:500 1rem/1.2 var(--font-body, "Outfit", sans-serif);text-decoration:none;transition:background-color .25s ease-in-out}
.blko-soda-drop a:hover{background:var(--color-mint, #b8f0d8)}
.blko-soda-header__mobile{display:none;padding:.5rem 1.25rem 1.25rem;background:var(--color-header-bg, #fdf6ea)}
.blko-soda-header__mobile.is-open{display:grid}
.blko-soda-header__sub{border-bottom:1px solid var(--color-border, #dccfae)}
.blko-soda-header__sub summary{padding:.75rem 0;font:700 1.1rem var(--font-body, "Outfit", sans-serif);cursor:pointer}
.blko-soda-header__sub a{display:block;padding:.55rem 0 .55rem 1rem;border-bottom:0;font-size:1rem}
.blko-soda-header__sub a.is-grand{padding-left:2rem;font-weight:500;font-size:.95rem}
.blko-soda-header__mobile a{padding:.75rem 0;border-bottom:1px solid var(--color-border, #dccfae);color:inherit;font:700 1.1rem var(--font-body, "Outfit", sans-serif);text-decoration:none}
@media(max-width:900px){.blko-soda-header__inner{grid-template-columns:1fr auto 1fr;min-height:64px}.blko-soda-header__toggle{display:inline-flex}.blko-soda-header__nav{display:none}.blko-soda-header__tools .blko-soda-header__find,.blko-soda-header__tools .blko-soda-header__acct{display:none}.blko-soda-mega{display:none}.blko-soda-header__logo{justify-self:center}.blko-soda-header__logo img{height:40px}}
@media(prefers-reduced-motion:reduce){.blko-soda-mega,.blko-soda-mega__row,.blko-soda-mega__all,.blko-soda-mega__media img,.blko-soda-header__item>a,.blko-soda-header__tools a,.blko-soda-drop{transition:none}.blko-soda-mega__panel.is-active{animation:none}.blko-soda-mega__track{scroll-behavior:auto}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda header",
  "settings": [
    {"type": "link_list", "id": "menu", "label": "Menu", "info": "The top-level link named below opens the mega menu: its child links become the left rail and each child's collection fills the can carousel. Other links with children open a small dropdown.", "default": "main-menu"},
    {"type": "text", "id": "mega_title", "label": "Mega menu link title", "default": "Shop"},
    {"type": "text", "id": "shop_all_label", "label": "Shop all button", "default": "Shop All"},
    {"type": "text", "id": "heading_prefix", "label": "Panel heading prefix", "default": "Shop"},
    {"type": "text", "id": "tagline", "label": "Panel tagline", "default": "Real fruit. 2g sugar. 9g fiber."},
    {"type": "text", "id": "body", "label": "Panel text (used when the collection has no description)", "default": "Prebiotic soda that tastes like soda."},
    {"type": "text", "id": "sale_label", "label": "Sale badge text", "default": "Sale"},
    {"type": "text", "id": "find_label", "label": "Store finder label", "default": "Where to buy"},
    {"type": "url", "id": "find_url", "label": "Store finder link"}
  ],
  "presets": [{"name": "Soda header"}]
}
{% endschema %}
