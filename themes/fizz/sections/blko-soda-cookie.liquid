<blko-soda-cookie class="blko-soda-cookie" data-regions-only="{{ section.settings.regions_only }}" hidden style="--cookie-bg:{{ section.settings.bg }};--cookie-text:{{ section.settings.text_color }};--cookie-btn:{{ section.settings.button_color }};--cookie-btn-text:{{ section.settings.button_text_color }}">
  <div class="blko-soda-cookie__card" role="dialog" aria-label="{{ section.settings.title | escape }}">
    <div class="blko-soda-cookie__main">
      <p class="blko-soda-cookie__text">{{ section.settings.text | escape }}{% if section.settings.link_label != blank %} <a href="{{ section.settings.link_url | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a>{% endif %}</p>
      <div class="blko-soda-cookie__btns">
        <button type="button" data-cookie-accept>{{ section.settings.accept_label | escape }}</button>
        <button type="button" class="is-outline" data-cookie-custom>{{ section.settings.customize_label | escape }}</button>
      </div>
    </div>
    <form class="blko-soda-cookie__panel" data-cookie-panel hidden>
      <label class="blko-soda-cookie__row"><span><b>{{ section.settings.necessary_label | escape }}</b><small>{{ section.settings.necessary_text | escape }}</small></span><input type="checkbox" name="necessary" checked disabled><span class="blko-soda-cookie__sw" aria-hidden="true"></span></label>
      <label class="blko-soda-cookie__row"><span><b>{{ section.settings.analytics_label | escape }}</b><small>{{ section.settings.analytics_text | escape }}</small></span><input type="checkbox" name="analytics"><span class="blko-soda-cookie__sw" aria-hidden="true"></span></label>
      <label class="blko-soda-cookie__row"><span><b>{{ section.settings.marketing_label | escape }}</b><small>{{ section.settings.marketing_text | escape }}</small></span><input type="checkbox" name="marketing"><span class="blko-soda-cookie__sw" aria-hidden="true"></span></label>
      <label class="blko-soda-cookie__row"><span><b>{{ section.settings.preferences_label | escape }}</b><small>{{ section.settings.preferences_text | escape }}</small></span><input type="checkbox" name="preferences"><span class="blko-soda-cookie__sw" aria-hidden="true"></span></label>
      <button type="submit">{{ section.settings.save_label | escape }}</button>
    </form>
  </div>
</blko-soda-cookie>
<script type="module" src="{{ 'blko-soda-chrome.js' | asset_url }}"></script>

{% stylesheet %}
.blko-theme{--color-brand-green:#0f6e4f;--color-mint:#b8f0d8;--color-yellow:#f7ee6b;--color-cream-light:#fffaf0}
.blko-soda-cookie{position:fixed;left:16px;right:16px;bottom:16px;z-index:90;font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-cookie[hidden]{display:none}
.blko-soda-cookie__card{max-width:90rem;margin:0 auto;padding:1rem 1.25rem;border-radius:16px;background:var(--cookie-bg, #fff);color:var(--cookie-text, #0f3b2e);box-shadow:0 10px 40px rgba(15,59,46,.25)}
.blko-soda-cookie__main{display:flex;align-items:center;justify-content:space-between;gap:1.25rem}
.blko-soda-cookie__text{margin:0;font-size:.9375rem;line-height:1.5}
.blko-soda-cookie__text a{color:inherit;font-weight:700}
.blko-soda-cookie__btns{display:flex;flex:none;gap:.5rem}
.blko-soda-cookie__btns button,.blko-soda-cookie__panel button{height:40px;padding:0 1.4rem;border:1px solid var(--cookie-btn, #0f3b2e);border-radius:999px;background:var(--cookie-btn, #0f3b2e);color:var(--cookie-btn-text, #fff);font:700 .9rem/1 var(--font-body, "Outfit", sans-serif);cursor:pointer;transition:background-color .25s ease-in-out,color .25s ease-in-out}
.blko-soda-cookie__btns button:hover,.blko-soda-cookie__panel button:hover{background:#1f5a44}
.blko-soda-cookie__btns .is-outline{background:transparent;color:var(--cookie-btn, #0f3b2e)}
.blko-soda-cookie__btns .is-outline:hover{background:var(--cookie-btn, #0f3b2e);color:var(--cookie-btn-text, #fff)}
.blko-soda-cookie__panel{display:grid;gap:.25rem;margin-top:.9rem;padding-top:.9rem;border-top:1px solid rgba(15,59,46,.15)}
.blko-soda-cookie__panel[hidden]{display:none}
.blko-soda-cookie__row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.5rem 0;cursor:pointer}
.blko-soda-cookie__row b{display:block;font-size:.95rem}
.blko-soda-cookie__row small{display:block;opacity:.75;font-size:.8125rem}
.blko-soda-cookie__row input{position:absolute;opacity:0;pointer-events:none}
.blko-soda-cookie__sw{position:relative;flex:none;width:44px;height:26px;border-radius:999px;background:#c9c2ab;transition:background-color .25s ease-in-out}
.blko-soda-cookie__sw::after{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#fff;transition:transform .25s ease-in-out}
.blko-soda-cookie__row input:checked+.blko-soda-cookie__sw{background:var(--color-brand-green, #0f6e4f)}
.blko-soda-cookie__row input:checked+.blko-soda-cookie__sw::after{transform:translateX(18px)}
.blko-soda-cookie__row input:disabled+.blko-soda-cookie__sw{opacity:.55}
.blko-soda-cookie__row input:focus-visible+.blko-soda-cookie__sw{outline:3px solid var(--color-accent, #ff6b8b);outline-offset:2px}
.blko-soda-cookie__panel button[type=submit]{justify-self:end;margin-top:.4rem}
@media(max-width:700px){.blko-soda-cookie__main{flex-direction:column;align-items:stretch}.blko-soda-cookie__btns{flex-direction:column}.blko-soda-cookie__btns button{width:100%}.blko-soda-cookie__panel button[type=submit]{justify-self:stretch}}
@media(prefers-reduced-motion:reduce){.blko-soda-cookie__sw,.blko-soda-cookie__sw::after{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda cookie banner",
  "settings": [
    {"type": "text", "id": "title", "label": "Dialog label", "default": "Cookie consent"},
    {"type": "text", "id": "text", "label": "Text", "default": "We use cookies to keep Fizz running and to make it better."},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Learn more"},
    {"type": "url", "id": "link_url", "label": "Link", "info": "Your privacy policy."},
    {"type": "checkbox", "id": "regions_only", "label": "Show only in regions that need consent", "info": "Uses Shopify's Customer Privacy API. Turn off to always ask visitors who have not chosen yet.", "default": true},
    {"type": "color", "id": "bg", "label": "Background", "default": "#ffffff"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0f3b2e"},
    {"type": "color", "id": "button_color", "label": "Buttons", "default": "#0f3b2e"},
    {"type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff"},
    {"type": "text", "id": "accept_label", "label": "Accept button", "default": "Accept all"},
    {"type": "text", "id": "customize_label", "label": "Customize button", "default": "Customize"},
    {"type": "text", "id": "save_label", "label": "Save button", "default": "Save"},
    {"type": "text", "id": "necessary_label", "label": "Necessary: title", "default": "Necessary"},
    {"type": "text", "id": "necessary_text", "label": "Necessary: text", "default": "Keeps the store working. Always on."},
    {"type": "text", "id": "analytics_label", "label": "Analytics: title", "default": "Analytics"},
    {"type": "text", "id": "analytics_text", "label": "Analytics: text", "default": "Helps us see what works."},
    {"type": "text", "id": "marketing_label", "label": "Marketing: title", "default": "Marketing"},
    {"type": "text", "id": "marketing_text", "label": "Marketing: text", "default": "Lets us show relevant offers."},
    {"type": "text", "id": "preferences_label", "label": "Preferences: title", "default": "Preferences"},
    {"type": "text", "id": "preferences_text", "label": "Preferences: text", "default": "Remembers your settings."}
  ]
}
{% endschema %}
