<section class="blko-soda-coll">
  <header class="blko-soda-coll__hero" style="background:{{ section.settings.bg }}">
    <div class="blko-soda-coll__copy">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<p>{{ collection.description | strip_html }}</p>{%- else -%}<p>{{ section.settings.fallback_intro }}</p>{%- endif -%}
    </div>
    {%- if section.settings.banner != blank -%}
      {{ section.settings.banner | image_url: width: 1600 | image_tag: class: 'blko-soda-coll__banner', loading: 'eager', alt: '' }}
    {%- else -%}
      <img class="blko-soda-coll__banner" src="{{ 'fizz-banner-collection-header.svg' | asset_url }}" alt="" width="1600" height="500" loading="eager">
    {%- endif -%}
  </header>
  {%- paginate collection.products by section.settings.per_page -%}
    {%- assign line_names = collection.all_types | sort -%}
    <blko-soda-jump class="blko-soda-coll__jump">
      <nav class="blko-soda-coll__filters" aria-label="{{ section.settings.jump_label | escape }}">
        {%- for line_name in line_names -%}
          {%- assign group_items = collection.products | where: 'type', line_name -%}
          {%- if group_items.size > 0 -%}<a class="{% if forloop.first %}is-active{% endif %}" href="#{{ line_name | handleize }}">{{ line_name | escape }}</a>{%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          <a href="{{ collections[block.settings.handle].url | default: routes.collections_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
        {%- endfor -%}
      </nav>
    </blko-soda-jump>
    {%- for line_name in line_names -%}
      {%- assign group_items = collection.products | where: 'type', line_name -%}
      {%- if group_items.size > 0 -%}
        <section class="blko-soda-coll__group" id="{{ line_name | handleize }}" aria-labelledby="h-{{ line_name | handleize }}">
          <h2 id="h-{{ line_name | handleize }}">{{ line_name | escape }}</h2>
          <div class="blko-soda-coll__grid">
            {%- for product in group_items -%}
              {% render 'blko-soda-product-card', product: product, line: line_name, add_label: section.settings.add_label, view_label: section.settings.view_label, sale_label: section.settings.sale_label %}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    {%- else -%}
      <p class="blko-soda-coll__empty">{{ section.settings.empty_text }}</p>
    {%- endfor -%}
    {%- if collection.products.size == 0 -%}<p class="blko-soda-coll__empty">{{ section.settings.empty_text }}</p>{%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="blko-soda-coll__pages" aria-label="Pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span aria-current="page">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>
<script type="module" src="{{ 'blko-soda.js' | asset_url }}"></script>

{% stylesheet %}
.blko-soda-coll{font-family:var(--font-body, "Outfit", sans-serif);color:var(--color-text, #0f3b2e)}
.blko-soda-coll__hero{padding:clamp(2.5rem,6vw,4.5rem) 1.25rem;text-align:center}
.blko-soda-coll__hero h1{margin:0 0 .6rem;font:900 clamp(2.5rem,6vw,4.5rem)/1 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-coll__hero p{max-width:40rem;margin:0 auto;font-size:1.1rem;line-height:1.5}
.blko-soda-coll__filters{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;padding:1.5rem 1.25rem}
.blko-soda-coll__filters a{padding:.55rem 1.2rem;border:2px solid var(--color-text, #0f3b2e);border-radius:999px;color:inherit;font:700 1rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
.blko-soda-coll__filters a.is-active{background:var(--color-text, #0f3b2e);color:var(--color-bg-alt, #f3e8cd)}
.blko-soda-coll__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.75rem 1.25rem;max-width:82rem;margin:0 auto;padding:0 1.25rem 2rem}
.blko-soda-coll__empty{grid-column:1/-1;text-align:center}
.blko-soda-coll__pages{display:flex;justify-content:center;gap:.5rem;padding:0 1.25rem 3rem}
.blko-soda-coll__pages a,.blko-soda-coll__pages span{padding:.45rem .9rem;border-radius:999px;color:inherit;font-weight:800;text-decoration:none}
.blko-soda-coll__pages span{background:var(--color-announcement-bg, #cdf26b)}
@media(max-width:1000px){.blko-soda-coll__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:700px){.blko-soda-coll__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem .75rem}}
/* pills (14px/700, 1.5px outline) */
.blko-soda-tabs__tab,.blko-soda-coll__filters a{padding:.55rem 1.25rem;border:1.5px solid var(--color-text,#0f3b2e);font:700 14px/1.2 var(--font-body,"Outfit",sans-serif);transition:background-color .15s ease,color .15s ease,border-color .15s ease}
.blko-soda-tabs__tab:hover,.blko-soda-coll__filters a:hover{background:var(--color-text,#0f3b2e);color:var(--color-bg-alt,#f3e8cd)}
.blko-soda-tabs__cta a,.blko-soda-retailers a{border-width:1.5px;font:700 14px/1.2 var(--font-body,"Outfit",sans-serif);transition:background-color .25s ease-in-out,color .25s ease-in-out}
.blko-soda-tabs__cta a:hover,.blko-soda-retailers a:hover{background:var(--color-text,#0f3b2e);color:#fff}
/* collection */
.blko-soda-coll__hero{display:grid;gap:1.5rem;padding:clamp(2rem,5vw,4rem) 0 0;text-align:left;overflow:hidden}
.blko-soda-coll__copy{max-width:80rem;width:100%;margin:0 auto;padding:0 1.25rem}
.blko-soda-coll .blko-soda-coll__hero h1{margin:0 0 .6rem;font:900 clamp(3rem,5.6vw,5rem)/1.1 var(--font-heading,"Fraunces",Georgia,serif)}
.blko-soda-coll .blko-soda-coll__hero p{max-width:32rem;margin:0;font-size:1.25rem;line-height:1.55}
.blko-soda-coll__banner{width:100%;height:clamp(180px,22vw,300px);object-fit:cover;object-position:center}
.blko-soda-coll__jump{position:sticky;top:var(--blko-header-h,0px);z-index:20;display:block;background:var(--color-bg,#fbf3e2);border-bottom:1px solid var(--color-border,#dccfae)}
.blko-soda-coll__jump .blko-soda-coll__filters{flex-wrap:nowrap;justify-content:center;overflow-x:auto;padding:.75rem 1.25rem;scrollbar-width:none}
.blko-soda-coll__filters a{white-space:nowrap}
.blko-soda-coll__group{max-width:82rem;margin:0 auto;padding:clamp(2rem,5vw,3.5rem) 0 0;scroll-margin-top:calc(var(--blko-header-h,0px) + 4rem)}
.blko-soda-coll__group h2{margin:0;padding:0 1.25rem;font:800 40px/44px var(--font-heading,"Fraunces",Georgia,serif);text-align:center}
.blko-soda-coll__note{margin:.4rem 0 1.5rem;padding:0 1.25rem;font:700 14px/1.5 var(--font-body,"Outfit",sans-serif);color:var(--color-text-muted,#4a6a5c);text-align:center}
.blko-soda-coll__group .blko-soda-coll__grid{display:flex;flex-wrap:wrap;justify-content:center;gap:1.75rem 1.25rem;padding-bottom:0}
.blko-soda-coll__group .blko-soda-coll__grid>.blko-soda-card{flex:0 0 calc((100% - 3.75rem)/4);height:auto}
.blko-soda-coll__promo{padding:clamp(2rem,4vw,3rem) 1.25rem 0}
@media(max-width:1000px){.blko-soda-coll__group .blko-soda-coll__grid>.blko-soda-card{flex-basis:calc((100% - 2.5rem)/3)}}
@media(max-width:700px){.blko-soda-coll__group .blko-soda-coll__grid{gap:1.25rem .75rem}.blko-soda-coll__group .blko-soda-coll__grid>.blko-soda-card{flex-basis:calc((100% - .75rem)/2)}.blko-soda-coll__group h2{font-size:32px;line-height:36px}.blko-soda-coll__jump .blko-soda-coll__filters{justify-content:flex-start}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda collection",
  "settings": [
    {"type": "color", "id": "bg", "label": "Hero background", "default": "#fff0cc"},
    {"type": "textarea", "id": "fallback_intro", "label": "Intro (when the collection has no description)", "default": "Prebiotic soda with real fruit flavor. Pick a flavor, a pack size, or build your own case."},
    {"type": "image_picker", "id": "banner", "label": "Header banner (fixed height, cover)"},
    {"type": "text", "id": "jump_label", "label": "Jump pills label", "default": "Jump to a group"},
    {"type": "text", "id": "tab_all", "label": "All tab label", "default": "All flavors"},
    {"type": "text", "id": "handle_all", "label": "All tab collection handle", "default": "drinks"},
    {"type": "text", "id": "add_label", "label": "Quick add label", "default": "Add to cart"},
    {"type": "text", "id": "view_label", "label": "Card button label", "default": "Shop now"},
    {"type": "text", "id": "sale_label", "label": "Sale badge", "default": "Sale"},
    {"type": "text", "id": "empty_text", "label": "Empty text", "default": "No products found."},
    {"type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 50, "step": 4, "default": 48}
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Extra link pill",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "Classics"},
        {"type": "text", "id": "handle", "label": "Collection handle", "default": "drinks", "info": "Handle of a real store collection. The tab links to it."}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Soda collection",
      "blocks": [
        {"type": "filter", "settings": {"label": "Variety packs", "handle": "variety-packs"}},
        {"type": "filter", "settings": {"label": "Single flavor packs", "handle": "single-flavor-packs"}},
        {"type": "filter", "settings": {"label": "9g fiber", "handle": "shop-9g-fiber"}},
        {"type": "filter", "settings": {"label": "6g fiber", "handle": "shop-6g-fiber"}}
      ]
    }
  ]
}
{% endschema %}
