{%- comment -%} Product card on the shared .blko-soda-tile frame with hover image swap and quick add. Params: product, line (optional label), add_label, view_label, sale_label {%- endcomment -%}
{%- assign p = product -%}
<article class="blko-soda-card">
  <div class="blko-soda-card__media-wrap">
    <a href="{{ p.url }}" class="blko-soda-card__media" aria-label="{{ p.title | escape }}">
      {% render 'blko-soda-tile', product: p, size: 'card', alt_image: p.images[1], sale_label: sale_label %}
    </a>
    {%- if p.available -%}
      {%- form 'product', p, class: 'blko-soda-card__quick' -%}
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        <button type="submit" class="blko-soda-card__btn" data-quick-add aria-label="{{ add_label | default: 'Quick add' }} {{ p.title | escape }}">{{ add_label | default: 'Quick add' }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
  <div class="blko-soda-card__info">
    {%- if line != blank -%}<p class="blko-soda-card__line">{{ line }}</p>{%- endif -%}
    <h3 class="blko-soda-card__title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
    <p class="blko-soda-card__price">{% if p.compare_at_price > p.price %}<s>{{ p.compare_at_price | money }}</s> {% endif %}{{ p.price | money }}</p>
    <a href="{{ p.url }}" class="blko-soda-card__btn">{{ view_label | default: 'Shop now' }}</a>
  </div>
</article>

{% stylesheet %}
.blko-soda-card{display:flex;flex-direction:column;gap:.8rem;font-family:var(--font-body, "Outfit", sans-serif);color:var(--color-text, #0f3b2e)}
.blko-soda-card__media-wrap{position:relative;overflow:hidden;border-radius:1.75rem;background:var(--color-pastel-1, #ffc9d6)}
.blko-soda-card__media{display:block;position:relative;aspect-ratio:1}
.blko-soda-card__quick{position:absolute;left:.75rem;right:.75rem;bottom:.75rem;transform:translateY(130%);transition:transform .25s}
.blko-soda-card__media-wrap:hover .blko-soda-card__quick,.blko-soda-card__quick:focus-within{transform:none}
.blko-soda-card__info{display:grid;gap:.3rem;text-align:center}
.blko-soda-card__line{margin:0;color:var(--color-text-muted, #4a6a5c);font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.blko-soda-card__title{margin:0;font:900 1.25rem/1.1 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-card__title a{color:inherit;text-decoration:none}
.blko-soda-card__price{margin:0;font-weight:700}
.blko-soda-card__btn{display:block;padding:.7rem 1rem;border:0;border-radius:999px;background:var(--color-button, #0f3b2e);color:var(--color-button-text, #fff);font:700 .95rem var(--font-heading, "Fraunces", Georgia, serif);text-align:center;text-decoration:none;cursor:pointer}
.blko-soda-card__quick .blko-soda-card__btn{width:100%;background:var(--color-announcement-bg, #cdf26b);color:var(--color-text, #0f3b2e)}
.blko-soda-card__info .blko-soda-card__btn{margin-top:.35rem}
@media(hover:none){.blko-soda-card__quick{position:static;transform:none;padding:0 .75rem .75rem}}
/* card */
.blko-soda-card{height:100%;gap:.9rem}
.blko-soda-card .blko-soda-card__media-wrap{border-radius:20px;background:none}
.blko-soda-card .blko-soda-card__media{aspect-ratio:auto}
.blko-soda-card .blko-soda-card__media .blko-soda-tile__img--can{object-fit:contain}
.blko-soda-card__media-wrap:hover .blko-soda-tile__img--can,.blko-soda-card__media:focus-visible .blko-soda-tile__img--can{transform:scale(1.06)}
.blko-soda-card__media-wrap:hover .blko-soda-tile__img--alt,.blko-soda-card__media:focus-visible .blko-soda-tile__img--alt{opacity:1;transform:none}
.blko-soda-card__media-wrap:hover .blko-soda-tile__img--alt~.blko-soda-tile__badge{opacity:1}
.blko-soda-card .blko-soda-card__info{flex:1;display:flex;flex-direction:column;gap:.3rem;text-align:center}
.blko-soda-card .blko-soda-card__line{font-size:.8rem;letter-spacing:.06em}
.blko-soda-card .blko-soda-card__title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.2em;font-size:1.25rem}
.blko-soda-card .blko-soda-card__price{margin-top:auto;padding-top:.2rem}
.blko-soda-card .blko-soda-card__btn{padding:.8rem 1rem;font:700 14px/1 var(--font-body,"Outfit",sans-serif);transition:background-color .25s ease-in-out,color .25s ease-in-out,box-shadow .25s ease-in-out}
.blko-soda-card .blko-soda-card__info .blko-soda-card__btn{margin-top:.5rem}
.blko-soda-card .blko-soda-card__info .blko-soda-card__btn:hover{background:#1f5a44}
.blko-soda-card__quick{transition:transform .3s cubic-bezier(.4,0,.2,1),opacity .3s cubic-bezier(.4,0,.2,1)}
.blko-soda-card__quick .blko-soda-card__btn:hover{background:#b9dd4e}
/* motion */
@media(prefers-reduced-motion:reduce){.blko-soda-tile .blko-soda-tile__img,.blko-soda-card *,.blko-soda-promo img,.blko-soda-spot__item img,.blko-soda-sticky,.blko-soda-pdp *,.blko-soda-flavor *,.blko-soda-hero *,.blko-soda-fan img{transition-duration:.01ms!important}.blko-soda-card__media-wrap:hover .blko-soda-tile__img--can,.blko-soda-spot__item:hover img,.blko-soda-promo:hover img{transform:none}.blko-soda-tabs__track{scroll-behavior:auto}}
{% endstylesheet %}
