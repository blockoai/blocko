{%- comment -%}
  Product image frame: square 1:1, pastel background, product centered at 78% height (object-fit: contain).
  Params: product, size ('card' | 'gallery' | 'thumb' | 'pick'), image (optional, defaults to featured image), alt_image (optional hover image),
  tint (optional), full (optional, true = fill the frame), attrs (optional attributes for the main img), loading (optional), sale_label (optional)
{%- endcomment -%}
{%- liquid
  assign p = product
  assign img = image | default: p.featured_image
  assign tile_bg = tint | default: p.metafields.fizz.tile_bg.value | default: '#fde1e3'
  assign w = 600
  if size == 'gallery'
    assign w = 1200
  elsif size == 'thumb'
    assign w = 160
  endif
  assign show_sale = false
  if p.compare_at_price > p.price and size != 'thumb' and size != 'pick'
    assign show_sale = true
  endif
-%}
<div class="blko-soda-tile{% if full %} is-full{% endif %}" style="--tile-bg:{{ tile_bg }}">
  {%- if img -%}
    <img class="blko-soda-tile__img blko-soda-tile__img--can" src="{{ img | image_url: width: w }}" alt="{{ img.alt | default: p.title | escape }}" width="{{ w }}" height="{{ w }}" loading="{{ loading | default: 'lazy' }}" {{ attrs }}>
  {%- endif -%}
  {%- if alt_image -%}
    <img class="blko-soda-tile__img blko-soda-tile__img--alt" src="{{ alt_image | image_url: width: w }}" alt="" width="{{ w }}" height="{{ w }}" loading="lazy">
  {%- endif -%}
  {%- if show_sale -%}
    <img class="blko-soda-tile__badge" src="{{ 'fizz-badge-sale.svg' | asset_url }}" alt="{{ sale_label | default: 'Sale' }}" width="64" height="64">
  {%- endif -%}
</div>

{% stylesheet %}
.blko-soda-tile{--tile-bg:#fde1e3;position:relative;display:block;aspect-ratio:1/1;border-radius:20px;background:var(--tile-bg);overflow:hidden;isolation:isolate}
.blko-soda-tile .blko-soda-tile__img{position:absolute;left:11%;top:11%;width:78%;height:78%;max-width:none;object-fit:contain;transition:transform .25s ease-in-out,opacity .5s ease-in-out}
.blko-soda-tile .blko-soda-tile__img--alt{opacity:0;transform:scale(.94)}
.blko-soda-tile.is-full .blko-soda-tile__img{left:0;top:0;width:100%;height:100%;object-fit:cover}
.blko-soda-tile .blko-soda-tile__badge{position:absolute;left:auto;top:.6rem;right:.6rem;z-index:2;width:clamp(46px,24%,76px);height:auto;object-fit:contain;pointer-events:none}
{% endstylesheet %}
