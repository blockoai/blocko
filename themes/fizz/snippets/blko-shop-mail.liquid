{%- comment -%} Swaps the example.com placeholder addresses in template defaults for the store email. Usage: {% render 'blko-shop-mail', text: value %}. Prints the value unchanged when no placeholder is present. {%- endcomment -%}
{%- assign shop_mail = shop.email | default: shop.customer_email -%}
{%- if shop_mail == blank -%}{{ text | replace: '[Organization name]', shop.name }}{%- else -%}{{ text | replace: 'help@example.com', shop_mail | replace: 'wholesale@example.com', shop_mail | replace: 'press@example.com', shop_mail | replace: 'privacy@example.com', shop_mail | replace: 'creators@example.com', shop_mail | replace: 'hello@example.com', shop_mail | replace: '[Organization name]', shop.name }}{%- endif -%}
