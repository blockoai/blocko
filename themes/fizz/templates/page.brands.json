    "brand-logo-usage": {
      "type": "blko-brand-logo-usage",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "do",
          "settings": {
            "text": "Use the primary wordmark on light surfaces and the inverse on dark ones."
          }
        },
        "block-2": {
          "type": "do",
          "settings": {
            "text": "Keep the shadow and bubbles in the accent colour, never a third colour."
          }
        },
        "block-3": {
          "type": "do",
          "settings": {
            "text": "Place the logo on calm areas of a photograph with enough contrast."
          }
        },
        "block-4": {
          "type": "dont",
          "settings": {
            "text": "Do not stretch, rotate or outline the wordmark."
          }
        },
        "block-5": {
          "type": "dont",
          "settings": {
            "text": "Do not remove the shadow, recolour the bubbles or change the offset direction."
          }
        },
        "block-6": {
          "type": "dont",
          "settings": {
            "text": "Do not set the logo on a busy pattern or low-contrast photograph."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6"
      ]
    },
    "brand-voice": {
      "type": "blko-brand-voice",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "principle",
          "settings": {
            "title": "Bubbly, never bossy",
            "text": "Big headlines, short lines, the odd exclamation mark. Energy comes from rhythm and confidence, not from shouting at people."
          }
        },
        "block-2": {
          "type": "principle",
          "settings": {
            "title": "Joke, then the facts",
            "text": "Land the grin first, then say what is in the can. Never let a gag hide the fiber count or a price."
          }
        },
        "block-3": {
          "type": "principle",
          "settings": {
            "title": "Friend, not guru",
            "text": "Talk like the friend who always has the good snacks and tells you where she got them. No lectures, no ranking people's habits."
          }
        },
        "block-4": {
          "type": "write",
          "settings": {
            "text": "Cherry, a squeeze of lime and 9g of fiber. Cold in ten minutes."
          }
        },
        "block-5": {
          "type": "write",
          "settings": {
            "text": "Your fridge called. It wants better soda."
          }
        },
        "block-6": {
          "type": "write",
          "settings": {
            "text": "Subscribe and save. Skip or cancel whenever."
          }
        },
        "block-7": {
          "type": "avoid",
          "settings": {
            "text": "Be the healthiest person in the room"
          }
        },
        "block-8": {
          "type": "avoid",
          "settings": {
            "text": "Revolutionary formula, unbeatable results"
          }
        },
        "block-9": {
          "type": "avoid",
          "settings": {
            "text": "Cure your gut in one can"
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6",
        "block-7",
        "block-8",
        "block-9"
      ]
    },
    "brand-imagery": {
      "type": "blko-brand-imagery",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "direction",
          "settings": {
            "title": "Cold cans, warm days",
            "text": "Picnics, patios, bike rides and road trips. Friends mid-laugh with a can in hand, never posed stiffly."
          }
        },
        "block-2": {
          "type": "direction",
          "settings": {
            "title": "Hard sun, pastel colour",
            "text": "Strong daylight against sky blue, lime and cherry pink. Shadows stay crisp, like the offset shadow in the logo."
          }
        },
        "block-3": {
          "type": "direction",
          "settings": {
            "title": "Cans in the splash",
            "text": "Cans on ice, wet tile and fruit slices, with real droplets and bubbles. Close, tactile, slightly imperfect."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3"
      ]
    }
  },
