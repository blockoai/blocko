    "fizz-benefit-trio": {
      "type": "blko-fizz-benefit-trio",
      "settings": {
        "eyebrow": "What's inside the can",
        "heading": "Three rules we do not bend"
      },
      "blocks": {
        "block-1": {
          "type": "benefit",
          "settings": {
            "title": "9g plant fiber",
            "text": "Every 12 fl oz can packs prebiotic fiber from plants and botanicals that feeds your good bacteria, with just 2g sugar and 35 calories."
          }
        },
        "block-2": {
          "type": "benefit",
          "settings": {
            "icon": "flame",
            "title": "Sweet from fruit",
            "text": "Real fruit juice and botanicals do the sweetening. No artificial sweeteners, ever, and every ingredient is listed on the can."
          }
        },
        "block-3": {
          "type": "benefit",
          "settings": {
            "icon": "peak",
            "title": "Fizz for everyone",
            "text": "Sparkling, gluten-free and vegan, with bold flavors that taste like soda night at the picnic, not a health lecture."
          }
        }
      },
