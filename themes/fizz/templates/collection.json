    "collection-about": {
      "type": "blko-collection-about",
      "settings": {
        "image_alt": "Cans of Fizz soda stacked in rows by flavor family",
        "kicker": "About Fizz soda",
        "heading": "A proper soda, not a sugar bomb.",
        "text": "Our cans are made in small batches with fruit juice, plant fiber and real botanicals, then carbonated until they are crisp and bright. Choose a flavor family for your mood and a pack size that fits your fridge schedule."
      }
    },
    "collection-faq": {
      "type": "blko-collection-faq",
      "settings": {
        "eyebrow": "Fizz questions",
        "heading": "Quick answers before you buy"
      },
      "blocks": {
        "block-1": {
          "type": "question",
          "settings": {
            "label": "How much fiber is in a can?",
            "text": "Every 12 fl oz can has 9g of plant fiber, 2g sugar and 35 calories."
          }
        },
        "block-2": {
          "type": "question",
          "settings": {
            "label": "Are there artificial sweeteners?",
            "text": "No. Sweetness comes from fruit juice and botanicals, and the ingredient list stays short."
          }
        },
        "block-3": {
          "type": "question",
          "settings": {
            "label": "What are the flavor families?",
            "text": "Citrus is bright and zesty, Berry is jammy, Tropical is sunny, Classic is nostalgic and Spicy has a ginger kick."
          }
        },
        "block-4": {
          "type": "question",
          "settings": {
            "label": "How should I store my cans?",
            "text": "Keep them cool and dry, then chill before opening. Unopened cans stay fizzy for months."
          }
        },
        "block-5": {
          "type": "question",
          "settings": {
            "label": "Where does Fizz ship from?",
            "text": "Every pack is packed and shipped from our own warehouse, so we can check each order ourselves."
          }
        }
      },
