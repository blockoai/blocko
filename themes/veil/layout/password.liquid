<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ shop.name | escape }}</title>
  {% render 'blko-theme-styles' %}
  {{ 'blko-theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="blko-theme">
  <main id="content">{{ content_for_layout }}</main>
  <footer class="blko-password-footer">
    <details class="blko-password-enter">
      <summary>{{ 'blko.password.enter' | t }}</summary>
      {% form 'storefront_password' %}
        <label for="blko-password-field">{{ 'blko.password.label' | t }}</label>
        <input id="blko-password-field" type="password" name="password" autocomplete="current-password" required>
        <button class="blko-button" type="submit">{{ 'blko.password.submit' | t }}</button>
        {%- if form.errors %}<p role="alert">{{ 'blko.password.error' | t }}</p>{% endif -%}
      {% endform %}
    </details>
  </footer>
  <style>.blko-password-footer{padding:1rem 5vw 2rem;text-align:center}.blko-password-enter summary{cursor:pointer}.blko-password-enter form{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;align-items:center;margin-top:1rem}.blko-password-enter input{min-height:44px;padding:.5rem .75rem}</style>
</body>
</html>
