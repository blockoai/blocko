{%- comment -%} Generated by Blocko from tools/themes/veil/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><aside class="blko-announcement">{{ section.settings.text | escape }} <a href="{{ section.settings.link | default: '#shipping' }}">{{ section.settings.link_label | escape }}</a></aside></div>
{% stylesheet %}
:where(.blko-theme){--color-announcement-text:#ffffff;--color-announcement-bg:#a2605b;--tracking-label:.075rem;--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--color-ink:var(--color-text);--color-text:#5e5047;--color-paper:var(--color-bg-alt);--color-bg-alt:#f7f4f0}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-announcement{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-announcement{padding:.7rem 5vw;text-align:center;background:var(--color-announcement-bg);color:var(--color-announcement-text)}
{% endstylesheet %}
