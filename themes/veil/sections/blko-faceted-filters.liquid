{%- comment -%} Generated by Blocko from tools/themes/veil/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection | default: collection | default: collections.all
-%}
<div class="blko-theme"><blko-tabs><section class="blko-filters"><div>{% for block in section.blocks %}<button class="blko-filter-chip {% if forloop.index0 == 0 %}is-active{% else %}{% endif %}" data-filter-chip {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>{% endfor %}</div><label>{{ 'blko.collection.sort' | t }} <select>{% for option in collection.sort_options %}<option>{{ option.name | escape }}</option>{% endfor %}</select></label></section></blko-tabs></div>
<script type="module" src="{{ 'blko-tabs.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-button-text:#ffffff;--color-ink:var(--color-text);--color-text:#5e5047;--text-small:.75rem;--color-bg:var(--color-paper);--color-paper:var(--color-bg-alt);--color-bg-alt:#f7f4f0;--leading-display:.9;--text-title:2rem;--color-button:#5e5047;--color-border:#d6d0c7;--tracking-button:.075rem;--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-button:1.5;--text-button:.75rem;--weight-medium:500}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-filter-chip{font:var(--weight-medium) var(--text-button)/var(--leading-button) var(--font-accent);letter-spacing:var(--tracking-button);text-transform:uppercase}
.blko-theme .blko-filters{display:flex;align-items:center;gap:1rem}
.blko-theme .blko-filters{padding:clamp(3rem,8vw,8rem) 5vw}
.blko-theme .blko-filter-chip{padding:.6rem .8rem;border:1px solid var(--color-border);background:transparent;color:inherit;cursor:pointer}
.blko-theme .blko-filter-chip.is-active{border-color:var(--color-button);background:var(--color-button);color:var(--color-button-text)}
.blko-theme .blko-variant-options [aria-pressed=true]{border-color:var(--color-button);background:var(--color-button);color:var(--color-button-text)}
.blko-theme .blko-global-cookie .blko-global-link-button{color:var(--color-button-text)}
.blko-theme .blko-global-announce.blko-global-announce--rotate{color:var(--color-bg)}
.blko-theme .blko-home-collection-filter-drawer [data-filter-drawer-close]{justify-self:end;border:0;background:color-mix(in srgb, var(--color-bg) 0%, transparent);font-size:var(--text-title);line-height:var(--leading-display)}
.blko-theme .blko-pdp-bundle-item.is-selected{border-color:var(--color-ink);background:var(--color-bg-alt)}
.blko-theme .blko-pdp-bundle__summary .blko-button{background:var(--color-bg);border-color:var(--color-button-text);color:var(--color-ink)}
@media(max-width:760px){.blko-theme .blko-pdp-sticky-buy .blko-button{font-size:var(--text-small)}
.blko-theme .blko-pdp-bundle__summary .blko-button{font-size:var(--text-small);padding:.65rem}}
.blko-theme .blko-search-blog-tag-filter .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-filters .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-pagination .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-section-heading .blko-search-blog-tag-filter{justify-content:center;margin-top:1.25rem}
.blko-theme .blko-search-blog-comment-form .blko-button{justify-self:start}
