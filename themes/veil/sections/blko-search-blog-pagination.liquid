{%- comment -%} Generated by Blocko from tools/themes/veil/groups/search-blog.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign blog = section.settings.blog | default: blog
-%}
<div class="blko-theme"><blko-search-blog>{% paginate blog.articles by section.settings.page_size %}{% if paginate.pages > 1 %}<nav class="blko-search-blog-pagination" aria-label="{{ section.settings.nav_label | escape }}">{% if paginate.previous.url != blank %}<a href="{{ paginate.previous.url | escape }}" aria-label="{{ section.settings.previous_label | escape }}">←</a>{% else %}<span class="blko-search-blog-pagination__edge" aria-disabled="true" aria-label="{{ section.settings.previous_label | escape }}">←</span>{% endif %}{% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url | escape }}">{{ part.title }}</a>{% else %}{% if part.title == paginate.current_page %}<span class="is-active" aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endif %}{% endfor %}{% if paginate.next.url != blank %}<a href="{{ paginate.next.url | escape }}" aria-label="{{ section.settings.next_label | escape }}">→</a>{% else %}<span class="blko-search-blog-pagination__edge" aria-disabled="true" aria-label="{{ section.settings.next_label | escape }}">→</span>{% endif %}</nav>{% else %}{% endif %}{% endpaginate %}</blko-search-blog></div>
<script type="module" src="{{ 'blko-search-blog.js' | asset_url }}"></script>
