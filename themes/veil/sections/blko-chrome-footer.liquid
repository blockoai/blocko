{%- comment -%} Generated by Blocko from tools/themes/veil/chrome.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><footer class="blko-footer blko-{{ section.settings.color_scheme.id | escape }}"><div><a class="blko-wordmark" href="{{ routes.root_url | escape }}">{{ shop.name | escape }}</a><p>{{ section.settings.tagline | escape | newline_to_br }}</p></div>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong>{% for link in block.settings.menu.links %}<a href="{{ link.url | escape }}">{{ link.title | escape }}</a>{% endfor %}</div>{% endfor %}</footer></div>
