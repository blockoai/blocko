{%- comment -%} Generated by Blocko from tools/themes/veil/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-contact-channels">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span aria-hidden="true">{{ block.settings.icon | escape }}</span><h2>{{ block.settings.title | escape }}</h2><p>{{ block.settings.text | escape | newline_to_br }}</p><a href="{{ block.settings.url | default: 'mailto:hello@example.com' }}">{{ block.settings.link_label | escape }}</a></article>{% endfor %}</section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--text-title:2rem;--text-display:2.5rem;--font-mono:var(--font-accent);--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--font-display:var(--font-heading);--font-heading:"Cormorant Garamond",Georgia,serif;--leading-card-title:1.125;--text-card-title:1.5rem;--leading-display:.9;--leading-body:1.5;--text-small:.75rem;--color-text-muted:#756e65;--color-accent:#bba293;--tracking-label:.075rem;--text-h2:2rem;--color-footer-bg:#271f1f;--color-button-text:#ffffff;--color-overlay:#00000066;--tracking-h2:-.08rem;--weight-light:300;--color-line:var(--color-border);--color-border:#d6d0c7;--tracking-body:-.02rem;--text-body:1rem;--color-ink:var(--color-text);--color-text:#5e5047;--color-paper:var(--color-bg-alt);--color-bg-alt:#f7f4f0}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem;--text-display:5rem;--text-card-title:2rem;--text-h2:2.5rem;--tracking-h2:-.1rem;--tracking-body:-.025rem;--text-body:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-contact-channels{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--color-line);margin:0 5vw}
.blko-theme .blko-content-contact-channels article{padding:2.5rem 2rem}
.blko-theme .blko-content-contact-channels article+article{border-left:1px solid var(--color-line)}
.blko-theme .blko-content-contact-channels span{display:grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid;border-radius:50%;font-size:var(--text-body)}
.blko-theme .blko-content-contact-channel-card>span{display:grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid;border-radius:50%;font-size:var(--text-body)}
.blko-theme .blko-content-contact-channels h2{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);letter-spacing:var(--tracking-body)}
.blko-theme .blko-content-faq-search span{font-weight:600}
.blko-theme .blko-content-policy-document h2{font-size:var(--text-h2);margin:.1rem 0 1rem}
@media (max-width:760px){.blko-theme .blko-content-values-grid article+article{padding-left:0;border-left:0}
.blko-theme .blko-content-contact-channels{grid-template-columns:1fr}
.blko-theme .blko-content-contact-channels article+article{border-left:0;border-top:1px solid var(--color-line)}}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-category-card span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-category-card span{position:absolute;left:1rem;bottom:1rem;color:var(--color-button-text);font-family:var(--font-accent);text-shadow:0 1px 8px var(--color-overlay)}
.blko-theme .blko-global-page h2{margin:.35rem 0 1rem}
.blko-theme .blko-global-components h2{margin:.35rem 0 1rem}
.blko-theme .blko-global-region-notice h2{font-size:var(--text-h2)}
.blko-theme .blko-global-gift-card>span{font-size:var(--text-display)}
.blko-theme .blko-home-collection-mega-menu h2{margin:.35rem 0 1.5rem;font-size:var(--text-title)}
.blko-theme .blko-home-collection-mega-menu__tiles span{position:absolute;inset:auto 1rem 1rem;color:var(--color-button-text);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase;text-shadow:0 1px 8px var(--color-footer-bg)}
.blko-theme .blko-home-collection-filter-drawer h2{margin:0}
.blko-theme .blko-home-collection-promo-tile h2{font-size:var(--text-h2);margin:.4rem 0}
.blko-theme .blko-home-collection-directory__grid span{position:absolute;left:1rem;text-shadow:0 1px 8px var(--color-footer-bg)}
.blko-theme .blko-home-collection-directory__grid span{bottom:2rem;font:var(--weight-medium) var(--text-h2)/var(--leading-display) var(--font-display)}
.blko-theme .blko-home-collection-quick-view__content h2{margin:.3rem 0 1.5rem;font-size:var(--text-title)}
.blko-theme .blko-pdp-rating span{letter-spacing:var(--tracking-label);color:var(--color-accent)}
.blko-theme .blko-pdp-price span{color:var(--color-text-muted);font-size:var(--text-small)}
.blko-theme .blko-pdp-sticky-buy span{display:block;font-size:var(--text-small)}
.blko-theme .blko-pdp-before-after h2{margin:.4rem 0 1rem}
.blko-theme .blko-pdp-stat-grid span{font-size:var(--text-small);line-height:var(--leading-body)}
.blko-theme .blko-pdp-reviews h2{font:var(--weight-medium) var(--text-display)/var(--leading-display) var(--font-display);margin:.5rem 0}
.blko-theme .blko-pdp-bundle-item h2{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);margin:.3rem 0}
.blko-theme .blko-search-blog-predictive__dropdown span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);text-transform:uppercase}
.blko-theme .blko-search-blog-featured-post h2{font-size:var(--text-display)}
.blko-theme .blko-search-blog-reading h2{font-size:var(--text-title);margin-top:3rem}
{% endstylesheet %}
