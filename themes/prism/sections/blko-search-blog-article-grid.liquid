{%- comment -%} Generated by Blocko from tools/themes/prism/groups/search-blog.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign blog = section.settings.blog | default: blog
-%}
<div class="blko-theme"><blko-search-blog><blko-predictive-search><section class="blko-search-blog-article-grid"><div class="blko-search-blog-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="blko-search-blog-tag-filter" aria-label="{{ section.settings.filter_label | escape }}"><a href="{{ blog.url | escape }}" class="{% if current_tags == blank %}is-active{% else %}{% endif %}">{{ section.settings.all_label | escape }}</a>{% for tag in blog.all_tags %}<a href="{{ blog.url | escape }}/tagged/{{ tag | handleize }}" class="{% if current_tags.first == tag %}is-active{% else %}{% endif %}">{{ tag | escape }}</a>{% endfor %}</div></div><div class="blko-search-blog-article-grid__items">{% paginate blog.articles by section.settings.page_size %}{% for post in blog.articles %}<article class="blko-search-blog-article-card" data-search-blog-article data-search-blog-tag="{{ post.tags.first | escape }}">
  {% if post.image != blank %}{{ post.image | image_url: width: 860 | image_tag: loading: 'lazy', widths: '215, 430, 645, 860', alt: post.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}
  <div><p class="blko-eyebrow">{{ post.tags.first | escape }}</p><h3>{{ post.title | escape }}</h3><p>{{ post.excerpt_or_content | strip_html | truncate: 160 | escape }}</p><a href="{{ post.url | escape }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a></div>
</article>{% endfor %}{% endpaginate %}</div></section></blko-predictive-search></blko-search-blog></div>
<script type="module" src="{{ 'blko-predictive-search.js' | asset_url }}"></script>
