{% schema %}
{
  "name": "Filterable article grid",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Stories per page",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "More to explore"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the journal"
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "Filter journal stories"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read the story"
    }
  ],
  "presets": [
    {
      "name": "Filterable article grid"
    }
  ]
}
{% endschema %}
