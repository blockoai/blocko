<div class="blko-theme"><blko-variant-picker><blko-accordion><section class="blko-product-detail">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '275, 550, 825, 1100', alt: product.featured_image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ product.vendor | escape }}</p><h1>{{ product.title | escape }}</h1><p>{{ product.description | strip_html | truncate: 160 | escape }}</p><fieldset class="blko-variant-options"><legend>{{ section.settings.legend | escape }}</legend>{% for variant in product.variants %}<button data-variant-option{% if variant.id == product.selected_or_first_available_variant.id %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %} data-variant-id="{{ variant.id | escape }}">{{ variant.title | escape }}</button>{% endfor %}</fieldset>{% form 'product', product, id: 'blko-product-form', hidden: '' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | escape }}">{% endform %}<button class="blko-button" type="submit" name="add" form="blko-product-form">{{ section.settings.button_label | escape }}</button>{% for block in section.blocks %}<blko-accordion {{ block.shopify_attributes }}><article class="blko-accordion" data-accordion><button type="button" data-accordion-trigger aria-expanded="false">{{ block.settings.label | escape }}<span>+</span></button><div data-accordion-panel hidden><p>{{ block.settings.text | escape | newline_to_br }}</p></div></article></blko-accordion>{% endfor %}</div></section></blko-accordion></blko-variant-picker></div>
