    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Keep shopping"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Hair care products on a table"
    }
  ],
  "presets": [
    {
      "name": "Empty cart"
    }
  ]
}
{% endschema %}
