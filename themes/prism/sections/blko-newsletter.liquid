{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the color club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "get 10% off your first system."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing."
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Drops, tips and color-care know-how. No spam."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
