{% schema %}
{
  "name": "Account dashboard",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Your account"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting",
      "default": "Hello,"
    },
    {
      "type": "text",
      "id": "greeting_fallback",
      "label": "Greeting fallback",
      "default": "Welcome back."
    },
    {
      "type": "text",
      "id": "signout_label",
      "label": "Signout label",
      "default": "Sign out"
    },
    {
      "type": "text",
      "id": "nav_orders",
      "label": "Nav orders",
      "default": "Orders"
    },
    {
      "type": "text",
      "id": "nav_addresses",
      "label": "Nav addresses",
      "default": "Addresses"
    },
    {
      "type": "url",
      "id": "details_url",
      "label": "Details url"
    },
    {
      "type": "text",
      "id": "nav_details",
      "label": "Nav details",
      "default": "Account details"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Manage recent purchases and saved delivery information."
    },
    {
      "type": "text",
      "id": "show_order_label",
      "label": "Show order label",
      "default": "Show recent order"
    },
    {
      "type": "text",
      "id": "show_empty_label",
      "label": "Show empty label",
      "default": "Show empty state"
    },
    {
      "type": "text",
      "id": "shortcut_orders",
      "label": "Shortcut orders",
      "default": "View orders"
    },
    {
      "type": "text",
      "id": "shortcut_addresses",
      "label": "Shortcut addresses",
      "default": "Manage addresses"
    }
  ],
  "presets": [
    {
      "name": "Account dashboard"
    }
  ]
}
{% endschema %}
