    {
      "type": "text",
      "id": "prefix",
      "label": "Prefix",
      "default": "Small seasonal gift ends in"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link url"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See details"
    }
  ],
  "presets": [
    {
      "name": "Countdown announcement"
    }
  ]
}
{% endschema %}
