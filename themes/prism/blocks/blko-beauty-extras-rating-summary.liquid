{%- comment -%} Generated by Blocko from tools/themes/prism/groups/beauty-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-beauty-extras><div class="blko-beauty-extras-mini-rating"><strong>{{ block.settings.average | escape }}</strong><span>{% assign blko_rating = block.settings.average | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</span><p>{{ block.settings.count | escape }}</p></div></blko-beauty-extras></div>
<script type="module" src="{{ 'blko-beauty-extras.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--font-heading:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--font-mono:var(--font-accent);--font-accent:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--leading-label:1.5;--text-label:0.75rem;--weight-medium:500;--text-small:.75rem;--leading-body:1.5;--text-card-title:1.125rem;--color-text-muted:CanvasText;--text-body:0.9375rem;--color-accent:GrayText;--tracking-label:.075rem;--font-display:var(--font-heading);--leading-display:.9;--text-h2:1.875rem;--color-footer-bg:CanvasText;--color-button-text:Canvas;--text-display:3.25rem;--color-border:ButtonFace;--color-overlay:rgb(0 0 0 / .4);--tracking-price:-.02rem;--font-body:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--text-price:1rem;--weight-bold:700;--color-text:CanvasText;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:1.25rem;--text-body:1rem;--text-h2:2.5rem;--text-display:5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-beauty-extras-mini-rating strong{font:var(--weight-medium) var(--text-display)/var(--leading-display) var(--font-display)}
.blko-theme .blko-beauty-extras-mini-rating span{margin-left:.5rem}
.blko-theme .blko-cart-checkout-progress span{display:block;height:4px;margin-top:.65rem;background:var(--color-border)}
.blko-theme .blko-cart-checkout-map span{position:absolute;z-index:1;width:.85rem;height:.85rem;border-radius:50%;background:var(--color-text)}
.blko-theme .blko-content-contact-channels span{display:grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid;border-radius:50%;font-size:var(--text-body)}
.blko-theme .blko-content-contact-channel-card>span{display:grid;place-items:center;width:2.5rem;height:2.5rem;border:1px solid;border-radius:50%;font-size:var(--text-body)}
.blko-theme .blko-content-faq-search span{font-weight:600}
.blko-theme .blko-category-card span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-price strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-cart-line>strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-cart-summary strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-footer strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-timeline strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-press-section strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-category-card span{position:absolute;left:1rem;bottom:1rem;color:var(--color-button-text);font-family:var(--font-accent);text-shadow:0 1px 8px var(--color-overlay)}
.blko-theme .blko-press-section strong{display:grid;place-items:center;min-height:4rem;padding:1rem;border:1px solid var(--color-border);font-size:clamp(.72rem,1vw,.9rem)}
@media(max-width:760px){.blko-theme .blko-press-section strong{min-height:3.25rem;padding:.5rem;font-size:.6rem}}
.blko-theme .blko-global-gift-card>span{font-size:var(--text-display)}
.blko-theme .blko-global-code strong{font-size:var(--text-small)}
.blko-theme .blko-home-collection-mega-menu__tiles span{position:absolute;inset:auto 1rem 1rem;color:var(--color-button-text);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase;text-shadow:0 1px 8px var(--color-footer-bg)}
.blko-theme .blko-home-collection-directory__grid span{position:absolute;left:1rem;text-shadow:0 1px 8px var(--color-footer-bg)}
.blko-theme .blko-home-collection-directory__grid span{bottom:2rem;font:var(--weight-medium) var(--text-h2)/var(--leading-display) var(--font-display)}
.blko-theme .blko-pdp-rating span{letter-spacing:var(--tracking-label);color:var(--color-accent)}
.blko-theme .blko-pdp-price strong{font-size:var(--text-body)}
.blko-theme .blko-pdp-price span{color:var(--color-text-muted);font-size:var(--text-small)}
.blko-theme .blko-pdp-sticky-buy span{display:block;font-size:var(--text-small)}
.blko-theme .blko-pdp-stat-grid strong{font-size:var(--text-card-title)}
.blko-theme .blko-pdp-stat-grid span{font-size:var(--text-small);line-height:var(--leading-body)}
.blko-theme .blko-pdp-mini-product strong{font-size:var(--text-small)}
.blko-theme .blko-search-blog-predictive__dropdown span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);text-transform:uppercase}
.blko-theme .blko-prism-finder__tile strong{display:block;font:700 1.375rem/1.05 var(--font-heading);letter-spacing:-.01em}
.blko-theme .blko-prism-effect__stat span{margin-top:.35rem;font-weight:500}
@media(max-width:520px){.blko-theme .blko-prism-finder__tile strong{font-size:1.125rem}}
