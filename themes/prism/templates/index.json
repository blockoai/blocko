    "hero-campaign": {
      "type": "blko-hero-campaign",
      "settings": {
        "image_alt": "Close-up of vivid copper hair with a glossy finish",
        "eyebrow": "New colour-care launch",
        "heading": "3 steps to keep your shade.",
        "text": "A wash, a treatment and a seal built to hold pigment in, so a fresh colour job stays bright and feels stronger between appointments.",
        "button_label": "Shop the system"
      }
    },
    "prism-system": {
      "type": "blko-prism-system",
      "settings": {
        "eyebrow": "The colour-care system",
        "heading": "Cleanse, treat, seal.",
        "text": "Three formulas that work in sequence. Lab testing on dyed hair showed less fade and fewer broken strands after six weeks.*"
      },
      "blocks": {
        "block-1": {
          "type": "step",
          "settings": {
            "title": "wash gently",
            "text": "A sulfate-free cleanse that lifts buildup without dragging colour down the drain."
          }
        },
        "block-2": {
          "type": "step",
          "settings": {
            "number": "2",
            "title": "treat weekly",
            "text": "A pigment-friendly treatment that patches weak spots and revives dull, tired ends.",
            "link_label": "Shop treatments"
          }
        },
        "block-3": {
          "type": "step",
          "settings": {
            "number": "3",
            "title": "seal and shine",
            "text": "A light serum that closes the cuticle, calms frizz and shields strands from the dryer.",
            "link_label": "Shop serums"
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3"
      ]
    },
