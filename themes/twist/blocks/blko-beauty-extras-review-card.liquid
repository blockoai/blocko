{%- comment -%} Generated by Blocko from tools/themes/twist/groups/beauty-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-beauty-extras><article class="blko-beauty-extras-review-card"><p>{% assign blko_rating = block.settings.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</p><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.meta | escape }}</p></article></blko-beauty-extras></div>
<script type="module" src="{{ 'blko-beauty-extras.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--tracking-h3:.0875rem;--leading-h3:1.5;--weight-medium:500;--text-h3:.875rem;--font-body:"Figtree",Arial,sans-serif;--color-paper:var(--color-bg);--color-bg:Canvas;--color-ink:var(--color-text);--color-text:CanvasText}
@media (min-width:1024px){:where(.blko-theme){--tracking-h3:.1rem;--text-h3:1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-beauty-extras-review-card{padding:1.5rem;background:var(--color-paper)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
{% endstylesheet %}
{% schema %}
{
  "name": "Review card",
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Fresh style, no fuss."
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Meta",
      "default": "Verified customer"
    }
  ],
  "presets": [
    {
      "name": "Review card"
    }
  ]
}
{% endschema %}
