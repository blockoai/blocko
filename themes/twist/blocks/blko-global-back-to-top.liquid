{%- comment -%} Generated by Blocko from tools/themes/twist/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-global><button class="blko-global-back-top" type="button" data-global-back-top aria-label="Back to top">↑ <span>{{ block.settings.label | escape }}</span></button></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-ink:var(--color-text);--color-text:CanvasText;--color-bg:Canvas;--font-body:"Figtree",Arial,sans-serif;--color-paper:var(--color-bg)}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-global-back-top{position:fixed;z-index:10;right:1rem;bottom:1rem;display:flex;gap:.4rem;align-items:center;padding:.7rem .85rem;border:1px solid var(--color-ink);background:var(--color-bg);color:var(--color-ink);opacity:0;pointer-events:none;transform:translateY(1rem);transition:.2s}
{% endstylesheet %}
