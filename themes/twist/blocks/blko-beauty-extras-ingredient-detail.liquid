{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:none;--kit-heading-transform:none;--kit-heading-weight:700;--font-heading:"Fraunces",Georgia,serif;--tracking-label:.075rem;--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:2rem;--font-body:"Figtree",Arial,sans-serif;--color-sand:var(--color-bg-alt);--color-bg-alt:Canvas;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
