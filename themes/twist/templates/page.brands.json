      "type": "blko-brand-imagery",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "direction",
          "settings": {
            "title": "Bright and close",
            "text": "Clean daylight, saturated colour, crops tight on the accessory and the hair it holds."
          }
        },
        "block-2": {
          "type": "direction",
          "settings": {
            "title": "Flat lays with a wink",
            "text": "Sets arranged in bold colour blocks on plain grounds, a small surprise in each frame."
          }
        },
        "block-3": {
          "type": "direction",
          "settings": {
            "title": "Real hair days",
            "text": "Candid, mid-laugh, every texture and length. Never retouched into sameness."
          }
