{%- comment -%} Generated by Blocko from tools/themes/twist/groups/brand.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-brand-section blko-{{ section.settings.color_scheme.id | escape }}"><header class="blko-brand-head"><p class="blko-brand-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></header><div class="blko-brand-mood">{% if section.settings.image_1 != blank %}{{ section.settings.image_1 | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: section.settings.image_1_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}{% if section.settings.image_2 != blank %}{{ section.settings.image_2 | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: section.settings.image_2_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}{% if section.settings.image_3 != blank %}{{ section.settings.image_3 | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: section.settings.image_3_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</div><div class="blko-brand-cards">{% for block in section.blocks %}<article class="blko-brand-card" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></article>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-heading-transform:none;--kit-heading-weight:700;--font-heading:"Fraunces",Georgia,serif;--kit-radius-image:0;--color-text-muted:CanvasText;--leading-card-title:1.125;--text-card-title:1.5rem;--weight-light:300;--kit-radius-card:0;--color-bg-alt:Canvas;--color-border:ButtonFace;--leading-display:.9;--text-h2:2rem;--color-text:CanvasText;--color-bg:Canvas;--kit-label-transform:none;--tracking-label:.075rem;--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--font-body:"Figtree",Arial,sans-serif;--tracking-h2:-.08rem;--color-accent:GrayText;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:2rem;--text-h2:2.5rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-brand-eyebrow{margin:0;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase);opacity:.75}
.blko-theme .blko-brand-section{padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem);background:var(--color-bg);color:var(--color-text);display:grid;gap:2rem}
.blko-theme .blko-brand-head{display:grid;gap:.6rem;max-width:44rem}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-cards{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}
.blko-theme .blko-brand-card{padding:1.25rem 1.5rem;border:1px solid var(--color-border);background:var(--color-bg-alt);border-radius:var(--kit-radius-card,0)}
.blko-theme .blko-brand-card h3{margin:0 0 .5rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-card-title)/var(--leading-card-title) var(--font-heading)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
.blko-theme .blko-brand-mood{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr))}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme .blko-search-blog-comment p{margin:.25rem 0}
