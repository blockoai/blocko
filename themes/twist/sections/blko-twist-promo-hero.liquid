{% schema %}
{
  "name": "Promo hero",
  "settings": [
    {
      "type": "text",
      "id": "burst",
      "label": "Burst",
      "default": "35% off"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Person smiling with bouncy curls"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "just in"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "the winter gift drop is live"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Scrunchie packs, scented mists and cozy sleep sets, wrapped up in sets you can hand over as they are. A free gift lands in your bag at $60."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "shop the drop"
    }
  ],
  "presets": [
    {
      "name": "Promo hero"
    }
  ]
}
{% endschema %}
