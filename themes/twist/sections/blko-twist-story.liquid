{% schema %}
{
  "name": "Story split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Hair routine in the morning light"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "our story"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We started with one pillowcase and a simple idea: hair care should be cheerful, affordable and a little bit giftable. Today our tools and accessories make everyday hair days easier for people around the world."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "read more"
    }
  ],
  "presets": [
    {
      "name": "Story split"
    }
  ]
}
{% endschema %}
