{%- comment -%} Generated by Blocko from tools/themes/twist/groups/twist-signature.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection | default: collection | default: collections.all
-%}
<div class="blko-theme"><blko-twist-signature><blko-cart-drawer><blko-variant-picker><blko-fbt class="blko-fbt" data-currency="{{ cart.currency.iso_code | escape }}" data-cart-add="{{ routes.cart_add_url | escape }}"><h2>{{ section.settings.heading | escape }}</h2><div class="blko-fbt-row">{% for pick in collection.products limit: 3 %}<label class="blko-fbt-item"><input type="checkbox" checked data-fbt-item data-cents="{{ pick.price | escape }}" data-variant="{{ pick.selected_or_first_available_variant.id | escape }}">{% if pick.featured_image != blank %}{{ pick.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '270, 360', alt: pick.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span>{{ pick.title | escape }}</span><strong>{{ pick.price | money_without_trailing_zeros }}</strong></label>{% endfor %}</div><div class="blko-fbt-total"><p>{{ section.settings.total_label | escape }} <strong data-fbt-total>$0</strong></p><button class="blko-button" type="button" data-fbt-add>{{ section.settings.button_label | escape }}</button></div></blko-fbt></blko-variant-picker></blko-cart-drawer></blko-twist-signature></div>
<script type="module" src="{{ 'blko-variant-picker.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-cart-drawer.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-twist-signature.js' | asset_url }}"></script>
