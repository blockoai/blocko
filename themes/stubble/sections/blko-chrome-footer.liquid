{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-17"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Razors and grooming essentials that perform, at a price that stays fair."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer-shop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {}
        },
        {
          "type": "column",
          "settings": {
            "title": "About",
            "menu": "footer-about"
          }
        }
      ]
    }
  ]
}
{% endschema %}
