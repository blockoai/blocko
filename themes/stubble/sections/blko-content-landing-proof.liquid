{%- comment -%} Generated by Blocko from tools/themes/stubble/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-landing-proof"><div><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><blockquote>{{ section.settings.quote | escape }}</blockquote><p>{{ section.settings.author | escape }}</p></div><ul>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></li>{% endfor %}</ul></section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-transform:none;--kit-heading-weight:600;--font-heading:"Archivo",Arial,sans-serif;--font-mono:var(--font-accent);--font-accent:"Inter",Arial,sans-serif;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--color-ink:var(--color-text);--color-text:CanvasText;--font-sans:var(--font-body);--font-body:"Inter",Arial,sans-serif;--leading-body:1.5;--text-small:.75rem;--color-border:ButtonFace;--tracking-title:-.08rem;--text-title:1.625rem;--weight-light:300;--color-text-muted:CanvasText;--leading-display:.9;--text-display:2.5rem;--color-accent:GrayText;--tracking-label:.075rem;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--tracking-title:-.1rem;--text-title:1.75rem;--text-display:3.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-kicker{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none;margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-content-landing-proof{display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding:clamp(4rem,9vw,9rem) 12vw;background:var(--color-accent)}
.blko-theme .blko-content-landing-proof blockquote{font-size:var(--text-display);line-height:var(--leading-display);margin:0 0:1.5rem}
.blko-theme .blko-content-landing-proof ul{list-style:none;margin:0;padding:0}
.blko-theme .blko-content-landing-proof li{display:grid;gap:.3rem;padding:1.1rem 0;border-top:1px solid var(--color-text-muted)}
.blko-theme .blko-content-landing-proof li span{font-size:var(--text-small)}
@media (max-width:760px){.blko-theme .blko-content-landing-proof{grid-template-columns:1fr}
.blko-theme .blko-content-story-timeline li{grid-template-columns:5rem 1fr;gap:1rem}
.blko-theme .blko-content-landing-proof{padding-inline:5vw}}
.blko-theme blockquote{margin:1rem 0;font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading);letter-spacing:var(--tracking-title)}
.blko-theme .blko-timeline li{display:grid;grid-template-columns:120px 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--color-border)}
.blko-theme .blko-pdp-reviews h2 span{font:var(--weight-medium) var(--text-small)/var(--leading-body) var(--font-sans);vertical-align:middle}
.blko-theme .blko-pdp-bundle-explainer li{border-top:1px solid var(--color-ink);padding-top:1rem}
.blko-theme .blko-pdp-bundle-explainer li>span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono)}
.blko-theme .blko-stubble-story__copy ul{margin:0;padding:0;list-style:none;display:grid;gap:.4rem}
.blko-theme.blko-theme blockquote{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
{% endstylesheet %}
