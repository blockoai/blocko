      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our approach"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed and formulated for quality."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Build your kit with essentials that work well together and cost less than the big names."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore more"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    }
  ],
  "presets": [
    {
      "name": "Review slider"
    }
  ]
}
