          "settings": {
            "text": "A thick, cushioning gel that turns into a rich lather. Use it on its own or with a weighted razor for a close, comfortable shave."
          }
        },
        "block-2": {
          "type": "accordion",
          "settings": {
            "label": "Ingredients",
            "text": "Water, glycerin, plant-based cleansers and skin-conditioning ingredients in a comfortable daily formula, free of parabens and dyes."
          }
        },
        "block-3": {
          "type": "accordion",
          "settings": {
            "label": "How to use",
            "text": "Wet your face, apply a small amount of gel and work it into a lather. Shave in the direction of hair growth, rinse the blade often, then rinse your face."
          }
        }
