        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "text",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "Pick your logo files here. Empty fields use the logo bundled with the theme (an SVG that follows your colours)."
