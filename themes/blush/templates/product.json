    "pdp-how-to": {
      "type": "blko-pdp-how-to",
      "settings": {
        "kicker": "How to wear it",
        "heading": "Three ways to place it"
      },
      "blocks": {
        "block-1": {
          "type": "step",
          "settings": {
            "image_alt": "Fingertip pressing gel-cream colour into the cheek",
            "label": "Press",
            "title": "Dab with fingertips",
            "text": "Start on the apple of the cheek and pat outward until the edge disappears."
          }
        },
        "block-2": {
          "type": "step",
          "settings": {
            "image_alt": "Soft flush swept up toward the temple",
            "label": "Sweep",
            "title": "Draw it up and out",
            "text": "Follow the cheekbone toward the temple for a lifted look, or keep it low for a sweet one."
          }
        },
        "block-3": {
          "type": "step",
          "settings": {
            "image_alt": "Cheek colour and lip balm side by side",
            "label": "Layer",
            "title": "Stack for intensity",
            "text": "Add a second thin coat once the first has set, and swipe any leftover onto lips."
          }
        }
      },
