{%- comment -%} Generated by Blocko from tools/themes/blush/groups/account.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-account><a class="blko-account-order-row" href="{{ customer.orders.first.customer_url | escape }}"><strong>{{ block.settings.order_prefix | escape }} {{ customer.orders.first.order_number | escape }}</strong><span>{{ customer.orders.first.created_at | date: '%B %-d, %Y' }}</span><span><i class="blko-account-status">{{ customer.orders.first.fulfillment_status_label | escape }}</i></span><span>{{ customer.orders.first.total_price | money }}</span></a></blko-account></div>
<script type="module" src="{{ 'blko-account.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-label-transform:uppercase;--font-sans:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--color-text:CanvasText;--color-bg-alt:Canvas;--color-border:ButtonFace;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-account-order-row{display:grid;grid-template-columns:1.15fr 1.4fr 1.3fr .7fr;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--color-border)}
.blko-theme .blko-account-order-row{color:inherit;text-decoration:none}
.blko-theme .blko-account-order-row:hover strong{text-decoration:underline;text-underline-offset:3px}
.blko-theme .blko-account-status{display:inline-block;padding:.18rem .45rem;background:var(--color-bg-alt);color:var(--color-text);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);font-style:normal}
@media (max-width:760px){.blko-theme .blko-account-order-row{grid-template-columns:1fr auto;gap:.35rem 1rem}
.blko-theme .blko-account-order-row span:nth-child(2){grid-column:1}
.blko-theme .blko-account-order-row span:nth-child(3){grid-column:2;grid-row:1}
.blko-theme .blko-account-order-row span:last-child{grid-column:2;grid-row:2}}
.blko-theme .blko-cart-checkout-order-summary .blko-cart-checkout-line-item>strong{grid-column:2;text-align:right}
.blko-theme .blko-cart-checkout-drawer-preview .blko-cart-checkout-line-item>strong{grid-column:2;text-align:right}
.blko-theme.blko-theme .blko-footer strong{text-transform:var(--kit-label-transform)}
{% endstylesheet %}
{% schema %}
{
  "name": "Account order row",
  "settings": [
