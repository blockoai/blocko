{%- comment -%} Generated by Blocko from tools/themes/blush/groups/blush-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-blush-duo">{% for block in section.blocks %}<a class="blko-blush-duo__tile" href="{{ block.settings.url | default: '#makeup' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250, 500, 750, 1000', alt: block.settings.label }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span class="blko-blush-duo__chip">{{ block.settings.label | escape }}</span></a>{% endfor %}</section></div>
{% stylesheet %}
:where(.blko-theme){--kit-radius-image:0;--text-body:1rem;--color-text:CanvasText;--color-bg:Canvas;--color-border:ButtonFace;--color-accent:GrayText;--font-body:"DM Sans",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-body:1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme .blko-blush-duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:0 16px clamp(3rem,7vw,6rem)}
.blko-theme .blko-blush-duo__tile{position:relative;display:block;overflow:hidden}
.blko-theme .blko-blush-duo__tile img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
.blko-theme .blko-blush-duo__chip{position:absolute;left:50%;bottom:1.5rem;transform:translateX(-50%);padding:.55rem 1.4rem;background:var(--color-bg);color:var(--color-text);font-size:var(--text-body);white-space:nowrap}
.blko-theme .blko-blush-shades>img{display:block;width:100%;height:100%;min-height:420px;object-fit:cover}
.blko-theme .blko-blush-ugc__photo img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
@media(max-width:760px){.blko-theme .blko-blush-duo{grid-template-columns:1fr}
.blko-theme .blko-blush-shades>img{min-height:0;aspect-ratio:4/5;height:auto}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
{% endstylesheet %}
