{%- comment -%} Generated by Blocko from tools/themes/blush/groups/blush-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-blush-shades">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250, 500, 750, 1000', alt: section.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div class="blko-blush-shades__card"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><div class="blko-blush-shades__chips" role="group" aria-label="{{ section.settings.chips_label | escape }}">{% for block in section.blocks %}<button class="blko-blush-shades__chip" type="button" aria-label="{{ block.settings.label | escape }}"{% if block.settings.selected %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %} style="--chip:var(--color-swatch-{{ block.settings.tone | escape }})" {{ block.shopify_attributes }}></button>{% endfor %}</div><a class="blko-button" href="{{ section.settings.button_url | default: '#shades' }}">{{ section.settings.button_label | escape }}</a></div></section></div>
