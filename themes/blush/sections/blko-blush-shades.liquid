{% schema %}
{
  "name": "Shade picker",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Soft pink cheek colour on bare skin"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your colour"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a pink that looks like you."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Five buildable shades, one easy formula. Tap a chip to preview the tone, then add it to your bag."
    },
    {
      "type": "text",
      "id": "chips_label",
      "label": "Chips label",
      "default": "Shades"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop shades"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Shade",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Petal"
        },
        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Shade",
          "options": [
            {
              "value": "petal",
              "label": "Petal"
            },
            {
              "value": "honey",
              "label": "Honey"
            },
            {
              "value": "coral",
              "label": "Coral"
            },
            {
              "value": "rose",
              "label": "Rose"
            },
            {
              "value": "orchid",
              "label": "Orchid"
            }
          ],
          "default": "petal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shade picker",
      "blocks": [
        {
          "type": "chip",
          "settings": {
            "selected": true
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Honey",
            "tone": "honey"
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Coral",
            "tone": "coral"
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Rose",
            "tone": "rose"
          }
        },
        {
          "type": "chip",
          "settings": {
            "label": "Orchid",
            "tone": "orchid"
          }
        }
      ]
    }
  ]
}
{% endschema %}
