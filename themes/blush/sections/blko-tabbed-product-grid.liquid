{% schema %}
{
  "name": "Tabbed product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Most added to bag"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "shop bestsellers"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Tab key",
          "default": "best"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bestsellers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed product grid",
      "blocks": [
        {
          "type": "tab",
          "settings": {}
        },
        {
          "type": "tab",
          "settings": {
            "key": "new",
            "label": "Just dropped"
          }
        }
      ]
    }
  ]
}
{% endschema %}
