    "brand-logo-usage": {
      "type": "blko-brand-logo-usage",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "do",
          "settings": {
            "text": "Use the primary wordmark on light surfaces and the inverse on dark ones."
          }
        },
        "block-2": {
          "type": "do",
          "settings": {
            "text": "Keep the leaf and glide in the accent colour or in the text colour, never a third colour."
          }
        },
        "block-3": {
          "type": "do",
          "settings": {
            "text": "Use the round leaf mark for favicons, seals and packaging lids."
          }
        },
        "block-4": {
          "type": "dont",
          "settings": {
            "text": "Do not stretch, rotate or outline the wordmark."
          }
        },
        "block-5": {
          "type": "dont",
          "settings": {
            "text": "Do not move the leaf or straighten the glide."
          }
        },
        "block-6": {
          "type": "dont",
          "settings": {
            "text": "Do not set the logo on a busy pattern or low-contrast photograph."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6"
      ]
    },
    "brand-voice": {
      "type": "blko-brand-voice",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "principle",
          "settings": {
            "title": "Plain-spoken luxury",
            "text": "Refined, never precious. Say what it is and how it feels, in few words."
          }
        },
        "block-2": {
          "type": "principle",
          "settings": {
            "title": "Ingredients first",
            "text": "Lead with the botanical, the oil, the origin. Proof comes from the formula, not from volume."
          }
        },
        "block-3": {
          "type": "principle",
          "settings": {
            "title": "Unhurried and tactile",
            "text": "Write about touch, scent and ritual. Let sentences breathe and end on a full stop."
          }
        },
        "block-4": {
          "type": "write",
          "settings": {
            "text": "Cold-pressed oils and organic shea in a cream that melts on contact."
          }
        },
        "block-5": {
          "type": "write",
          "settings": {
            "text": "Warm between your fingers, then press into skin."
          }
        },
        "block-6": {
          "type": "write",
          "settings": {
            "text": "Made slowly in small batches."
          }
        },
        "block-7": {
          "type": "avoid",
          "settings": {
            "text": "Revolutionary anti-ageing breakthrough!"
          }
        },
        "block-8": {
          "type": "avoid",
          "settings": {
            "text": "Erase wrinkles overnight"
          }
        },
        "block-9": {
          "type": "avoid",
          "settings": {
            "text": "Chemical-free miracle formula"
          }
        }
      },
      "block_order": [
