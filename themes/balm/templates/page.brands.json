    "brand-imagery": {
      "type": "blko-brand-imagery",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "direction",
          "settings": {
            "title": "Studio softness",
            "text": "Diffuse light, gentle shadow, skin that keeps its texture and a healthy glow."
          }
        },
        "block-2": {
          "type": "direction",
          "settings": {
            "title": "Botanical and tactile",
            "text": "Close crops of cream, oil and leaf. Warm neutrals, stone and glass."
          }
        },
        "block-3": {
          "type": "direction",
          "settings": {
            "title": "Calm confidence",
            "text": "Unposed portraits with a relaxed gaze. Space around the subject."
          }
        }
      },
