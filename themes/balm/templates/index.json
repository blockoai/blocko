    "balm-ritual-steps": {
      "type": "blko-balm-ritual-steps",
      "settings": {
        "eyebrow": "Place it in three zones",
        "heading": "Define, warm, light",
        "button_label": "Shop the three sticks"
      },
      "blocks": {
        "block-1": {
          "type": "step",
          "settings": {
            "title": "Define",
            "text": "Draw the bronzer stick under the cheekbone and along the jaw for shadow and depth."
          }
        },
        "block-2": {
          "type": "step",
          "settings": {
            "title": "Warm",
            "text": "Tap the blush stick onto the apples and sweep it toward the temple for a lifted flush."
          }
        },
        "block-3": {
          "type": "step",
          "settings": {
            "title": "Light",
            "text": "Dot the highlighter stick on brow bone, cheekbone and the bridge of the nose, then press in."
          }
        }
      },
