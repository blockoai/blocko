.blko-theme .blko-search-blog-tabs button[aria-selected=true]{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-tag-filter .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
