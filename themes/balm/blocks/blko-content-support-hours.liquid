{%- comment -%} Generated by Blocko from tools/themes/balm/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-content><dl class="blko-content-support-hours"><div><dt>{{ block.settings.label_1 | escape }}</dt><dd>{{ block.settings.value_1 | escape }}</dd></div><div><dt>{{ block.settings.label_2 | escape }}</dt><dd>{{ block.settings.value_2 | escape }}</dd></div></dl></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-text-muted:CanvasText;--color-border:ButtonFace;--color-text:CanvasText;--color-swatch-blush:ButtonFace;--color-paper:var(--color-bg);--color-bg:Canvas;--color-ink:var(--color-text);--text-small:.75rem;--color-footer-bg:CanvasText;--font-display:var(--font-heading);--font-heading:"Playfair Display",Georgia,serif;--leading-display:.9;--text-display:2.5rem;--weight-medium:500;--color-button-text:Canvas;--color-overlay:rgb(0 0 0 / .4);--color-line:var(--color-border);--font-body:"Inter",Helvetica Neue,Arial,sans-serif}
@media (min-width:1024px){:where(.blko-theme){--text-display:5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-support-hours{margin:0}
.blko-theme .blko-content-support-hours>div{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--color-line)}
.blko-theme .blko-content-support-hours dd{margin:0}
.blko-theme .blko-content-landing-hero>div{max-width:44rem;padding:clamp(3rem,9vw,9rem) 5vw}
.blko-theme .blko-content-support-hours{max-width:32rem}
.blko-theme .blko-content-support-hours>div{grid-template-columns:1fr 1fr}
@media (max-width:760px){.blko-theme .blko-content-about-hero>div{padding:4rem 5vw}
.blko-theme .blko-content-landing-hero>div{padding-inline:5vw}
.blko-theme .blko-content-support-hours>div{grid-template-columns:1fr}}
.blko-theme .blko-hero>div{position:relative;z-index:1;max-width:650px;padding:clamp(2rem,8vw,8rem) 5vw;margin-left:auto;text-align:center;text-shadow:0 1px 14px var(--color-overlay)}
.blko-theme .blko-split>div{display:grid;align-content:center;padding:clamp(2rem,8vw,7rem)}
.blko-theme .blko-product-detail>div{display:grid;align-content:center;padding:clamp(2rem,8vw,7rem)}
.blko-theme .blko-press-section>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;max-width:860px;margin:auto;width:100%}
@media(max-width:760px){.blko-theme .blko-hero>div{margin:0}
.blko-theme .blko-press-section>div{gap:.45rem}}
.blko-theme .blko-global-password-art div{position:absolute;inset:1.25rem;border:1px solid var(--color-bg);display:grid;place-items:center;color:var(--color-button-text);font:var(--weight-medium) var(--text-display)/var(--leading-display) var(--font-display)}
.blko-theme .blko-home-collection-filter-drawer>div{display:grid;align-content:start;gap:1rem;height:100%}
.blko-theme .blko-home-collection-promo-tile div{position:relative;display:grid;align-content:end;min-height:100%;padding:1.4rem;background:linear-gradient(transparent,color-mix(in srgb, var(--color-footer-bg) 60%, transparent))}
.blko-theme .blko-home-collection-quick-view__content>div{padding:clamp(2rem,5vw,4rem)}
.blko-theme .blko-pdp-shades>div{display:flex;gap:.7rem;flex-wrap:wrap}
.blko-theme .blko-pdp-review>div{display:flex;justify-content:space-between;font-size:var(--text-small)}
.blko-theme .blko-search-blog-empty>div{text-align:center;max-width:780px;margin:auto}
.blko-theme .blko-search-blog-empty>div{padding:clamp(3rem,10vw,9rem) 5vw;text-align:left}
.blko-theme .blko-search-blog-journal-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-article-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-featured-post>div{padding:clamp(2rem,6vw,6rem);background:var(--color-ink);color:var(--color-paper)}
.blko-theme .blko-search-blog-inline-products>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
@media(max-width:760px){.blko-theme .blko-search-blog-inline-products>div{grid-template-columns:1fr}}
.blko-theme .blko-balm-claim>div{position:relative;grid-column:1 / span 6;background:var(--color-swatch-blush);color:var(--color-text);padding:clamp(1.75rem,4vw,3.5rem);border:1px solid var(--color-border)}
.blko-theme .blko-balm-claim dd{margin:.35rem 0 0;font-size:.75rem;text-transform:uppercase;letter-spacing:.14em;color:var(--color-text-muted)}
.blko-theme .blko-balm-quiz-card div{position:absolute;z-index:1;left:1.25rem;right:1.25rem;bottom:1.25rem}
@media(max-width:860px){.blko-theme .blko-balm-claim>div{margin:-3rem 5vw 3rem;padding:1.75rem}}
{% endstylesheet %}
