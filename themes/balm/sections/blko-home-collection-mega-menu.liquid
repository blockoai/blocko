{% schema %}
{
  "name": "Editorial mega menu",
  "settings": [
    {
      "type": "text",
      "id": "trigger_href",
      "label": "Header link URL that opens this menu",
      "default": "#shop"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Begin with the three steps."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Menu link",
      "limit": 8,
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Skincare"
        }
      ]
    },
    {
      "type": "tile",
      "name": "Image tile",
      "limit": 4,
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Skincare ritual"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Skincare"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial mega menu",
      "blocks": [
        {
          "type": "link",
          "settings": {}
        },
        {
          "type": "link",
          "settings": {
            "label": "Eyes",
            "url": "#eyes"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Cheeks",
            "url": "#lips"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "Sculpt",
            "url": "#care"
          }
        },
        {
          "type": "tile",
          "settings": {}
        },
        {
          "type": "tile",
          "settings": {
            "url": "#care",
            "image_alt": "Sculpt ritual",
            "label": "Sculpt"
          }
        }
      ]
    }
  ]
}
{% endschema %}
