{%- comment -%} Generated by Blocko from tools/themes/balm/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-contact-map"><div class="blko-content-map-art" role="img" aria-label="{{ section.settings.map_label | escape }}"><span class="blko-content-map-pin" aria-hidden="true"></span><span class="blko-content-map-road blko-content-map-road-a" aria-hidden="true"></span><span class="blko-content-map-road blko-content-map-road-b" aria-hidden="true"></span></div><div><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><p>{{ section.settings.city | escape }}<br>{{ section.settings.country | escape }}</p><a class="blko-content-text-link" href="{{ section.settings.link | default: '#directions' }}">{{ section.settings.link_label | escape }}</a></div></section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--leading-display:.9;--text-h2:2rem;--weight-light:300;--color-border:ButtonFace;--text-title:2rem;--text-display:2.5rem;--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:1.5rem;--weight-medium:500;--tracking-h2:-.08rem;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--color-text-muted:CanvasText;--color-bg:Canvas;--color-sale:GrayText;--color-bg-alt:Canvas;--color-accent:GrayText;--tracking-label:.075rem;--font-sans:var(--font-body);--leading-label:1.5;--text-label:.75rem;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--text-title:2.5rem;--text-display:5rem;--text-card-title:2rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-kicker{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none;margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-content-text-link{display:inline-block;border-bottom:1px solid;padding-bottom:.15rem;text-underline-offset:.2em}
.blko-theme .blko-content-contact-map{display:grid;grid-template-columns:1.1fr .9fr;background:var(--color-border)}
.blko-theme .blko-content-contact-map>div:last-child{padding:clamp(3rem,8vw,8rem);align-self:center}
.blko-theme .blko-content-contact-map h2{margin:.25rem 0 1rem}
.blko-theme .blko-content-map-art{position:relative;min-height:32rem;overflow:hidden;background:linear-gradient(125deg,var(--color-accent) 0 36%,var(--color-accent) 36% 53%,var(--color-accent) 53%)}
.blko-theme .blko-content-map-art::before{content:"";position:absolute;inset:auto -5% 18% -5%;height:4rem;background:var(--color-bg-alt);transform:rotate(-16deg);box-shadow:0 6rem 0 var(--color-border),0 12rem 0 var(--color-bg-alt)}
.blko-theme .blko-content-map-art::after{content:"";position:absolute;inset:auto -5% 18% -5%;height:4rem;background:var(--color-bg-alt);transform:rotate(-16deg);box-shadow:0 6rem 0 var(--color-border),0 12rem 0 var(--color-bg-alt)}
.blko-theme .blko-content-map-art::after{inset:18% -5% auto -5%;transform:rotate(23deg);box-shadow:0 7rem 0 var(--color-border)}
.blko-theme .blko-content-map-pin{position:absolute;z-index:1;top:46%;left:48%;width:2rem;height:2rem;background:var(--color-sale);border:4px solid var(--color-bg);border-radius:50%;box-shadow:0 0 0 1px var(--color-text-muted)}
.blko-theme .blko-content-policy-document h2{font-size:var(--text-h2);margin:.1rem 0 1rem}
@media (max-width:760px){.blko-theme .blko-content-contact-map{grid-template-columns:1fr}
.blko-theme .blko-content-map-art{min-height:23rem}}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-global-page h2{margin:.35rem 0 1rem}
.blko-theme .blko-global-components h2{margin:.35rem 0 1rem}
.blko-theme .blko-global-region-notice h2{font-size:var(--text-h2)}
.blko-theme .blko-global-region-notice>div:last-child{display:flex;gap:1rem;align-items:center}
@media(max-width:760px){.blko-theme .blko-global-region-notice>div:last-child{align-items:stretch;flex-direction:column}}
.blko-theme .blko-home-collection-mega-menu h2{margin:.35rem 0 1.5rem;font-size:var(--text-title)}
.blko-theme .blko-home-collection-filter-drawer h2{margin:0}
.blko-theme .blko-home-collection-promo-tile h2{font-size:var(--text-h2);margin:.4rem 0}
.blko-theme .blko-home-collection-quick-view__content h2{margin:.3rem 0 1.5rem;font-size:var(--text-title)}
.blko-theme .blko-pdp-before-after h2{margin:.4rem 0 1rem}
.blko-theme .blko-pdp-reviews h2{font:var(--weight-medium) var(--text-display)/var(--leading-display) var(--font-display);margin:.5rem 0}
.blko-theme .blko-pdp-bundle-item h2{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);margin:.3rem 0}
.blko-theme .blko-search-blog-featured-post h2{font-size:var(--text-display)}
.blko-theme .blko-search-blog-reading h2{font-size:var(--text-title);margin-top:3rem}
.blko-theme .blko-content-map-road{background:var(--color-border)}
.blko-theme .blko-content-map-road-a{background:var(--color-border)}
.blko-theme .blko-content-map-road-b{background:var(--color-border)}
.blko-theme .blko-balm-steps h2{margin:.4rem 0 2rem;max-width:14ch}
.blko-theme .blko-balm-claim h2{margin:.4rem 0 1.5rem;font-size:clamp(1.75rem,3.4vw,2.75rem);line-height:1.15}
.blko-theme .blko-balm-quiz h2{margin:.4rem auto 2.5rem;max-width:20ch}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme.blko-theme .blko-product-card>div{padding:.9rem 1rem 1.1rem}
{% endstylesheet %}
