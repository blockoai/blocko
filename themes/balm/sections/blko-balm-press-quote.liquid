{%- comment -%} Generated by Blocko from tools/themes/balm/groups/balm-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-balm-press">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '225, 450, 675, 900', alt: section.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><blockquote>{{ section.settings.quote | escape }}</blockquote><cite>{{ section.settings.source | escape }}</cite></div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--kit-radius-image:0;--color-accent:GrayText;--font-display:var(--font-heading);--color-bg-alt:Canvas;--tracking-title:-.08rem;--leading-body:1.5;--text-title:2rem;--weight-light:300;--tracking-label:.075rem;--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--color-border:ButtonFace;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--tracking-title:-.1rem;--text-title:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme blockquote{margin:1rem 0;font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading);letter-spacing:var(--tracking-title)}
.blko-theme .blko-balm-press{padding:clamp(3rem,7vw,6rem) 5vw;display:grid;grid-template-columns:1fr 1.4fr;gap:clamp(2rem,5vw,5rem);align-items:center;background:var(--color-bg-alt)}
.blko-theme .blko-balm-press img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.blko-theme .blko-balm-press blockquote{margin:0;font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.25}
.blko-theme .blko-balm-press cite{display:block;margin-top:1.25rem;font-style:normal;font-size:.75rem;letter-spacing:.2em;text-transform:uppercase;color:var(--color-accent)}
@media(max-width:860px){.blko-theme .blko-balm-press{grid-template-columns:1fr}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme blockquote{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
{% endstylesheet %}
