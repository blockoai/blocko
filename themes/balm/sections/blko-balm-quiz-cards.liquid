{%- comment -%} Generated by Blocko from tools/themes/balm/groups/balm-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-balm-quiz"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="blko-balm-quiz-grid">{% for block in section.blocks %}<a class="blko-balm-quiz-card" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3>{{ block.settings.title | escape }}</h3><span>{{ block.settings.cta | escape }}</span></div></a>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--color-button:CanvasText;--color-bg:Canvas;--color-button-text:Canvas;--tracking-label:.075rem;--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:2rem;--color-border:ButtonFace;--color-accent:GrayText;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem;--text-h2:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-balm-quiz{padding:clamp(3rem,8vw,7rem) 5vw;text-align:center}
.blko-theme .blko-balm-quiz h2{margin:.4rem auto 2.5rem;max-width:20ch}
.blko-theme .blko-balm-quiz-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;text-align:left}
.blko-theme .blko-balm-quiz-card{position:relative;display:block;aspect-ratio:3/4.4;overflow:hidden;color:var(--color-button-text);text-decoration:none}
.blko-theme .blko-balm-quiz-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.blko-theme .blko-balm-quiz-card:after{content:"";position:absolute;inset:0;background:linear-gradient(to top,color-mix(in srgb,var(--color-button) 65%,transparent),transparent 55%)}
.blko-theme .blko-balm-quiz-card div{position:absolute;z-index:1;left:1.25rem;right:1.25rem;bottom:1.25rem}
.blko-theme .blko-balm-quiz-card h3{margin:0 0 .8rem;font-size:clamp(1.3rem,2.2vw,1.75rem);color:var(--color-button-text)}
.blko-theme .blko-balm-quiz-card span{display:inline-block;background:var(--color-bg);color:var(--color-button);padding:.8rem 1.2rem;font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
.blko-theme .blko-balm-press img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
@media(max-width:860px){.blko-theme .blko-balm-claim>img{position:static;height:340px}
.blko-theme .blko-balm-quiz-grid{grid-template-columns:1fr}
.blko-theme .blko-balm-quiz-card{aspect-ratio:4/5}}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
