{%- comment -%} Generated by Blocko from tools/themes/bare/groups/bare-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-bare-looks"><div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-bare-looks-grid">{% for block in section.blocks %}<a class="blko-bare-look" href="{{ block.settings.url | default: '#shop' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span>{{ block.settings.title | escape }} <b>{{ block.settings.cta | escape }}</b></span></a>{% endfor %}</div></section></div>
