{%- comment -%} Generated by Blocko from tools/themes/bare/groups/bare-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-bare-founder blko-{{ section.settings.color_scheme.id | escape }}"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><blockquote>{{ section.settings.quote | escape }}</blockquote><p class="blko-bare-founder-name">{{ section.settings.name | escape }} <span>{{ section.settings.role | escape }}</span></p></section></div>
{% stylesheet %}
:where(.blko-theme){--font-accent:"DM Mono",ui-monospace,Menlo,monospace;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Cormorant Garamond",Georgia,serif;--color-bg:Canvas;--color-text-muted:CanvasText;--text-label:.75rem;--color-text:CanvasText;--tracking-title:-.08rem;--leading-body:1.5;--text-title:2rem;--weight-light:300;--tracking-label:.075rem;--leading-label:1.5;--weight-medium:500;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--tracking-title:-.1rem;--text-title:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme blockquote{margin:1rem 0;font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading);letter-spacing:var(--tracking-title)}
.blko-theme .blko-bare-founder{background:var(--color-bg);color:var(--color-text)}
.blko-theme .blko-bare-founder{padding:clamp(3.5rem,8vw,7rem) 5vw;text-align:center}
.blko-theme .blko-bare-founder blockquote{max-width:26ch;margin:1rem auto 1.75rem;font-family:var(--font-heading);font-size:clamp(1.9rem,4.2vw,3.4rem);line-height:1.15;font-weight:400;letter-spacing:-.01em}
.blko-theme .blko-bare-founder-name{margin:0;font-family:var(--font-accent);font-size:var(--text-label);letter-spacing:.14em;text-transform:uppercase}
.blko-theme .blko-bare-founder-name span{display:block;margin-top:.35rem;color:var(--color-text-muted)}
.blko-theme .blko-bare-look span{position:absolute;inset:auto .75rem .75rem .75rem;display:flex;flex-direction:column;gap:.5rem;padding:.9rem 1rem;background:var(--color-bg);font-family:var(--font-heading);font-size:1.35rem;line-height:1}
@media(max-width:760px){.blko-theme .blko-bare-look span{inset:auto .4rem .4rem .4rem;padding:.6rem .7rem;font-size:1.1rem}}
.blko-theme.blko-theme blockquote{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme .blko-eyebrow{font-family:var(--font-accent);letter-spacing:.14em}
{% endstylesheet %}
