    "collection-about": {
      "type": "blko-collection-about",
      "settings": {
        "image_alt": "Bars of soap stacked in rows by scent family",
        "kicker": "About bar soap",
        "heading": "A proper bar, not a pink rectangle.",
        "text": "Our bars are made in small batches with plant oils, shea butter and real botanicals, then cured until they are hard enough to last. Choose a grit level for your hands, a scent family for your nose and a pack size that fits your shower schedule."
      }
    },
    "collection-faq": {
      "type": "blko-collection-faq",
      "settings": {
        "eyebrow": "Bar soap questions",
        "heading": "Quick answers before you buy"
      },
      "blocks": {
        "block-1": {
          "type": "question",
          "settings": {
            "label": "Can I use a bar on my face?",
            "text": "Zero-grit bars are gentle enough for most faces. Skip the gritty ones above the neck unless you like being sanded."
          }
        },
        "block-2": {
          "type": "question",
          "settings": {
            "label": "Are the bars free of sulfates and parabens?",
            "text": "Yes. The ingredient list stays short, and neither group is in it."
          }
        },
        "block-3": {
          "type": "question",
          "settings": {
            "label": "What do the grit levels mean?",
            "text": "Zero is smooth and creamy. Light has a hint of texture, medium scrubs like a washcloth and heavy is for mechanics and weekend warriors."
          }
        },
        "block-4": {
          "type": "question",
          "settings": {
            "label": "How should I store a bar?",
            "text": "Let it dry between showers on a draining dish or magnetic saver. A dry bar can last more than twice as long as a soggy one."
          }
        },
        "block-5": {
          "type": "question",
          "settings": {
            "label": "Where are the bars made?",
            "text": "Everything is mixed, poured and cut in our own facility, so we can check each batch ourselves."
          }
        }
      },
