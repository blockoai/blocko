    "lather-benefit-trio": {
      "type": "blko-lather-benefit-trio",
      "settings": {
        "eyebrow": "What is in the bar",
        "heading": "Three rules we do not bend"
      },
      "blocks": {
        "block-1": {
          "type": "benefit",
          "settings": {
            "title": "Natural origin",
            "text": "Nearly every ingredient comes from plants and minerals, measured against an international naturalness standard."
          }
        },
        "block-2": {
          "type": "benefit",
          "settings": {
            "icon": "flame",
            "title": "A short no-go list",
            "text": "A dozen ingredients never go in, from aluminum salts to synthetic dyes, and we publish every one."
          }
        },
        "block-3": {
          "type": "benefit",
          "settings": {
            "icon": "peak",
            "title": "Built for guys",
            "text": "Bigger bars, rougher grit, bolder scent and formulas tested on beards, chests and gym-bag hands."
          }
        }
      },
