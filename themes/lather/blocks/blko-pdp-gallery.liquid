{%- comment -%} Generated by Blocko from tools/themes/lather/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-pdp><div class="blko-pdp-gallery" data-pdp-gallery><div class="blko-pdp-gallery__thumbs">{% for image in product.images limit: 2 %}<button type="button" data-pdp-thumb data-src="{{ image | image_url: width: 1000 | escape }}">{% if image != blank %}{{ image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '200', alt: '' }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</button>{% endfor %}</div><figure class="blko-pdp-gallery__stage" data-pdp-zoom tabindex="0">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250, 500, 750, 1000', alt: product.featured_image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<button type="button" class="blko-pdp-gallery__zoom" data-pdp-zoom-trigger>{{ 'blko.pdp.zoom' | t }}</button></figure></div></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-radius:8px;--kit-radius-image:12px;--color-footer-text:Canvas;--color-footer-bg:CanvasText;--kit-label-transform:uppercase;--text-label:0.75rem;--color-button-text:Canvas;--color-ink:var(--color-text);--color-text:CanvasText;--color-bg:Canvas;--color-line:var(--color-border);--color-border:ButtonFace;--text-small:.75rem;--color-paper:var(--color-bg);--tracking-label:.075rem;--font-mono:var(--font-accent);--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--weight-medium:500;--color-bg-alt:Canvas;--color-accent:GrayText;--font-body:"Figtree",Arial,sans-serif}
@media (min-width:1024px){:where(.blko-theme){--text-label:0.8125rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-pdp-gallery{display:grid;grid-template-columns:76px 1fr;gap:1rem;min-width:0}
.blko-theme .blko-pdp-gallery__thumbs{display:grid;align-content:start;gap:.7rem}
.blko-theme .blko-pdp-gallery__thumbs button{padding:0;border:1px solid transparent;background:color-mix(in srgb, var(--color-bg) 0%, transparent);aspect-ratio:1;cursor:pointer}
.blko-theme .blko-pdp-gallery__thumbs button.is-active{border-color:var(--color-ink)}
.blko-theme .blko-pdp-gallery__thumbs img{width:100%;height:100%;object-fit:cover}
.blko-theme .blko-pdp-gallery__stage{position:relative;overflow:hidden;margin:0;background:var(--color-bg-alt);aspect-ratio:.8}
.blko-theme .blko-pdp-gallery__stage>img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.blko-theme .blko-pdp-gallery__zoom{position:absolute;color:var(--color-text);right:1rem;bottom:1rem;border:0;background:var(--color-bg);padding:.65rem .8rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase;cursor:pointer}
.blko-theme .blko-pdp-shades button{width:2.2rem;height:2.2rem;border:3px solid var(--color-paper);border-radius:50%;outline:1px solid transparent;background:var(--pdp-shade);cursor:pointer}
.blko-theme .blko-pdp-size button{color:var(--color-text);border:1px solid var(--color-line);padding:.7rem .8rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
.blko-theme .blko-pdp-size button.is-active{border-color:var(--color-ink);background:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-pdp-plan button{color:var(--color-text);display:grid;grid-template-columns:1fr auto;gap:.25rem;padding:1rem;border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);text-align:left;cursor:pointer}
.blko-theme .blko-pdp-plan button.is-active{border-color:var(--color-ink);box-shadow:inset 3px 0 var(--color-ink)}
.blko-theme .blko-pdp-sticky-buy img{width:44px;height:50px}
.blko-theme .blko-pdp-compare>img{width:100%;height:100%;object-fit:cover}
.blko-theme .blko-pdp-compare__before img{width:100%;height:100%;object-fit:cover}
.blko-theme .blko-pdp-compare__before img{width:auto;max-width:none;aspect-ratio:.9}
.blko-theme .blko-pdp-mini-product img{width:100%;aspect-ratio:.78}
.blko-theme .blko-pdp-review-filters button{color:var(--color-text);border:1px solid var(--color-line);padding:.45rem .6rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);font-size:var(--text-small);cursor:pointer}
.blko-theme .blko-pdp-review-filters button.is-active{background:var(--color-ink);color:var(--color-button-text);border-color:var(--color-ink)}
.blko-theme .blko-pdp-bundle-item img{width:130px;height:150px}
.blko-theme .blko-pdp-bundle-item>button{border:1px solid var(--color-ink);padding:.65rem .9rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
.blko-theme .blko-pdp-bundle-item.is-selected>button{background:var(--color-ink);color:var(--color-button-text)}
@media(max-width:760px){.blko-theme .blko-pdp-gallery{grid-template-columns:1fr}
.blko-theme .blko-pdp-gallery__thumbs{grid-template-columns:repeat(4,1fr);order:2}
.blko-theme .blko-pdp-gallery__stage{aspect-ratio:.86}
.blko-theme .blko-pdp-bundle-item img{width:92px;height:112px}
.blko-theme .blko-pdp-bundle-item>button{grid-column:1/-1}}
.blko-theme .blko-search-blog-tabs button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-tag-filter button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-filters button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-pagination button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-share button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-tabs button[aria-selected=true]{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-filters button{text-align:left}
.blko-theme .blko-search-blog-result img{width:100%;aspect-ratio:1.05;object-fit:cover}
.blko-theme .blko-search-blog-article-card img{width:100%;aspect-ratio:1.05;object-fit:cover}
.blko-theme .blko-search-blog-empty img{width:100%;height:100%;min-height:520px;object-fit:cover}
.blko-theme .blko-search-blog-journal-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-article-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post img{width:100%;height:100%;min-height:520px;object-fit:cover}
@media(max-width:760px){.blko-theme .blko-search-blog-empty img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-journal-hero img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-article-hero img{min-height:0;aspect-ratio:1}}
.blko-theme .blko-lather-tabs button{min-height:2.75rem;padding:.55rem 1.25rem;border:2px solid var(--color-footer-bg);border-radius:999px;background:transparent;color:var(--color-footer-bg);font:inherit;font-size:var(--text-label);font-weight:800;text-transform:var(--kit-label-transform);cursor:pointer}
.blko-theme .blko-lather-tabs button[aria-pressed=true]{background:var(--color-footer-bg);color:var(--color-footer-text)}
.blko-theme .blko-lather-card img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:var(--kit-radius-image);margin-bottom:.5rem}
.blko-theme .blko-lather-trio>*{position:relative}
.blko-theme.blko-theme .blko-tabs button{border-radius:var(--kit-radius)}
.blko-theme.blko-theme .blko-home-collection-filter-chips button{border-radius:var(--kit-radius)}
{% endstylesheet %}
