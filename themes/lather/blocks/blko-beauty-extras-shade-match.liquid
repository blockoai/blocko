    {
      "type": "select",
      "id": "tone",
      "label": "Swatch tone",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "deep",
          "label": "Deep"
        }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your match"
    }
  ],
  "presets": [
    {
      "name": "Scent match"
    }
  ]
}
{% endschema %}
