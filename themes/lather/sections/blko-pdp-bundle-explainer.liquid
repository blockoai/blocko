{%- comment -%} Generated by Blocko from tools/themes/lather/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-pdp><section class="blko-pdp-bundle-explainer"><div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span>{{ block.settings.number | escape }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></li>{% endfor %}</ol></section></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.01em;--kit-label-transform:uppercase;--kit-heading-transform:uppercase;--kit-heading-weight:800;--font-heading:"Archivo",Arial Black,Arial,sans-serif;--text-card-title:1.125rem;--color-button-text:Canvas;--color-accent:GrayText;--kit-radius-card:14px;--color-footer-bg:CanvasText;--font-display:var(--font-heading);--leading-h3:1.5;--text-h4:1.25rem;--weight-medium:500;--text-small:.75rem;--tracking-body:-.02rem;--font-mono:var(--font-accent);--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--text-label:0.75rem;--color-ink:var(--color-text);--color-text:CanvasText;--color-bg-alt:Canvas;--tracking-label:.075rem;--tracking-h3:.0875rem;--text-h3:.875rem;--font-body:"Figtree",Arial,sans-serif;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:1.875rem;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:1.25rem;--text-h4:1.5rem;--tracking-body:-.025rem;--text-label:0.8125rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem;--text-h2:2.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-section-heading{text-align:center;max-width:850px;margin:auto}
.blko-theme .blko-pdp-bundle-explainer{padding:clamp(4rem,9vw,8rem) 5vw;background:var(--color-bg-alt)}
.blko-theme .blko-pdp-bundle-explainer ol{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;max-width:1000px;margin:3rem auto 0;padding:0;list-style:none}
.blko-theme .blko-pdp-bundle-explainer li{border-top:1px solid var(--color-ink);padding-top:1rem}
.blko-theme .blko-pdp-bundle-explainer li>span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono)}
.blko-theme .blko-pdp-bundle-explainer h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);text-transform:none;letter-spacing:var(--tracking-body)}
.blko-theme .blko-pdp-bundle-explainer p{font-size:var(--text-small)}
@media(max-width:760px){.blko-theme .blko-pdp-bundle-explainer{padding:4rem 1.2rem}
.blko-theme .blko-pdp-bundle-explainer ol{grid-template-columns:1fr;gap:1rem;margin-top:2rem}}
.blko-theme .blko-search-blog-result h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-search-blog-article-card h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-lather-trio-grid h3{margin:1rem 0 .5rem;font-family:var(--font-heading);font-weight:800;text-transform:uppercase;color:var(--color-footer-bg);font-size:var(--text-card-title)}
.blko-theme .blko-lather-steps li{padding:1.75rem;border:2px solid var(--color-accent);border-radius:var(--kit-radius-card)}
.blko-theme .blko-lather-steps li>span{display:inline-grid;place-items:center;width:3rem;height:3rem;border-radius:50%;background:var(--color-accent);color:var(--color-button-text);font-family:var(--font-heading);font-weight:800}
.blko-theme .blko-lather-steps h3{margin:1rem 0 .5rem;font-family:var(--font-heading);font-weight:800;text-transform:uppercase;font-size:var(--text-card-title)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme h2{font-variation-settings:"wdth" 125}
.blko-theme h2{overflow-wrap:break-word!important}
.blko-theme h3{overflow-wrap:break-word!important}
{% endstylesheet %}
