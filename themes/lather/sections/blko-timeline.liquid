{%- comment -%} Generated by Blocko from tools/themes/lather/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-timeline"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><strong>{{ block.settings.year | escape }}</strong><span>{{ block.settings.text | escape }}</span></li>{% endfor %}</ol></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.01em;--kit-label-transform:uppercase;--kit-heading-transform:uppercase;--kit-heading-weight:800;--font-heading:"Archivo",Arial Black,Arial,sans-serif;--leading-body:1.5;--color-text:CanvasText;--font-accent:"Figtree",Arial,sans-serif;--font-body:"Figtree",Arial,sans-serif;--weight-light:300;--tracking-label:.075rem;--text-label:0.75rem;--weight-medium:500;--color-bg-alt:Canvas;--kit-radius-button:10px;--color-border:ButtonFace;--kit-radius-card:14px;--color-accent:GrayText;--color-footer-bg:CanvasText;--text-card-title:1.125rem;--color-ink:var(--color-text);--text-small:.75rem;--text-body:1rem;--leading-label:1.5;--tracking-h2:-.08rem;--leading-display:.9;--text-h2:1.875rem;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-label:0.8125rem;--text-card-title:1.25rem;--text-body:1.25rem;--tracking-h2:-.1rem;--text-h2:2.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-timeline strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-press-section strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-timeline{padding:clamp(3rem,8vw,8rem) 5vw}
.blko-theme .blko-press-section strong{display:grid;place-items:center;min-height:4rem;padding:1rem;border:1px solid var(--color-border);font-size:clamp(.72rem,1vw,.9rem)}
.blko-theme .blko-timeline{max-width:1000px;margin:auto}
.blko-theme .blko-timeline li{display:grid;grid-template-columns:120px 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--color-border)}
@media(max-width:760px){.blko-theme .blko-press-section strong{min-height:3.25rem;padding:.5rem;font-size:.6rem}}
.blko-theme .blko-global-code strong{font-size:var(--text-small)}
.blko-theme .blko-pdp-price strong{font-size:var(--text-body)}
.blko-theme .blko-pdp-stat-grid strong{font-size:var(--text-card-title)}
.blko-theme .blko-pdp-mini-product strong{font-size:var(--text-small)}
.blko-theme .blko-pdp-bundle-explainer li{border-top:1px solid var(--color-ink);padding-top:1rem}
.blko-theme .blko-lather-card strong{font-family:var(--font-heading);font-size:var(--text-card-title);font-weight:800;text-transform:uppercase;color:var(--color-footer-bg);line-height:1.1}
.blko-theme .blko-lather-steps li{padding:1.75rem;border:2px solid var(--color-accent);border-radius:var(--kit-radius-card)}
.blko-theme .blko-brand-traits li{padding:.5rem 1rem;border:1px solid var(--color-border);border-radius:var(--kit-radius-button,999px);background:var(--color-bg-alt);font:var(--weight-medium) var(--text-label)/1 var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-type__face--heading strong{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__face--body strong{font-family:var(--font-body)}
.blko-theme .blko-brand-type__face--accent strong{font-family:var(--font-accent)}
.blko-theme .blko-brand-rule strong{color:var(--color-text)}
.blko-theme .blko-brand-do li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme .blko-brand-dont li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme h2{font-variation-settings:"wdth" 125}
.blko-theme h2{overflow-wrap:break-word!important}
{% endstylesheet %}
