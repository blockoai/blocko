{%- comment -%} Generated by Blocko from tools/themes/lather/groups/lather-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-lather-signature><section class="blko-lather-lineup" data-lather-lineup><div class="blko-lather-head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-lather-tabs" role="group" aria-label="Scent families"><button type="button" data-lather-tab="all" aria-pressed="true">{{ section.settings.all_label | escape }}</button>{% for block in section.blocks %}{% if block.type == 'family' %}<button type="button" data-lather-tab="{{ block.settings.label | escape }}" aria-pressed="false" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>{% endif %}{% endfor %}</div><div class="blko-lather-cards">{% for block in section.blocks %}{% if block.type == 'scent' %}<a class="blko-lather-card" href="{{ block.settings.url | default: '#' }}" data-family="{{ block.settings.family | escape }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span class="blko-lather-card-family">{{ block.settings.family | escape }}</span><strong>{{ block.settings.name | escape }}</strong><span class="blko-lather-card-note">{{ block.settings.note | escape }}</span><span class="blko-lather-card-price">{{ block.settings.price | escape }}</span></a>{% endif %}{% endfor %}</div></section></blko-lather-signature></div>
<script type="module" src="{{ 'blko-lather-signature.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.01em;--kit-label-transform:uppercase;--kit-heading-transform:uppercase;--kit-heading-weight:800;--font-heading:"Archivo",Arial Black,Arial,sans-serif;--kit-radius-image:12px;--color-text:CanvasText;--font-accent:"Figtree",Arial,sans-serif;--font-body:"Figtree",Arial,sans-serif;--weight-light:300;--leading-display:.9;--text-h2:1.875rem;--color-accent:GrayText;--color-footer-bg:CanvasText;--text-small:.75rem;--color-text-muted:CanvasText;--text-card-title:1.125rem;--text-badge:.688rem;--color-bg-alt:Canvas;--kit-radius-card:14px;--color-footer-text:Canvas;--text-label:0.75rem;--tracking-label:.075rem;--leading-label:1.5;--weight-medium:500;--tracking-h2:-.08rem;--color-border:ButtonFace;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.25rem;--text-card-title:1.25rem;--text-label:0.8125rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-lather-lineup{padding:clamp(3rem,7vw,6rem) 5vw}
.blko-theme .blko-lather-head{max-width:46rem;margin:0 auto clamp(1.75rem,4vw,3rem);text-align:center}
.blko-theme .blko-lather-head h2{margin:.35rem 0 0;color:var(--color-footer-bg);font-size:var(--text-h2);line-height:1.05}
.blko-theme .blko-lather-head .blko-eyebrow{color:var(--color-accent)}
.blko-theme .blko-lather-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin:0 0 clamp(1.5rem,3vw,2.5rem)}
.blko-theme .blko-lather-tabs button{min-height:2.75rem;padding:.55rem 1.25rem;border:2px solid var(--color-footer-bg);border-radius:999px;background:transparent;color:var(--color-footer-bg);font:inherit;font-size:var(--text-label);font-weight:800;text-transform:var(--kit-label-transform);cursor:pointer}
.blko-theme .blko-lather-tabs button[aria-pressed=true]{background:var(--color-footer-bg);color:var(--color-footer-text)}
.blko-theme .blko-lather-cards{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(15rem,22%);gap:1.25rem;overflow-x:auto;padding-bottom:1rem;scroll-snap-type:x mandatory}
.blko-theme .blko-lather-card{display:grid;align-content:start;gap:.35rem;scroll-snap-align:start;padding:.9rem .9rem 1.2rem;border-radius:var(--kit-radius-card);background:var(--color-bg-alt);color:var(--color-text);text-decoration:none;transition:transform .15s ease}
.blko-theme .blko-lather-card:hover{transform:translateY(-4px)}
.blko-theme .blko-lather-card[hidden]{display:none}
.blko-theme .blko-lather-card img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:var(--kit-radius-image);margin-bottom:.5rem}
.blko-theme .blko-lather-card-family{font-size:var(--text-badge);font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--color-accent)}
.blko-theme .blko-lather-card strong{font-family:var(--font-heading);font-size:var(--text-card-title);font-weight:800;text-transform:uppercase;color:var(--color-footer-bg);line-height:1.1}
.blko-theme .blko-lather-card-note{color:var(--color-text-muted);font-size:var(--text-small)}
.blko-theme .blko-lather-card-price{font-weight:800}
.blko-theme .blko-lather-quiz h2{margin:.3rem 0;color:var(--color-footer-bg);font-size:var(--text-h2)}
.blko-theme .blko-lather-quiz .blko-eyebrow{color:var(--color-accent)}
@media(max-width:900px){.blko-theme .blko-lather-cards{grid-auto-columns:minmax(13rem,70%)}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-type__face--heading strong{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__face--body strong{font-family:var(--font-body)}
.blko-theme .blko-brand-type__face--accent strong{font-family:var(--font-accent)}
.blko-theme .blko-brand-rule strong{color:var(--color-text)}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme h2{font-variation-settings:"wdth" 125}
.blko-theme h2{overflow-wrap:break-word!important}
{% endstylesheet %}
