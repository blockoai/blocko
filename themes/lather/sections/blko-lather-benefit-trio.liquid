{%- comment -%} Generated by Blocko from tools/themes/lather/groups/lather-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-lather-signature><section class="blko-lather-trio"><div class="blko-lather-head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-lather-trio-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span class="blko-lather-icon {% if block.settings.icon == 'leaf' %}blko-lather-icon--leaf{% else %}{% endif %} {% if block.settings.icon == 'drop' %}blko-lather-icon--drop{% else %}{% endif %} {% if block.settings.icon == 'flame' %}blko-lather-icon--flame{% else %}{% endif %} {% if block.settings.icon == 'peak' %}blko-lather-icon--peak{% else %}{% endif %}" aria-hidden="true"></span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></article>{% endfor %}</div></section></blko-lather-signature></div>
<script type="module" src="{{ 'blko-lather-signature.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.01em;--kit-label-transform:uppercase;--kit-heading-transform:uppercase;--kit-heading-weight:800;--font-heading:"Archivo",Arial Black,Arial,sans-serif;--color-accent:GrayText;--text-h2:1.875rem;--color-footer-bg:CanvasText;--text-card-title:1.125rem;--color-text-muted:CanvasText;--kit-shadow:0 6px 0 var(--color-border);--color-border:ButtonFace;--color-bg:Canvas;--kit-radius-card:14px;--color-bg-alt:Canvas;--tracking-label:.075rem;--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--text-label:0.75rem;--weight-medium:500;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--font-body:"Figtree",Arial,sans-serif;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.25rem;--text-card-title:1.25rem;--text-label:0.8125rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-lather-trio{padding:clamp(3rem,7vw,6rem) 5vw}
.blko-theme .blko-lather-head{max-width:46rem;margin:0 auto clamp(1.75rem,4vw,3rem);text-align:center}
.blko-theme .blko-lather-head h2{margin:.35rem 0 0;color:var(--color-footer-bg);font-size:var(--text-h2);line-height:1.05}
.blko-theme .blko-lather-head .blko-eyebrow{color:var(--color-accent)}
.blko-theme .blko-lather-trio{position:relative;background:var(--color-bg-alt)}
.blko-theme .blko-lather-trio::before{content:"";position:absolute;inset:0;background:var(--color-border);opacity:.55;-webkit-mask:url("data:image/svg+xml;base64,") 0 0/240px 240px;mask:url("data:image/svg+xml;base64,") 0 0/240px 240px;pointer-events:none}
.blko-theme .blko-lather-trio>*{position:relative}
.blko-theme .blko-lather-trio-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1rem,2.5vw,2rem);max-width:72rem;margin:0 auto}
.blko-theme .blko-lather-trio-grid article{padding:1.75rem;border-radius:var(--kit-radius-card);background:var(--color-bg);box-shadow:var(--kit-shadow)}
.blko-theme .blko-lather-trio-grid h3{margin:1rem 0 .5rem;font-family:var(--font-heading);font-weight:800;text-transform:uppercase;color:var(--color-footer-bg);font-size:var(--text-card-title)}
.blko-theme .blko-lather-trio-grid p{margin:0;color:var(--color-text-muted)}
.blko-theme .blko-lather-icon{display:block;width:3.5rem;height:3.5rem;background:var(--color-accent);-webkit-mask-size:contain;mask-size:contain;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
.blko-theme .blko-lather-icon--leaf{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.blko-theme .blko-lather-icon--drop{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.blko-theme .blko-lather-icon--flame{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.blko-theme .blko-lather-icon--peak{-webkit-mask-image:url("data:image/svg+xml;base64,");mask-image:url("data:image/svg+xml;base64,")}
.blko-theme .blko-lather-steps h3{margin:1rem 0 .5rem;font-family:var(--font-heading);font-weight:800;text-transform:uppercase;font-size:var(--text-card-title)}
.blko-theme .blko-lather-steps p{margin:0;opacity:.85}
.blko-theme .blko-lather-quiz h2{margin:.3rem 0;color:var(--color-footer-bg);font-size:var(--text-h2)}
.blko-theme .blko-lather-quiz p{margin:0;max-width:42rem}
.blko-theme .blko-lather-quiz .blko-eyebrow{color:var(--color-accent)}
@media(max-width:900px){.blko-theme .blko-lather-trio-grid{grid-template-columns:1fr}}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme h2{font-variation-settings:"wdth" 125}
.blko-theme h2{overflow-wrap:break-word!important}
