{%- comment -%} Generated by Blocko from tools/themes/beauty-01/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-story-timeline"><div class="blko-content-section-intro"><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><time datetime="{{ block.settings.datetime | escape }}">{{ block.settings.label | escape }}</time><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></div></li>{% endfor %}</ol></section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--text-title:2rem;--text-display:2.5rem;--font-display:var(--font-heading);--font-heading:"Cormorant Garamond",Georgia,serif;--leading-h3:1.5;--text-h4:1.25rem;--weight-medium:500;--text-small:.75rem;--tracking-body:-.02rem;--color-ink:var(--color-text);--color-text:#5e5047;--leading-card-title:1.125;--text-card-title:1.5rem;--leading-display:.9;--tracking-label:.075rem;--font-mono:var(--font-accent);--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--text-h2:2rem;--color-text-muted:#756e65;--color-border:#d6d0c7;--tracking-footer:-.0175rem;--leading-footer:1.5;--text-footer:.875rem;--weight-body:400;--tracking-card-title:-.06rem;--weight-light:300;--tracking-h3:.0875rem;--text-h3:.875rem;--tracking-h2:-.08rem;--leading-body:1.5;--text-body:1rem;--font-sans:var(--font-body);--color-line:var(--color-border);--color-paper:var(--color-bg-alt);--color-bg-alt:#f7f4f0}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem;--text-display:5rem;--text-h4:1.5rem;--tracking-body:-.025rem;--text-card-title:2rem;--text-h2:2.5rem;--tracking-card-title:-.08rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem;--text-body:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-kicker{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none;margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-content-section-intro{max-width:43rem}
.blko-theme .blko-content-section-intro h2{margin-top:0}
.blko-theme .blko-content-mission h2{margin:.3rem 0 1.5rem}
.blko-theme .blko-content-story-timeline{padding:clamp(4rem,9vw,9rem) 5vw;max-width:1100px;margin:auto}
.blko-theme .blko-content-story-timeline ol{list-style:none;padding:0;margin:4rem 0 0;border-top:1px solid var(--color-line)}
.blko-theme .blko-content-story-timeline li{display:grid;grid-template-columns:10rem 1fr;gap:2rem;padding:1.8rem 0;border-bottom:1px solid var(--color-line)}
.blko-theme .blko-content-story-timeline time{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label)}
.blko-theme .blko-content-story-timeline h3{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);letter-spacing:var(--tracking-body);margin:0}
.blko-theme .blko-content-story-timeline p{max-width:33rem;margin-bottom:0}
.blko-theme .blko-content-contact-channel-card h3{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);letter-spacing:var(--tracking-body)}
