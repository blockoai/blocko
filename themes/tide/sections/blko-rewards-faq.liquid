{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Rewards questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Points, explained"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "How do I choose a ritual?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Clear, honest product information for everyday rituals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "label": "Do points expire?",
            "text": "Yes. Points expire after three months with no activity, so any order or review resets the clock."
          }
        },
        {
          "type": "question",
          "settings": {
            "label": "Is there a minimum to redeem?",
            "text": "Your cart needs to be at least $30, and you can use up to 1,500 points per order."
          }
        },
        {
          "type": "question",
          "settings": {
            "label": "Can I stack points with a promo code?",
            "text": "No. Points and promo codes cannot be combined on the same order."
          }
        },
        {
          "type": "question",
          "settings": {
            "label": "What happens to points if I return something?",
            "text": "Points earned on the returned item are removed from your balance."
          }
        },
        {
          "type": "question",
          "settings": {
            "label": "How long does my tier last?",
            "text": "Once you reach a tier you keep it for the full year."
          }
        }
      ]
    }
  ]
}
{% endschema %}
