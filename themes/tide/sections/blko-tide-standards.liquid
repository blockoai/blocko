{%- comment -%} Generated by Blocko from tools/themes/tide/groups/tide-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-tide-standards blko-{{ section.settings.color_scheme.id | escape }}"><div class="blko-tide-standards-head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-tide-standards-grid">{% for block in section.blocks %}<article class="blko-tide-standard" {{ block.shopify_attributes }}><span class="blko-tide-standard-badge">{{ block.settings.number | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></article>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:300;--font-heading:"Fraunces",Georgia,serif;--color-text-muted:CanvasText;--leading-card-title:1.125;--text-card-title:1.5rem;--weight-light:300;--tracking-label:.075rem;--font-accent:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--text-small:.75rem;--leading-display:.9;--text-h2:2rem;--color-button-text:Canvas;--color-button:CanvasText;--kit-shadow:0 8px 28px rgb(0 0 0 / .08);--color-bg:Canvas;--kit-radius-card:16px;--color-text:CanvasText;--color-bg-alt:Canvas;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--font-body:"DM Sans",Arial,sans-serif;--tracking-h2:-.08rem;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:2rem;--text-h2:2.25rem;--tracking-h3:.1rem;--text-h3:1.5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-tide-standards{padding:clamp(3rem,7vw,6rem) 5vw;background:var(--color-bg-alt);color:var(--color-text)}
.blko-theme .blko-tide-standards-head{max-width:36rem;margin:0 auto clamp(1.5rem,4vw,3rem);text-align:center}
.blko-theme .blko-tide-standards-head h2{margin:.4rem 0 0}
.blko-theme .blko-tide-standards-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(.75rem,2vw,1.5rem);max-width:1100px;margin:0 auto}
.blko-theme .blko-tide-standard{padding:clamp(1.5rem,3vw,2.5rem);border-radius:var(--kit-radius-card);background:var(--color-bg);box-shadow:var(--kit-shadow)}
.blko-theme .blko-tide-standard-badge{display:grid;place-items:center;width:3rem;height:3rem;margin-bottom:1.25rem;border-radius:50%;background:var(--color-button);color:var(--color-button-text);font-family:var(--font-accent);font-size:var(--text-label);letter-spacing:.08em}
.blko-theme .blko-tide-standard h3{margin:0 0 .5rem}
.blko-theme .blko-tide-standard p{margin:0;color:var(--color-text-muted)}
.blko-theme .blko-tide-ritual-copy h2{margin:.4rem 0 1.5rem;max-width:14ch}
.blko-theme .blko-tide-ritual-steps h3{margin:.2rem 0 .3rem}
.blko-theme .blko-tide-ritual-steps p{margin:0;color:var(--color-text-muted);max-width:42ch}
.blko-theme .blko-tide-botanical-copy h2{margin:.4rem 0 1rem;max-width:16ch}
.blko-theme .blko-tide-botanical-copy p{max-width:48ch;color:var(--color-text-muted)}
.blko-theme .blko-tide-subscribe-head h2{margin:.9rem 0 .75rem}
.blko-theme .blko-tide-subscribe-head p{margin:0;color:var(--color-text-muted)}
.blko-theme .blko-tide-subscribe-step h3{margin:0 0 .4rem}
.blko-theme .blko-tide-subscribe-step p{margin:0;color:var(--color-text-muted)}
.blko-theme .blko-tide-standard h3{font-family:var(--font-heading);font-size:1.35rem;font-weight:400;letter-spacing:0;text-transform:none}
.blko-theme .blko-tide-ritual-steps h3{font-family:var(--font-heading);font-size:1.35rem;font-weight:400;letter-spacing:0;text-transform:none}
.blko-theme .blko-tide-subscribe-step h3{font-family:var(--font-heading);font-size:1.35rem;font-weight:400;letter-spacing:0;text-transform:none}
@media(max-width:760px){.blko-theme .blko-tide-standards-grid{grid-template-columns:1fr}}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-rule p{margin:0;font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-brand-do h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-dont h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-card h3{margin:0 0 .5rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-card-title)/var(--leading-card-title) var(--font-heading)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
