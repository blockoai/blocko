    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Pick a favorite, choose delivery every one to four months and enjoy a lower price on every refill, plus free shipping."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Browse subscription picks"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick your essentials"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Add any product with the subscribe option."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscribe & save",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Choose a product",
            "text": "Look for the subscribe option on any face or body favorite."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "title": "Set your cadence",
            "text": "Every month, every two, three or four months."
          }
        },
        {
          "type": "step",
          "settings": {
