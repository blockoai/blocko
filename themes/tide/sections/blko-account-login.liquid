        </div>
        <div hidden data-account-panel="recover">
          <p class="blko-account-kicker">{{ section.settings.recover_kicker | escape }}</p><h2>{{ section.settings.recover_heading | escape }}</h2><p>{{ section.settings.recover_lede | escape | newline_to_br }}</p>
          {% form 'recover_customer_password' %}<div class="blko-account-fields"><label class="blko-account-field" for="account-recover-email"><span>{{ section.settings.recover_email_label | escape }}</span><input id="account-recover-email" name="email" type="email" autocomplete="email" required></label></div><button class="blko-button" type="submit">{{ section.settings.recover_submit_label | escape }}</button><p class="blko-account-form-message {% if form.errors %}blko-account-form-error{% else %}{% endif %}" aria-live="polite">{% if form.posted_successfully? %}{{ section.settings.recover_success | escape }}{% else %}{% if form.errors %}{{ form.errors | default_errors }}{% else %}{% endif %}{% endif %}</p>{% endform %}
          <button type="button" class="blko-account-text-button" data-account-show="signin">{{ section.settings.return_label | escape }}</button>
        </div>
      </div>
    </section></blko-account></div>
