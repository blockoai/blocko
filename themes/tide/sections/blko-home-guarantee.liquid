{% stylesheet %}
:where(.blko-theme){--kit-label-transform:uppercase;--color-border:ButtonFace;--color-text:CanvasText;--color-bg:Canvas;--tracking-label:.075rem;--font-accent:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--font-body:"DM Sans",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-message-band{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-message-band{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding:.7rem 5vw;text-align:center;background:var(--color-bg);color:var(--color-text);border-block:1px solid var(--color-border)}
@media(max-width:760px){.blko-theme .blko-message-band{gap:.35rem;padding-inline:1rem;font-size:clamp(.55rem,2.1vw,.72rem);line-height:1.25}}
.blko-theme.blko-theme .blko-message-band{text-transform:var(--kit-label-transform)}
