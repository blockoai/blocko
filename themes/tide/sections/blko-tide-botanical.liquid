{%- comment -%} Generated by Blocko from tools/themes/tide/groups/tide-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-tide-botanical blko-{{ section.settings.color_scheme.id | escape }}"><div class="blko-tide-botanical-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250, 500, 750, 1000', alt: section.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</div><div class="blko-tide-botanical-copy"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><ul class="blko-tide-chips">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>{% endfor %}</ul><a class="blko-tide-link" href="{{ section.settings.link_url | default: '#ingredients' }}">{{ section.settings.link_label | escape }}</a></div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:300;--font-heading:"Fraunces",Georgia,serif;--kit-radius-image:16px;--color-text-muted:CanvasText;--text-small:.75rem;--tracking-label:.075rem;--font-accent:"DM Sans",Arial,sans-serif;--text-label:.75rem;--weight-medium:500;--color-bg-alt:Canvas;--kit-radius-button:50px;--color-border:ButtonFace;--leading-display:.9;--text-h2:2rem;--weight-light:300;--color-button:CanvasText;--color-accent:GrayText;--color-text:CanvasText;--kit-radius-card:16px;--leading-label:1.5;--tracking-h2:-.08rem;--font-body:"DM Sans",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.25rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-tide-botanical{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(1.5rem,5vw,5rem);align-items:center;margin:clamp(1rem,3vw,2.5rem) 5vw;padding:clamp(1.25rem,3vw,2.5rem);border-radius:calc(var(--kit-radius-card) * 2);background:var(--color-bg-alt);color:var(--color-text)}
.blko-theme .blko-tide-botanical-media img{display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:var(--kit-radius-image)}
.blko-theme .blko-tide-botanical-copy h2{margin:.4rem 0 1rem;max-width:16ch}
.blko-theme .blko-tide-botanical-copy p{max-width:48ch;color:var(--color-text-muted)}
.blko-theme .blko-tide-chips{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.25rem 0;padding:0;list-style:none}
.blko-theme .blko-tide-chips li{padding:.45rem 1rem;border:1px solid var(--color-accent);border-radius:999px;font-family:var(--font-accent);font-size:var(--text-small);color:var(--color-button)}
.blko-theme .blko-tide-link{color:var(--color-button);font-family:var(--font-accent);font-size:var(--text-label);letter-spacing:.1em;text-transform:uppercase;text-decoration:underline;text-underline-offset:.35em}
.blko-theme .blko-tide-subscribe-head h2{margin:.9rem 0 .75rem}
