.blko-theme .blko-tide-subscribe-step p{margin:0;color:var(--color-text-muted)}
@media(max-width:760px){.blko-theme .blko-tide-botanical{grid-template-columns:1fr}
.blko-theme .blko-tide-ritual-media img{aspect-ratio:1;border-radius:var(--kit-radius-image)}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
