{%- comment -%} Generated by Blocko from tools/themes/tide/groups/beauty-extras.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-beauty-extras><div class="blko-cart-line">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 280 | image_tag: loading: 'lazy', widths: '210, 280', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3>{{ product.title | escape }}</h3><p>{{ block.settings.variant_label | escape }} · {{ product.price | money_without_trailing_zeros }}</p></div></div></blko-beauty-extras></div>
<script type="module" src="{{ 'blko-beauty-extras.js' | asset_url }}"></script>
