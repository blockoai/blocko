{%- comment -%} Generated by Blocko from tools/themes/tide/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-pdp><div class="blko-pdp-sticky-buy blko-is-visible">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', widths: '', alt: '' }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><strong>{{ product.title | escape }}</strong><span>{{ product.selected_or_first_available_variant.option1 | escape }}</span></div><button class="blko-button" type="submit" name="add" form="blko-pdp-sticky-form" data-pdp-add>{{ block.settings.button_label | escape }} · {{ product.price | money_without_trailing_zeros }}</button>{% form 'product', product, id: 'blko-pdp-sticky-form', hidden: '' %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | escape }}">{% endform %}</div></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
