:where(.blko-theme){--color-line:var(--color-border);--color-border:ButtonFace;--font-mono:var(--font-accent);--font-accent:"Barlow Semi Condensed",Arial Narrow,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Fraunces",Georgia,serif;--leading-display:.9;--text-h2:2rem;--weight-light:300;--color-bg:Canvas;--color-text:CanvasText;--color-accent:GrayText;--color-sale:GrayText;--tracking-h2:-.08rem;--font-body:"Assistant",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
