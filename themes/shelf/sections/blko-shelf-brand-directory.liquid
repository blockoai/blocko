{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/shelf.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-shelf-brands" id="brands"><div class="blko-shelf-brands__head"><p class="blko-shelf-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.lede | escape | newline_to_br }}</p></div><ul class="blko-shelf-brands__list">{% for block in section.blocks %}<li class="blko-shelf-brands__item" {{ block.shopify_attributes }}><span class="blko-shelf-brands__letter">{{ block.settings.letter | escape }}</span><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.name | escape }}</a></li>{% endfor %}</ul></section></div>
