{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/beauty-extras.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product
-%}
<div class="blko-theme"><blko-beauty-extras><blko-tabs><section class="blko-beauty-extras-reviews blko-beauty-extras-panel" data-beauty-extras-reviews data-api-base="{{ settings.blocko_api_base | escape }}" data-product-id="{{ product.id | escape }}">
  <div class="blko-beauty-extras-review-summary"><div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1></div><div><strong data-beauty-extras-avg>{{ section.settings.average | escape }}</strong><span aria-label="{{ section.settings.stars_label | escape }}" data-beauty-extras-avg-stars>{% assign blko_rating = section.settings.average | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</span><p data-beauty-extras-count data-template="{{ 'blko.reviews.count_template' | t }}">{{ section.settings.count_text | escape }}</p></div><div class="blko-beauty-extras-rating-bars" data-beauty-extras-bars>{% for block in section.blocks %}{% if block.type == 'bar' %}<p {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><i><b style="width:{{ block.settings.percent | escape }}%"></b></i></p>{% endif %}{% endfor %}</div></div>
  <div class="blko-beauty-extras-filter-row" data-beauty-extras-review-filters>{% for block in section.blocks %}{% if block.type == 'filter' %}<button type="button"{% if block.settings.active %} class="is-active"{% else %}{% endif %} data-filter="{{ block.settings.key | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>{% endif %}{% endfor %}</div>
  <div class="blko-beauty-extras-ugc-grid" data-beauty-extras-ugc>{% for block in section.blocks %}{% if block.type == 'photo' %}<figure data-beauty-extras-review data-tags="{{ block.settings.tags | escape }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '280, 420, 560', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption>{{ block.settings.caption | escape }} <span>{% assign blko_rating = block.settings.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</span></figcaption></figure>{% endif %}{% endfor %}</div>
  <div class="blko-beauty-extras-review-list" data-beauty-extras-review-list>{% for block in section.blocks %}{% if block.type == 'review' %}<article data-beauty-extras-review data-tags="{{ block.settings.tags | escape }}" {{ block.shopify_attributes }}><p>{% assign blko_rating = block.settings.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</p><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.meta | escape }}</p></article>{% endif %}{% endfor %}</div>
</section></blko-tabs></blko-beauty-extras></div>
<script type="module" src="{{ 'blko-tabs.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-beauty-extras.js' | asset_url }}"></script>
