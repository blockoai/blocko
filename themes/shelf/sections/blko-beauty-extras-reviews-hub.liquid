{% endstylesheet %}
{% schema %}
{
  "name": "Reviews hub",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product (optional, store-wide reviews when empty)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shopper reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What 2,000+ shoppers say after using it."
    },
    {
      "type": "text",
      "id": "average",
      "label": "Average",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "stars_label",
      "label": "Stars label",
      "default": "Four and a half out of five stars"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Count text",
      "default": "From 11,874 verified reviews across the shelf"
    }
  ],
  "blocks": [
    {
      "type": "bar",
      "name": "Rating bar",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "5 stars"
        },
        {
          "type": "range",
          "id": "percent",
          "label": "Share of reviews",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 92
        }
      ]
    },
    {
      "type": "filter",
      "name": "Filter",
      "limit": 6,
      "settings": [
        {
          "type": "checkbox",
          "id": "active",
          "label": "Active by default",
          "default": false
        },
        {
          "type": "text",
          "id": "key",
          "label": "Filter key (matches review tags)",
          "default": "all"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All reviews"
        }
      ]
    },
    {
      "type": "photo",
      "name": "Photo review",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (space separated)",
          "default": "complexion photos"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Community beauty routine"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "“My everyday reach-for.”"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (space separated)",
          "default": "complexion"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fresh finish, no fuss."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta",
          "default": "Verified customer · Skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews hub",
      "blocks": [
        {
          "type": "bar",
          "settings": {
            "percent": 66
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "4 stars",
            "percent": 21
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "3 stars",
            "percent": 8
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "2 stars",
            "percent": 3
          }
        },
        {
          "type": "bar",
          "settings": {
            "label": "1 star",
            "percent": 2
          }
        },
        {
          "type": "filter",
          "settings": {
            "active": true
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Skin",
            "key": "skin"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Makeup",
            "key": "makeup"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Hair + body",
            "key": "hair"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "With photos",
            "key": "photos"
          }
        },
        {
          "type": "photo",
          "settings": {
            "tags": "skin photos",
            "image_alt": "Reviewer with calm skin after two weeks",
            "caption": "Two weeks on the barrier serum"
          }
        },
        {
          "type": "photo",
          "settings": {
            "tags": "makeup photos",
            "image_alt": "Reviewer's lip color on a dark stone",
            "caption": "Four lip balm shades",
            "rating": 4
          }
        },
        {
          "type": "photo",
          "settings": {
            "tags": "hair photos",
            "image_alt": "Scalp drops pump beside a leaf",
            "caption": "Scalp drops, month three"
          }
        },
        {
          "type": "review",
          "settings": {
            "tags": "skin",
            "title": "Cleansing balm removed a full face of waterproof makeup",
            "meta": "Melting Cleansing Balm · Verified buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "tags": "makeup",
            "rating": 4,
            "title": "Tint is sheer, so buy a shade lighter",
            "meta": "Skin-Tint Moisturizer · Verified buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "tags": "hair",
            "rating": 3,
            "title": "Scalp drops need patience",
            "meta": "Scalp Density Drops · Verified buyer"
          }
        },
        {
          "type": "review",
          "settings": {
            "tags": "skin",
            "title": "Blemish serum cleared marks in a month",
            "meta": "Clarifying Blemish Serum · Verified buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
