      "default": "Logo and usage"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Square cut lowercase letters stand on a shelf line, and the l carries a small cap so it reads as a bottle. The shelf and cap take the accent; the letters take the text colour."
    },
    {
      "type": "text",
      "id": "primary_name",
      "label": "Primary wordmark name",
      "default": "Primary wordmark"
    },
    {
      "type": "text",
      "id": "primary_note",
      "label": "Primary wordmark note",
      "default": "Default on light surfaces."
    },
    {
      "type": "text",
      "id": "inverse_name",
      "label": "Inverse wordmark name",
      "default": "Inverse wordmark"
    },
    {
      "type": "text",
      "id": "inverse_note",
      "label": "Inverse wordmark note",
      "default": "On dark photography and the footer colour."
    },
    {
      "type": "text",
      "id": "mark_name",
      "label": "Mark name",
      "default": "Mark"
    },
    {
      "type": "text",
      "id": "mark_note",
      "label": "Mark note",
      "default": "Favicon, avatar and small spaces."
    },
    {
      "type": "text",
      "id": "accent_name",
      "label": "Mark on accent name",
      "default": "Mark on accent"
    },
    {
      "type": "text",
      "id": "accent_note",
      "label": "Mark on accent note",
      "default": "Stickers, packaging, social."
    },
    {
      "type": "text",
      "id": "clear_title",
      "label": "Clear title",
      "default": "Clear space"
    },
    {
      "type": "text",
      "id": "clearspace",
      "label": "Clear space rule",
      "default": "Keep a margin equal to the height of the letter h on every side. Nothing, including text and photo edges, enters it."
    },
    {
      "type": "text",
      "id": "min_title",
      "label": "Min title",
      "default": "Minimum size"
    },
    {
      "type": "text",
      "id": "minsize",
      "label": "Minimum size rule",
      "default": "Wordmark: 88 px wide on screen, 22 mm in print. Mark: 24 px, 8 mm. Below that, use the mark alone."
    },
    {
      "type": "text",
      "id": "dl_logo_svg",
      "label": "Wordmark SVG link label",
      "default": "Wordmark SVG"
    },
    {
      "type": "text",
      "id": "dl_logo_png",
      "label": "Wordmark PNG link label",
      "default": "Wordmark PNG"
    },
    {
      "type": "text",
      "id": "dl_logo_webp",
      "label": "Wordmark WebP link label",
      "default": "Wordmark WebP"
    },
    {
      "type": "text",
      "id": "dl_inverse_svg",
      "label": "Inverse SVG link label",
      "default": "Inverse SVG"
    },
    {
      "type": "text",
      "id": "dl_inverse_png",
      "label": "Inverse PNG link label",
      "default": "Inverse PNG"
    },
    {
      "type": "text",
      "id": "dl_mark_svg",
      "label": "Mark SVG link label",
      "default": "Mark SVG"
    },
    {
      "type": "text",
      "id": "dl_mark_png",
      "label": "Mark PNG link label",
      "default": "Mark PNG"
    },
    {
      "type": "text",
      "id": "dl_mark_webp",
      "label": "Mark WebP link label",
      "default": "Mark WebP"
    },
    {
      "type": "text",
      "id": "do_title",
      "label": "Do title",
      "default": "Do"
    },
    {
      "type": "text",
      "id": "dont_title",
      "label": "Dont title",
      "default": "Don't"
    }
  ],
  "blocks": [
    {
      "type": "do",
      "name": "Do",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Keep the clear space."
        }
      ]
    },
    {
      "type": "dont",
      "name": "Don't",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Stretch or recolour the logo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand logo usage",
      "blocks": [
        {
          "type": "do",
          "settings": {
            "text": "Use the primary wordmark on light surfaces and the inverse on dark ones."
          }
        },
        {
          "type": "do",
          "settings": {
            "text": "Keep the shelf line and cap in the accent colour or the text colour, never a third colour."
          }
        },
        {
          "type": "do",
          "settings": {
            "text": "Place the logo on calm areas of a photograph with enough contrast."
          }
        },
        {
          "type": "dont",
          "settings": {
            "text": "Do not stretch, rotate or outline the wordmark."
          }
        },
        {
          "type": "dont",
          "settings": {
            "text": "Do not remove the shelf line or move the cap off the l."
          }
        },
        {
          "type": "dont",
          "settings": {
            "text": "Do not set the logo on a busy pattern or low-contrast photograph."
          }
        }
      ]
    }
  ]
}
{% endschema %}
