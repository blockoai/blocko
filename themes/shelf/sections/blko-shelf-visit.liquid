{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/shelf.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-shelf-visit"><article class="blko-shelf-visit__card">{% if section.settings.store_image != blank %}{{ section.settings.store_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 600, 900, 1200', alt: section.settings.store_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div class="blko-shelf-visit__body"><p class="blko-shelf-eyebrow">{{ section.settings.store_eyebrow | escape }}</p><h2>{{ section.settings.store_heading | escape }}</h2><p>{{ section.settings.store_text | escape | newline_to_br }}</p><a class="blko-button" href="{{ section.settings.store_url | default: '#stores' }}">{{ section.settings.store_label | escape }}</a></div></article><article class="blko-shelf-visit__card">{% if section.settings.service_image != blank %}{{ section.settings.service_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '300, 600, 900, 1200', alt: section.settings.service_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div class="blko-shelf-visit__body"><p class="blko-shelf-eyebrow">{{ section.settings.service_eyebrow | escape }}</p><h2>{{ section.settings.service_heading | escape }}</h2><p>{{ section.settings.service_text | escape | newline_to_br }}</p><a class="blko-button" href="{{ section.settings.service_url | default: '#book' }}">{{ section.settings.service_label | escape }}</a></div></article></section></div>
