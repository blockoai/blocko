    },
    {
      "type": "url",
      "id": "store_url",
      "label": "Store url"
    },
    {
      "type": "text",
      "id": "store_label",
      "label": "Store label",
      "default": "Store finder"
    },
    {
      "type": "image_picker",
      "id": "service_image",
      "label": "Service image"
    },
    {
      "type": "text",
