      "default": "Skin consultation at a mirror"
    },
    {
      "type": "text",
      "id": "service_eyebrow",
      "label": "Service eyebrow",
      "default": "Services"
    },
    {
      "type": "text",
      "id": "service_heading",
      "label": "Service heading",
      "default": "Book a skin consultation"
    },
    {
      "type": "textarea",
      "id": "service_text",
