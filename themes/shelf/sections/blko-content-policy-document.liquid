{% schema %}
{
  "name": "Policy document",
  "settings": [
    {
      "type": "text",
      "id": "toc_label",
      "label": "Toc label",
      "default": "Table of contents"
    },
    {
      "type": "text",
      "id": "toc_heading",
      "label": "Toc heading",
      "default": "In this policy"
    }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Policy section",
      "settings": [
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor id",
          "default": "content-policy-intro"
        },
        {
          "type": "text",
          "id": "toc",
          "label": "Toc",
          "default": "Introduction"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "1. Introduction"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>[Organization name] respects your privacy. This placeholder explains the headings a reviewed privacy policy commonly covers; it is not legal advice and must be replaced with approved copy before publication.</p><p>This policy applies to the website, customer support, and related services identified by your organization.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policy document",
      "blocks": [
        {
          "type": "section",
          "settings": {
            "anchor": "returns-window",
            "toc": "Return window",
            "heading": "1. Return window",
            "body": "<p>Items can be sent back within 30 days of delivery. They must be unused or only lightly tested.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "returns-cost",
            "toc": "Fees",
            "heading": "2. Fees",
            "body": "<p>Returns by mail cost $5, deducted from the refund. Bringing an item to any boutique is free.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "returns-excluded",
            "toc": "Not returnable",
            "heading": "3. Not returnable",
            "body": "<p>Final-sale markdowns, gifts with purchase, gift cards and rewards redeemed with points can't be returned.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "returns-refund",
            "toc": "Refunds",
            "heading": "4. Refunds",
            "body": "<p>Money goes back to the original payment method about two days after the parcel is scanned in. Shipping charges are not refunded.</p>"
          }
        },
        {
          "type": "section",
          "settings": {
            "anchor": "returns-contact",
            "toc": "Need help",
            "heading": "5. Need help",
            "body": "<p>Write to <a href=\"mailto:care@example.com\">care@example.com</a> with your order number.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
