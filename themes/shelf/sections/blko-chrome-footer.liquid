{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-17"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "A multi-brand beauty shop where every product has passed one written ingredient and packaging standard."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer-shop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {}
        },
        {
          "type": "column",
          "settings": {
            "title": "Our standard",
            "menu": "footer-about"
          }
        }
      ]
    }
  ]
}
{% endschema %}
