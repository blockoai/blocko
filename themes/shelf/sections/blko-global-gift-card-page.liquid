{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-global><section class="blko-global-page blko-global-gift"><div class="blko-global-gift-card"><div><p>{{ section.settings.card_label | escape }}</p><h1>{{ section.settings.card_title | escape }}</h1><span>{{ gift_card.balance | money }}</span></div><span aria-hidden="true">✦</span></div><div class="blko-global-gift__details"><p class="blko-global-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><div class="blko-global-code"><span>{{ section.settings.code_label | escape }}</span><strong>{{ gift_card.code | escape }}</strong><button type="button" class="blko-global-link-button" data-global-copy-code data-global-toast="{{ section.settings.copied_message | escape }}">{{ section.settings.copy_label | escape }}</button></div>{% if gift_card.pass_url != blank %}<a class="blko-global-pass" href="{{ gift_card.pass_url | escape }}">{{ section.settings.wallet_label | escape }}</a>{% else %}{% endif %}</div></section></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
