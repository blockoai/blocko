{% schema %}
{
  "name": "Gift card display",
  "settings": [
    {
      "type": "text",
      "id": "card_label",
      "label": "Card label",
      "default": "For any occasion"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "E-gift card"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "From $25 to $300"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let them pick their own favorites."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Use it online, in any boutique or toward a booked service. Send it to yourself, email it with a message, or print it."
    },
    {
      "type": "text",
      "id": "code_label",
      "label": "Code label",
      "default": "Gift card code"
    },
    {
      "type": "text",
      "id": "copied_message",
      "label": "Copied message",
      "default": "Gift card code copied."
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy label",
      "default": "Copy code"
    },
    {
      "type": "text",
      "id": "wallet_label",
      "label": "Wallet label",
      "default": "Add to Apple Wallet"
    }
  ],
  "presets": [
    {
      "name": "Gift card display"
    }
  ]
}
{% endschema %}
