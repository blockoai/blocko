    "brand-logo-usage": {
      "type": "blko-brand-logo-usage",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "do",
          "settings": {
            "text": "Use the primary wordmark on light surfaces and the inverse on dark ones."
          }
        },
        "block-2": {
          "type": "do",
          "settings": {
            "text": "Keep the shelf line and cap in the accent colour or the text colour, never a third colour."
          }
        },
        "block-3": {
          "type": "do",
          "settings": {
            "text": "Place the logo on calm areas of a photograph with enough contrast."
          }
        },
        "block-4": {
          "type": "dont",
          "settings": {
            "text": "Do not stretch, rotate or outline the wordmark."
          }
        },
        "block-5": {
          "type": "dont",
          "settings": {
            "text": "Do not remove the shelf line or move the cap off the l."
          }
        },
        "block-6": {
          "type": "dont",
          "settings": {
            "text": "Do not set the logo on a busy pattern or low-contrast photograph."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6"
      ]
    },
    "brand-voice": {
      "type": "blko-brand-voice",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "principle",
          "settings": {
            "title": "Plain and precise",
            "text": "Say what is in it and what it does. Short words, concrete claims, no jargon without a reason."
          }
        },
        "block-2": {
          "type": "principle",
          "settings": {
            "title": "Fair to every brand",
            "text": "Compare on facts such as ingredients, size and price. Never run another brand down to lift one up."
          }
        },
        "block-3": {
          "type": "principle",
          "settings": {
            "title": "Helpful, not pushy",
            "text": "Offer a clear next step and let the shopper decide. Sales language stays quiet."
          }
        },
        "block-4": {
          "type": "write",
          "settings": {
            "text": "Fragrance-free, vegan and tested on no one. See the full ingredient list."
          }
        },
        "block-5": {
          "type": "write",
          "settings": {
            "text": "Three cleansers for dry skin, side by side."
          }
        },
        "block-6": {
          "type": "write",
          "settings": {
            "text": "Not sure where to start? Take the two-minute quiz."
          }
        },
        "block-7": {
          "type": "avoid",
          "settings": {
            "text": "The only moisturiser you will ever need!!!"
          }
        },
        "block-8": {
          "type": "avoid",
          "settings": {
            "text": "Toxic ingredients are hiding in your bathroom"
          }
        },
        "block-9": {
          "type": "avoid",
          "settings": {
            "text": "Hurry, going fast, buy now"
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6",
        "block-7",
        "block-8",
        "block-9"
      ]
    },
    "brand-imagery": {
      "type": "blko-brand-imagery",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "direction",
          "settings": {
            "title": "Lined up and lit clean",
            "text": "Products in neat rows on pale surfaces, even daylight, labels readable."
          }
        },
        "block-2": {
          "type": "direction",
          "settings": {
            "title": "Variety on show",
            "text": "Many brands, shapes and sizes together so the range feels generous and well chosen."
          }
        },
        "block-3": {
          "type": "direction",
          "settings": {
            "title": "Real people, real routines",
            "text": "Everyday skin and everyday bathrooms, candid and unretouched."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3"
      ]
    }
