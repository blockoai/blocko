{% schema %}
{
  "name": "Campaign landing hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Warm-toned mist and mask on a pastel shelf"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The scent drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A fragrance you can put in your hair."
    },
    {
      "type": "textarea",
