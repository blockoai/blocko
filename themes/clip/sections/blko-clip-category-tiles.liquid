{% schema %}
{
  "name": "Category tiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a department"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "limit": 6,
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Brush, comb and scrunchies on a soft rug"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Claw clips"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "image_alt": "A boxed set with a mini brush and claw clip",
            "label": "Sets + gifts",
            "url": "#sets"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_alt": "Pastel mist bottles lined up on a shelf",
            "label": "Scented mists",
            "url": "#care"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_alt": "Satin and knit hair ties in a stack",
            "label": "Scrunchies + bands",
            "url": "#ties"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_alt": "Brush with a bamboo handle on a rug",
            "label": "Brushes + tools",
            "url": "#tools"
          }
        }
      ]
    }
  ]
}
{% endschema %}
