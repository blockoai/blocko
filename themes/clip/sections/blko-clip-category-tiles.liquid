{%- comment -%} Generated by Blocko from tools/themes/clip/groups/clip.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-clip-tiles"><div class="blko-clip-tiles__head"><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-clip-tiles__grid">{% for block in section.blocks %}<a href="{{ block.settings.url | default: '#brushes' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span>{{ block.settings.label | escape }}</span></a>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--color-line:var(--color-border);--color-border:ButtonFace;--font-mono:var(--font-accent);--font-accent:"Hanken Grotesk",Arial,sans-serif;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--kit-heading-tracking:0.14em;--kit-heading-transform:uppercase;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Arial,sans-serif;--kit-radius-image:0;--text-small:.7rem;--color-bg:Canvas;--color-text:CanvasText;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:1.1875rem;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-accent:GrayText;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-label:.6875rem;--tracking-h2:-.1rem;--text-h2:1.1875rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-clip-tiles{padding:clamp(2.5rem,6vw,5rem) 5vw}
.blko-theme .blko-clip-tiles__head{text-align:center;margin-bottom:clamp(1.5rem,3vw,2.5rem)}
.blko-theme .blko-clip-tiles__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(.5rem,1.4vw,1.25rem)}
.blko-theme .blko-clip-tiles a{position:relative;display:block;color:var(--color-text);text-decoration:none;overflow:hidden}
.blko-theme .blko-clip-tiles img{width:100%;aspect-ratio:3/4.4;object-fit:cover;display:block;transition:transform .5s ease}
.blko-theme .blko-clip-tiles a:hover img{transform:scale(1.03)}
.blko-theme .blko-clip-tiles span{position:absolute;inset:auto 0 0 0;margin:0 .6rem .6rem;padding:.85rem .5rem;background:var(--color-bg);text-align:center;font-size:var(--text-small,.78rem);letter-spacing:.16em;text-transform:uppercase}
.blko-theme .blko-clip-mosaic img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.blko-theme .blko-clip-story img{width:100%;height:100%;min-height:26rem;object-fit:cover;display:block}
@media(max-width:900px){.blko-theme .blko-clip-tiles__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.blko-theme .blko-clip-story img{min-height:18rem;order:-1}
.blko-theme .blko-clip-tiles img{aspect-ratio:3/4}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
