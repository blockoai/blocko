{%- comment -%} Generated by Blocko from tools/themes/clip/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-contact-hero"><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p><a class="blko-content-text-link" href="{{ section.settings.link | default: '#content-contact-form' }}">{{ section.settings.link_label | escape }}</a></section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.14em;--kit-heading-transform:uppercase;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Arial,sans-serif;--text-display:1.75rem;--tracking-display:-.1rem;--tracking-title:-.08rem;--text-title:1.25rem;--tracking-h1:-.08rem;--leading-display:.9;--weight-light:300;--text-h1:1.75rem;--font-body:"Hanken Grotesk",Arial,sans-serif;--text-body:.8625rem;--color-text-muted:CanvasText;--tracking-label:.075rem;--font-sans:var(--font-body);--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-display:2.25rem;--tracking-display:-.2rem;--tracking-title:-.1rem;--text-title:1.5rem;--tracking-h1:-.16rem;--text-h1:2.25rem;--text-body:.8625rem;--text-label:.6875rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-kicker{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none;margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-content-text-link{display:inline-block;border-bottom:1px solid;padding-bottom:.15rem;text-underline-offset:.2em}
.blko-theme .blko-content-contact-hero h1{margin:.25rem 0 1.25rem;font-size:var(--text-display)}
.blko-theme .blko-content-faq-hero h1{margin:.25rem 0 1.25rem;font-size:var(--text-display)}
.blko-theme .blko-content-policy-hero h1{margin:.25rem 0 1.25rem;font-size:var(--text-display)}
.blko-theme .blko-content-contact-hero{padding:clamp(5rem,12vw,12rem) 5vw 5rem;max-width:66rem}
.blko-theme .blko-content-contact-hero>p:not(.blko-content-kicker){max-width:37rem;font-size:var(--text-body)}
.blko-theme .blko-content-faq-hero>p:not(.blko-content-kicker){max-width:37rem;font-size:var(--text-body)}
.blko-theme .blko-content-policy-hero>p:not(.blko-content-kicker){max-width:37rem;font-size:var(--text-body)}
.blko-theme .blko-content-landing-hero h1{font-size:var(--text-display);margin:.3rem 0 1rem}
.blko-theme h1{font-family:var(--font-body);font-size:var(--text-h1);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h1)}
.blko-theme .blko-page-header h1{font-size:var(--text-title);letter-spacing:var(--tracking-title)}
.blko-theme .blko-product-detail h1{font-size:var(--text-title);letter-spacing:var(--tracking-title)}
.blko-theme .blko-not-found h1{font-size:var(--text-title);letter-spacing:var(--tracking-title)}
.blko-theme .blko-hero h1{font-size:var(--text-display);letter-spacing:var(--tracking-display)}
.blko-theme .blko-global-page h1{margin:.35rem 0 1rem}
.blko-theme .blko-global-components h1{margin:.35rem 0 1rem}
.blko-theme .blko-global-gift-card h1{font-size:var(--text-display)}
.blko-theme .blko-home-collection-toolbar__heading h1{margin:.7rem 0}
.blko-theme .blko-pdp-purchase h1{margin:.7rem 0 1rem}
.blko-theme .blko-pdp-bundle__intro h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-page-intro h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-journal-hero h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-article-hero h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-empty h1{margin:.5rem 0 1rem}
.blko-theme.blko-theme h1{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h1{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
