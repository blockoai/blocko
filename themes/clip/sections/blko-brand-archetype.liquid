{%- comment -%} Generated by Blocko from tools/themes/clip/groups/brand.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-brand-section blko-{{ section.settings.color_scheme.id | escape }}"><header class="blko-brand-head"><p class="blko-brand-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></header><div class="blko-brand-archetype"><div><p class="blko-brand-archetype__name">{{ section.settings.primary | escape }}</p><p class="blko-brand-archetype__second">{{ section.settings.secondary_label | escape }} {{ section.settings.secondary | escape }}</p><p class="blko-brand-lede">{{ section.settings.description | escape | newline_to_br }}</p><blockquote class="blko-brand-promise">{{ section.settings.promise | escape }}</blockquote></div><ul class="blko-brand-traits">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.trait | escape }}</li>{% endfor %}</ul></div></section></div>
{% stylesheet %}
:where(.blko-theme){--text-title:1.25rem;--kit-heading-tracking:0.14em;--kit-heading-transform:uppercase;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Arial,sans-serif;--kit-label-transform:uppercase;--tracking-label:.075rem;--font-accent:"Hanken Grotesk",Arial,sans-serif;--text-label:.6875rem;--weight-medium:500;--color-bg-alt:Canvas;--kit-radius-button:0;--color-border:ButtonFace;--leading-body:1.5;--weight-light:300;--color-accent:GrayText;--color-text-muted:CanvasText;--text-display:1.75rem;--leading-display:.9;--text-h2:1.1875rem;--color-text:CanvasText;--color-bg:Canvas;--text-body:.8625rem;--leading-label:1.5;--tracking-title:-.08rem;--tracking-h2:-.08rem;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-title:1.5rem;--text-label:.6875rem;--text-display:2.25rem;--text-h2:1.1875rem;--text-body:.8625rem;--tracking-title:-.1rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme blockquote{margin:1rem 0;font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading);letter-spacing:var(--tracking-title)}
.blko-theme .blko-brand-eyebrow{margin:0;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase);opacity:.75}
.blko-theme .blko-brand-lede{margin:0;max-width:40rem;font-size:var(--text-body);line-height:var(--leading-body)}
.blko-theme .blko-brand-section{padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem);background:var(--color-bg);color:var(--color-text);display:grid;gap:2rem}
.blko-theme .blko-brand-head{display:grid;gap:.6rem;max-width:44rem}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-archetype{display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));align-items:start}
.blko-theme .blko-brand-archetype__name{margin:0 0 .25rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-display)/1.05 var(--font-heading)}
.blko-theme .blko-brand-archetype__second{margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-brand-promise{margin:1.25rem 0 0;padding:0 0 0 1rem;border-left:3px solid var(--color-accent);font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading)}
.blko-theme .blko-brand-traits{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.6rem}
.blko-theme .blko-brand-traits li{padding:.5rem 1rem;border:1px solid var(--color-border);border-radius:var(--kit-radius-button,999px);background:var(--color-bg-alt);font:var(--weight-medium) var(--text-label)/1 var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme blockquote{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme blockquote{text-transform:none;letter-spacing:.02em}
.blko-theme .blko-quote-section blockquote{font-size:var(--text-title);line-height:1.35}
.blko-theme .blko-content-founder-copy blockquote{font-size:var(--text-title);line-height:1.35}
{% endstylesheet %}
