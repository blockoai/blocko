{%- comment -%} Generated by Blocko from tools/themes/clip/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-contact-hours"><div><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><dl>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}</dd></div>{% endfor %}</dl></section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.14em;--kit-heading-transform:uppercase;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Arial,sans-serif;--leading-display:.9;--text-h2:1.1875rem;--weight-light:300;--text-title:1.25rem;--text-display:1.75rem;--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:.75rem;--weight-medium:500;--tracking-h2:-.08rem;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-line:var(--color-border);--color-border:ButtonFace;--color-text-muted:CanvasText;--tracking-label:.075rem;--font-sans:var(--font-body);--leading-label:1.5;--text-label:.6875rem;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:1.1875rem;--text-title:1.5rem;--text-display:2.25rem;--text-card-title:.75rem;--tracking-h2:-.1rem;--text-label:.6875rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-kicker{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none;margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-content-contact-hours{display:grid;grid-template-columns:1fr 1fr;gap:3rem;padding:clamp(4rem,9vw,9rem) 12vw}
.blko-theme .blko-content-contact-hours h2{margin-top:.25rem}
.blko-theme .blko-content-contact-hours dl{margin:0}
.blko-theme .blko-content-contact-hours dl>div{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:1rem 0;border-top:1px solid var(--color-line)}
.blko-theme .blko-content-contact-hours dd{margin:0}
.blko-theme .blko-content-support-hours dd{margin:0}
.blko-theme .blko-content-contact-map h2{margin:.25rem 0 1rem}
.blko-theme .blko-content-policy-document h2{font-size:var(--text-h2);margin:.1rem 0 1rem}
@media (max-width:760px){.blko-theme .blko-content-contact-hours{grid-template-columns:1fr}
.blko-theme .blko-content-contact-hours{padding-inline:5vw}
.blko-theme .blko-content-contact-hours dl>div{grid-template-columns:1fr}}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-global-page h2{margin:.35rem 0 1rem}
.blko-theme .blko-global-components h2{margin:.35rem 0 1rem}
.blko-theme .blko-global-region-notice h2{font-size:var(--text-h2)}
.blko-theme .blko-home-collection-mega-menu h2{margin:.35rem 0 1.5rem;font-size:var(--text-title)}
.blko-theme .blko-home-collection-filter-drawer h2{margin:0}
.blko-theme .blko-home-collection-promo-tile h2{font-size:var(--text-h2);margin:.4rem 0}
.blko-theme .blko-home-collection-quick-view__content h2{margin:.3rem 0 1.5rem;font-size:var(--text-title)}
.blko-theme .blko-pdp-before-after h2{margin:.4rem 0 1rem}
.blko-theme .blko-pdp-reviews h2{font:var(--weight-medium) var(--text-display)/var(--leading-display) var(--font-display);margin:.5rem 0}
.blko-theme .blko-pdp-bundle-item h2{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);margin:.3rem 0}
.blko-theme .blko-search-blog-featured-post h2{font-size:var(--text-display)}
.blko-theme .blko-search-blog-reading h2{font-size:var(--text-title);margin-top:3rem}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
{% schema %}
{
  "name": "Support hours",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Live chat"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "When we are online"
    }
  ],
  "blocks": [
    {
      "type": "hours",
      "name": "Hours",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Monday–Friday"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "9:00 AM–5:00 PM local time"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Support hours",
      "blocks": [
        {
          "type": "hours",
          "settings": {
            "label": "Weekdays",
            "value": "8 AM to 4 PM Pacific"
          }
        },
        {
          "type": "hours",
          "settings": {
            "label": "Weekends",
            "value": "Messages only"
          }
        },
        {
          "type": "hours",
          "settings": {
            "label": "Reply time",
            "value": "Two to three business days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
