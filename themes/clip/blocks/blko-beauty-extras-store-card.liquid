      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Harbor Studio"
    },
    {
      "type": "text",
      "id": "place",
      "label": "Place",
      "default": "New York, NY"
    },
    {
      "type": "text",
      "id": "directions_label",
      "label": "Directions label",
      "default": "Directions"
    },
    {
      "type": "url",
      "id": "directions_url",
      "label": "Directions url"
    }
  ],
  "presets": [
    {
      "name": "Store locator"
    }
  ]
}
{% endschema %}
