{%- comment -%} Generated by Blocko from tools/themes/isle/groups/cart-checkout.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-cart-checkout><blko-cart-drawer><section class="blko-cart-checkout-progress" aria-label="{{ block.settings.progress_label | escape }}" data-cart-checkout-progress data-goal="{{ block.settings.threshold | times: 100 }}"{% assign blko_calc_0 = block.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 %}{% if blko_calc_0 > 0 %} data-unlocked="false"{% else %} data-unlocked="true"{% endif %}><div>{% assign blko_calc_1 = block.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 %}{% if blko_calc_1 > 0 %}<p>{{ block.settings.before | escape }} <strong data-cart-checkout-remaining>{{ block.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 | money_without_trailing_zeros }}</strong> {{ block.settings.after | escape }}</p>{% else %}<p>{{ block.settings.unlocked | escape }}</p>{% endif %}<span aria-hidden="true"><i style="width:{% assign blko_calc_2 = block.settings.threshold | times: 100 %}{{ cart.total_price | times: 100 | divided_by: blko_calc_2 | at_most: 100 }}%"></i></span></div><p class="blko-cart-checkout-progress-label" data-cart-checkout-progress-label>{{ cart.total_price | money_without_trailing_zeros }} <b>{{ block.settings.threshold | times: 100 | money_without_trailing_zeros }}</b></p></section></blko-cart-drawer></blko-cart-checkout></div>
<script type="module" src="{{ 'blko-cart-drawer.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-cart-checkout.js' | asset_url }}"></script>
