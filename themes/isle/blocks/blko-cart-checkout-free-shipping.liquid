{% schema %}
{
  "name": "Free-shipping progress",
  "settings": [
    {
      "type": "range",
      "id": "threshold",
      "label": "Free-shipping threshold",
      "min": 5,
      "max": 500,
      "step": 5,
      "unit": "$",
      "default": 50
    },
    {
      "type": "text",
      "id": "progress_label",
      "label": "Progress label",
      "default": "Shipping progress"
    },
    {
      "type": "text",
      "id": "before",
      "label": "Before",
      "default": "Only"
    },
    {
      "type": "text",
      "id": "after",
      "label": "After",
      "default": "away from complimentary shipping."
    },
    {
      "type": "text",
      "id": "unlocked",
      "label": "Unlocked",
      "default": "You have unlocked complimentary shipping."
    }
  ],
  "presets": [
    {
      "name": "Free-shipping progress"
    }
  ]
}
{% endschema %}
