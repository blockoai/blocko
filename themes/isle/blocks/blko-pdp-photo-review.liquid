{%- comment -%} Generated by Blocko from tools/themes/isle/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-pdp><article class="blko-pdp-review"><div><strong>{% assign blko_rating = block.settings.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</strong><span>{{ block.settings.badge | escape }}</span></div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p><figure>{% if block.settings.photo != blank %}{{ block.settings.photo | image_url: width: 620 | image_tag: loading: 'lazy', widths: '310, 465, 620', alt: block.settings.photo_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption>{{ block.settings.caption | escape }}</figcaption></figure></article></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-text-muted:CanvasText;--font-heading:"Jost",'Trebuchet MS',Arial,sans-serif;--leading-card-title:1.125;--text-card-title:1.125rem;--weight-light:300;--kit-heading-weight:700;--kit-label-transform:uppercase;--tracking-label:.075rem;--font-accent:"Jost",'Trebuchet MS',Arial,sans-serif;--leading-label:1.5;--text-label:.8125rem;--weight-medium:500;--text-small:.75rem;--color-text:CanvasText;--color-bg:Canvas;--font-display:var(--font-heading);--leading-h3:1.5;--text-h4:1.25rem;--tracking-body:-.02rem;--color-line:var(--color-border);--color-border:ButtonFace;--color-accent:GrayText;--tracking-h3:.0875rem;--text-h3:.875rem;--font-body:"Jost",'Trebuchet MS',Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:1.25rem;--text-h4:1.5rem;--tracking-body:-.025rem;--tracking-h3:.1rem;--text-h3:1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-pdp-review>div strong{letter-spacing:var(--tracking-label);color:var(--color-accent)}
.blko-theme .blko-pdp-review{padding:1.5rem 0;border-bottom:1px solid var(--color-line)}
.blko-theme .blko-pdp-review>div{display:flex;justify-content:space-between;font-size:var(--text-small)}
.blko-theme .blko-pdp-review h3{margin:1rem 0 .4rem;font-size:var(--text-small)}
.blko-theme .blko-pdp-review p{max-width:58ch;margin:.4rem 0 1rem}
.blko-theme .blko-pdp-review figure{display:grid;grid-template-columns:120px 1fr;gap:1rem;margin:1rem 0;align-items:end}
.blko-theme .blko-pdp-review figure img{width:120px;height:120px}
.blko-theme .blko-pdp-review figcaption{font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-pdp-bundle-item p{margin:.35rem 0;font-size:var(--text-small)}
.blko-theme .blko-pdp-bundle-explainer h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);text-transform:none;letter-spacing:var(--tracking-body)}
.blko-theme .blko-pdp-bundle-explainer p{font-size:var(--text-small)}
.blko-theme .blko-search-blog-result h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-search-blog-article-card h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-search-blog-inline-products>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
@media(max-width:760px){.blko-theme .blko-search-blog-inline-products>div{grid-template-columns:1fr}}
@keyframes isle-scroll{to{transform:translateX(-50%)}}
.blko-theme .blko-isle-actives p{max-width:34rem;margin:0 0 1.75rem}
.blko-theme .blko-isle-results>div{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:2rem}
.blko-theme .blko-isle-results>p{margin:2.5rem 0 0;font-size:var(--text-small)}
@media (max-width:760px){.blko-theme .blko-isle-results>div{grid-template-columns:1fr}}
.blko-theme .blko-brand-tile figcaption{padding:.9rem 1rem;font-size:var(--text-small);background:var(--color-bg);color:var(--color-text-muted)}
.blko-theme .blko-brand-tile figcaption strong{color:var(--color-text)}
.blko-theme .blko-brand-rule p{margin:0;font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-brand-do h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-dont h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-card h3{margin:0 0 .5rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-card-title)/var(--leading-card-title) var(--font-heading)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
