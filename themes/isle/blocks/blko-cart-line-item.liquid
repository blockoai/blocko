{%- comment -%} Generated by Blocko from tools/themes/isle/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}>{% for line in cart.items limit: 1 %}<div class="blko-cart-line">{% if line.image != blank %}{{ line.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '225, 300', alt: line.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3>{{ line.product.title | escape }}</h3>{% if line.variant.title != blank %}<p>{{ line.variant.title | escape }}</p>{% else %}{% endif %}</div><strong>{{ line.final_line_price | money_without_trailing_zeros }}</strong></div>{% endfor %}</div>
{% stylesheet %}
:where(.blko-theme){--font-heading:"Jost",'Trebuchet MS',Arial,sans-serif;--font-display:var(--font-heading);--leading-h3:1.5;--text-h4:1.25rem;--weight-medium:500;--tracking-body:-.02rem;--text-small:.75rem;--text-card-title:1.125rem;--text-body:.9375rem;--color-border:ButtonFace;--tracking-label:.075rem;--font-accent:"Jost",'Trebuchet MS',Arial,sans-serif;--leading-label:1.5;--text-label:.8125rem;--tracking-price:-.02rem;--font-body:"Jost",'Trebuchet MS',Arial,sans-serif;--leading-body:1.5;--text-price:1rem;--weight-bold:700;--tracking-card-title:-.06rem;--leading-card-title:1.125;--weight-light:300;--tracking-h3:.0875rem;--text-h3:.875rem;--color-accent:GrayText;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h4:1.5rem;--tracking-body:-.025rem;--text-card-title:1.25rem;--text-body:1rem;--tracking-card-title:-.08rem;--tracking-h3:.1rem;--text-h3:1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-cart-line h3{font-size:var(--text-card-title);font-weight:var(--weight-light);line-height:var(--leading-card-title);letter-spacing:var(--tracking-card-title);text-transform:none}
.blko-theme .blko-ingredient h3{font-size:var(--text-card-title);font-weight:var(--weight-light);line-height:var(--leading-card-title);letter-spacing:var(--tracking-card-title);text-transform:none}
.blko-theme .blko-cart-line>strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-cart-summary strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-footer strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-timeline strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-press-section strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-cart-line{display:flex;align-items:center;gap:1rem}
.blko-theme .blko-press-section strong{display:grid;place-items:center;min-height:4rem;padding:1rem;border:1px solid var(--color-border);font-size:clamp(.72rem,1vw,.9rem)}
.blko-theme .blko-cart-line{display:grid;grid-template-columns:90px 1fr auto;padding:1rem 0;border-block:1px solid var(--color-border)}
.blko-theme .blko-cart-line img{width:90px;height:110px}
.blko-theme .blko-notice img{width:110px;height:130px}
.blko-theme .blko-ingredient img{width:100%;max-width:400px;aspect-ratio:1}
