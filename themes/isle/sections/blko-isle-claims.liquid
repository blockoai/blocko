{%- comment -%} Generated by Blocko from tools/themes/isle/groups/isle-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-isle-claims"><h2>{{ section.settings.heading | escape }}</h2><ul>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><i aria-hidden="true"></i><span>{{ block.settings.label | escape }}</span></li>{% endfor %}</ul></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-.01em;--kit-heading-transform:none;--kit-heading-weight:700;--font-heading:"Jost",'Trebuchet MS',Arial,sans-serif;--leading-body:1.5;--leading-display:.9;--text-h2:2rem;--weight-light:300;--text-body:.9375rem;--color-text:CanvasText;--tracking-h2:-.08rem;--font-body:"Jost",'Trebuchet MS',Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--text-body:1rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
@keyframes isle-scroll{to{transform:translateX(-50%)}}
.blko-theme .blko-isle-claims{padding:clamp(3rem,7vw,5.5rem) 5vw;text-align:center}
.blko-theme .blko-isle-claims h2{max-width:34rem;margin:0 auto 2.5rem}
.blko-theme .blko-isle-claims ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:2rem 3.5rem}
.blko-theme .blko-isle-claims li{display:grid;justify-items:center;gap:.75rem;min-width:5.5rem}
.blko-theme .blko-isle-claims i{width:3.5rem;height:3.5rem;background:var(--color-text);-webkit-mask:var(--isle-icon) center/contain no-repeat;mask:var(--isle-icon) center/contain no-repeat}
.blko-theme .blko-isle-claims li span{font-size:var(--text-body);font-weight:500}
.blko-theme .blko-isle-claims li:nth-child(1) i{--isle-icon:url("data:image/svg+xml;base64,")}
.blko-theme .blko-isle-claims li:nth-child(2) i{--isle-icon:url("data:image/svg+xml;base64,")}
.blko-theme .blko-isle-claims li:nth-child(3) i{--isle-icon:url("data:image/svg+xml;base64,")}
.blko-theme .blko-isle-claims li:nth-child(4) i{--isle-icon:url("data:image/svg+xml;base64,")}
.blko-theme .blko-isle-claims li:nth-child(5) i{--isle-icon:url("data:image/svg+xml;base64,")}
.blko-theme .blko-isle-claims li:nth-child(n+6) i{--isle-icon:url("data:image/svg+xml;base64,")}
.blko-theme .blko-isle-actives h2{margin:0 0 1rem;text-align:left}
.blko-theme .blko-isle-results h2{margin:0 0 2rem}
@media (max-width:760px){.blko-theme .blko-isle-claims ul{gap:1.5rem 1.75rem}}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-do ul{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
.blko-theme .blko-brand-dont ul{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
.blko-theme .blko-brand-do li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme .blko-brand-dont li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
