{% schema %}
{
  "name": "Subscription manager",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Subscribed product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your replenishment"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to keep up."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Adjust your next shipment whenever your ritual changes."
    },
    {
      "type": "text",
      "id": "shipment_eyebrow",
      "label": "Shipment eyebrow",
      "default": "Next shipment"
    },
    {
      "type": "text",
      "id": "shipment_heading",
      "label": "Shipment heading",
      "default": "Arrives around the 18th"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt",
      "default": "Sun lotion product"
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant label",
      "default": "Sandalwood"
    },
    {
      "type": "text",
      "id": "shipment_note",
      "label": "Shipment note",
      "default": "Ships to your saved address."
    },
    {
      "type": "text",
      "id": "frequency_eyebrow",
      "label": "Frequency eyebrow",
      "default": "Delivery every"
    },
    {
      "type": "text",
      "id": "frequency_copy",
      "label": "Frequency copy",
      "default": "Currently every 4 weeks."
    },
    {
      "type": "text",
      "id": "skip_label",
      "label": "Skip label",
      "default": "Skip this shipment"
    },
    {
      "type": "text",
      "id": "swap_label",
      "label": "Swap label",
      "default": "Swap product"
    }
  ],
  "blocks": [
    {
      "type": "frequency",
      "name": "Frequency",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "4 weeks"
        },
        {
          "type": "checkbox",
          "id": "selected",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscription manager",
      "blocks": [
        {
          "type": "frequency",
          "settings": {
            "selected": true
          }
        },
        {
          "type": "frequency",
          "settings": {
            "label": "6 weeks"
          }
        },
        {
          "type": "frequency",
          "settings": {
            "label": "8 weeks"
          }
        }
      ]
    }
  ]
}
{% endschema %}
