{%- comment -%} Generated by Blocko from tools/themes/isle/groups/isle-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-isle-results"><h2>{{ section.settings.heading | escape }}</h2><div>{% for block in section.blocks %}<article {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span></article>{% endfor %}</div><p>{{ section.settings.note | escape }}</p></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-.01em;--kit-heading-transform:none;--kit-heading-weight:700;--font-heading:"Jost",'Trebuchet MS',Arial,sans-serif;--color-text-muted:CanvasText;--text-small:.75rem;--font-accent:"Jost",'Trebuchet MS',Arial,sans-serif;--font-body:"Jost",'Trebuchet MS',Arial,sans-serif;--weight-light:300;--leading-display:.9;--text-h2:2rem;--color-text:CanvasText;--color-accent:GrayText;--tracking-h2:-.08rem;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
@keyframes isle-scroll{to{transform:translateX(-50%)}}
.blko-theme .blko-isle-results{padding:clamp(3rem,7vw,5.5rem) 5vw;text-align:center;background:var(--color-accent);color:var(--color-text)}
.blko-theme .blko-isle-results h2{margin:0 0 2rem}
.blko-theme .blko-isle-results>div{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.blko-theme .blko-isle-results article{display:grid;gap:.25rem;justify-items:center}
.blko-theme .blko-isle-results strong{font:700 clamp(3rem,8vw,5.5rem)/1 var(--font-heading)}
.blko-theme .blko-isle-results article span{max-width:14rem}
.blko-theme .blko-isle-results>p{margin:2.5rem 0 0;font-size:var(--text-small)}
@media (max-width:760px){.blko-theme .blko-isle-results>div{grid-template-columns:1fr}}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-type__face--heading strong{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__face--body strong{font-family:var(--font-body)}
.blko-theme .blko-brand-type__face--accent strong{font-family:var(--font-accent)}
.blko-theme .blko-brand-rule p{margin:0;font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme .blko-search-blog-comment p{margin:.25rem 0}
.blko-theme .blko-search-blog-comment p{margin:.25rem 0}
.blko-theme .blko-search-blog-comment p{margin:.25rem 0}
