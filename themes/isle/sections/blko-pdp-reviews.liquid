{%- comment -%} Generated by Blocko from tools/themes/isle/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product
-%}
<div class="blko-theme"><blko-pdp><section class="blko-pdp-reviews" id="pdp-reviews" data-pdp-reviews data-pdp-api="{{ settings.blocko_api_base | escape }}" data-pdp-product-id="{{ product.id | escape }}"><div class="blko-pdp-reviews__summary"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.average | escape }} <span>{{ section.settings.stars | escape }}</span></h2><p>{{ section.settings.summary | escape }}</p><div class="blko-pdp-rating-bars" aria-label="{{ 'blko.pdp.rating_breakdown' | t }}">{% for block in section.blocks %}{% if block.type == 'bar' %}<p {{ block.shopify_attributes }}><span>{{ block.settings.label | escape }}</span><i style="--pdp-rating:{{ block.settings.percent | escape }}%"></i><b>{{ block.settings.percent | escape }}%</b></p>{% endif %}{% endfor %}</div></div><div class="blko-pdp-reviews__list"><div class="blko-pdp-review-toolbar"><strong>{{ section.settings.list_heading | escape }}</strong><div class="blko-pdp-review-filters" data-pdp-review-filters>{% for block in section.blocks %}{% if block.type == 'filter' %}<button{% if forloop.index0 == 0 %} class="is-active"{% else %}{% endif %} type="button" data-pdp-review-filter="{{ block.settings.key | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>{% endif %}{% endfor %}</div></div><div data-pdp-review-items>{% for block in section.blocks %}{% if block.type == 'review' %}<article class="blko-pdp-review" data-pdp-review data-tags="{{ block.settings.tags | escape }}" {{ block.shopify_attributes }}><div><strong>{% assign blko_rating = block.settings.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %}</strong><span>{{ block.settings.badge | escape }}</span></div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p>{% if block.settings.photo != blank %}<figure>{% if block.settings.photo != blank %}{{ block.settings.photo | image_url: width: 620 | image_tag: loading: 'lazy', widths: '310, 465, 620', alt: 'Customer makeup result' }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption>{{ block.settings.caption | escape }}</figcaption></figure>{% else %}{% endif %}<footer>{{ block.settings.footer | escape }}</footer></article>{% endif %}{% endfor %}</div><p class="blko-pdp-no-reviews" data-pdp-no-reviews hidden>{{ section.settings.empty | escape }}</p></div></section></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
