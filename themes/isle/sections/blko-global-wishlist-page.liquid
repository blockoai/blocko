{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Your saved items"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keep an eye on these."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Save products you want to return to later."
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove label",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "empty_kicker",
      "label": "Empty kicker",
      "default": "Nothing saved yet"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty heading",
      "default": "Start with what catches your eye."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Browse products"
    }
  ],
  "presets": [
    {
      "name": "Wishlist"
    }
  ]
}
{% endschema %}
