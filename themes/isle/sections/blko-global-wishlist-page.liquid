{%- comment -%} Generated by Blocko from tools/themes/isle/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection | default: collection
-%}
<div class="blko-theme"><blko-global><section class="blko-global-page blko-global-wishlist" data-global-wishlist data-global-wishlist-api="{{ settings.blocko_api_base | escape }}"><div class="blko-global-page__intro"><p class="blko-global-kicker">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p></div><div class="blko-global-wishlist__grid" data-global-wishlist-grid>{% for product in collection.products limit: 3 %}<div class="blko-global-saved-item"><article class="blko-product-card">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ product.vendor | escape }}</p><h3><a class="blko-product-link" href="{{ product.url | escape }}">{{ product.title | escape }}</a></h3>{% if product.metafields.reviews.rating.value.rating != blank %}<p>{% assign blko_rating = product.metafields.reviews.rating.value.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %} <span>{{ product.metafields.reviews.rating.value.rating | escape }} ({{ product.metafields.reviews.rating_count | escape }})</span></p>{% else %}{% endif %}<strong class="blko-price">{{ product.price | money_without_trailing_zeros }}</strong></div></article><button class="blko-global-link-button" type="button" data-global-wishlist-remove aria-label="Remove saved item {{ forloop.index }}">{{ section.settings.remove_label | escape }}</button></div>{% endfor %}</div><div class="blko-global-empty-state" data-global-wishlist-empty hidden><p class="blko-global-kicker">{{ section.settings.empty_kicker | escape }}</p><h2>{{ section.settings.empty_heading | escape }}</h2><a class="blko-button" href="{{ routes.all_products_collection_url | escape }}">{{ section.settings.button_label | escape }}</a></div></section></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
