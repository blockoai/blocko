ape }}</span><input id="account-address-postal-{{ address.id | escape }}" name="address[zip]" type="text" autocomplete="postal-code" required value="{{ address.zip | escape }}"></label></div><div class="blko-account-fields"><label class="blko-account-field" for="account-address-country-{{ address.id | escape }}"><span>{{ section.settings.country_label | escape }}</span><input id="account-address-country-{{ address.id | escape }}" name="address[country]" type="text" autocomplete="country-name" required value="{{ address.country | escape }}"></label></div><button class="blko-button" type="submit">{{ section.settings.save_label | escape }}</button><p class="blko-account-form-message {% if form.errors %}blko-account-form-error{% else %}{% endif %}" aria-live="polite">{% if form.errors %}{{ form.errors | default_errors }}{% else %}{% endif %}</p>{% endform %}</div></section>{% endfor %}<p class="blko-account-form-message" aria-live="polite" data-account-address-message></p></section></blko-account></div>
