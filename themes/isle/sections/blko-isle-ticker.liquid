{%- comment -%} Generated by Blocko from tools/themes/isle/groups/isle-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-isle-ticker" aria-label="{{ section.settings.label | escape }}"><div class="blko-isle-ticker-track">{% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--color-accent:GrayText;--color-text:CanvasText;--font-heading:"Jost",'Trebuchet MS',Arial,sans-serif;--weight-bold:700;--color-bg:Canvas;--kit-border:1px;--font-body:"Jost",'Trebuchet MS',Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-isle-ticker{overflow:hidden;border-block:var(--kit-border) solid var(--color-text);background:var(--color-bg);padding:.9rem 0}
.blko-theme .blko-isle-ticker-track{display:flex;gap:3rem;width:max-content;animation:isle-scroll 36s linear infinite}
.blko-theme .blko-isle-ticker-track span{font:var(--weight-bold,700) 1.25rem/1.2 var(--font-heading);white-space:nowrap;color:var(--color-text)}
.blko-theme .blko-isle-ticker-track span+span::before{content:"";display:inline-block;width:.5rem;height:.5rem;margin-right:3rem;background:var(--color-accent);border-radius:50%;vertical-align:middle}
@keyframes isle-scroll{to{transform:translateX(-50%)}}
@media (prefers-reduced-motion:reduce){.blko-theme .blko-isle-ticker-track{animation:none;flex-wrap:wrap;width:auto;justify-content:center}}
{% endstylesheet %}
