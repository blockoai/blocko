{% schema %}
{
  "name": "Campaign routine",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Application guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Spray, smooth, repeat"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Cream texture"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Step one"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Start with sets"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Give skin a little hydration after every rinse."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign routine",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "image_alt": "Shaking the mist bottle",
            "title": "Shake it",
            "text": "A few firm shakes mix the shimmer into the formula."
          }
        },
        {
          "type": "step",
          "settings": {
            "image_alt": "Spraying the mist onto an arm",
            "label": "Step two",
            "title": "Spray until it glistens",
            "text": "Hold six inches away and coat each area evenly; a sheen means enough product."
          }
        },
        {
          "type": "step",
          "settings": {
            "image_alt": "Smoothing mist over a shoulder",
            "label": "Step three",
            "title": "Smooth and set a timer",
            "text": "Spread it with your palm, avoid the face, and reapply when two hours pass."
          }
        }
      ]
    }
  ]
}
{% endschema %}
