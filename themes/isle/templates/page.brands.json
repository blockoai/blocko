    "brand-logo-usage": {
      "type": "blko-brand-logo-usage",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "do",
          "settings": {
            "text": "Use the primary wordmark on light surfaces and the inverse on dark ones."
          }
        },
        "block-2": {
          "type": "do",
          "settings": {
            "text": "Keep the sun and wave in the accent colour or the text colour, never a third colour."
          }
        },
        "block-3": {
          "type": "do",
          "settings": {
            "text": "Place the logo over calm areas of a photograph with enough contrast."
          }
        },
        "block-4": {
          "type": "dont",
          "settings": {
            "text": "Do not stretch, rotate or outline the wordmark."
          }
        },
        "block-5": {
          "type": "dont",
          "settings": {
            "text": "Do not move the sun away from the i or straighten the wave."
          }
        },
        "block-6": {
          "type": "dont",
          "settings": {
            "text": "Do not set the logo on a busy pattern or a low-contrast photograph."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6"
      ]
    },
    "brand-voice": {
      "type": "blko-brand-voice",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "principle",
          "settings": {
            "title": "Bright and upbeat",
            "text": "Short, energetic lines with room for a holiday pun. One exclamation mark is plenty."
          }
        },
        "block-2": {
          "type": "principle",
          "settings": {
            "title": "Sensory first",
            "text": "Lead with scent, texture and warmth: coconut, mango, sun-warm skin. Facts follow close behind."
          }
        },
        "block-3": {
          "type": "principle",
          "settings": {
            "title": "Easygoing, never silly",
            "text": "Wink at the reader, then be clear about what the product does and how to use it."
          }
        },
        "block-4": {
          "type": "write",
          "settings": {
            "text": "Coconut body wash that smells like a day off."
          }
        },
        "block-5": {
          "type": "write",
          "settings": {
            "text": "Pack your shower for paradise. Lather, rinse, repeat."
          }
        },
        "block-6": {
          "type": "write",
          "settings": {
            "text": "Soft, sun-ready skin from the first use."
          }
        },
        "block-7": {
          "type": "avoid",
          "settings": {
            "text": "WARNING: skin emergency, buy now!!!"
          }
        },
        "block-8": {
          "type": "avoid",
          "settings": {
            "text": "Clinically engineered anti-dryness system"
          }
        },
        "block-9": {
          "type": "avoid",
          "settings": {
            "text": "Escape your boring, dull life"
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3",
        "block-4",
        "block-5",
        "block-6",
        "block-7",
        "block-8",
        "block-9"
      ]
    },
    "brand-imagery": {
      "type": "blko-brand-imagery",
      "settings": {},
      "blocks": {
        "block-1": {
          "type": "direction",
          "settings": {
            "title": "Full sun",
            "text": "Bright, direct daylight with crisp shadows. Colours stay saturated: aqua, teal and warm sand."
          }
        },
        "block-2": {
          "type": "direction",
          "settings": {
            "title": "Skin and splash",
            "text": "Close, tactile moments: water, lather, bare shoulders. Products appear in use as well as on a shelf."
          }
        },
        "block-3": {
          "type": "direction",
          "settings": {
            "title": "Relaxed people",
            "text": "Candid, smiling and unposed, caught mid-holiday rather than looking at the lens."
          }
        }
      },
      "block_order": [
        "block-1",
        "block-2",
        "block-3"
      ]
    }
