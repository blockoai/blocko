{% schema %}
{
  "name": "Build-your-routine bundle",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add label",
      "default": "Add 3 items to bag"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build your set"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make your everyday routine."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Choose any three essentials and save 15%. Your set, your pace, your skin."
    },
    {
      "type": "text",
      "id": "summary_eyebrow",
      "label": "Summary eyebrow",
      "default": "Your set"
    },
    {
      "type": "text",
      "id": "summary_empty",
      "label": "Summary empty",
      "default": "Choose 3 items to unlock your set"
    },
    {
      "type": "text",
      "id": "saving_text",
      "label": "Saving text",
      "default": "Save 15% when your three picks are ready."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "Bundle price"
    }
  ],
  "presets": [
    {
      "name": "Build-your-routine bundle"
    }
  ]
}
{% endschema %}
