{%- comment -%} Generated by Blocko from tools/themes/tide/groups/brand.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-brand-section blko-{{ section.settings.color_scheme.id | escape }}"><header class="blko-brand-head"><p class="blko-brand-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p class="blko-brand-lede">{{ section.settings.lede | escape | newline_to_br }}</p></header><div class="blko-brand-type__faces"><div class="blko-brand-type__face blko-brand-type__face--heading"><span class="blko-brand-type__aa" aria-hidden="true">Aa</span><p class="blko-brand-eyebrow">{{ section.settings.heading_label | escape }}</p><strong>{{ section.settings.heading_font | escape }}</strong><p class="blko-brand-type__glyphs">{{ section.settings.heading_glyphs | escape }}</p></div><div class="blko-brand-type__face blko-brand-type__face--body"><span class="blko-brand-type__aa" aria-hidden="true">Aa</span><p class="blko-brand-eyebrow">{{ section.settings.body_label | escape }}</p><strong>{{ section.settings.body_font | escape }}</strong><p class="blko-brand-type__glyphs">{{ section.settings.body_glyphs | escape }}</p></div></div><div class="blko-brand-type__scale"><div class="blko-brand-type__row"><span class="blko-brand-type__meta">{{ section.settings.name_display | escape }} <code>--text-display</code></span><p class="blko-brand-type__sample blko-brand-type__sample--display blko-brand-type__family--heading">{{ section.settings.sample_display | escape }}</p></div><div class="blko-brand-type__row"><span class="blko-brand-type__meta">{{ section.settings.name_h1 | escape }} <code>--text-h1</code></span><p class="blko-brand-type__sample blko-brand-type__sample--h1 blko-brand-type__family--heading">{{ section.settings.sample_h1 | escape }}</p></div><div class="blko-brand-type__row"><span class="blko-brand-type__meta">{{ section.settings.name_h2 | escape }} <code>--text-h2</code></span><p class="blko-brand-type__sample blko-brand-type__sample--h2 blko-brand-type__family--heading">{{ section.settings.sample_h2 | escape }}</p></div><div class="blko-brand-type__row"><span class="blko-brand-type__meta">{{ section.settings.name_h3 | escape }} <code>--text-h3</code></span><p class="blko-brand-type__sample blko-brand-type__sample--h3 blko-brand-type__family--heading">{{ section.settings.sample_h3 | escape }}</p></div><div class="blko-brand-type__row"><span class="blko-brand-type__meta">{{ section.settings.name_body | escape }} <code>--text-body</code></span><p class="blko-brand-type__sample blko-brand-type__sample--body blko-brand-type__family--body">{{ section.settings.sample_body | escape }}</p></div><div class="blko-brand-type__row"><span class="blko-brand-type__meta">{{ section.settings.name_label | escape }} <code>--text-label</code></span><p class="blko-brand-type__sample blko-brand-type__sample--label blko-brand-type__family--accent">{{ section.settings.sample_label | escape }}</p></div></div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-heading-transform:none;--kit-heading-weight:300;--font-heading:"Fraunces",Georgia,serif;--text-label:.75rem;--leading-body:1.5;--text-body:1rem;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--tracking-h2:-.08rem;--leading-display:.9;--text-h2:2rem;--tracking-h1:-.08rem;--text-h1:2.5rem;--tracking-display:-.1rem;--text-display:2.75rem;--kit-label-transform:uppercase;--tracking-label:.075rem;--font-accent:"DM Sans",Arial,sans-serif;--font-body:"DM Sans",Arial,sans-serif;--weight-light:300;--color-text-muted:CanvasText;--font-mono:var(--font-accent);--text-small:.75rem;--weight-body:400;--color-border:ButtonFace;--kit-radius-card:16px;--color-bg-alt:Canvas;--color-text:CanvasText;--color-bg:Canvas;--leading-label:1.5;--weight-medium:500;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-body:1.25rem;--tracking-h3:.1rem;--text-h3:1.5rem;--tracking-h2:-.1rem;--text-h2:2.25rem;--tracking-h1:-.16rem;--text-h1:3.25rem;--tracking-display:-.2rem;--text-display:4rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-brand-eyebrow{margin:0;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase);opacity:.75}
.blko-theme .blko-brand-lede{margin:0;max-width:40rem;font-size:var(--text-body);line-height:var(--leading-body)}
.blko-theme .blko-brand-section{padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem);background:var(--color-bg);color:var(--color-text);display:grid;gap:2rem}
.blko-theme .blko-brand-head{display:grid;gap:.6rem;max-width:44rem}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-type__faces{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr))}
.blko-theme .blko-brand-type__face{display:grid;gap:.4rem;padding:1.5rem;border:1px solid var(--color-border);background:var(--color-bg-alt);border-radius:var(--kit-radius-card,0)}
.blko-theme .blko-brand-type__aa{font-size:clamp(3.5rem,8vw,6rem);line-height:1}
.blko-theme .blko-brand-type__face--heading .blko-brand-type__aa{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__face--heading strong{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__face--body .blko-brand-type__aa{font-family:var(--font-body)}
.blko-theme .blko-brand-type__face--body strong{font-family:var(--font-body)}
.blko-theme .blko-brand-type__face--accent .blko-brand-type__aa{font-family:var(--font-accent)}
.blko-theme .blko-brand-type__face--accent strong{font-family:var(--font-accent)}
.blko-theme .blko-brand-type__glyphs{margin:0;font-size:var(--text-small);color:var(--color-text-muted);overflow-wrap:anywhere}
.blko-theme .blko-brand-type__scale{display:grid}
.blko-theme .blko-brand-type__row{display:grid;gap:.4rem;padding:1.25rem 0;border-top:1px solid var(--color-border)}
.blko-theme .blko-brand-type__meta{font:var(--weight-body) var(--text-small)/1.3 var(--font-mono);color:var(--color-text-muted)}
.blko-theme .blko-brand-type__sample{margin:0;overflow-wrap:anywhere}
.blko-theme .blko-brand-type__family--heading{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__family--body{font-family:var(--font-body)}
.blko-theme .blko-brand-type__family--accent{font-family:var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-type__sample--display{font-size:var(--text-display);line-height:var(--leading-display);letter-spacing:var(--tracking-display)}
.blko-theme .blko-brand-type__sample--h1{font-size:var(--text-h1);line-height:var(--leading-display);letter-spacing:var(--tracking-h1)}
.blko-theme .blko-brand-type__sample--h2{font-size:var(--text-h2);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-brand-type__sample--h3{font-size:var(--text-h3);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3)}
.blko-theme .blko-brand-type__sample--body{font-size:var(--text-body);line-height:var(--leading-body);max-width:40rem}
.blko-theme .blko-brand-type__sample--label{font-size:var(--text-label)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
