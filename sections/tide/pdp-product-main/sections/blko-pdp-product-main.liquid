{% schema %}
{
  "name": "Product detail",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One time label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "breadcrumb_shop",
      "label": "Breadcrumb shop",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "breadcrumb_category_url",
      "label": "Breadcrumb category url"
    },
    {
      "type": "text",
      "id": "breadcrumb_category",
      "label": "Breadcrumb category",
      "default": "Face"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "3.4 fl oz / 100 ml"
    },
    {
      "type": "url",
      "id": "shade_help_url",
      "label": "Shade help url"
    },
    {
      "type": "text",
      "id": "shade_help_label",
      "label": "Shade help label",
      "default": "Not sure? Find your skin type."
    },
    {
      "type": "text",
      "id": "plan_legend",
      "label": "Plan legend",
      "default": "Purchase option"
    },
    {
      "type": "text",
      "id": "ship_note",
      "label": "Ship note",
      "default": "Free delivery on orders over $50 · Easy returns within 30 days"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Details"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Clear, honest product information for everyday rituals."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product detail",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "text": "Lightweight, water-resistant protection with a soft natural finish. Wear alone or layer over your favorite moisturiser."
          }
        },
        {
          "type": "accordion",
          "settings": {
            "label": "Ingredients",
            "text": "Non-nano zinc oxide, kelp extract, sea fennel, and skin-conditioning botanicals in a comfortable daily formula."
          }
        },
        {
          "type": "accordion",
          "settings": {
            "label": "How to use",
            "text": "Shake well. Apply generously 15 minutes before sun exposure and blend outward. Reapply after swimming or every two hours."
          }
        }
      ]
    }
  ]
}
{% endschema %}
