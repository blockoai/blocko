{%- comment -%} Generated by Blocko from tools/themes/tide/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-pdp><article class="blko-pdp-bundle-item" data-pdp-bundle-item data-pdp-price-cents="{{ product.price | escape }}" data-pdp-variant="{{ product.selected_or_first_available_variant.id | escape }}">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: product.featured_image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h2>{{ product.title | escape }}</h2><strong>{{ product.price | money_without_trailing_zeros }}</strong></div><button type="button" data-pdp-bundle-toggle aria-pressed="false">{{ 'blko.pdp.add' | t }}</button></article></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-footer-bg:CanvasText;--color-accent:GrayText;--color-text:CanvasText;--color-bg:Canvas;--kit-shadow:0 8px 28px rgb(0 0 0 / .08);--kit-radius-card:16px;--color-border:ButtonFace;--kit-border:1px;--color-bg-alt:Canvas;--kit-heading-tracking:-0.01em;--kit-radius:6px;--kit-radius-image:16px;--kit-radius-button:50px;--kit-heading-transform:none;--kit-heading-weight:300;--font-heading:"Fraunces",Georgia,serif;--leading-display:.9;--text-h2:2rem;--weight-light:300;--text-title:2rem;--text-display:2.75rem;--color-button-text:Canvas;--color-ink:var(--color-text);--color-line:var(--color-border);--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:1.5rem;--weight-medium:500;--tracking-h2:-.08rem;--font-body:"DM Sans",Arial,sans-serif;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.25rem;--text-title:2.5rem;--text-display:4rem;--text-card-title:2rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
