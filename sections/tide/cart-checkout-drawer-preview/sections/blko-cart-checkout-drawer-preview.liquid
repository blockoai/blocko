{% schema %}
{
  "name": "Cart drawer preview",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Upsell product"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout label",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Cart drawer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your bag"
    },
    {
      "type": "range",
      "id": "threshold",
      "label": "Free-shipping threshold",
      "min": 5,
      "max": 500,
      "step": 5,
      "unit": "$",
      "default": 50
    },
    {
      "type": "text",
      "id": "progress_label",
      "label": "Progress label",
      "default": "Shipping progress"
    },
    {
      "type": "text",
      "id": "before",
      "label": "Before",
      "default": "Only"
    },
    {
      "type": "text",
      "id": "after",
      "label": "After",
      "default": "away from complimentary shipping."
    },
    {
      "type": "text",
      "id": "unlocked",
      "label": "Unlocked",
      "default": "You have unlocked complimentary shipping."
    },
    {
      "type": "text",
      "id": "upsell_text",
      "label": "Upsell text",
      "default": "Add a finishing touch"
    },
    {
      "type": "text",
      "id": "upsell_eyebrow",
      "label": "Upsell eyebrow",
      "default": "Pairs well with"
    },
    {
      "type": "text",
      "id": "upsell_button",
      "label": "Upsell button",
      "default": "Add"
    }
  ],
  "presets": [
    {
      "name": "Cart drawer preview"
    }
  ]
}
{% endschema %}
