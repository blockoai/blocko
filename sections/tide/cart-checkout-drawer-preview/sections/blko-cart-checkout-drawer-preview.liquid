<div class="blko-theme"><blko-cart-checkout><blko-cart-drawer><section class="blko-cart-checkout-drawer-preview"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><section class="blko-cart-checkout-progress" aria-label="{{ section.settings.progress_label | escape }}" data-cart-checkout-progress data-goal="{{ section.settings.threshold | times: 100 }}"{% assign blko_calc_0 = section.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 %}{% if blko_calc_0 > 0 %} data-unlocked="false"{% else %} data-unlocked="true"{% endif %}><div>{% assign blko_calc_1 = section.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 %}{% if blko_calc_1 > 0 %}<p>{{ section.settings.before | escape }} <strong data-cart-checkout-remaining>{{ section.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 | money_without_trailing_zeros }}</strong> {{ section.settings.after | escape }}</p>{% else %}<p>{{ section.settings.unlocked | escape }}</p>{% endif %}<span aria-hidden="true"><i style="width:{% assign blko_calc_2 = section.settings.threshold | times: 100 %}{{ cart.total_price | times: 100 | divided_by: blko_calc_2 | at_most: 100 }}%"></i></span></div><p class="blko-cart-checkout-progress-label" data-cart-checkout-progress-label>{{ cart.total_price | money_without_trailing_zeros }} <b>{{ section.settings.threshold | times: 100 | money_without_trailing_zeros }}</b></p></section>{% for item in cart.items %}<article class="blko-cart-checkout-line-item" data-cart-checkout-line-item data-cart-checkout-line data-key="{{ item.key | escape }}">{% if item.image != blank %}{{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210, 315, 420', alt: item.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div>{% if item.variant.title != blank and item.variant.title != 'Default Title' %}<p class="blko-eyebrow">{{ item.variant.title | escape }}</p>{% else %}{% endif %}<h2><a href="{{ item.url | escape }}">{{ item.product.title | escape }}</a></h2><p class="blko-cart-checkout-price">{{ item.final_price | money_without_trailing_zeros }}</p><div class="blko-cart-checkout-quantity" data-cart-checkout-line-quantity><button type="button" aria-label="{{ 'blko.cart.decrease' | t }}" data-cart-checkout-line-step="-1">−</button><output data-cart-checkout-line-qty>{{ item.quantity | escape }}</output><button type="button" aria-label="{{ 'blko.cart.increase' | t }}" data-cart-checkout-line-step="1">+</button><input type="hidden" name="updates[]" value="{{ item.quantity | escape }}"></div><a class="blko-cart-checkout-text-button" href="{{ item.url_to_remove | escape }}" data-cart-checkout-line-remove>{{ 'blko.cart.remove' | t }}</a></div><strong aria-label="{{ 'blko.cart.line_total' | t }}" data-cart-checkout-line-total>{{ item.final_line_price | money_without_trailing_zeros }}</strong></article>{% endfor %}{% if product != blank %}<div class="blko-cart-checkout-drawer-upsell"><p>{{ section.settings.upsell_text | escape }}</p><article class="blko-cart-checkout-upsell-card">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '280, 420, 560', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.upsell_eyebrow | escape }}</p><h3>{{ product.title | escape }}</h3><strong>{{ product.price | money_without_trailing_zeros }}</strong><button type="button" data-cart-checkout-upsell-add data-cart-checkout-variant="{{ product.selected_or_first_available_variant.id | escape }}"{% if product.available == blank %} disabled{% else %}{% endif %}>{{ section.settings.upsell_button | escape }}</button></div></article></div>{% else %}{% endif %}{% form 'cart', cart, class: 'blko-cart-checkout-drawer-form' %}<button class="blko-button" type="submit" name="checkout">{{ section.settings.checkout_label | escape }} · {{ cart.total_price | money_without_trailing_zeros }}</button>{% endform %}</section></blko-cart-drawer></blko-cart-checkout></div>
