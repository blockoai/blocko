{% schema %}
{
  "name": "Article share controls",
  "settings": [
    {
      "type": "text",
      "id": "share_label",
      "label": "Share label",
      "default": "Share this note"
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy label",
      "default": "Copy link"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "url",
      "id": "save_url",
      "label": "Save url"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Save label",
      "default": "Save"
    }
  ],
  "presets": [
    {
      "name": "Article share controls"
    }
  ]
}
{% endschema %}
