{%- comment -%} Generated by Blocko from tools/themes/tint/groups/search-blog.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-search-blog><blko-predictive-search><div class="blko-search-blog-share"><span class="blko-eyebrow">{{ block.settings.share_label | escape }}</span><button type="button" data-search-blog-share>{{ block.settings.copy_label | escape }}</button><a href="mailto:?subject={{ article.title | url_encode }}&body={{ canonical_url | escape }}">{{ block.settings.email_label | escape }}</a><a href="{{ block.settings.save_url | default: '#share' }}">{{ block.settings.save_label | escape }}</a><span data-search-blog-share-status aria-live="polite"></span></div></blko-predictive-search></blko-search-blog></div>
<script type="module" src="{{ 'blko-predictive-search.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-search-blog.js' | asset_url }}"></script>
