{%- comment -%} Generated by Blocko from tools/themes/tint/groups/account.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-account><article class="blko-account-address-card"><p class="blko-account-status">{{ block.settings.default_label | escape }}</p><h2>{% if customer.default_address.company != blank %}{{ customer.default_address.company | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</h2><p>{{ customer.default_address.name | escape }}<br>{{ customer.default_address.address1 | escape }}<br>{{ customer.default_address.city | escape }}, {{ customer.default_address.zip | escape }}</p><a class="blko-account-text-button" href="{{ routes.account_addresses_url | escape }}">{{ block.settings.edit_label | escape }}</a></article></blko-account></div>
<script type="module" src="{{ 'blko-account.js' | asset_url }}"></script>
