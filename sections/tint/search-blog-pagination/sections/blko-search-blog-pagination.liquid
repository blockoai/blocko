{% schema %}
{
  "name": "Journal pagination",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Stories per page",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Nav label",
      "default": "Journal pages"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous label",
      "default": "Previous page"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next label",
      "default": "Next page"
    }
  ],
  "presets": [
    {
      "name": "Journal pagination"
    }
  ]
}
{% endschema %}
