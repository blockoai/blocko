{%- comment -%} Generated by Blocko from tools/themes/tint/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-founder-note"><div class="blko-content-founder-copy"><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><blockquote>{{ section.settings.quote | escape }}</blockquote><p>{{ section.settings.note | escape | newline_to_br }}</p><p class="blko-content-signature">{{ section.settings.name | escape }}<br><span>{{ section.settings.role | escape }}</span></p></div>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250, 500, 750, 1000', alt: section.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Helvetica Neue,Arial,sans-serif;--font-mono:var(--font-accent);--font-accent:"DM Mono",ui-monospace,Menlo,monospace;--text-label:.75rem;--weight-medium:500;--color-bg-alt:Canvas;--leading-label:1.5;--text-small:.75rem;--leading-body:1.5;--color-text-muted:CanvasText;--color-accent:GrayText;--tracking-label:.075rem;--font-display:var(--font-heading);--leading-display:.9;--text-h2:2rem;--color-footer-bg:CanvasText;--color-button-text:Canvas;--text-display:2.5rem;--tracking-title:-.08rem;--text-title:2rem;--weight-light:300;--color-overlay:rgb(0 0 0 / .4);--tracking-footer:-.0175rem;--font-body:"Familjen Grotesk",Helvetica Neue,Arial,sans-serif;--leading-footer:1.5;--text-footer:.875rem;--weight-body:400;--text-body:1rem;--leading-card-title:1.125;--text-card-title:1.5rem;--font-sans:var(--font-body);--color-border:ButtonFace;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--text-display:5rem;--tracking-title:-.1rem;--text-title:2.5rem;--text-body:1.25rem;--text-card-title:2rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
