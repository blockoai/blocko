{% schema %}
{
  "name": "Founder note",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "A note from our founder"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "“The best routine is one you can return to—on a busy morning, a slow evening, and everything in between.”"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Founder name is a placeholder for the person shaping your brand’s point of view."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Founder name"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Role",
      "default": "Founder"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Founder portrait placeholder"
    }
  ],
  "presets": [
    {
      "name": "Founder note"
    }
  ]
}
{% endschema %}
