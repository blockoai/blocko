{% schema %}
{
  "name": "Video review cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real people, real shades"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link url"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read reviews"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Review card",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": ""
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "Blends in seconds."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Maya"
        },
        {
          "type": "text",
          "id": "shade",
          "label": "Shade",
          "default": "Rose Beige"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video review cards",
      "blocks": [
        {
          "type": "reel",
          "settings": {}
        },
        {
          "type": "reel",
          "settings": {
            "quote": "My new everyday cheek.",
            "shade": "Honey Sand",
            "name": "Jo"
          }
        },
        {
          "type": "reel",
          "settings": {
            "quote": "So juicy, so easy.",
            "shade": "Soft Caramel",
            "name": "Ines"
          }
        },
        {
          "type": "reel",
          "settings": {
            "quote": "Matches perfectly.",
            "shade": "Cocoa Deep",
            "name": "Ade"
          }
        }
      ]
    }
  ]
}
{% endschema %}
