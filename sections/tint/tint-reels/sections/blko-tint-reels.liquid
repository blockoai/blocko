{%- comment -%} Generated by Blocko from tools/themes/tint/groups/tint-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-tint-reels"><div class="blko-tint-head"><h2>{{ section.settings.heading | escape }}</h2><a href="{{ section.settings.link_url | default: '#reviews' }}">{{ section.settings.link_label | escape }}</a></div><div class="blko-tint-reel-row">{% for block in section.blocks %}<figure class="blko-tint-reel" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption><q>{{ block.settings.quote | escape }}</q><small>{{ block.settings.name | escape }} · {{ block.settings.shade | escape }}</small><a class="blko-tint-add" href="{{ block.settings.url | default: '#shop' }}" aria-label="Shop this shade">+</a></figcaption></figure>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--color-button-text:Canvas;--color-ink:var(--color-text);--color-text:CanvasText;--kit-heading-tracking:-0.02em;--kit-radius-image:0;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Helvetica Neue,Arial,sans-serif;--font-mono:var(--font-accent);--font-accent:"DM Mono",ui-monospace,Menlo,monospace;--weight-medium:500;--color-bg:Canvas;--text-label:.75rem;--text-body:1rem;--color-overlay:rgb(0 0 0 / .4);--color-bg-alt:Canvas;--text-h2:2rem;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--font-body:"Familjen Grotesk",Helvetica Neue,Arial,sans-serif;--color-border:ButtonFace;--color-accent:GrayText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-body:1.25rem;--text-h2:2.5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-tint-reels{padding:clamp(2rem,5vw,4rem) 1rem}
.blko-theme .blko-tint-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;flex-wrap:wrap}
.blko-theme .blko-tint-head h2{margin:0;font-size:var(--text-h2)}
.blko-theme .blko-tint-reel-row{display:grid;grid-auto-flow:column;grid-auto-columns:clamp(11rem,24vw,17rem);gap:.5rem;overflow-x:auto;scroll-snap-type:x mandatory}
.blko-theme .blko-tint-reel{position:relative;margin:0;scroll-snap-align:start;aspect-ratio:9/16;overflow:hidden;background:var(--color-bg-alt)}
.blko-theme .blko-tint-reel img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.blko-theme .blko-tint-reel figcaption{position:absolute;inset:auto 0 0;display:grid;gap:.25rem;padding:2.5rem .75rem .75rem;color:var(--color-button-text);background:linear-gradient(transparent,var(--color-overlay))}
.blko-theme .blko-tint-reel q{font-size:var(--text-body);quotes:none;font-weight:var(--weight-medium)}
.blko-theme .blko-tint-reel small{font:var(--text-label)/1.2 var(--font-mono);letter-spacing:.08em;text-transform:uppercase}
.blko-theme .blko-tint-reel a.blko-tint-add{position:absolute;right:.75rem;bottom:.75rem;display:grid;place-items:center;width:2rem;height:2rem;border-radius:50%;background:var(--color-bg);color:var(--color-text);font:var(--weight-medium) 1.1rem/1 var(--font-mono)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
