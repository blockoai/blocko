{%- comment -%} Generated by Blocko from tools/themes/prism/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><aside class="blko-announcement">{{ section.settings.text | escape }} <a href="{{ section.settings.link | default: '#shipping' }}">{{ section.settings.link_label | escape }}</a></aside></div>
{% stylesheet %}
:where(.blko-theme){--kit-label-transform:uppercase;--color-announcement-text:Canvas;--color-announcement-bg:CanvasText;--tracking-label:.075rem;--font-accent:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--leading-label:1.5;--text-label:0.75rem;--weight-medium:500;--font-body:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-announcement{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-announcement{padding:.7rem 5vw;text-align:center;background:var(--color-announcement-bg);color:var(--color-announcement-text)}
.blko-theme.blko-theme .blko-announcement{text-transform:var(--kit-label-transform)}
{% endstylesheet %}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "free shipping over $50 + a free color-safe sample"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Details"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
