{%- comment -%} Generated by Blocko from tools/themes/prism/groups/prism-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-prism-effect"><div class="blko-prism-effect__head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-prism-effect__layout"><div class="blko-prism-effect__pair"><figure>{% if section.settings.before_image != blank %}{{ section.settings.before_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', alt: section.settings.before_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption>{{ section.settings.before_label | escape }}</figcaption></figure><figure>{% if section.settings.after_image != blank %}{{ section.settings.after_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', alt: section.settings.after_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption>{{ section.settings.after_label | escape }}</figcaption></figure></div><div class="blko-prism-effect__stats">{% for block in section.blocks %}<div class="blko-prism-effect__stat" {{ block.shopify_attributes }}><b>{{ block.settings.value | escape }}</b><span>{{ block.settings.label | escape }}</span></div>{% endfor %}</div></div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.02em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:700;--font-heading:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--kit-radius-image:0;--color-text-muted:CanvasText;--color-bg:Canvas;--text-small:.75rem;--leading-display:.9;--text-h2:1.875rem;--weight-light:300;--color-swatch-fine:ButtonFace;--color-swatch-coarse:ButtonFace;--color-announcement-text:Canvas;--color-accent:GrayText;--color-text:CanvasText;--font-body:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--tracking-label:.075rem;--font-accent:"Jost",Futura,'Trebuchet MS',Arial,sans-serif;--leading-label:1.5;--text-label:0.75rem;--weight-medium:500;--tracking-h2:-.08rem;--color-border:ButtonFace;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-prism-effect{padding:clamp(2.5rem,6vw,5rem) 5vw}
.blko-theme .blko-prism-effect__head{max-width:46rem;margin:0 0 clamp(1.5rem,3vw,2.5rem)}
.blko-theme .blko-prism-effect__head h2{margin:.35rem 0 .75rem;font-size:var(--text-h2);line-height:1.02}
.blko-theme .blko-prism-subscribe h2{margin:.35rem 0 .75rem;font-size:var(--text-h2);line-height:1.02}
.blko-theme .blko-prism-effect__layout{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(1rem,3vw,2.5rem);align-items:stretch}
.blko-theme .blko-prism-effect__pair{display:grid;grid-template-columns:1fr 1fr;gap:.5rem}
.blko-theme .blko-prism-effect__pair figure{position:relative;margin:0}
.blko-theme .blko-prism-effect__pair img{display:block;width:100%;height:100%;aspect-ratio:3/4;object-fit:cover;border:2px solid var(--color-text)}
.blko-theme .blko-prism-effect__pair figure:first-child img{filter:saturate(.35) brightness(1.05)}
.blko-theme .blko-prism-effect__pair figcaption{position:absolute;left:.5rem;top:.5rem;padding:.2rem .5rem;background:var(--color-text);color:var(--color-bg);font:700 .6875rem/1 var(--font-body);letter-spacing:.08em;text-transform:uppercase}
.blko-theme .blko-prism-effect__stats{display:grid;gap:.5rem;align-content:stretch}
.blko-theme .blko-prism-effect__stat{display:grid;align-content:center;padding:1rem 1.25rem;border:2px solid var(--color-text)}
.blko-theme .blko-prism-effect__stat:nth-child(1){background:var(--color-accent);color:var(--color-announcement-text)}
.blko-theme .blko-prism-effect__stat:nth-child(2){background:var(--color-swatch-coarse)}
.blko-theme .blko-prism-effect__stat:nth-child(3){background:var(--color-swatch-fine)}
.blko-theme .blko-prism-effect__stat b{font:700 clamp(2.75rem,6vw,4.5rem)/.9 var(--font-heading);letter-spacing:-.04em}
.blko-theme .blko-prism-effect__stat span{margin-top:.35rem;font-weight:500}
@media(max-width:900px){.blko-theme .blko-prism-effect__layout{grid-template-columns:1fr}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-tile figcaption{padding:.9rem 1rem;font-size:var(--text-small);background:var(--color-bg);color:var(--color-text-muted)}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
