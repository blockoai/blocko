-%}
<div class="blko-theme"><blko-tabs><section class="blko-filters"><div>{% for block in section.blocks %}<button class="blko-filter-chip {% if forloop.index0 == 0 %}is-active{% else %}{% endif %}" data-filter-chip {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>{% endfor %}</div><label>{{ 'blko.collection.sort' | t }} <select>{% for option in collection.sort_options %}<option>{{ option.name | escape }}</option>{% endfor %}</select></label></section></blko-tabs></div>
