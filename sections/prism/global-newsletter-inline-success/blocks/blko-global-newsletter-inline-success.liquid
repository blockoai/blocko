<div class="blko-theme" {{ block.shopify_attributes }}><blko-global><section class="blko-global-inline-signup" aria-labelledby="global-inline-title">
  <div><p class="blko-global-kicker">{{ block.settings.kicker | escape }}</p><h2 id="global-inline-title">{{ block.settings.heading | escape }}</h2></div>
  {% form 'customer', class: 'blko-global-inline-form' %}<input type="hidden" name="contact[tags]" value="newsletter">
  <label for="global-inline-form-email">{{ block.settings.inline_email_label | escape }}</label>
  <div class="blko-global-form-row"><input id="global-inline-form-email" name="contact[email]" type="email" autocomplete="email" placeholder="{{ block.settings.inline_email_placeholder | escape }}" required><button class="blko-button" type="submit">{{ block.settings.inline_submit_label | escape }}</button></div>
  <p class="blko-global-form-message" data-global-form-message aria-live="polite"{% if form.posted_successfully? %} data-global-form-success{% else %}{% endif %}>{% if form.posted_successfully? %}{{ block.settings.inline_success_message | escape }}{% else %}{% if form.errors != blank %}{{ block.settings.inline_error_message | escape }}{% else %}{{ block.settings.inline_message | escape }}{% endif %}{% endif %}</p>
{% endform %}
</section></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
