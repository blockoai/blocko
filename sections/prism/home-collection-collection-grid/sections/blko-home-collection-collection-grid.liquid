-%}
<div class="blko-theme"><blko-home-collection><blko-cart-drawer><section class="blko-home-collection-catalog" data-catalog-root>{% paginate collection.products by section.settings.products_per_page %}<p class="blko-home-collection-catalog__status" data-catalog-status>{{ 'blko.collection.showing' | t }} {{ paginate.current_offset | plus: collection.products.size }} {{ 'blko.collection.of' | t }} {{ paginate.items | escape }} {{ 'blko.collection.products' | t }}</p><div class="blko-home-collection-catalog__grid" data-catalog-grid>{% for product in collection.products %}<article class="blko-home-collection-product"><div class="blko-home-collection-product__media">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '380, 570, 760', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}{% if product.type != blank %}<span class="blko-home-collection-product__badge">{{ product.type | escape }}</span>{% else %}{% endif %}<button type="button" class="blko-home-collection-product__quick" data-quick-view data-name="{{ product.title | escape }}" data-price="{{ product.price | money_without_trailing_zeros }}" data-note="{{ product.description | strip_html | truncate: 160 | escape }}" data-handle="{{ product.handle | escape }}">{{ section.settings.quick_label | escape }}</button></div><div class="blko-home-collection-product__body"><p>{{ product.description | strip_html | truncate: 160 | escape }}</p><h3><a class="blko-product-link" href="{{ product.url | escape }}">{{ product.title | escape }}</a></h3><strong>{{ product.price | money_without_trailing_zeros }}</strong></div></article>{% if forloop.index0 == 2 %}<aside class="blko-home-collection-promo-tile">{% if section.settings.promo_image != blank %}{{ section.settings.promo_image | image_url: width: 760 | image_tag: loading: 'lazy', widths: '380, 570, 760', alt: section.settings.promo_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.promo_eyebrow | escape }}</p><h2>{{ section.settings.promo_heading | escape }}</h2><a href="{{ section.settings.promo_url | default: '#care' }}">{{ section.settings.promo_label | escape }}</a></div></aside>{% else %}{% endif %}{% else %}<p>{{ section.settings.empty_text | escape }}</p>{% endfor %}</div>{% if paginate.pages > 1 %}<div class="blko-home-collection-load-more"><progress value="{{ paginate.current_offset | plus: collection.products.size }}" max="{{ paginate.items | escape }}" data-load-progress>{{ paginate.current_offset | plus: collection.products.size }} {{ 'blko.collection.of' | t }} {{ paginate.items | escape }}</progress><p data-load-label>{{ paginate.current_offset | plus: collection.products.size }} {{ 'blko.collection.of' | t }} {{ paginate.items | escape }} {{ 'blko.collection.products_shown' | t }}</p>{% if paginate.previous.url != blank %}<a class="blko-button" href="{{ paginate.previous.url | escape }}" rel="prev">{{ section.settings.previous_label | escape }}</a>{% else %}{% endif %}{% if paginate.next.url != blank %}<a class="blko-button" href="{{ paginate.next.url | escape }}" rel="next" data-load-more-link>{{ section.settings.load_more_label | escape }}</a>{% else %}{% endif %}</div>{% else %}{% endif %}{% endpaginate %}</section></blko-cart-drawer></blko-home-collection></div>
