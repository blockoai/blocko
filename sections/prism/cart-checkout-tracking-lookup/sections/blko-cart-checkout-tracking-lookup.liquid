{% schema %}
{
  "name": "Order tracking lookup",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Order tracking"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow your delivery."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Enter the details from your confirmation email to see the latest status."
    },
    {
      "type": "text",
      "id": "found_message",
      "label": "Found message",
      "default": "Your latest shipment status is shown."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "We could not find that order. Check the details and try again."
    },
    {
      "type": "text",
      "id": "unavailable_message",
      "label": "Unavailable message",
      "default": "Order tracking is not available for this store yet. Please use the link in your shipping confirmation email."
    },
    {
      "type": "text",
      "id": "order_label",
      "label": "Order label",
      "default": "Order number"
    },
    {
      "type": "text",
      "id": "order_placeholder",
      "label": "Order placeholder",
      "default": "e.g. B-10482"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Track order"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Timeline step",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Order confirmed"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "We received your order."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Order tracking lookup",
      "blocks": [
        {
          "type": "step",
          "settings": {}
        },
        {
          "type": "step",
          "settings": {
            "title": "Preparing your items",
            "text": "Your order is being carefully packed."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "On its way",
            "text": "Tracking will appear after handoff."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Delivered",
            "text": "Enjoy your new color-care system."
          }
        }
      ]
    }
  ]
}
{% endschema %}
