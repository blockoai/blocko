{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Send a note"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell us what you need."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We’ll respond during the support hours below. Fields marked with an asterisk are required."
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "topic_label",
      "label": "Topic label",
      "default": "Topic"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks — your message is on its way."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Please complete the required fields before sending your message."
    }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order support"
        }
      ]
    }
  ],
  "presets": [
