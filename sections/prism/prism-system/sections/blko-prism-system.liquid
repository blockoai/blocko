{%- comment -%} Generated by Blocko from tools/themes/prism/groups/prism-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-prism-system"><div class="blko-prism-system__head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p></div><div class="blko-prism-system__steps">{% for block in section.blocks %}<article class="blko-prism-system__step" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><span class="blko-prism-system__num">{{ block.settings.number | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p><a href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_label | escape }}</a></div></article>{% endfor %}</div></section></div>
