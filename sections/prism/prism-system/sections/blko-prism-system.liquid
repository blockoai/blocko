{% schema %}
{
  "name": "Three-step system",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The system"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "3 steps to save your color"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Cleanse, rebuild, seal. One routine that keeps vivid shades vivid between salon visits."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Hair care product"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "lock it in"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A sulfate-free cleanse that keeps pigment where it belongs."
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link url"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop shampoo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three-step system",
      "blocks": [
        {
          "type": "step",
          "settings": {}
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "title": "rebuild it",
            "text": "Bond-building mask that repairs the damage color leaves behind.",
            "link_label": "Shop masks"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "3",
            "title": "seal the shine",
            "text": "A weightless serum for glass-like gloss and heat protection.",
            "link_label": "Shop serums"
          }
        }
      ]
    }
  ]
}
{% endschema %}
