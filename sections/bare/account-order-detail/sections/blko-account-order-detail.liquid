<div class="blko-theme"><blko-account><section class="blko-account-order-detail"><a class="blko-account-back-link" href="{{ routes.account_url | escape }}">{{ section.settings.back_label | escape }}</a><div class="blko-account-order-detail__head"><div><p class="blko-account-kicker">{{ section.settings.kicker_label | escape }} {{ order.order_number | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.placed_label | escape }} {{ order.created_at | date: '%B %-d, %Y' }}</p></div><span class="blko-account-status">{{ order.fulfillment_status_label | escape }}</span></div><div class="blko-account-order-detail__grid"><div><h2>{{ section.settings.items_heading | escape }}</h2>{% for line in order.line_items %}<div class="blko-account-order-item"><div><h3>{{ line.title | escape }}</h3><p>{% if line.variant_title != blank %}{{ line.variant_title | escape }} · {{ 'blko.account.quantity' | t }} {{ line.quantity | escape }}{% else %}{{ 'blko.account.quantity' | t }} {{ line.quantity | escape }}{% endif %}</p></div><strong>{{ line.final_line_price | money }}</strong></div>{% endfor %}</div><aside class="blko-account-order-summary"><h2>{{ section.settings.summary_heading | escape }}</h2><p><span>{{ section.settings.subtotal_label | escape }}</span><strong>{{ order.subtotal_price | money }}</strong></p><p><span>{{ section.settings.shipping_label | escape }}</span><strong>{% if order.shipping_price == 0 %}{{ section.settings.free_label | escape }}{% else %}{{ order.shipping_price | money }}{% endif %}</strong></p><p class="blko-account-order-summary__total"><span>{{ section.settings.total_label | escape }}</span><strong>{{ order.total_price | money }}</strong></p><hr>{% if order.shipping_address != blank %}<h3>{{ section.settings.address_heading | escape }}</h3><p>{{ order.shipping_address.name | escape }}<br>{{ order.shipping_address.address1 | escape }}<br>{{ order.shipping_address.city | escape }}, {{ order.shipping_address.zip | escape }}</p>{% else %}{% endif %}</aside></div></section></blko-account></div>
