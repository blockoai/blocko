    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Order details"
    },
    {
      "type": "text",
      "id": "placed_label",
      "label": "Placed label",
      "default": "Placed"
    },
    {
      "type": "text",
      "id": "items_heading",
      "label": "Items heading",
      "default": "Items"
    },
    {
      "type": "text",
      "id": "summary_heading",
      "label": "Summary heading",
      "default": "Order summary"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "free_label",
      "label": "Free label",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address heading",
      "default": "Delivery address"
    }
  ],
  "presets": [
    {
      "name": "Account order detail"
    }
  ]
}
{% endschema %}
