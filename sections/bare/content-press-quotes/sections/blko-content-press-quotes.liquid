{%- comment -%} Generated by Blocko from tools/themes/bare/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-press-quotes"><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><blockquote>{{ block.settings.quote | escape }}</blockquote><cite>{{ block.settings.source | escape }}</cite></div>{% endfor %}</section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
