{%- comment -%} Generated by Blocko from tools/themes/bare/groups/bare-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-bare-press blko-{{ section.settings.color_scheme.id | escape }}"><div class="blko-bare-press-logos">{% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</span>{% endfor %}</div><blockquote>{{ section.settings.quote | escape }}</blockquote><p class="blko-bare-press-credit">{{ section.settings.credit | escape }}</p></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Cormorant Garamond",Georgia,serif;--text-label:.75rem;--font-accent:"DM Mono",ui-monospace,Menlo,monospace;--color-text:CanvasText;--color-bg:Canvas;--tracking-title:-.08rem;--leading-body:1.5;--text-title:2rem;--weight-light:300;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--tracking-title:-.1rem;--text-title:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme blockquote{margin:1rem 0;font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading);letter-spacing:var(--tracking-title)}
.blko-theme .blko-bare-press{background:var(--color-bg);color:var(--color-text)}
.blko-theme .blko-bare-press{padding:clamp(2.5rem,5vw,4.5rem) 5vw;text-align:center}
.blko-theme .blko-bare-press-logos{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem clamp(1.5rem,5vw,4rem);margin-bottom:clamp(1.5rem,3vw,2.5rem);font-family:var(--font-accent);font-size:var(--text-label);letter-spacing:.14em;text-transform:uppercase;opacity:.7}
.blko-theme .blko-bare-press blockquote{max-width:34ch;margin:0 auto;font-family:var(--font-heading);font-size:clamp(1.7rem,3.4vw,2.8rem);line-height:1.2;font-weight:400}
.blko-theme .blko-bare-press-credit{margin:1.2rem 0 0;font-family:var(--font-accent);font-size:var(--text-label);letter-spacing:.14em;text-transform:uppercase;opacity:.7}
.blko-theme .blko-bare-founder blockquote{max-width:26ch;margin:1rem auto 1.75rem;font-family:var(--font-heading);font-size:clamp(1.9rem,4.2vw,3.4rem);line-height:1.15;font-weight:400;letter-spacing:-.01em}
.blko-theme.blko-theme blockquote{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
{% endstylesheet %}
