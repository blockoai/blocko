{%- comment -%} Generated by Blocko from tools/themes/bare/groups/beauty-extras.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-beauty-extras><button class="blko-beauty-extras-answer" type="button" data-beauty-extras-choice{% if block.settings.selected %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %}>{{ block.settings.label | escape }} <small>{{ block.settings.hint | escape }}</small></button></blko-beauty-extras></div>
