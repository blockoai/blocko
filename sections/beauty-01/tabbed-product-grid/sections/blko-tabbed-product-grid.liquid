-%}
<div class="blko-theme"><blko-tabs><section class="blko-catalog" data-tabs><div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-tabs">{% for block in section.blocks %}<button role="tab"{% if forloop.index0 == 0 %} aria-selected="true"{% else %} aria-selected="false"{% endif %} data-tab="{{ block.settings.key | escape }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>{% endfor %}</div><div class="blko-product-grid" data-tab-panel="best">{% for product in collection.products limit: 3 %}<article class="blko-product-card">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ product.vendor | escape }}</p><h3><a class="blko-product-link" href="{{ product.url | escape }}">{{ product.title | escape }}</a></h3>{% if product.metafields.reviews.rating.value.rating != blank %}<p>{% assign blko_rating = product.metafields.reviews.rating.value.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %} <span>{{ product.metafields.reviews.rating.value.rating | escape }} ({{ product.metafields.reviews.rating_count | escape }})</span></p>{% else %}{% endif %}<strong class="blko-price">{{ product.price | money_without_trailing_zeros }}</strong></div></article>{% endfor %}</div></section></blko-tabs></div>
<script type="module" src="{{ 'blko-tabs.js' | asset_url }}"></script>
