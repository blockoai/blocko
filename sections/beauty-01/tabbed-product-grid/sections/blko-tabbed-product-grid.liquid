{% schema %}
{
  "name": "Tabbed product grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday essentials"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Tab key",
          "default": "best"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Best sellers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed product grid",
      "blocks": [
        {
          "type": "tab",
          "settings": {}
        },
        {
          "type": "tab",
          "settings": {
            "label": "New arrivals",
            "key": "new"
          }
        }
      ]
    }
  ]
}
{% endschema %}
