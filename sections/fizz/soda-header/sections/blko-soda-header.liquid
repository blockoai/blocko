{%- assign menu = linklists[section.settings.menu] -%}
<blko-soda-nav class="blko-soda-header">
  <div class="blko-soda-header__inner">
    <button type="button" class="blko-soda-header__toggle" data-toggle aria-expanded="false" aria-label="Menu">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <nav class="blko-soda-header__nav" aria-label="Primary">
      <ul>
        {%- for link in menu.links -%}
          <li class="blko-soda-header__item{% if link.links.size > 0 %} has-mega{% endif %}">
            <a href="{{ link.url }}">{{ link.title }}{% if link.links.size > 0 %}<svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 1l4 4 4-4"/></svg>{% endif %}</a>
            {%- if link.links.size > 0 -%}
              <div class="blko-soda-mega">
                <div class="blko-soda-mega__inner">
                  {%- for child in link.links -%}
                    {%- assign img = nil -%}
                    {%- if child.type == 'collection_link' -%}{%- assign img = child.object.image | default: child.object.products.first.featured_image -%}{%- endif -%}
                    <div class="blko-soda-mega__col">
                      <a class="blko-soda-mega__head" href="{{ child.url }}">
                        {%- if img -%}<span class="blko-soda-mega__img"><img src="{{ img | image_url: width: 400 }}" alt="" width="200" height="200" loading="lazy"></span>{%- endif -%}
                        <span>{{ child.title }}</span>
                      </a>
                      {%- if child.links.size > 0 -%}<ul>{%- for grand in child.links -%}<li><a href="{{ grand.url }}">{{ grand.title }}</a></li>{%- endfor -%}</ul>{%- endif -%}
                    </div>
                  {%- endfor -%}
                  <a class="blko-soda-header__btn" href="{{ link.url }}">{{ section.settings.shop_all_label }}</a>
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
    <a class="blko-soda-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.brand_logo != blank -%}
        {{ settings.brand_logo | image_url: width: 480 | image_tag: alt: shop.name, width: 120, height: 48 }}
      {%- else -%}
        <img src="{{ 'brand-logo.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="120" height="48">
      {%- endif -%}
    </a>
    <div class="blko-soda-header__tools">
      {%- if section.settings.find_label != blank -%}<a class="blko-soda-header__find" href="{{ section.settings.find_url }}">{{ section.settings.find_label | escape }}</a>{%- endif -%}
      <a href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></a>
      <a href="{{ routes.cart_url }}" data-cart-open aria-controls="CartDrawer" aria-label="Cart"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 7h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg><span class="blko-soda-header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></a>
    </div>
  </div>
  <nav class="blko-soda-header__mobile" data-menu aria-label="Mobile">
    {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
  </nav>
</blko-soda-nav>
<script type="module" src="{{ 'blko-soda.js' | asset_url }}"></script>

{% stylesheet %}
.blko-soda-header{position:relative;z-index:20;background:var(--color-bg, #fbf3e2);color:var(--color-text, #0f3b2e);font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-header__inner{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;max-width:90rem;margin:0 auto;padding:.6rem 1.25rem}
.blko-soda-header__toggle{display:none;justify-self:start;border:0;background:none;color:inherit;cursor:pointer}
.blko-soda-header__nav ul{display:flex;gap:1.5rem;margin:0;padding:0;list-style:none}
.blko-soda-header__item{position:static}
.blko-soda-header__item>a{display:inline-flex;align-items:center;gap:.35rem;padding:1rem 0;color:inherit;font:700 1rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
.blko-soda-header__logo img{display:block;width:var(--logo-width, 120px);max-width:100%;height:auto}
.blko-soda-header__tools{display:flex;align-items:center;justify-content:flex-end;gap:1rem}
.blko-soda-header__tools a{position:relative;display:inline-flex;color:inherit;text-decoration:none}
.blko-soda-header__find{font:700 .95rem var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-header__count{position:absolute;top:-.45rem;right:-.6rem;min-width:1.15rem;padding:0 .25rem;border-radius:999px;background:var(--color-accent, #ff6b8b);color:var(--color-text, #0f3b2e);font:800 .7rem/1.15rem var(--font-body, "Outfit", sans-serif);text-align:center}
.blko-soda-mega{position:absolute;left:0;right:0;top:100%;display:none;background:var(--color-bg-alt, #f3e8cd);border-top:3px solid var(--color-announcement-bg, #cdf26b);box-shadow:0 18px 30px -18px rgba(20,67,61,.45)}
.blko-soda-header__item.has-mega:hover .blko-soda-mega,.blko-soda-header__item.has-mega:focus-within .blko-soda-mega{display:block}
.blko-soda-mega__inner{display:flex;flex-wrap:wrap;align-items:flex-start;gap:2rem;max-width:90rem;margin:0 auto;padding:1.75rem 1.25rem}
.blko-soda-mega__col{min-width:9rem;max-width:12rem}
.blko-soda-mega__head{display:grid;gap:.5rem;color:inherit;font:700 1.05rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
.blko-soda-mega__img{display:block;overflow:hidden;border-radius:1rem;background:var(--color-bg, #fbf3e2);aspect-ratio:1}
.blko-soda-mega__img img{width:100%;height:100%;object-fit:cover}
.blko-soda-mega__col ul{margin:.5rem 0 0;padding:0;list-style:none}
.blko-soda-mega__col li a{display:block;padding:.2rem 0;color:inherit;font-size:.95rem;text-decoration:none}
.blko-soda-mega__col li a:hover{text-decoration:underline}
.blko-soda-header__btn{align-self:center;margin-left:auto;padding:.7rem 1.4rem;border-radius:999px;background:var(--color-announcement-bg, #cdf26b);color:var(--color-text, #0f3b2e);font:700 .95rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
.blko-soda-header__mobile{display:none;padding:.5rem 1.25rem 1.25rem;background:var(--color-bg-alt, #f3e8cd)}
.blko-soda-header__mobile.is-open{display:grid}
.blko-soda-header__mobile a{padding:.75rem 0;border-bottom:1px solid var(--color-border, #dccfae);color:inherit;font:700 1.1rem var(--font-heading, "Fraunces", Georgia, serif);text-decoration:none}
@media(max-width:900px){.blko-soda-header__toggle{display:inline-flex}.blko-soda-header__nav{display:none}.blko-soda-header__inner{grid-template-columns:auto 1fr auto}.blko-soda-header__logo{justify-self:center}.blko-soda-header__find{display:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda header",
  "settings": [
    {"type": "link_list", "id": "menu", "label": "Menu (dropdown links become the mega menu)", "default": "main-menu"},
    {"type": "text", "id": "shop_all_label", "label": "Mega menu button", "default": "Shop all flavors"},
    {"type": "text", "id": "find_label", "label": "Store finder label", "default": "Find a store"},
    {"type": "url", "id": "find_url", "label": "Store finder link"}
  ],
  "presets": [{"name": "Soda header"}]
}
{% endschema %}
