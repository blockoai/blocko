<section class="blko-soda-fiber" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <header class="blko-soda-fiber__head">
    <p class="blko-soda-fiber__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.text | escape }}</p>
  </header>
  <ol class="blko-soda-fiber__steps">
    {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
      <li style="background:{{ block.settings.color }}" {{ block.shopify_attributes }}>
        <span class="blko-soda-fiber__num">{{ forloop.index }}</span>
        <h2>{{ block.settings.title | escape }}</h2>
        <p>{{ block.settings.text | escape }}</p>
      </li>
    {%- endif -%}{%- endfor -%}
  </ol>
  <div class="blko-soda-fiber__compare">
    <h2>{{ section.settings.compare_heading | escape }}</h2>
    <ul>
      {%- for block in section.blocks -%}{%- if block.type == 'compare' -%}
        <li {{ block.shopify_attributes }}>
          <span>{{ block.settings.label | escape }}</span>
          <span class="blko-soda-fiber__bar"><i style="width:{{ block.settings.percent }}%;background:{{ block.settings.color }}"></i></span>
          <b>{{ block.settings.grams | escape }}</b>
        </li>
      {%- endif -%}{%- endfor -%}
    </ul>
    <p>{{ section.settings.note | escape }}</p>
  </div>
</section>

{% stylesheet %}
.blko-soda-fiber{display:grid;gap:2.5rem;padding:clamp(2.5rem,6vw,5rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-fiber__head,.blko-soda-fiber__steps,.blko-soda-fiber__compare{width:100%;max-width:72rem;margin:0 auto}
.blko-soda-fiber__head{display:grid;gap:.8rem;text-align:center}
.blko-soda-fiber__eyebrow{margin:0;font-size:.8rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
.blko-soda-fiber__head h1{max-width:18ch;margin:0 auto;font:900 clamp(2.4rem,6vw,4.75rem)/.98 var(--font-heading, "Fraunces", Georgia, serif);letter-spacing:-.02em}
.blko-soda-fiber__head p:last-child{max-width:38rem;margin:0 auto;font-size:1.15rem}
.blko-soda-fiber__steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1rem;margin-block:0;padding:0;list-style:none}
.blko-soda-fiber__steps li{display:grid;align-content:start;gap:.6rem;padding:1.75rem;border-radius:2rem;color:var(--color-text, #0f3b2e)}
.blko-soda-fiber__num{display:grid;place-items:center;width:3rem;height:3rem;border-radius:50%;background:var(--color-text, #0f3b2e);color:#fff;font:900 1.4rem var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-fiber__steps h2{margin:0;font:900 1.7rem/1.05 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-fiber__steps p{margin:0}
.blko-soda-fiber__compare{display:grid;gap:1rem;padding:clamp(1.5rem,4vw,2.5rem);border-radius:2rem;background:var(--color-text, #0f3b2e);color:var(--color-bg, #fbf3e2)}
.blko-soda-fiber__compare h2{margin:0;font:900 clamp(1.7rem,3.5vw,2.5rem)/1.05 var(--font-heading, "Fraunces", Georgia, serif)}
.blko-soda-fiber__compare ul{display:grid;gap:.8rem;margin:0;padding:0;list-style:none}
.blko-soda-fiber__compare li{display:grid;grid-template-columns:minmax(7rem,12rem) 1fr 3.5rem;align-items:center;gap:1rem;font-weight:700}
.blko-soda-fiber__bar{display:block;height:1.1rem;overflow:hidden;border-radius:999px;background:rgba(255,255,255,.18)}
.blko-soda-fiber__bar i{display:block;height:100%;border-radius:999px}
.blko-soda-fiber__compare p{margin:0;font-size:.85rem;opacity:.8}
@media(max-width:600px){.blko-soda-fiber__compare li{grid-template-columns:1fr 3rem}.blko-soda-fiber__bar{grid-column:1/-1;grid-row:2}}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda fiber education",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#fbf3e2"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0f3b2e"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fiber 101"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Fiber is the good stuff your gut is missing."},
    {"type": "textarea", "id": "text", "label": "Intro", "default": "Most of us eat about half the fiber we need. Prebiotic fiber feeds the friendly bugs in your gut, and a can of Fizz brings nine grams to the party."},
    {"type": "text", "id": "compare_heading", "label": "Comparison heading", "default": "Grams of fiber, side by side"},
    {"type": "text", "id": "note", "label": "Footnote", "default": "Typical values. Check each label for exact numbers."}
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {"type": "color", "id": "color", "label": "Tile color", "default": "#ffc9d6"},
        {"type": "text", "id": "title", "label": "Title", "default": "Fiber arrives"},
        {"type": "textarea", "id": "text", "label": "Text", "default": "Plant fiber from chicory and cassava skips digestion in your stomach."}
      ]
    },
    {
      "type": "compare",
      "name": "Comparison bar",
      "settings": [
        {"type": "text", "id": "label", "label": "Label", "default": "One can of Fizz"},
        {"type": "text", "id": "grams", "label": "Grams", "default": "9g"},
        {"type": "range", "id": "percent", "label": "Bar length", "min": 5, "max": 100, "step": 5, "default": 75},
        {"type": "color", "id": "color", "label": "Bar color", "default": "#cdf26b"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Soda fiber education",
      "blocks": [
        {"type": "step", "settings": {"title": "Fiber arrives"}},
        {"type": "step", "settings": {"title": "Gut bugs feast", "color": "#fff3b0"}},
        {"type": "step", "settings": {"title": "You feel it", "color": "#c8f1dd"}},
        {"type": "compare", "settings": {}}
      ]
    }
  ]
}
{% endschema %}
