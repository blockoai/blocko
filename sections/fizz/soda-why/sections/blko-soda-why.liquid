<section class="blko-soda-why" style="background-color:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <h2>{{ section.settings.heading | escape }}</h2>
  <p>{{ section.settings.text | escape }}</p>
  <a href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
</section>

{% stylesheet %}
.blko-soda-why{display:grid;justify-items:center;gap:1.1rem;padding:clamp(3rem,8vw,6rem) 1.25rem;font-family:var(--font-body, "Figtree", sans-serif);text-align:center}
.blko-soda-why h2{margin:0;font:800 clamp(2.2rem,5vw,4rem)/1 var(--font-heading, "Baloo 2", sans-serif)}
.blko-soda-why p{max-width:42rem;margin:0;font-size:1.2rem;line-height:1.55}
.blko-soda-why a{padding:.9rem 2rem;border-radius:999px;background:var(--color-button, #14433d);color:var(--color-button-text, #fff);font:700 1.05rem var(--font-heading, "Baloo 2", sans-serif);text-decoration:none}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda why block",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#d4f23c"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#14433d"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Why Fizz?"},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Fizz pairs prebiotic fiber with real fruit and a short ingredient list. Two grams of sugar, zero guilt, and a flavor you would sip on purpose."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Find your flavor"},
    {"type": "url", "id": "button_url", "label": "Button link"}
  ],
  "presets": [{"name": "Soda why block"}]
}
{% endschema %}
