<section class="blko-soda-qa" style="background:{{ section.settings.bg }};color:{{ section.settings.text_color }}">
  <blko-soda-qa class="blko-soda-qa__inner">
    <header class="blko-soda-qa__head">
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.text | escape }}</p>
    </header>
    <div class="blko-soda-qa__tabs" role="group" aria-label="{{ section.settings.heading | escape }}">
      <button type="button" data-cat="" aria-pressed="true">{{ section.settings.all_label | escape }}</button>
      {%- for block in section.blocks -%}{%- if block.type == 'category' -%}<button type="button" data-cat="{{ block.settings.name | handleize }}" aria-pressed="false" {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</button>{%- endif -%}{%- endfor -%}
    </div>
    <div class="blko-soda-qa__list">
      {%- for block in section.blocks -%}{%- if block.type == 'question' -%}
        <details class="blko-soda-qa__item" data-item data-cat="{{ block.settings.category | handleize }}" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <p>{{ block.settings.answer | escape }}</p>
        </details>
      {%- endif -%}{%- endfor -%}
    </div>
    <p class="blko-soda-qa__more">{{ section.settings.more_text | escape }} <a href="{{ section.settings.more_url }}">{{ section.settings.more_label | escape }}</a></p>
  </blko-soda-qa>
</section>

{% stylesheet %}
.blko-soda-qa{padding:clamp(2.5rem,6vw,5rem) 1.25rem;font-family:var(--font-body, "Outfit", sans-serif)}
.blko-soda-qa__inner{display:grid;gap:1.5rem;max-width:50rem;margin:0 auto}
.blko-soda-qa__head{display:grid;gap:.7rem;text-align:center}
.blko-soda-qa__head h1{margin:0;font:900 clamp(2.4rem,6vw,4.5rem)/.98 var(--font-heading, "Fraunces", Georgia, serif);letter-spacing:-.02em}
.blko-soda-qa__head p{margin:0;font-size:1.15rem}
.blko-soda-qa__tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem}
.blko-soda-qa__tabs button{padding:.6rem 1.3rem;border:2px solid var(--color-text, #0f3b2e);border-radius:999px;background:transparent;color:inherit;font:800 .95rem var(--font-body, "Outfit", sans-serif);cursor:pointer}
.blko-soda-qa__tabs button[aria-pressed="true"]{background:var(--color-text, #0f3b2e);color:var(--color-bg, #fbf3e2)}
.blko-soda-qa__list{display:grid;gap:.7rem}
.blko-soda-qa__item{padding:0 1.5rem;border-radius:1.5rem;background:#fff}
.blko-soda-qa__item[hidden]{display:none}
.blko-soda-qa__item summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.15rem 0;font:900 1.2rem/1.2 var(--font-heading, "Fraunces", Georgia, serif);cursor:pointer;list-style:none}
.blko-soda-qa__item summary::-webkit-details-marker{display:none}
.blko-soda-qa__item summary::after{content:"+";display:grid;place-items:center;flex:none;width:2rem;height:2rem;border-radius:50%;background:var(--color-announcement-bg, #cdf26b);font-size:1.3rem;line-height:1}
.blko-soda-qa__item[open] summary::after{content:"\2212"}
.blko-soda-qa__item p{margin:0;padding:0 0 1.25rem;font-size:1.05rem}
.blko-soda-qa__more{margin:0;text-align:center;font-weight:700}
.blko-soda-qa__more a{color:inherit}
{% endstylesheet %}

{% schema %}
{
  "name": "Soda FAQ",
  "settings": [
    {"type": "color", "id": "bg", "label": "Background", "default": "#c8f1dd"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#0f3b2e"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered."},
    {"type": "textarea", "id": "text", "label": "Intro", "default": "Flavors, fiber, shipping and subscriptions. Still stuck? We are one message away."},
    {"type": "text", "id": "all_label", "label": "All tab label", "default": "All"},
    {"type": "text", "id": "more_text", "label": "Footer text", "default": "Did not find it?"},
    {"type": "text", "id": "more_label", "label": "Footer link label", "default": "Contact us"},
    {"type": "url", "id": "more_url", "label": "Footer link"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category tab",
      "settings": [{"type": "text", "id": "name", "label": "Name", "default": "Flavors"}]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {"type": "text", "id": "category", "label": "Category (match a tab name)", "default": "Flavors"},
        {"type": "text", "id": "question", "label": "Question", "default": "Which flavor should I try first?"},
        {"type": "textarea", "id": "answer", "label": "Answer", "default": "Start with Cherry Pop or grab a variety pack and pick a favorite."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Soda FAQ",
      "blocks": [
        {"type": "category", "settings": {}},
        {"type": "question", "settings": {}}
      ]
    }
  ]
}
{% endschema %}
