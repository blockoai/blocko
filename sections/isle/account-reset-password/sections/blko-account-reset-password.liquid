{% schema %}
{
  "name": "Password reset",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Password reset"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose a new password."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Use a password you have not used before."
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password label",
      "default": "New password"
    },
    {
      "type": "text",
      "id": "confirm_label",
      "label": "Confirm label",
      "default": "Confirm password"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Save new password"
    },
    {
      "type": "text",
      "id": "signin_link",
      "label": "Signin link",
      "default": "Sign in"
    },
    {
      "type": "text",
      "id": "register_link",
      "label": "Register link",
      "default": "Create an account"
    }
  ],
  "presets": [
    {
      "name": "Password reset"
    }
  ]
}
{% endschema %}
