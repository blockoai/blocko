{% schema %}
{
  "name": "Scent finder",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Natural makeup model"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your match"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet your shade."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answer a few quick questions to begin with a comfortable, natural-looking tint."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start the finder"
    }
  ],
  "presets": [
    {
      "name": "Scent finder"
    }
  ]
}
{% endschema %}
