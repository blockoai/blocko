{% schema %}
{
  "name": "FAQ browser",
  "settings": [
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search answers"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Try “shipping” or “scent”"
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tabs label",
      "default": "FAQ categories"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty message",
      "default": "No matching questions yet. Try a different search or contact support."
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "key",
          "label": "Category key",
          "default": "all"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category key",
          "default": "orders"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "When will my order ship?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Orders are prepared on business days. You’ll receive a shipping update when your package is on its way."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ browser",
      "blocks": [
        {
          "type": "tab",
          "settings": {}
        },
        {
          "type": "tab",
          "settings": {
            "key": "orders",
            "label": "Orders"
          }
        },
        {
          "type": "tab",
          "settings": {
            "key": "products",
            "label": "Products"
          }
        },
        {
          "type": "tab",
          "settings": {
            "key": "returns",
            "label": "Returns"
          }
        },
        {
          "type": "question",
          "settings": {}
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I change my order?",
            "answer": "Contact support as soon as possible. We’ll help if your order has not begun processing."
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "products",
            "question": "How do I find my scent?",
            "answer": "Begin with our best sellers, then compare notes from coconut to vanilla. Our team can offer general guidance."
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "products",
            "question": "Where can I find ingredient information?",
            "answer": "Each product page includes a clear ingredient list and straightforward usage notes."
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "returns",
            "question": "What is the return window?",
            "answer": "Unused items may be eligible for return within the stated window. Start with your order number and support email."
          }
        },
        {
          "type": "question",
          "settings": {
            "category": "returns",
            "question": "What if something arrived damaged?",
            "answer": "Send a photo and your order number to support, and we’ll explain the next available step."
          }
        }
      ]
    }
  ]
}
{% endschema %}
