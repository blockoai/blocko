{%- comment -%} Generated by Blocko from tools/themes/lather/groups/brand.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-brand-section blko-{{ section.settings.color_scheme.id | escape }}"><header class="blko-brand-head"><p class="blko-brand-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p class="blko-brand-lede">{{ section.settings.lede | escape | newline_to_br }}</p></header><ul class="blko-brand-swatches"><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-bg)"></span><strong>{{ section.settings.name_bg | escape }}</strong><code class="blko-brand-hex">{{ settings.color_bg | escape }}</code><span class="blko-brand-swatch__token">--color-bg</span><span class="blko-brand-swatch__role">{{ section.settings.role_bg | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-bg-alt)"></span><strong>{{ section.settings.name_bg_alt | escape }}</strong><code class="blko-brand-hex">{{ settings.color_bg_alt | escape }}</code><span class="blko-brand-swatch__token">--color-bg-alt</span><span class="blko-brand-swatch__role">{{ section.settings.role_bg_alt | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-text)"></span><strong>{{ section.settings.name_text | escape }}</strong><code class="blko-brand-hex">{{ settings.color_text | escape }}</code><span class="blko-brand-swatch__token">--color-text</span><span class="blko-brand-swatch__role">{{ section.settings.role_text | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-text-muted)"></span><strong>{{ section.settings.name_text_muted | escape }}</strong><code class="blko-brand-hex">{{ settings.color_text_muted | escape }}</code><span class="blko-brand-swatch__token">--color-text-muted</span><span class="blko-brand-swatch__role">{{ section.settings.role_text_muted | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-border)"></span><strong>{{ section.settings.name_border | escape }}</strong><code class="blko-brand-hex">{{ settings.color_border | escape }}</code><span class="blko-brand-swatch__token">--color-border</span><span class="blko-brand-swatch__role">{{ section.settings.role_border | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-button)"></span><strong>{{ section.settings.name_button | escape }}</strong><code class="blko-brand-hex">{{ settings.color_button | escape }}</code><span class="blko-brand-swatch__token">--color-button</span><span class="blko-brand-swatch__role">{{ section.settings.role_button | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-accent)"></span><strong>{{ section.settings.name_accent | escape }}</strong><code class="blko-brand-hex">{{ settings.color_accent | escape }}</code><span class="blko-brand-swatch__token">--color-accent</span><span class="blko-brand-swatch__role">{{ section.settings.role_accent | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-sale)"></span><strong>{{ section.settings.name_sale | escape }}</strong><code class="blko-brand-hex">{{ settings.color_sale | escape }}</code><span class="blko-brand-swatch__token">--color-sale</span><span class="blko-brand-swatch__role">{{ section.settings.role_sale | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-announcement-bg)"></span><strong>{{ section.settings.name_announcement_bg | escape }}</strong><code class="blko-brand-hex">{{ settings.color_announcement_bg | escape }}</code><span class="blko-brand-swatch__token">--color-announcement-bg</span><span class="blko-brand-swatch__role">{{ section.settings.role_announcement_bg | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-footer-bg)"></span><strong>{{ section.settings.name_footer_bg | escape }}</strong><code class="blko-brand-hex">{{ settings.color_footer_bg | escape }}</code><span class="blko-brand-swatch__token">--color-footer-bg</span><span class="blko-brand-swatch__role">{{ section.settings.role_footer_bg | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-success)"></span><strong>{{ section.settings.name_success | escape }}</strong><code class="blko-brand-hex">{{ settings.color_success | escape }}</code><span class="blko-brand-swatch__token">--color-success</span><span class="blko-brand-swatch__role">{{ section.settings.role_success | escape }}</span></li><li class="blko-brand-swatch"><span class="blko-brand-swatch__chip" style="background:var(--color-error)"></span><strong>{{ section.settings.name_error | escape }}</strong><code class="blko-brand-hex">{{ settings.color_error | escape }}</code><span class="blko-brand-swatch__token">--color-error</span><span class="blko-brand-swatch__role">{{ section.settings.role_error | escape }}</span></li></ul></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.01em;--kit-heading-transform:uppercase;--kit-heading-weight:800;--font-heading:"Archivo",Arial Black,Arial,sans-serif;--color-text-muted:CanvasText;--text-small:.75rem;--font-mono:var(--font-accent);--font-accent:"Figtree",Arial,sans-serif;--weight-body:400;--kit-radius-card:14px;--color-border:ButtonFace;--leading-display:.9;--text-h2:1.875rem;--weight-light:300;--color-text:CanvasText;--color-bg:Canvas;--leading-body:1.5;--text-body:1rem;--kit-label-transform:uppercase;--tracking-label:.075rem;--leading-label:1.5;--text-label:0.75rem;--weight-medium:500;--tracking-h2:-.08rem;--font-body:"Figtree",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.25rem;--text-body:1.25rem;--text-label:0.8125rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-brand-eyebrow{margin:0;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase);opacity:.75}
.blko-theme .blko-brand-lede{margin:0;max-width:40rem;font-size:var(--text-body);line-height:var(--leading-body)}
.blko-theme .blko-brand-section{padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem);background:var(--color-bg);color:var(--color-text);display:grid;gap:2rem}
.blko-theme .blko-brand-head{display:grid;gap:.6rem;max-width:44rem}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-swatches{list-style:none;margin:0;padding:0;display:grid;gap:1.25rem;grid-template-columns:repeat(auto-fill,minmax(8.5rem,1fr))}
.blko-theme .blko-brand-swatch{display:grid;gap:.3rem;align-content:start}
.blko-theme .blko-brand-swatch__chip{display:block;aspect-ratio:4/3;border:1px solid var(--color-border);border-radius:var(--kit-radius-card,0)}
.blko-theme .blko-brand-hex{font:var(--weight-body) var(--text-small)/1.3 var(--font-mono);color:var(--color-text-muted);word-break:break-all}
.blko-theme .blko-brand-swatch__token{font:var(--weight-body) var(--text-small)/1.3 var(--font-mono);color:var(--color-text-muted);word-break:break-all}
.blko-theme .blko-brand-swatch__role{font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme h2{font-variation-settings:"wdth" 125}
.blko-theme h2{overflow-wrap:break-word!important}
{% endstylesheet %}
