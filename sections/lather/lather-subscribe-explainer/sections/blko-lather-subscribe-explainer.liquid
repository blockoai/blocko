{% schema %}
{
  "name": "Subscribe and save",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A habit, not a discount"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe, save and stop thinking about it"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Build my box"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pick your bundle"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Choose your soap, deodorant or cologne."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscribe and save",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Every three months",
            "text": "Your box ships on a quarterly rhythm. Edit the items or snooze it from your account whenever you like."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Shipping is on us",
            "text": "Every subscription order travels free, with no minimum to hit."
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "First in line",
            "text": "Subscribers hear about limited bars before anyone else and earn bonus points on their first renewal."
          }
        }
      ]
    }
  ]
}
{% endschema %}
