<div class="blko-theme" {{ block.shopify_attributes }}><blko-cart-checkout><blko-cart-drawer>{% for item in cart.items %}<article class="blko-cart-checkout-line-item" data-cart-checkout-line-item data-cart-checkout-line data-key="{{ item.key | escape }}">{% if item.image != blank %}{{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210, 315, 420', alt: item.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div>{% if item.variant.title != blank and item.variant.title != 'Default Title' %}<p class="blko-eyebrow">{{ item.variant.title | escape }}</p>{% else %}{% endif %}<h2><a href="{{ item.url | escape }}">{{ item.product.title | escape }}</a></h2><p class="blko-cart-checkout-price">{{ item.final_price | money_without_trailing_zeros }}</p><div class="blko-cart-checkout-quantity" data-cart-checkout-line-quantity><button type="button" aria-label="{{ 'blko.cart.decrease' | t }}" data-cart-checkout-line-step="-1">−</button><output data-cart-checkout-line-qty>{{ item.quantity | escape }}</output><button type="button" aria-label="{{ 'blko.cart.increase' | t }}" data-cart-checkout-line-step="1">+</button><input type="hidden" name="updates[]" value="{{ item.quantity | escape }}"></div><a class="blko-cart-checkout-text-button" href="{{ item.url_to_remove | escape }}" data-cart-checkout-line-remove>{{ 'blko.cart.remove' | t }}</a></div><strong aria-label="{{ 'blko.cart.line_total' | t }}" data-cart-checkout-line-total>{{ item.final_line_price | money_without_trailing_zeros }}</strong></article>{% endfor %}</blko-cart-drawer></blko-cart-checkout></div>
