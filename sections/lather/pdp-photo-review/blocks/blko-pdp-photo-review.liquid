{% schema %}
{
  "name": "Photo review card",
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Verified buyer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Smells like a hike"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "It evens out my soap while looking natural."
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "photo_alt",
      "label": "Photo alt text",
      "default": "Customer makeup result"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "Wood & Musk · photo review"
    }
  ],
  "presets": [
    {
      "name": "Photo review card"
    }
  ]
}
{% endschema %}
