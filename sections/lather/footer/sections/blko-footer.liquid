{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Clean, loud grooming for men who like to smell good."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer-shop"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {}
        },
        {
          "type": "column",
          "settings": {
            "title": "Our story",
            "menu": "footer-about"
          }
        }
      ]
    }
  ]
}
{% endschema %}
