{% schema %}
{
  "name": "Campaign hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Man hiking a ridge at golden hour"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Big bar energy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Smell like you mean it."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Natural soap, deodorant and cologne with bold scents and zero junk."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop bar soap"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    }
  ],
  "presets": [
    {
      "name": "Campaign hero"
    }
  ]
}
{% endschema %}
