{% stylesheet %}
:where(.blko-theme){--color-line:var(--color-border);--color-border:ButtonFace;--font-mono:var(--font-accent);--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--text-label:0.75rem;--weight-medium:500;--color-bg:Canvas;--leading-body:1.5;--text-small:.75rem;--color-text-muted:CanvasText;--color-accent:GrayText;--tracking-label:.075rem;--font-display:var(--font-heading);--font-heading:"Archivo",Arial Black,Arial,sans-serif;--leading-display:.9;--text-h2:1.875rem;--color-footer-bg:CanvasText;--color-button-text:Canvas;--text-display:2.75rem;--color-ink:var(--color-text);--color-text:CanvasText;--color-input-text:CanvasText;--color-input-bg:Canvas;--color-overlay:rgb(0 0 0 / .4);--font-body:"Figtree",Arial,sans-serif;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-label:0.8125rem;--text-h2:2.25rem;--text-display:4.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-faq-search input:focus-visible{outline:2px solid var(--color-text-muted);outline-offset:3px}
.blko-theme .blko-content-faq-search{display:grid;grid-template-columns:11rem 1fr;gap:1rem;align-items:center;padding:1.5rem 0;border-block:1px solid var(--color-line)}
.blko-theme .blko-content-faq-search span{font-weight:600}
.blko-theme .blko-content-faq-search input{width:100%;border:0;background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.75rem 0}
@media (max-width:760px){.blko-theme .blko-content-faq-search{grid-template-columns:1fr;padding-block:1rem}}
.blko-theme .blko-category-card span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-category-card span{position:absolute;left:1rem;bottom:1rem;color:var(--color-button-text);font-family:var(--font-accent);text-shadow:0 1px 8px var(--color-overlay)}
.blko-theme .blko-newsletter input{padding:.8rem;border:0;border-bottom:1px solid var(--color-text);background:var(--color-input-bg);color:var(--color-input-text)}
.blko-theme .blko-search-panel input{padding:.8rem;border:0;border-bottom:1px solid var(--color-text);background:var(--color-input-bg);color:var(--color-input-text)}
