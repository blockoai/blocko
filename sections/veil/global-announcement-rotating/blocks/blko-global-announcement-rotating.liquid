{%- comment -%} Generated by Blocko from tools/themes/veil/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-global><aside class="blko-global-announce blko-global-announce--rotate" data-global-rotate data-global-messages="{{ block.settings.message_1 | escape }}||{{ block.settings.message_2 | escape }}||{{ block.settings.message_3 | escape }}" aria-live="polite"><span data-global-rotate-message>{{ block.settings.message_1 | escape }}</span><div><button type="button" data-global-rotate-prev aria-label="Previous announcement">←</button><button type="button" data-global-rotate-next aria-label="Next announcement">→</button></div></aside></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-button-text:#ffffff;--color-ink:var(--color-text);--color-text:#5e5047;--color-bg:var(--color-paper);--color-paper:var(--color-bg-alt);--color-bg-alt:#f7f4f0;--color-line:var(--color-border);--color-border:#d6d0c7;--text-small:.75rem;--text-title:2rem;--font-mono:var(--font-accent);--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--color-accent:#bba293;--text-body:1rem}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem;--text-body:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-global-announce{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.75rem 5vw;background:var(--color-text);color:var(--color-bg)}
.blko-theme .blko-global-announce button{border:0;background:color-mix(in srgb, var(--color-bg) 0%, transparent);color:inherit;cursor:pointer;font-size:var(--text-body)}
.blko-theme .blko-global-announce--countdown{background:var(--color-accent)}
.blko-theme .blko-global-announce.blko-global-announce--rotate{color:var(--color-bg)}
.blko-theme .blko-home-collection-filter-chips button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-home-collection-filter-drawer__choices button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-home-collection-active-filters button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-home-collection-active-filters button{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);text-transform:uppercase}
.blko-theme .blko-home-collection-quick-view>button{position:absolute;z-index:1;right:.7rem;top:.5rem;border:0;background:color-mix(in srgb, var(--color-bg) 0%, transparent);font-size:var(--text-title);cursor:pointer}
.blko-theme .blko-home-collection-quick-view__choices button{padding:.55rem .7rem;border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
.blko-theme .blko-pdp-gallery__thumbs button{padding:0;border:1px solid transparent;background:color-mix(in srgb, var(--color-bg) 0%, transparent);aspect-ratio:1;cursor:pointer}
.blko-theme .blko-pdp-shades button{width:2.2rem;height:2.2rem;border:3px solid var(--color-paper);border-radius:50%;outline:1px solid transparent;background:var(--pdp-shade);cursor:pointer}
.blko-theme .blko-pdp-size button{color:var(--color-text);border:1px solid var(--color-line);padding:.7rem .8rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
.blko-theme .blko-pdp-plan button{color:var(--color-text);display:grid;grid-template-columns:1fr auto;gap:.25rem;padding:1rem;border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);text-align:left;cursor:pointer}
.blko-theme .blko-pdp-review-filters button{color:var(--color-text);border:1px solid var(--color-line);padding:.45rem .6rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);font-size:var(--text-small);cursor:pointer}
.blko-theme .blko-pdp-bundle-item>button{border:1px solid var(--color-ink);padding:.65rem .9rem;background:color-mix(in srgb, var(--color-bg) 0%, transparent);cursor:pointer}
@media(max-width:760px){.blko-theme .blko-pdp-bundle-item>button{grid-column:1/-1}}
.blko-theme .blko-search-blog-tabs button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-tag-filter button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-filters button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-pagination button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-share button{border:1px solid var(--color-line);background:color-mix(in srgb, var(--color-bg) 0%, transparent);padding:.55rem .75rem;cursor:pointer}
.blko-theme .blko-search-blog-tag-filter .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-filters .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-pagination .is-active{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-button-text)}
.blko-theme .blko-search-blog-filters button{text-align:left}
.blko-theme .blko-global-announce--rotate{color:inherit}
{% endstylesheet %}
