{% schema %}
{
  "name": "Shade finder result",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Recommended tints"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add label",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your starting point"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two shades to try first."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Based on your selections, these flexible shades are a beautiful place to start. Use the swatches below to compare."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add suggested tint"
    },
    {
      "type": "text",
      "id": "card_eyebrow",
      "label": "Card eyebrow",
      "default": "Flexible tint"
    },
    {
      "type": "text",
      "id": "card_detail",
      "label": "Card detail",
      "default": "Natural finish · SPF 40"
    }
  ],
  "blocks": [
    {
      "type": "swatch",
      "name": "Swatch",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "tone",
          "label": "Swatch tone",
          "options": [
            {
              "value": "light",
              "label": "Light"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "deep",
              "label": "Deep"
            }
          ],
          "default": "light"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Light neutral shade"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shade finder result",
      "blocks": [
        {
          "type": "swatch",
          "settings": {}
        },
        {
          "type": "swatch",
          "settings": {
            "label": "Medium neutral shade",
            "tone": "medium"
          }
        }
      ]
    }
  ]
}
{% endschema %}
