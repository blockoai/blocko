-%}
<div class="blko-theme"><blko-beauty-extras><section class="blko-beauty-extras-result blko-beauty-extras-panel" data-beauty-extras-result hidden>
  <div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><div class="blko-beauty-extras-swatches">{% for block in section.blocks %}<button style="--swatch:var(--color-swatch-{{ block.settings.tone | escape }})" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}></button>{% endfor %}</div><a class="blko-button" href="{{ collection.products.first.url | escape }}">{{ section.settings.button_label | escape }}</a></div>
  <div class="blko-beauty-extras-result-cards">{% for product in collection.products limit: 2 %}<article>{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 680 | image_tag: loading: 'lazy', widths: '340, 510, 680', alt: product.featured_image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<p class="blko-eyebrow">{{ section.settings.card_eyebrow | escape }}</p><h3>{{ product.title | escape }}</h3><p>{{ section.settings.card_detail | escape }}</p>{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | escape }}"><button type="submit">{{ section.settings.add_label | escape }} — {{ product.price | money_without_trailing_zeros }}</button>{% endform %}</article>{% endfor %}</div>
</section></blko-beauty-extras></div>
<script type="module" src="{{ 'blko-beauty-extras.js' | asset_url }}"></script>
