{% schema %}
{
  "name": "Values in practice",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "How we decide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three rules for every formula"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Make it wearable"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Thoughtful textures and shades that work with the skin you have, not against it."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values in practice",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Safe for sensitive skin",
            "text": "Every product is tested on reactive skin before it ships."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "02",
            "title": "Only what earns its place",
            "text": "We leave out fragrance, gluten and silicones unless there is a clear reason."
          }
        },
        {
          "type": "value",
          "settings": {
            "number": "03",
            "title": "Show our work",
            "text": "Ingredient lists, study results and sourcing notes stay public."
          }
        }
      ]
    }
  ]
}
{% endschema %}
