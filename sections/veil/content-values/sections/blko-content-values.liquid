{%- comment -%} Generated by Blocko from tools/themes/veil/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-content><section class="blko-content-values"><div class="blko-content-section-intro"><p class="blko-content-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-content-values-grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><span>{{ block.settings.number | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></article>{% endfor %}</div></section></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--font-heading:"Cormorant Garamond",Georgia,serif;--leading-card-title:1.125;--text-card-title:1.5rem;--weight-light:300;--tracking-label:.075rem;--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--leading-display:.9;--text-h2:2rem;--text-title:2rem;--text-display:2.5rem;--font-display:var(--font-heading);--leading-h3:1.5;--text-h4:1.25rem;--font-mono:var(--font-accent);--tracking-body:-.02rem;--text-small:.75rem;--leading-body:1.5;--color-text-muted:CanvasText;--color-accent:GrayText;--color-footer-bg:CanvasText;--color-button-text:Canvas;--color-overlay:rgb(0 0 0 / .4);--tracking-card-title:-.06rem;--tracking-h3:.0875rem;--text-h3:.875rem;--tracking-h2:-.08rem;--color-line:var(--color-border);--color-border:ButtonFace;--text-body:1rem;--font-sans:var(--font-body);--weight-body:400;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg-alt);--color-bg-alt:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:2rem;--text-h2:2.5rem;--text-title:2.5rem;--text-display:5rem;--text-h4:1.5rem;--tracking-body:-.025rem;--tracking-card-title:-.08rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem;--text-body:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-kicker{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none;margin:0 0 1rem;color:var(--color-text-muted)}
.blko-theme .blko-content-section-intro{max-width:43rem}
.blko-theme .blko-content-section-intro h2{margin-top:0}
.blko-theme .blko-content-mission h2{margin:.3rem 0 1.5rem}
.blko-theme .blko-content-values{padding:clamp(4rem,9vw,9rem) 5vw}
.blko-theme .blko-content-values-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:3rem;border-top:1px solid var(--color-line)}
.blko-theme .blko-content-values-grid article{padding:1.5rem 1.5rem 1.5rem 0;border-bottom:1px solid var(--color-line)}
.blko-theme .blko-content-values-grid article+article{padding-left:1.5rem;border-left:1px solid var(--color-line)}
.blko-theme .blko-content-values-grid span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);color:var(--color-text-muted)}
.blko-theme .blko-content-value-card>span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);color:var(--color-text-muted)}
.blko-theme .blko-content-values-grid h3{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);letter-spacing:var(--tracking-body);margin:1.5rem 0 .75rem}
.blko-theme .blko-content-value-card h3{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);letter-spacing:var(--tracking-body);margin:1.5rem 0 .75rem}
.blko-theme .blko-content-signature span{font:var(--weight-body) var(--text-small)/var(--leading-body) var(--font-sans)}
.blko-theme .blko-content-story-timeline h3{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);letter-spacing:var(--tracking-body);margin:0}
