.blko-theme .blko-content-policy-document h2{font-size:var(--text-h2);margin:.1rem 0 1rem}
.blko-theme .blko-content-landing-routine h3{font:var(--weight-medium) var(--text-h2)/var(--leading-h3) var(--font-display);letter-spacing:var(--tracking-body);margin:.35rem 0}
@media (max-width:760px){.blko-theme .blko-content-values-grid{grid-template-columns:1fr}
.blko-theme .blko-content-values-grid article+article{padding-left:0;border-left:0}
.blko-theme .blko-content-contact-channels article+article{border-left:0;border-top:1px solid var(--color-line)}}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
