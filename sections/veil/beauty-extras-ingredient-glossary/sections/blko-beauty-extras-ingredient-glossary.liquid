{% endstylesheet %}
{% schema %}
{
  "name": "Ingredient glossary",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ingredient index"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What goes in, and why."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Look up the actives and gentle extras in every formula, from the SPF filter to the humectants."
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search ingredients"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Try “niacinamide”"
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Note label",
      "default": "Read note ↗"
    },
    {
      "type": "text",
      "id": "detail_eyebrow",
      "label": "Detail eyebrow",
      "default": "Ingredient detail"
    },
    {
      "type": "text",
      "id": "detail_heading",
      "label": "Detail heading",
      "default": "Niacinamide"
    },
    {
      "type": "textarea",
      "id": "detail_text",
      "label": "Detail text",
      "default": "A form of vitamin B3 that helps skin look smoother and more even. It is well tolerated and works with the other actives in the tinted serum."
    },
    {
      "type": "text",
      "id": "best_for_label",
      "label": "Best for label",
      "default": "Best for"
    },
    {
      "type": "text",
      "id": "best_for",
      "label": "Best for",
      "default": "Uneven tone and visible pores"
    },
    {
      "type": "text",
      "id": "found_in_label",
      "label": "Found in label",
      "default": "Found in"
    },
    {
      "type": "text",
      "id": "found_in",
      "label": "Found in",
      "default": "Tinted serum, face milk"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "limit": 8,
      "settings": [
        {
          "type": "checkbox",
          "id": "active",
          "label": "Active by default",
          "default": false
        },
        {
          "type": "text",
          "id": "key",
          "label": "Filter key (matches ingredient tags)",
          "default": "all"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All"
        }
      ]
    },
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (space separated)",
          "default": "soothing hydration"
        },
        {
          "type": "text",
          "id": "letter",
          "label": "Letter",
          "default": "A"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Aloe leaf juice"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "Detail",
          "default": "Calms and cushions skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient glossary",
      "blocks": [
        {
          "type": "filter",
          "settings": {
            "active": true
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Hydration",
            "key": "hydration"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Sun protection",
            "key": "sun"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Barrier",
            "key": "barrier"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Allantoin",
            "detail": "Comforts reactive, easily irritated skin",
            "tags": "barrier"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "letter": "H",
            "name": "Hyaluronic acid",
            "detail": "Holds many times its weight in water for plump-looking skin",
            "tags": "hydration"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "letter": "N",
            "name": "Niacinamide",
            "detail": "Smooths the look of pores and uneven tone",
            "tags": "barrier"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "letter": "S",
            "name": "Squalane",
            "detail": "A plant-based oil that seals in moisture without clogging",
            "tags": "hydration"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "letter": "Z",
            "name": "Zinc oxide",
            "detail": "A non-nano mineral filter that sits on skin and reflects UV",
            "tags": "sun"
          }
        }
      ]
    }
  ]
}
{% endschema %}
