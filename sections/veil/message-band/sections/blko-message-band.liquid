.blko-theme .blko-message-band{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-message-band{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding:.7rem 5vw;text-align:center;background:var(--color-bg);color:var(--color-text);border-block:1px solid var(--color-border)}
@media(max-width:760px){.blko-theme .blko-message-band{gap:.35rem;padding-inline:1rem;font-size:clamp(.55rem,2.1vw,.72rem);line-height:1.25}}
