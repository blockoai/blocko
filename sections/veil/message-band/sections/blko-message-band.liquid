{% stylesheet %}
:where(.blko-theme){--color-border:ButtonFace;--color-text:CanvasText;--color-bg:var(--color-paper);--color-paper:var(--color-bg-alt);--color-bg-alt:Canvas;--tracking-label:.075rem;--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--color-ink:var(--color-text)}
