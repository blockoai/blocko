:where(.blko-theme){--text-title:2rem;--text-display:2.5rem;--color-paper:var(--color-bg-alt);--color-bg-alt:Canvas;--color-ink:var(--color-text);--color-text:CanvasText;--color-button-text:Canvas;--text-small:.75rem;--color-bg:var(--color-paper);--font-display:var(--font-heading);--font-heading:"Cormorant Garamond",Georgia,serif;--leading-card-title:1.125;--text-card-title:1.5rem;--weight-medium:500;--leading-display:.9;--text-h2:2rem;--color-footer-bg:CanvasText;--color-button:CanvasText;--color-overlay:rgb(0 0 0 / .4);--tracking-h2:-.08rem;--weight-light:300;--font-body:"DM Sans",Arial,sans-serif;--color-line:var(--color-border);--color-border:ButtonFace;--color-footer-text:Canvas;--color-text-muted:CanvasText;--tracking-label:.075rem;--font-sans:var(--font-body);--leading-label:1.5;--text-label:.75rem;--color-accent:GrayText}
