{%- comment -%} Generated by Blocko from tools/themes/veil/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection | default: collection | default: collections.all
-%}
<div class="blko-theme"><blko-pdp><section class="blko-pdp-bundle" data-pdp-bundle data-pdp-live data-pdp-currency="{{ cart.currency.iso_code | escape }}" data-pdp-cart-add="{{ routes.cart_add_url | escape }}" data-pdp-cart="{{ routes.cart_url | escape }}"><div class="blko-pdp-bundle__intro"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape }}</p><div class="blko-pdp-bundle__meter"><span data-pdp-bundle-count>0</span> of 3 selected <i><b data-pdp-bundle-progress></b></i></div></div><div class="blko-pdp-bundle__choices">{% for pick in collection.products limit: 5 %}<article class="blko-pdp-bundle-item" data-pdp-bundle-item data-pdp-price-cents="{{ pick.price | escape }}" data-pdp-variant="{{ pick.selected_or_first_available_variant.id | escape }}">{% if pick.featured_image != blank %}{{ pick.featured_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: pick.featured_image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{% if pick.type != blank %}Step {{ forloop.index }} · {{ pick.type | escape }}{% else %}Step {{ forloop.index }}{% endif %}</p><h2>{{ pick.title | escape }}</h2><p>{{ pick.description | strip_html | truncate: 160 | escape }}</p><strong>{{ pick.price | money_without_trailing_zeros }}</strong></div><button type="button" data-pdp-bundle-toggle aria-pressed="false" data-pdp-remove="{{ 'blko.pdp.remove' | t }}"{% if pick.available == blank %} disabled{% else %}{% endif %}>{{ 'blko.pdp.add' | t }}</button></article>{% endfor %}</div><aside class="blko-pdp-bundle__summary"><div><p class="blko-eyebrow">{{ section.settings.summary_eyebrow | escape }}</p><strong data-pdp-bundle-summary>{{ section.settings.summary_empty | escape }}</strong><p data-pdp-bundle-saving>{{ section.settings.saving_text | escape }}</p></div><div><p class="blko-pdp-price"><strong>$0</strong><span>{{ section.settings.price_note | escape }}</span></p></div><button class="blko-button" type="button" data-pdp-bundle-add disabled>{{ section.settings.add_label | escape }}</button></aside></section></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
