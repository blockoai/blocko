{%- comment -%} Generated by Blocko from tools/themes/veil/groups/search-blog.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign article = section.settings.article | default: article | default: blog.articles.first
-%}
<div class="blko-theme"><blko-search-blog>{% if article != blank %}<section class="blko-search-blog-featured-post">{% if article.image != blank %}{{ article.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '350, 700, 1050, 1400', alt: article.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.eyebrow_prefix | escape }} · {{ article.tags.first | escape }}</p><h2>{{ article.title | escape }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate: 160 | escape }}</p><p class="blko-search-blog-meta">By {{ article.author | escape }} · {{ section.settings.reading_time | escape }}</p><a class="blko-button" href="{{ article.url | escape }}">{{ section.settings.button_label | escape }}</a></div></section>{% else %}{% endif %}</blko-search-blog></div>
<script type="module" src="{{ 'blko-search-blog.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--text-title:2rem;--tracking-label:.075rem;--font-mono:var(--font-accent);--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--text-display:2.5rem;--color-paper:var(--color-bg-alt);--color-bg-alt:Canvas;--color-ink:var(--color-text);--color-text:CanvasText;--color-button-text:Canvas;--text-small:.75rem;--color-bg:var(--color-paper);--leading-display:.9;--color-button:CanvasText;--tracking-button:.075rem;--leading-button:1.5;--text-button:.75rem;--tracking-h2:-.08rem;--weight-light:300;--text-h2:2rem;--color-border:ButtonFace;--color-accent:GrayText;--color-button-hover:CanvasText}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem;--text-display:5rem;--tracking-h2:-.1rem;--text-h2:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
