{% schema %}
{
  "name": "Collection directory",
  "settings": [
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "Collections per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your everyday."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover routines, color stories, and tools made to fit into real life."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore"
    },
    {
      "type": "text",
      "id": "pager_label",
      "label": "Pager label",
