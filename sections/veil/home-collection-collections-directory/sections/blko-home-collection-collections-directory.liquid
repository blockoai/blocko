{%- comment -%} Generated by Blocko from tools/themes/veil/groups/home-collection.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-home-collection><section class="blko-home-collection-directory">{% paginate collections by section.settings.collections_per_page %}<div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p></div><div class="blko-home-collection-directory__grid">{% for collection in collections %}<a href="{{ collection.url | escape }}">{% if collection.image != blank %}{{ collection.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '200, 400, 600, 800', alt: collection.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span>{{ collection.title | escape }}</span><small>{{ section.settings.link_label | escape }}</small></a>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="blko-home-collection-pager" aria-label="{{ section.settings.pager_label | escape }}">{% if paginate.previous.url != blank %}<a href="{{ paginate.previous.url | escape }}" rel="prev">{{ section.settings.previous_label | escape }}</a>{% else %}{% endif %}<span>{{ 'blko.collection.page' | t }} {{ paginate.current_page | escape }} {{ 'blko.collection.of' | t }} {{ paginate.pages | escape }}</span>{% if paginate.next.url != blank %}<a href="{{ paginate.next.url | escape }}" rel="next">{{ section.settings.next_label | escape }}</a>{% else %}{% endif %}</nav>{% else %}{% endif %}{% endpaginate %}</section></blko-home-collection></div>
<script type="module" src="{{ 'blko-home-collection.js' | asset_url }}"></script>
