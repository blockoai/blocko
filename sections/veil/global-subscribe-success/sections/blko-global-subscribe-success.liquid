{%- comment -%} Generated by Blocko from tools/themes/veil/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-global><section class="blko-global-page blko-global-page--success"><div class="blko-global-success-mark" aria-hidden="true">✓</div><p class="blko-global-kicker">{{ section.settings.kicker | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p><a class="blko-button" href="{{ routes.all_products_collection_url | escape }}">{{ section.settings.button_label | escape }}</a></section></blko-global></div>
