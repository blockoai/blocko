{%- comment -%} Generated by Blocko from tools/themes/veil/groups/search-blog.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign article = section.settings.article | default: article
-%}
<div class="blko-theme"><blko-search-blog><section id="article" class="blko-search-blog-article-hero"><div><p class="blko-breadcrumb"><a href="{{ routes.root_url | escape }}">{{ section.settings.home_label | escape }}</a> / <a href="{{ article.blog.url | escape }}">{{ article.blog.title | escape }}</a> / {{ article.tags.first | escape }}</p><p class="blko-eyebrow">{{ article.tags.first | escape }}</p><h1>{{ article.title | escape }}</h1><p class="blko-search-blog-dek">{{ article.excerpt_or_content | strip_html | truncate: 160 | escape }}</p><p class="blko-search-blog-meta">By {{ article.author | escape }} · {{ article.published_at | date: '%B %-d, %Y' }} · {{ section.settings.reading_time | escape }}</p></div>{% if article.image != blank %}{{ article.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 800, 1200, 1600', alt: article.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</section></blko-search-blog></div>
<script type="module" src="{{ 'blko-search-blog.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-text-muted:CanvasText;--tracking-label:.075rem;--font-mono:var(--font-accent);--font-accent:var(--font-body);--font-body:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--color-paper:var(--color-bg-alt);--color-bg-alt:Canvas;--color-ink:var(--color-text);--color-text:CanvasText;--color-sand:var(--color-bg-alt);--tracking-h1:-.08rem;--leading-display:.9;--weight-light:300;--text-h1:2rem;--color-border:ButtonFace;--color-accent:GrayText}
@media (min-width:1024px){:where(.blko-theme){--tracking-h1:-.16rem;--text-h1:3.75rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h1{font-family:var(--font-body);font-size:var(--text-h1);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h1)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-breadcrumb{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-search-blog-article-hero h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-empty h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-article-hero{display:grid;grid-template-columns:1fr 1fr;background:var(--color-sand)}
.blko-theme .blko-search-blog-article-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-article-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post img{width:100%;height:100%;min-height:520px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post>div{padding:clamp(2rem,6vw,6rem);background:var(--color-ink);color:var(--color-paper)}
.blko-theme .blko-search-blog-meta{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase}
@media(max-width:760px){.blko-theme .blko-search-blog-article-hero{grid-template-columns:1fr}
.blko-theme .blko-search-blog-empty img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-journal-hero img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-article-hero img{min-height:0;aspect-ratio:1}}
.blko-theme .blko-search-blog-dek{color:var(--color-text-muted)}
{% endstylesheet %}
{% schema %}
{
  "name": "Article title & metadata",
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Article"
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "reading_time",
      "label": "Reading time",
      "default": "6 minutes"
    }
  ],
  "presets": [
    {
      "name": "Article title & metadata"
    }
  ]
}
{% endschema %}
