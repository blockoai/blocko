.blko-theme .blko-search-blog-filters button{text-align:left}
.blko-theme .blko-search-blog-result img{width:100%;aspect-ratio:1.05;object-fit:cover}
.blko-theme .blko-search-blog-article-card img{width:100%;aspect-ratio:1.05;object-fit:cover}
.blko-theme .blko-search-blog-result h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-search-blog-article-card h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-search-blog-empty>div{padding:clamp(3rem,10vw,9rem) 5vw;text-align:left}
.blko-theme .blko-search-blog-empty img{width:100%;height:100%;min-height:520px;object-fit:cover}
.blko-theme .blko-search-blog-journal-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-article-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-journal-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-article-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post img{width:100%;height:100%;min-height:520px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post>div{padding:clamp(2rem,6vw,6rem);background:var(--color-ink);color:var(--color-paper)}
.blko-theme .blko-search-blog-inline-products>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
.blko-theme .blko-search-blog-related__grid .blko-search-blog-article-card img{aspect-ratio:.9}
@media(max-width:760px){.blko-theme .blko-search-blog-filters p{display:none}
.blko-theme .blko-search-blog-empty img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-journal-hero img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-article-hero img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-inline-products>div{grid-template-columns:1fr}}
.blko-theme .blko-home-collection-filter-drawer[aria-hidden=true]{display:none}
.blko-theme .blko-shelf-standards__item h3{margin:.75rem 0 .4rem;color:inherit}
.blko-theme .blko-shelf-standards__item p{margin:0;opacity:.8}
.blko-theme .blko-shelf-visit__card img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.blko-theme .blko-shelf-visit__body p{margin:0 0 1.25rem}
.blko-theme .blko-shelf-rewards p{margin:0;color:var(--color-bg)}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-type__face--heading strong{font-family:var(--font-heading);font-weight:var(--kit-heading-weight,var(--weight-light))}
.blko-theme .blko-brand-type__face--body strong{font-family:var(--font-body)}
.blko-theme .blko-brand-type__face--accent strong{font-family:var(--font-accent)}
.blko-theme .blko-brand-rule p{margin:0;font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-brand-do h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-dont h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-card h3{margin:0 0 .5rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-card-title)/var(--leading-card-title) var(--font-heading)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme .blko-hero{display:grid;grid-template-columns:1fr 1.15fr .85fr;grid-template-areas:'copy main tall' 'small main tall';gap:clamp(.75rem,1.5vw,1.25rem);min-height:0;padding:clamp(1.5rem,4vw,3rem) 5vw;background:var(--color-bg-alt);color:var(--color-text)}
@media(max-width:760px){.blko-theme.blko-theme .blko-hero{grid-template-columns:1fr 1fr;grid-template-areas:'copy copy' 'main main' 'small tall'}
.blko-theme.blko-theme .blko-hero>img{min-height:0;aspect-ratio:4/5}}
