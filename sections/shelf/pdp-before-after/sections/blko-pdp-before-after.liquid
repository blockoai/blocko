      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 value",
      "default": "94%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "said it absorbed fast"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 value",
      "default": "91%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "said it calmed their skin"
    },
    {
