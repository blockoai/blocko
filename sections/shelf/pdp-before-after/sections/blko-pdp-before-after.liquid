{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-pdp><section class="blko-pdp-before-after" aria-labelledby="pdp-results-title"><div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="pdp-results-title">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p><div class="blko-pdp-stat-grid"><p><strong>{{ section.settings.stat_1_value | escape }}</strong><span>{{ section.settings.stat_1_label | escape }}</span></p><p><strong>{{ section.settings.stat_2_value | escape }}</strong><span>{{ section.settings.stat_2_label | escape }}</span></p></div></div><div class="blko-pdp-compare" data-pdp-compare>{% if section.settings.after_image != blank %}{{ section.settings.after_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '275, 550, 825, 1100', alt: section.settings.after_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div class="blko-pdp-compare__before">{% if section.settings.before_image != blank %}{{ section.settings.before_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '275, 550, 825, 1100', alt: section.settings.before_image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</div><input type="range" min="0" max="100" value="50" data-pdp-compare-range aria-label="{{ 'blko.pdp.reveal_comparison' | t }}"><span class="blko-pdp-compare__label blko-pdp-compare__label--before">{{ 'blko.pdp.before' | t }}</span><span class="blko-pdp-compare__label blko-pdp-compare__label--after">{{ 'blko.pdp.after' | t }}</span></div></section></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-line:var(--color-border);--color-border:ButtonFace;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Fraunces",Georgia,serif;--kit-radius-image:0;--color-text-muted:CanvasText;--text-small:.75rem;--font-accent:"Barlow Semi Condensed",Arial Narrow,Arial,sans-serif;--font-body:"Assistant",Arial,sans-serif;--weight-light:300;--leading-display:.9;--text-h2:2rem;--color-bg:Canvas;--text-title:2rem;--text-display:2.5rem;--font-mono:var(--font-accent);--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:1.5rem;--tracking-label:.075rem;--leading-body:1.5;--color-sand:var(--color-bg-alt);--color-bg-alt:Canvas;--tracking-h2:-.08rem;--color-accent:GrayText;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--text-title:2.5rem;--text-display:4rem;--text-card-title:2rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
