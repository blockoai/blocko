{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/shelf.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-shelf-clean"><div class="blko-shelf-clean__head"><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.lede | escape | newline_to_br }}</p></div><ul class="blko-shelf-clean__grid">{% for block in section.blocks %}<li class="blko-shelf-clean__item" {{ block.shopify_attributes }}><span class="blko-shelf-clean__icon" aria-hidden="true">✓</span><span>{{ block.settings.label | escape }}</span></li>{% endfor %}</ul></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Fraunces",Georgia,serif;--leading-display:.9;--text-h2:2rem;--weight-light:300;--color-bg:Canvas;--color-accent:GrayText;--font-accent:"Barlow Semi Condensed",Arial Narrow,Arial,sans-serif;--text-small:.75rem;--weight-medium:500;--color-line:var(--color-border);--color-border:ButtonFace;--color-bg-alt:Canvas;--tracking-h2:-.08rem;--font-body:"Assistant",Arial,sans-serif;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-shelf-clean__head{max-width:46rem}
.blko-theme .blko-shelf-clean{background:var(--color-bg-alt);padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem)}
.blko-theme .blko-shelf-clean h2{margin:0 0 .5rem}
.blko-theme .blko-shelf-clean__grid{list-style:none;margin:2rem 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:1px;background:var(--color-line);border:1px solid var(--color-line)}
.blko-theme .blko-shelf-clean__item{display:grid;justify-items:center;gap:.6rem;padding:1.5rem 1rem;background:var(--color-bg);text-align:center;font:var(--weight-medium) var(--text-small)/1.3 var(--font-accent);letter-spacing:.04em}
.blko-theme .blko-shelf-clean__icon{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:50%;background:var(--color-accent);color:var(--color-bg)}
.blko-theme .blko-shelf-visit__body h2{margin:0 0 .5rem}
.blko-theme .blko-shelf-pillars h2{margin:0 0 .5rem}
.blko-theme .blko-shelf-services h2{margin:0 0 .5rem}
.blko-theme .blko-shelf-rewards h2{margin:0 0 .4rem;color:var(--color-bg)}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme .blko-newsletter h2{color:inherit}
{% endstylesheet %}
