{% schema %}
{
  "name": "Required & encouraged",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The rulebook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Required and encouraged"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "A brand must clear every required item to be listed. Encouraged items win it a place in our spotlight."
    },
    {
      "type": "text",
      "id": "required_label",
      "label": "Required label",
      "default": "Required"
    },
    {
      "type": "text",
      "id": "encouraged_label",
      "label": "Encouraged label",
      "default": "Encouraged"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pillar"
        },
        {
          "type": "textarea",
          "id": "required",
          "label": "Required",
          "default": "What brands must do."
        },
        {
          "type": "textarea",
          "id": "encouraged",
          "label": "Encouraged",
          "default": "What we would like brands to do."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Required & encouraged",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Product",
            "required": "Full disclosure of ingredients under standard names. Warning before any formula change. Compliance with local law. Stability, preservative and compatibility tests. Skin patch testing on new launches. Heavy-metal, PFAS and asbestos checks where relevant. Batch traceability. Evidence behind every claim.",
            "encouraged": "Factories that follow good manufacturing practice. Accredited labs. Open fragrance disclosure. Sourcing notes. Organic certification."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Packaging",
            "required": "Follow our packaging guidelines. Limit single-use parts. At least half recycled plastic where plastic is used. Disposal directions on pack. Resin codes. Certified paper. Accurate recycling claims.",
            "encouraged": "Join the packaging collective. Offer refills. Raise recycled content further."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "People",
            "required": "A supplier code of conduct covering fair pay and safe workplaces. Traceability for high-risk materials.",
            "encouraged": "Third-party labor audits. Programs that support suppliers' communities."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Planet",
            "required": "No animal testing at any stage. A written position on raw material sourcing.",
            "encouraged": "Climate targets. Lower-impact materials. Public reports on progress."
          }
        }
      ]
    }
  ]
}
{% endschema %}
