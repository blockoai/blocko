{%- comment -%} Generated by Blocko from tools/themes/shelf/groups/shelf.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-shelf-pillars"><div class="blko-shelf-pillars__head"><p class="blko-shelf-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.lede | escape | newline_to_br }}</p></div><div class="blko-shelf-pillars__grid">{% for block in section.blocks %}<article class="blko-shelf-pillars__item" {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><p class="blko-shelf-pillars__label">{{ section.settings.required_label | escape }}</p><p>{{ block.settings.required | escape | newline_to_br }}</p><p class="blko-shelf-pillars__label">{{ section.settings.encouraged_label | escape }}</p><p>{{ block.settings.encouraged | escape | newline_to_br }}</p></article>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Fraunces",Georgia,serif;--color-text-muted:CanvasText;--leading-card-title:1.125;--text-card-title:1.5rem;--weight-light:300;--kit-label-transform:uppercase;--tracking-label:.075rem;--font-accent:"Barlow Semi Condensed",Arial Narrow,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--text-small:.75rem;--leading-display:.9;--text-h2:2rem;--color-bg:Canvas;--color-sale:GrayText;--color-line:var(--color-border);--color-border:ButtonFace;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--font-body:"Assistant",Arial,sans-serif;--tracking-h2:-.08rem;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:2rem;--text-h2:2.5rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-shelf-eyebrow{margin:0 0 .5rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:.08em;text-transform:uppercase;color:var(--color-sale)}
.blko-theme .blko-shelf-pillars{padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem)}
.blko-theme .blko-shelf-pillars__head{max-width:46rem}
.blko-theme .blko-shelf-pillars h2{margin:0 0 .5rem}
.blko-theme .blko-shelf-pillars__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr));gap:1px;margin-top:2rem;background:var(--color-line);border:1px solid var(--color-line)}
.blko-theme .blko-shelf-pillars__item{padding:1.5rem;background:var(--color-bg)}
.blko-theme .blko-shelf-pillars__item h3{margin:0 0 .75rem}
