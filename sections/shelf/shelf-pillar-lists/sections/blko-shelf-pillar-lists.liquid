.blko-theme .blko-shelf-pillars__label{font:var(--weight-medium) var(--text-label)/1 var(--font-accent);letter-spacing:.08em;text-transform:uppercase;color:var(--color-sale)}
.blko-theme .blko-shelf-services h2{margin:0 0 .5rem}
.blko-theme .blko-shelf-services__item h3{margin:0}
