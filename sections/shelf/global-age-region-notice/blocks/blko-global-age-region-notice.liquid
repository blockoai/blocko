{% schema %}
{
  "name": "Age / region notice",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "A quick check"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Is this your region?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Prices and availability may vary by location."
    },
    {
      "type": "text",
      "id": "confirm_label",
      "label": "Confirm label",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "change_label",
      "label": "Change label",
      "default": "Change region"
    }
  ],
  "presets": [
    {
      "name": "Age / region notice"
    }
  ]
}
{% endschema %}
