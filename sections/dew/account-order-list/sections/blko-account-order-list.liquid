{%- comment -%} Generated by Blocko from tools/themes/dew/groups/account.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-account>{% if customer.orders_count > 0 %}<section id="order-history" class="blko-account-orders" data-account-orders="populated"><div class="blko-account-section-heading"><div><p class="blko-account-kicker">{{ section.settings.kicker | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a href="{{ section.settings.view_all_url | default: '#order-history' }}">{{ section.settings.view_all_label | escape }}</a></div><div class="blko-account-order-table" role="table" aria-label="Recent orders"><div class="blko-account-order-table__head" role="row"><span>{{ section.settings.col_order | escape }}</span><span>{{ section.settings.col_date | escape }}</span><span>{{ section.settings.col_status | escape }}</span><span>{{ section.settings.col_total | escape }}</span></div>{% for order in customer.orders limit: 20 %}<a class="blko-account-order-row" href="{{ order.customer_url | escape }}" role="row"><strong>{{ 'blko.account.order_prefix' | t }} {{ order.order_number | escape }}</strong><span>{{ order.created_at | date: '%B %-d, %Y' }}</span><span><i class="blko-account-status">{{ order.fulfillment_status_label | escape }}</i></span><span>{{ order.total_price | money }}</span></a>{% endfor %}</div></section>{% else %}{% endif %}</blko-account></div>
<script type="module" src="{{ 'blko-account.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.02em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Manrope",Arial,sans-serif;--text-h2:1.75rem;--text-title:1.75rem;--text-display:2.5rem;--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:1.125rem;--weight-medium:500;--leading-display:.9;--tracking-h2:-.08rem;--weight-light:300;--font-body:"DM Sans",Arial,sans-serif;--tracking-body:-.02rem;--text-h3:.875rem;--text-h4:1.25rem;--leading-h3:1.5;--font-sans:var(--font-body);--leading-label:1.5;--text-label:.75rem;--color-text:CanvasText;--color-bg-alt:Canvas;--color-text-muted:CanvasText;--text-small:0.6875rem;--color-border:ButtonFace;--tracking-label:.075rem;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:1.875rem;--text-title:1.875rem;--text-display:3.25rem;--text-card-title:1.25rem;--tracking-h2:-.1rem;--tracking-body:-.025rem;--text-h3:1rem;--text-h4:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-account-orders{color:var(--color-text)}
.blko-theme .blko-account-kicker{margin:0 0:.35rem;color:var(--color-text-muted);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);letter-spacing:var(--tracking-label);text-transform:none}
.blko-theme .blko-account-orders{padding:clamp(2.5rem,7vw,6rem) 5vw}
.blko-theme .blko-account-section-heading{display:flex;justify-content:space-between;gap:1.5rem;align-items:flex-start;max-width:1100px;margin:auto}
.blko-theme .blko-account-orders{max-width:1200px;margin:auto}
.blko-theme .blko-account-section-heading{margin-bottom:1.5rem}
.blko-theme .blko-account-section-heading h2{margin:.2rem 0}
.blko-theme .blko-account-section-heading>a{align-self:center}
.blko-theme .blko-account-order-table{border-top:1px solid var(--color-border)}
.blko-theme .blko-account-order-table__head{display:grid;grid-template-columns:1.15fr 1.4fr 1.3fr .7fr;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--color-border)}
.blko-theme .blko-account-order-row{display:grid;grid-template-columns:1.15fr 1.4fr 1.3fr .7fr;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--color-border)}
.blko-theme .blko-account-order-table__head{font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-account-order-row{color:inherit;text-decoration:none}
.blko-theme .blko-account-order-row:hover strong{text-decoration:underline;text-underline-offset:3px}
.blko-theme .blko-account-status{display:inline-block;padding:.18rem .45rem;background:var(--color-bg-alt);color:var(--color-text);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-sans);font-style:normal}
.blko-theme .blko-account-empty h2{margin:.35rem 0}
