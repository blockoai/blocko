{%- comment -%} Generated by Blocko from tools/themes/dew/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-variant-picker><fieldset class="blko-variant-options"><legend>{{ block.settings.legend | escape }}</legend>{% for variant in product.variants %}<button data-variant-option{% if variant.id == product.selected_or_first_available_variant.id %} aria-pressed="true"{% else %} aria-pressed="false"{% endif %} data-variant-id="{{ variant.id | escape }}">{{ variant.title | escape }}</button>{% endfor %}</fieldset></blko-variant-picker></div>
<script type="module" src="{{ 'blko-variant-picker.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-text:CanvasText;--color-bg:Canvas;--color-bg-alt:Canvas;--color-footer-bg:CanvasText;--color-accent:GrayText;--color-sale:GrayText;--color-border:ButtonFace;--kit-radius:8px;--kit-radius-image:12px;--kit-radius-button:999px;--font-accent:"DM Sans",Arial,sans-serif;--font-body:"DM Sans",Arial,sans-serif;--weight-light:300;--kit-heading-weight:500;--font-heading:"Manrope",Arial,sans-serif;--color-button-text:Canvas;--color-ink:var(--color-text);--color-line:var(--color-border);--text-small:0.6875rem;--color-paper:var(--color-bg);--text-title:1.75rem;--leading-display:.9;--font-mono:var(--font-accent);--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--text-body:0.9rem;--color-button:CanvasText;--tracking-button:.075rem;--leading-button:1.5;--text-button:.75rem}
@media (min-width:1024px){:where(.blko-theme){--text-title:1.875rem;--text-body:0.9375rem}}
