{%- comment -%} Generated by Blocko from tools/themes/dew/groups/signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-signature><section class="blko-dew-facts"><div class="blko-dew-facts-head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><dl class="blko-dew-facts-list">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><dt>{{ block.settings.term | escape }}</dt><dd>{{ block.settings.detail | escape | newline_to_br }}</dd></div>{% endfor %}</dl></section></blko-signature></div>
<script type="module" src="{{ 'blko-signature.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.02em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Manrope",Arial,sans-serif;--leading-display:.9;--text-h2:1.75rem;--weight-light:300;--color-text-muted:CanvasText;--tracking-label:.075rem;--font-body:"DM Sans",Arial,sans-serif;--text-label:.75rem;--weight-medium:500;--color-border:ButtonFace;--color-bg-alt:Canvas;--font-accent:"DM Sans",Arial,sans-serif;--leading-label:1.5;--tracking-h2:-.08rem;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:1.875rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-dew-facts-head{align-self:start}
.blko-theme .blko-dew-facts{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(2rem,8vw,8rem);padding:clamp(4rem,9vw,8rem) 5vw;background:var(--color-bg-alt)}
.blko-theme .blko-dew-facts h2{margin:.25rem 0 0;font-size:var(--text-h2)}
.blko-theme .blko-dew-facts-list{margin:0}
.blko-theme .blko-dew-facts-list>div{display:grid;grid-template-columns:minmax(7rem,.4fr) 1fr;gap:1.5rem;padding:1.25rem 0;border-top:1px solid var(--color-border)}
.blko-theme .blko-dew-facts-list>div:last-child{border-bottom:1px solid var(--color-border)}
.blko-theme .blko-dew-facts-list dt{font:var(--weight-medium) var(--text-label)/1.4 var(--font-body);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-dew-facts-list dd{margin:0;color:var(--color-text-muted)}
@media (max-width:760px){.blko-theme .blko-dew-facts{grid-template-columns:1fr}
.blko-theme .blko-dew-facts-list>div{grid-template-columns:1fr;gap:.35rem}}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme h2{text-transform:lowercase}
{% endstylesheet %}
{% schema %}
{
  "name": "Feels, looks, smells",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "At a glance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "the facts."
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "term",
          "label": "Term",
          "default": "feels like"
        },
        {
          "type": "textarea",
          "id": "detail",
          "label": "Detail",
          "default": "a cool, weightless drop that sinks in and leaves skin plump."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feels, looks, smells",
      "blocks": [
        {
