{%- comment -%} Generated by Blocko from tools/themes/dew/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = section.settings.product | default: product
  assign collection = section.settings.collection | default: collection | default: collections.all
-%}
<div class="blko-theme"><blko-pdp><section class="blko-pdp-routine" data-pdp-recs="{{ routes.product_recommendations_url | escape }}?section_id={{ section.id | escape }}&product_id={{ product.id | escape }}&limit=3&intent=complementary"><div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div><div class="blko-pdp-routine__grid" data-pdp-recs-grid>{% if recommendations.performed %}{% for rec in recommendations.products limit: 3 %}<article class="blko-pdp-mini-product">{% if rec.featured_image != blank %}{{ rec.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '260, 390, 520', alt: rec.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3><a class="blko-product-link" href="{{ rec.url | escape }}">{{ rec.title | escape }}</a></h3>{% if rec.type != blank %}<p>{{ rec.type | escape }}</p>{% else %}{% endif %}<strong>{{ rec.price | money_without_trailing_zeros }}</strong></div></article>{% endfor %}{% else %}{% for pick in collection.products limit: 3 %}<article class="blko-pdp-mini-product">{% if pick.featured_image != blank %}{{ pick.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '260, 390, 520', alt: pick.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3><a class="blko-product-link" href="{{ pick.url | escape }}">{{ pick.title | escape }}</a></h3>{% if pick.type != blank %}<p>{{ pick.type | escape }}</p>{% else %}{% endif %}<strong>{{ pick.price | money_without_trailing_zeros }}</strong></div></article>{% endfor %}{% endif %}</div></section></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.02em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:500;--font-heading:"Manrope",Arial,sans-serif;--kit-radius-card:12px;--font-display:var(--font-heading);--leading-h3:1.5;--text-h4:1.25rem;--weight-medium:500;--text-small:0.6875rem;--tracking-body:-.02rem;--color-line:var(--color-border);--color-border:ButtonFace;--tracking-label:.075rem;--font-accent:"DM Sans",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--tracking-h3:.0875rem;--text-h3:.875rem;--font-body:"DM Sans",Arial,sans-serif;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:1.75rem;--color-accent:GrayText;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
