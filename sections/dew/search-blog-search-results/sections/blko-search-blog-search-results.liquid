      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "crumb",
      "label": "Crumb",
      "default": "Search"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next ritual."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Search products, journal notes, and helpful pages."
    },
