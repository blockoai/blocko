{%- comment -%} Generated by Blocko from tools/themes/stubble/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign product = block.settings.product | default: product
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><p class="blko-price"><strong>{{ product.price | money_without_trailing_zeros }}</strong>{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{% else %}{% endif %}</p></div>
{% stylesheet %}
:where(.blko-theme){--text-small:.75rem;--text-card-title:1.125rem;--text-body:.9375rem;--color-sale:GrayText;--color-text-muted:CanvasText;--color-border:ButtonFace;--tracking-label:.075rem;--font-accent:"Inter",Arial,sans-serif;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--tracking-price:-.02rem;--font-body:"Inter",Arial,sans-serif;--leading-body:1.5;--text-price:.9375rem;--weight-bold:700;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:1.125rem;--text-body:.9375rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-price{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-price strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-cart-line>strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-cart-summary strong{font:var(--weight-bold) var(--text-price)/var(--leading-body) var(--font-body);letter-spacing:var(--tracking-price);text-transform:none}
.blko-theme .blko-footer strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-timeline strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-press-section strong{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-press-section strong{display:grid;place-items:center;min-height:4rem;padding:1rem;border:1px solid var(--color-border);font-size:clamp(.72rem,1vw,.9rem)}
.blko-theme .blko-price s{color:var(--color-text-muted)}
.blko-theme .blko-price strong{color:var(--color-sale)}
@media(max-width:760px){.blko-theme .blko-press-section strong{min-height:3.25rem;padding:.5rem;font-size:.6rem}}
.blko-theme .blko-global-code strong{font-size:var(--text-small)}
.blko-theme .blko-pdp-price strong{font-size:var(--text-body)}
.blko-theme .blko-pdp-stat-grid strong{font-size:var(--text-card-title)}
.blko-theme .blko-pdp-mini-product strong{font-size:var(--text-small)}
.blko-theme .blko-stubble-chooser__tile strong{display:block;margin-bottom:1rem}
{% endstylesheet %}
{% schema %}
{
  "name": "Price",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Price"
    }
  ]
}
{% endschema %}
