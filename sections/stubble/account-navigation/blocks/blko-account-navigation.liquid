{%- comment -%} Generated by Blocko from tools/themes/stubble/groups/account.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-account><nav class="blko-account-nav" aria-label="Customer account"><a class="is-current" href="{{ routes.account_url | escape }}">{{ block.settings.orders_label | escape }}</a><a href="{{ routes.account_addresses_url | escape }}">{{ block.settings.addresses_label | escape }}</a><a href="{{ block.settings.details_url | default: '#details' }}">{{ block.settings.details_label | escape }}</a></nav></blko-account></div>
