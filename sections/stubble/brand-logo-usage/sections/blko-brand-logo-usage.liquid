      "label": "Heading",
      "default": "Logo and usage"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede",
      "default": "Seven square-cut capitals with one round-bottomed U and two round-bowled Bs. Beneath them a rule of short bristles gives way to a clean straight line: grown out on the left, shaved on the right. Letters take the text colour; the bristles and rule take the action colour."
    },
    {
      "type": "text",
      "id": "primary_name",
      "label": "Primary wordmark name",
      "default": "Primary wordmark"
    },
    {
      "type": "text",
      "id": "primary_note",
      "label": "Primary wordmark note",
      "default": "Default on light surfaces."
    },
    {
      "type": "text",
      "id": "inverse_name",
      "label": "Inverse wordmark name",
      "default": "Inverse wordmark"
    },
    {
      "type": "text",
      "id": "inverse_note",
      "label": "Inverse wordmark note",
      "default": "On dark photography and the footer colour."
    },
    {
      "type": "text",
      "id": "mark_name",
      "label": "Mark name",
      "default": "Mark"
    },
    {
      "type": "text",
      "id": "mark_note",
      "label": "Mark note",
      "default": "Favicon, avatar and small spaces."
    },
    {
      "type": "text",
      "id": "accent_name",
      "label": "Mark on accent name",
      "default": "Mark on accent"
    },
    {
      "type": "text",
      "id": "accent_note",
      "label": "Mark on accent note",
      "default": "Stickers, packaging, social."
    },
    {
      "type": "text",
      "id": "clear_title",
      "label": "Clear title",
      "default": "Clear space"
    },
    {
      "type": "text",
      "id": "clearspace",
      "label": "Clear space rule",
      "default": "Keep a margin equal to the height of the letter S on every side. Nothing, including text and photo edges, enters it."
    },
    {
      "type": "text",
      "id": "min_title",
      "label": "Min title",
      "default": "Minimum size"
    },
