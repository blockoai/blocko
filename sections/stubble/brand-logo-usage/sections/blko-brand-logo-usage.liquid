{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-heading-transform:none;--kit-heading-weight:600;--font-heading:"Archivo",Arial,sans-serif;--color-text-muted:CanvasText;--leading-card-title:1.125;--text-card-title:1.125rem;--weight-light:300;--color-error:currentColor;--color-success:currentColor;--leading-body:1.5;--kit-label-transform:uppercase;--tracking-label:.075rem;--font-accent:"Inter",Arial,sans-serif;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--kit-radius-card:4px;--color-border:ButtonFace;--color-accent:GrayText;--text-small:.75rem;--color-text:CanvasText;--kit-radius-button:4px;--color-bg-alt:Canvas;--color-bg:Canvas;--leading-display:.9;--text-h2:1.625rem;--text-body:.9375rem;--color-footer-text:Canvas;--color-footer-bg:CanvasText;--tracking-h3:.0875rem;--leading-h3:1.5;--text-h3:.875rem;--font-body:"Inter",Arial,sans-serif;--tracking-h2:-.08rem;--color-ink:var(--color-text);--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:1.125rem;--text-h2:1.75rem;--text-body:.9375rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-brand-tone-ink{background:var(--color-footer-bg);color:var(--color-footer-text)}
.blko-theme .blko-brand-tone-accent{background:var(--color-accent);color:var(--color-bg)}
.blko-theme .blko-brand-tone-light{background:var(--color-bg-alt);color:var(--color-text)}
.blko-theme .blko-brand-tone-plain{background:var(--color-bg);color:var(--color-text)}
.blko-theme .blko-brand-eyebrow{margin:0;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase);opacity:.75}
.blko-theme .blko-brand-lede{margin:0;max-width:40rem;font-size:var(--text-body);line-height:var(--leading-body)}
.blko-theme .blko-brand-section{padding:clamp(2.5rem,6vw,4.5rem) clamp(1rem,5vw,4rem);background:var(--color-bg);color:var(--color-text);display:grid;gap:2rem}
.blko-theme .blko-brand-head{display:grid;gap:.6rem;max-width:44rem}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-tiles{display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr))}
.blko-theme .blko-brand-tile{margin:0;display:grid;grid-template-rows:1fr auto;border:1px solid var(--color-border);border-radius:var(--kit-radius-card,0);overflow:hidden}
.blko-theme .blko-brand-tile__art{display:grid;place-items:center;min-height:11rem;padding:2rem}
.blko-theme .blko-brand-tile__art svg{display:block;width:min(100%,14rem);height:auto}
.blko-theme .blko-brand-tile--primary .blko-brand-tile__art svg{width:min(100%,16rem)}
.blko-theme .blko-brand-tile--inverse .blko-brand-tile__art svg{width:min(100%,16rem)}
.blko-theme .blko-brand-tile--mark .blko-brand-tile__art svg{width:4.5rem}
.blko-theme .blko-brand-tile--accent .blko-brand-tile__art svg{width:4.5rem}
.blko-theme .blko-brand-tile figcaption{padding:.9rem 1rem;font-size:var(--text-small);background:var(--color-bg);color:var(--color-text-muted)}
.blko-theme .blko-brand-tile figcaption strong{color:var(--color-text)}
.blko-theme .blko-brand-rules{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))}
.blko-theme .blko-brand-rule{display:grid;gap:.75rem;align-content:start}
.blko-theme .blko-brand-rule p{margin:0;font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-brand-rule strong{color:var(--color-text)}
.blko-theme .blko-brand-clear{padding:2.5rem;border:1px dashed var(--color-accent);background:var(--color-bg-alt)}
.blko-theme .blko-brand-clear__logo{border:1px solid var(--color-border);background:var(--color-bg);padding:.5rem}
.blko-theme .blko-brand-clear__logo svg{display:block;width:100%;max-width:12rem;height:auto}
.blko-theme .blko-brand-min{padding:2rem;border:1px solid var(--color-border);background:var(--color-bg-alt)}
.blko-theme .blko-brand-min__logo svg{display:block;width:6rem;height:auto}
.blko-theme .blko-brand-downloads{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.6rem}
.blko-theme .blko-brand-download{display:inline-block;padding:.55rem 1rem;border:1px solid var(--color-border);border-radius:var(--kit-radius-button,0);color:var(--color-text);text-decoration:none;font-size:var(--text-small)}
.blko-theme .blko-brand-download:hover{border-color:var(--color-accent);color:var(--color-accent)}
.blko-theme .blko-brand-dosdonts{display:grid;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr))}
.blko-theme .blko-brand-do{padding:1.25rem 1.5rem;border:1px solid var(--color-border);border-radius:var(--kit-radius-card,0)}
.blko-theme .blko-brand-dont{padding:1.25rem 1.5rem;border:1px solid var(--color-border);border-radius:var(--kit-radius-card,0)}
.blko-theme .blko-brand-do{border-top:3px solid var(--color-success)}
.blko-theme .blko-brand-dont{border-top:3px solid var(--color-error)}
.blko-theme .blko-brand-do h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-dont h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-do ul{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
.blko-theme .blko-brand-dont ul{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
.blko-theme .blko-brand-do li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme .blko-brand-dont li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme .blko-brand-do li::before{content:"\2713";color:var(--color-success)}
.blko-theme .blko-brand-dont li::before{content:"\2715";color:var(--color-error)}
.blko-theme .blko-brand-card h3{margin:0 0 .5rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-card-title)/var(--leading-card-title) var(--font-heading)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme .blko-newsletter p{color:inherit}
