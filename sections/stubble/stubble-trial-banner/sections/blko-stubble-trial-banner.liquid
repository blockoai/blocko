{% schema %}
{
  "name": "Subscription banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Subscribe and save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Refills before the old blade dulls."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every subscription order takes 5% off, and three or more items take 15% off each. Skip a shipment or cancel in a couple of clicks."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Set up refills"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    },
    {
      "type": "text",
      "id": "legend",
      "label": "Legend",
      "default": "Ship every"
    }
  ],
  "blocks": [
    {
      "type": "cadence",
      "name": "Cadence",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "8 weeks"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Most popular"
        }
      ]
    }
  ],
  "presets": [
    {
