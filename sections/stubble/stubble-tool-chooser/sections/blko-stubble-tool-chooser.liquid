{%- comment -%} Generated by Blocko from tools/themes/stubble/groups/stubble.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-stubble-chooser"><div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape | newline_to_br }}</p></div><div class="blko-stubble-chooser__grid">{% for block in section.blocks %}<article class="blko-stubble-chooser__tile" {{ block.shopify_attributes }}><span class="blko-stubble-chooser__badge">{{ block.settings.badge | escape }}</span>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '225, 450, 675, 900', alt: block.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><h3>{{ block.settings.name | escape }}</h3><p>{{ block.settings.note | escape | newline_to_br }}</p><strong>{{ block.settings.price | escape }}</strong><a class="blko-button" href="{{ block.settings.url | default: '#razor' }}">{{ block.settings.label | escape }}</a></div></article>{% endfor %}</div></section></div>
