<div class="blko-theme"><blko-search-blog><blko-predictive-search><article class="blko-search-blog-article-content"><div class="blko-search-blog-reading">{{ article.content }}<aside class="blko-search-blog-inline-products"><p class="blko-eyebrow">{{ section.settings.products_heading | escape }}</p><div>{% if product_a != blank %}<article class="blko-product-card">{% if product_a.featured_image != blank %}{{ product_a.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product_a.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ product_a.vendor | escape }}</p><h3><a class="blko-product-link" href="{{ product_a.url | escape }}">{{ product_a.title | escape }}</a></h3>{% if product_a.metafields.reviews.rating.value.rating != blank %}<p>{% assign blko_rating = product_a.metafields.reviews.rating.value.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %} <span>{{ product_a.metafields.reviews.rating.value.rating | escape }} ({{ product_a.metafields.reviews.rating_count | escape }})</span></p>{% else %}{% endif %}<strong class="blko-price">{{ product_a.price | money_without_trailing_zeros }}</strong>{% if product_a.options_with_values.first.name == 'Shade' or product_a.options_with_values.first.name == 'Color' or product_a.options_with_values.first.name == 'Colour' %}<ul class="blko-swatch-dots" aria-label="Available colors">{% for swatch in product_a.options_with_values.first.values %}<li class="blko-swatch-dot" title="{{ swatch | escape }}" style="background:var(--color-swatch-{{ swatch | handleize }},var(--color-accent))"></li>{% endfor %}</ul>{% else %}{% endif %}</div></article>{% else %}{% endif %}{% if product_b != blank %}<article class="blko-product-card">{% if product_b.featured_image != blank %}{{ product_b.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product_b.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ product_b.vendor | escape }}</p><h3><a class="blko-product-link" href="{{ product_b.url | escape }}">{{ product_b.title | escape }}</a></h3>{% if product_b.metafields.reviews.rating.value.rating != blank %}<p>{% assign blko_rating = product_b.metafields.reviews.rating.value.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %} <span>{{ product_b.metafields.reviews.rating.value.rating | escape }} ({{ product_b.metafields.reviews.rating_count | escape }})</span></p>{% else %}{% endif %}<strong class="blko-price">{{ product_b.price | money_without_trailing_zeros }}</strong>{% if product_b.options_with_values.first.name == 'Shade' or product_b.options_with_values.first.name == 'Color' or product_b.options_with_values.first.name == 'Colour' %}<ul class="blko-swatch-dots" aria-label="Available colors">{% for swatch in product_b.options_with_values.first.values %}<li class="blko-swatch-dot" title="{{ swatch | escape }}" style="background:var(--color-swatch-{{ swatch | handleize }},var(--color-accent))"></li>{% endfor %}</ul>{% else %}{% endif %}</div></article>{% else %}{% endif %}</div></aside><div class="blko-search-blog-share"><span class="blko-eyebrow">{{ section.settings.share_label | escape }}</span><button type="button" data-search-blog-share>{{ section.settings.copy_label | escape }}</button><a href="mailto:?subject={{ article.title | url_encode }}&body={{ canonical_url | escape }}">{{ section.settings.email_label | escape }}</a><a href="{{ section.settings.save_url | default: '#share' }}">{{ section.settings.save_label | escape }}</a><span data-search-blog-share-status aria-live="polite"></span></div>{% if article.comments_enabled? %}<section class="blko-search-blog-comments" id="comments"><h2>{{ section.settings.comments_heading | escape }}</h2>{% paginate article.comments by 20 %}{% for comment in article.comments %}<article class="blko-search-blog-comment"><p class="blko-eyebrow">{{ comment.author | escape }} · {{ comment.created_at | date: '%B %-d, %Y' }}</p><div>{{ comment.content }}</div></article>{% endfor %}{% endpaginate %}{% form 'new_comment', article, class: 'blko-search-blog-comment-form' %}<p aria-live="polite">{% if form.posted_successfully? %}{{ section.settings.success_message | escape }}{% else %}{% if form.errors %}{{ section.settings.error_message | escape }}{% else %}{% endif %}{% endif %}</p><label for="search-blog-comment-author">{{ section.settings.author_label | escape }}</label><input id="search-blog-comment-author" name="comment[author]" required autocomplete="name"><label for="search-blog-comment-email">{{ section.settings.email_label | escape }}</label><input id="search-blog-comment-email" name="comment[email]" type="email" required autocomplete="email"><label for="search-blog-comment-body">{{ section.settings.body_label | escape }}</label><textarea id="search-blog-comment-body" name="comment[body]" rows="5" required></textarea><button class="blko-button" type="submit">{{ section.settings.submit_label | escape }}</button>{% endform %}</section>{% else %}{% endif %}</div></article></blko-predictive-search></blko-search-blog></div>
