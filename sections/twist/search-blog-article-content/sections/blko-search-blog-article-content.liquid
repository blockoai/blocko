{
  "name": "Long-form article content",
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Article"
    },
    {
      "type": "product",
      "id": "product_a",
      "label": "First product"
    },
    {
      "type": "product",
      "id": "product_b",
      "label": "Second product"
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "Shop what we mention"
    },
    {
      "type": "text",
      "id": "share_label",
      "label": "Share label",
      "default": "Share this post"
    },
    {
      "type": "text",
      "id": "copy_label",
      "label": "Copy label",
      "default": "Copy link"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "url",
      "id": "save_url",
      "label": "Save url"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Save label",
      "default": "Save"
    },
    {
      "type": "text",
      "id": "comments_heading",
      "label": "Comments heading",
      "default": "Comments"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for your comment."
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "Please complete the required fields."
    },
    {
      "type": "text",
      "id": "author_label",
      "label": "Author label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "body_label",
      "label": "Body label",
      "default": "Comment"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Post comment"
    }
  ],
  "presets": [
    {
      "name": "Long-form article content"
    }
  ]
}
{% endschema %}
