{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:none;--kit-heading-transform:none;--kit-heading-weight:700;--font-heading:"Fraunces",Georgia,serif;--kit-radius-image:0;--tracking-h1:-.08rem;--leading-display:.9;--text-h1:2rem;--weight-light:300;--color-text:CanvasText;--color-bg:Canvas;--weight-bold:700;--color-paper:var(--color-bg);--color-ink:var(--color-text);--color-sand:var(--color-bg-alt);--color-bg-alt:Canvas;--tracking-label:.075rem;--font-accent:"Figtree",Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--font-body:"Figtree",Arial,sans-serif;--color-border:ButtonFace;--color-accent:GrayText}
@media (min-width:1024px){:where(.blko-theme){--tracking-h1:-.16rem;--text-h1:3.75rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h1{font-family:var(--font-body);font-size:var(--text-h1);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h1)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-breadcrumb{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-search-blog-journal-hero h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-article-hero h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-empty h1{margin:.5rem 0 1rem}
.blko-theme .blko-search-blog-journal-hero{display:grid;grid-template-columns:1fr 1fr;background:var(--color-sand)}
.blko-theme .blko-search-blog-journal-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-article-hero>div{padding:clamp(3rem,9vw,9rem) 10%}
.blko-theme .blko-search-blog-journal-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-article-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post img{width:100%;height:100%;min-height:520px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post>div{padding:clamp(2rem,6vw,6rem);background:var(--color-ink);color:var(--color-paper)}
@media(max-width:760px){.blko-theme .blko-search-blog-journal-hero{grid-template-columns:1fr}
.blko-theme .blko-search-blog-empty img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-journal-hero img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-article-hero img{min-height:0;aspect-ratio:1}}
.blko-theme .blko-promo-media img{width:100%;height:100%;min-height:22rem;object-fit:cover;object-position:center 20%;display:block}
.blko-theme .blko-promo-copy h1{margin:0;font-family:var(--font-heading);font-weight:var(--weight-bold);font-size:clamp(2.5rem,5vw,4rem);line-height:1.05}
.blko-theme .blko-box-slots img{width:100%;aspect-ratio:1;object-fit:cover;background:var(--color-bg);border:2px dashed var(--color-text);box-sizing:border-box;display:block}
.blko-theme .blko-story-media img{width:100%;aspect-ratio:16/10;object-fit:cover;display:block}
.blko-theme .blko-fbt-item img{width:4.5rem;height:4.5rem;object-fit:cover}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-hero h1{margin:0;max-width:20ch;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h1)/var(--leading-display) var(--font-heading);letter-spacing:var(--tracking-h1)}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h1{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h1{letter-spacing:var(--kit-heading-tracking)}
