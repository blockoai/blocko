-%}
<div class="blko-theme" {{ block.shopify_attributes }}><article class="blko-product-card">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ product.vendor | escape }}</p><h3><a class="blko-product-link" href="{{ product.url | escape }}">{{ product.title | escape }}</a></h3>{% if product.metafields.reviews.rating.value.rating != blank %}<p>{% assign blko_rating = product.metafields.reviews.rating.value.rating | round %}{% for blko_star in (1..5) %}{% if blko_star <= blko_rating %}★{% else %}☆{% endif %}{% endfor %} <span>{{ product.metafields.reviews.rating.value.rating | escape }} ({{ product.metafields.reviews.rating_count | escape }})</span></p>{% else %}{% endif %}<strong class="blko-price">{{ product.price | money_without_trailing_zeros }}</strong>{% if product.options_with_values.first.name == 'Shade' or product.options_with_values.first.name == 'Color' or product.options_with_values.first.name == 'Colour' %}<ul class="blko-swatch-dots" aria-label="Available colors">{% for swatch in product.options_with_values.first.values %}<li class="blko-swatch-dot" title="{{ swatch | escape }}" style="background:var(--color-swatch-{{ swatch | handleize }},var(--color-accent))"></li>{% endfor %}</ul>{% else %}{% endif %}</div></article></div>
