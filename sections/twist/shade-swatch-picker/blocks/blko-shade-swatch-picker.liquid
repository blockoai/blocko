{%- comment -%} Generated by Blocko from tools/themes/twist/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-variant-picker><fieldset class="blko-swatches" data-swatches><legend>{{ block.settings.legend | escape }} <span data-selected-shade>{{ block.settings.selected | escape }}</span></legend><button class="blko-swatch" style="--shade:var(--color-swatch-light)" data-swatch data-shade="Color 1" aria-label="Color 1"></button><button class="blko-swatch is-selected" style="--shade:var(--color-swatch-medium)" data-swatch data-shade="Color 2" aria-label="Color 2"></button><button class="blko-swatch" style="--shade:var(--color-swatch-deep)" data-swatch data-shade="Color 3" aria-label="Color 3"></button></fieldset></blko-variant-picker></div>
<script type="module" src="{{ 'blko-variant-picker.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-text:CanvasText;--color-button-text:Canvas;--font-body:"Figtree",Arial,sans-serif;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-swatches{border:0;padding:0;margin:1.5rem 0}
.blko-theme .blko-swatch{width:2rem;height:2rem;border:2px solid var(--color-button-text);outline:1px solid var(--color-text);border-radius:50%;background:var(--shade);margin-right:.7rem}
{% endstylesheet %}
{% schema %}
{
  "name": "Color swatch picker",
  "settings": [
    {
      "type": "text",
      "id": "legend",
      "label": "Legend",
      "default": "Color"
    },
    {
      "type": "text",
      "id": "selected",
      "label": "Selected shade",
      "default": "Medium"
    }
  ],
  "presets": [
    {
      "name": "Color swatch picker"
    }
  ]
}
{% endschema %}
