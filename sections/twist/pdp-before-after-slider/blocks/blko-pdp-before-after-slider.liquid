{% schema %}
{
  "name": "Before and after slider",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your hair, happily smoother."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A soft, shiny finish with less frizz and way fewer tangles."
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 value",
      "default": "94%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "said it cut frizz"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 value",
      "default": "91%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "said they woke up with smoother hair"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "after_image_alt",
      "label": "After image alt text",
      "default": "Smooth hair after a night on satin"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "text",
      "id": "before_image_alt",
      "label": "Before image alt text",
      "default": "Frizzy hair after a night on cotton"
    }
  ],
  "presets": [
    {
      "name": "Before and after slider"
    }
  ]
}
{% endschema %}
