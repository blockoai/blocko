.blko-theme .blko-pdp-compare__label{position:absolute;bottom:1rem;padding:.3rem .5rem;background:var(--color-bg);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-pdp-compare__label--before{left:1rem}
.blko-theme .blko-pdp-compare__label--after{right:1rem}
.blko-theme .blko-pdp-mini-product img{width:100%;aspect-ratio:.78}
.blko-theme .blko-pdp-mini-product strong{font-size:var(--text-small)}
