      "label": "Inline email placeholder",
      "default": "you@example.com"
    },
    {
      "type": "text",
      "id": "inline_submit_label",
      "label": "Inline submit label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "inline_success_message",
      "label": "Inline success message",
      "default": "You’re signed up. Keep an eye on your inbox."
    },
