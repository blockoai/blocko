{%- comment -%} Generated by Blocko from tools/themes/blush/groups/blush-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-blush-links"><div class="blko-blush-links__head"><h2>{{ section.settings.heading | escape }}</h2><a class="blko-blush-links__all" href="{{ section.settings.all_url | default: '#shop' }}">{{ section.settings.all_label | escape }}</a></div><div class="blko-blush-links__row">{% for block in section.blocks %}<a class="blko-blush-links__panel" href="{{ block.settings.url | default: '#petal' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', alt: block.settings.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span class="blko-blush-links__title">{{ block.settings.title | escape }}</span><span class="blko-blush-links__caption">{{ block.settings.caption | escape }}</span></a>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"DM Sans",Arial,sans-serif;--text-small:.75rem;--color-text-muted:CanvasText;--text-body:1rem;--color-text:CanvasText;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:1.25rem;--font-body:"DM Sans",Arial,sans-serif;--color-border:ButtonFace;--color-accent:GrayText;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-body:1rem;--tracking-h2:-.1rem;--text-h2:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-blush-links{padding:clamp(3rem,7vw,6rem) 16px}
.blko-theme .blko-blush-links__head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1.25rem}
.blko-theme .blko-blush-links__all{color:var(--color-text);font-size:var(--text-small);text-decoration:underline;text-underline-offset:.2em}
.blko-theme .blko-blush-links__row{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}
.blko-theme .blko-blush-links__panel{display:block;color:var(--color-text);text-decoration:none}
.blko-theme .blko-blush-links__panel img{display:block;width:100%;aspect-ratio:3/5;object-fit:cover}
.blko-theme .blko-blush-links__title{display:block;margin-top:.75rem;font-size:var(--text-body)}
.blko-theme .blko-blush-links__caption{display:block;color:var(--color-text-muted);font-size:var(--text-small)}
.blko-theme .blko-blush-links__panel:hover .blko-blush-links__title{text-decoration:underline;text-underline-offset:.2em}
.blko-theme .blko-blush-duo__tile img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
.blko-theme .blko-blush-shades>img{display:block;width:100%;height:100%;min-height:420px;object-fit:cover}
.blko-theme .blko-blush-ugc__photo img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
@media(max-width:760px){.blko-theme .blko-blush-links__row{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;margin-inline:-16px;padding-inline:16px}
.blko-theme .blko-blush-links__panel{flex:0 0 62%;scroll-snap-align:start}
.blko-theme .blko-blush-shades>img{min-height:0;aspect-ratio:4/5;height:auto}}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme.blko-theme .blko-header-row>[aria-controls=cart-drawer]{order:2;flex:1 1 0;text-align:right}
.blko-theme.blko-theme .blko-header-row>[aria-controls=mobile-menu]{order:0;flex:1 1 0;text-align:left}
.blko-theme.blko-theme .blko-footer .blko-wordmark{text-decoration:none}
{% endstylesheet %}
