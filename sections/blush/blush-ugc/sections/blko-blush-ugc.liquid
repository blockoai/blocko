{%- comment -%} Generated by Blocko from tools/themes/blush/groups/blush-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-blush-ugc"><div class="blko-blush-ugc__head"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-blush-ugc__row">{% for block in section.blocks %}<figure class="blko-blush-ugc__photo" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', alt: block.settings.caption }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<figcaption>{{ block.settings.caption | escape }}</figcaption></figure>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"DM Sans",Arial,sans-serif;--kit-radius-image:0;--color-text-muted:CanvasText;--color-bg:Canvas;--text-small:.75rem;--tracking-label:.075rem;--font-accent:"DM Mono",ui-monospace,Menlo,monospace;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--tracking-h2:-.08rem;--leading-display:.9;--weight-light:300;--text-h2:1.25rem;--font-body:"DM Sans",Arial,sans-serif;--color-border:ButtonFace;--color-accent:GrayText;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--tracking-h2:-.1rem;--text-h2:1.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-blush-ugc{padding:clamp(3rem,7vw,6rem) 16px}
.blko-theme .blko-blush-ugc__head{max-width:560px;margin:0 auto 2.5rem;text-align:center}
.blko-theme .blko-blush-ugc__row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:start}
.blko-theme .blko-blush-ugc__photo{margin:0}
.blko-theme .blko-blush-ugc__photo img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover}
.blko-theme .blko-blush-ugc__photo:nth-child(2){margin-top:3.5rem}
.blko-theme .blko-blush-ugc__photo figcaption{margin-top:.6rem;color:var(--color-text-muted);font-size:var(--text-small)}
@media(max-width:760px){.blko-theme .blko-blush-shades>img{min-height:0;aspect-ratio:4/5;height:auto}
.blko-theme .blko-blush-ugc__row{grid-template-columns:1fr 1fr}
.blko-theme .blko-blush-ugc__photo:nth-child(2){margin-top:2rem}
.blko-theme .blko-blush-ugc__photo:nth-child(3){display:none}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-tile figcaption{padding:.9rem 1rem;font-size:var(--text-small);background:var(--color-bg);color:var(--color-text-muted)}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
{% endstylesheet %}
