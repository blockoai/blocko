{%- comment -%} Generated by Blocko from tools/themes/clip/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-page-header"><p class="blko-breadcrumb"><a href="{{ routes.root_url | escape }}">{{ 'blko.general.home' | t }}</a> / {{ section.settings.breadcrumb | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:0.14em;--kit-heading-transform:uppercase;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Arial,sans-serif;--text-display:1.75rem;--tracking-label:.075rem;--font-accent:"Hanken Grotesk",Arial,sans-serif;--leading-label:1.5;--text-label:.6875rem;--weight-medium:500;--tracking-display:-.1rem;--tracking-title:-.08rem;--text-title:1.25rem;--tracking-h1:-.08rem;--leading-display:.9;--weight-light:300;--text-h1:1.75rem;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-display:2.25rem;--text-label:.6875rem;--tracking-display:-.2rem;--tracking-title:-.1rem;--text-title:1.5rem;--tracking-h1:-.16rem;--text-h1:2.25rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h1{font-family:var(--font-body);font-size:var(--text-h1);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h1)}
.blko-theme .blko-page-header h1{font-size:var(--text-title);letter-spacing:var(--tracking-title)}
.blko-theme .blko-product-detail h1{font-size:var(--text-title);letter-spacing:var(--tracking-title)}
.blko-theme .blko-not-found h1{font-size:var(--text-title);letter-spacing:var(--tracking-title)}
.blko-theme .blko-hero h1{font-size:var(--text-display);letter-spacing:var(--tracking-display)}
.blko-theme .blko-breadcrumb{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-page-header{padding:clamp(3rem,8vw,8rem) 5vw}
.blko-theme .blko-page-header{text-align:center;max-width:850px;margin:auto}
.blko-theme .blko-global-gift-card h1{font-size:var(--text-display)}
.blko-theme.blko-theme h1{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme h1{letter-spacing:var(--kit-heading-tracking)}
.blko-theme.blko-theme .blko-page-header{padding-block:clamp(4.5rem,10vw,10rem)}
{% endstylesheet %}
