{%- comment -%} Generated by Blocko from tools/themes/clip/groups/content.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-content><figure class="blko-content-press-quote"><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.source | escape }}</figcaption></figure></blko-content></div>
<script type="module" src="{{ 'blko-content.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--text-title:1.25rem;--kit-heading-transform:uppercase;--kit-heading-weight:500;--font-heading:"Familjen Grotesk",Arial,sans-serif;--text-small:.7rem;--color-text-muted:CanvasText;--tracking-title:-.08rem;--leading-body:1.5;--weight-light:300;--color-button-text:Canvas;--color-footer-bg:CanvasText;--leading-display:.9;--text-display:1.75rem;--font-display:var(--font-heading);--leading-card-title:1.125;--text-card-title:.75rem;--weight-medium:500;--font-body:"Hanken Grotesk",Arial,sans-serif;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-title:1.5rem;--tracking-title:-.1rem;--text-display:2.25rem;--text-card-title:.75rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-content-press-quote blockquote{font:var(--weight-medium) var(--text-card-title)/var(--leading-card-title) var(--font-display);margin:0 0:1rem}
.blko-theme .blko-content-press-quote figcaption{font-style:normal;font-size:var(--text-small)}
.blko-theme .blko-content-landing-proof blockquote{font-size:var(--text-display);line-height:var(--leading-display);margin:0 0:1.5rem}
.blko-theme .blko-content-press-quote{margin:0;padding:2rem;background:var(--color-footer-bg);color:var(--color-button-text)}
.blko-theme blockquote{margin:1rem 0;font:var(--weight-light) var(--text-title)/var(--leading-body) var(--font-heading);letter-spacing:var(--tracking-title)}
.blko-theme .blko-pdp-review figcaption{font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-clip-trio figcaption{display:grid;gap:.8rem;justify-items:center;font-size:var(--text-small,.8rem);letter-spacing:.08em;text-transform:uppercase}
.blko-theme.blko-theme blockquote{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme blockquote{text-transform:none;letter-spacing:.02em}
.blko-theme .blko-quote-section blockquote{font-size:var(--text-title);line-height:1.35}
.blko-theme .blko-content-founder-copy blockquote{font-size:var(--text-title);line-height:1.35}
{% endstylesheet %}
{% schema %}
{
  "name": "Press quote",
  "settings": [
    {
      "type": "text",
      "id": "quote",
      "label": "Quote",
      "default": "“The clearest case yet for keeping a routine simple.”"
    },
    {
      "type": "text",
      "id": "source",
      "label": "Source",
      "default": "— Clip Journal"
    }
  ],
  "presets": [
    {
      "name": "Press quote"
    }
  ]
}
{% endschema %}
