{%- comment -%} Generated by Blocko from tools/themes/clip/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><p class="blko-press-block">{{ block.settings.lead | escape }} <strong>{{ block.settings.name | escape }}</strong></p></div>
{% stylesheet %}
:where(.blko-theme){--font-body:"Hanken Grotesk",Arial,sans-serif;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg);--color-bg:Canvas}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme .blko-press-block{margin:.5rem 0}
{% endstylesheet %}
{% schema %}
{
  "name": "Press logo",
  "settings": [
    {
      "type": "text",
      "id": "lead",
      "label": "Lead",
      "default": "Featured in"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "PINS"
    }
  ],
  "presets": [
    {
      "name": "Press logo"
    }
  ]
}
{% endschema %}
