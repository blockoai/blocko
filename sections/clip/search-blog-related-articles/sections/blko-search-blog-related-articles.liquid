{%- comment -%} Generated by Blocko from tools/themes/clip/groups/search-blog.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign article = section.settings.article | default: article
-%}
<div class="blko-theme"><blko-search-blog><blko-predictive-search><section class="blko-search-blog-related"><div class="blko-search-blog-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="blko-search-blog-related__grid">{% for post in article.blog.articles limit: 3 %}{% if post.id != article.id %}<article class="blko-search-blog-article-card" data-search-blog-article data-search-blog-tag="{{ post.tags.first | escape }}">
  {% if post.image != blank %}{{ post.image | image_url: width: 860 | image_tag: loading: 'lazy', widths: '215, 430, 645, 860', alt: post.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}
  <div><p class="blko-eyebrow">{{ post.tags.first | escape }}</p><h3>{{ post.title | escape }}</h3><p>{{ post.excerpt_or_content | strip_html | truncate: 160 | escape }}</p><a href="{{ post.url | escape }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a></div>
</article>{% else %}{% endif %}{% endfor %}</div></section></blko-predictive-search></blko-search-blog></div>
<script type="module" src="{{ 'blko-predictive-search.js' | asset_url }}"></script>
<script type="module" src="{{ 'blko-search-blog.js' | asset_url }}"></script>
