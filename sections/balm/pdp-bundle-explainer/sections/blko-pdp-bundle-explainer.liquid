{%- comment -%} Generated by Blocko from tools/themes/balm/groups/pdp.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><blko-pdp><section class="blko-pdp-bundle-explainer"><div class="blko-section-heading"><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span>{{ block.settings.number | escape }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape | newline_to_br }}</p></li>{% endfor %}</ol></section></blko-pdp></div>
<script type="module" src="{{ 'blko-pdp.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--color-text-muted:CanvasText;--leading-card-title:1.125;--text-card-title:1.5rem;--weight-light:300;--leading-body:1.5;--tracking-label:.075rem;--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--text-small:.75rem;--color-bg-alt:Canvas;--kit-radius-button:0;--color-border:ButtonFace;--color-button-text:Canvas;--font-display:var(--font-heading);--leading-h3:1.5;--text-h4:1.25rem;--tracking-body:-.02rem;--font-mono:var(--font-accent);--color-ink:var(--color-text);--color-text:CanvasText;--tracking-h3:.0875rem;--text-h3:.875rem;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--tracking-h2:-.08rem;--leading-display:.9;--text-h2:2rem;--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-card-title:2rem;--text-h4:1.5rem;--tracking-body:-.025rem;--tracking-h3:.1rem;--text-h3:1rem;--tracking-h2:-.1rem;--text-h2:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme h3{font-family:var(--font-body);font-size:var(--text-h3);font-weight:var(--weight-medium);line-height:var(--leading-h3);letter-spacing:var(--tracking-h3);text-transform:uppercase}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-section-heading{text-align:center;max-width:850px;margin:auto}
.blko-theme .blko-pdp-bundle-explainer{padding:clamp(4rem,9vw,8rem) 5vw;background:var(--color-bg-alt)}
.blko-theme .blko-pdp-bundle-explainer ol{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;max-width:1000px;margin:3rem auto 0;padding:0;list-style:none}
.blko-theme .blko-pdp-bundle-explainer li{border-top:1px solid var(--color-ink);padding-top:1rem}
.blko-theme .blko-pdp-bundle-explainer li>span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono)}
.blko-theme .blko-pdp-bundle-explainer h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);text-transform:none;letter-spacing:var(--tracking-body)}
.blko-theme .blko-pdp-bundle-explainer p{font-size:var(--text-small)}
@media(max-width:760px){.blko-theme .blko-pdp-bundle-explainer{padding:4rem 1.2rem}
.blko-theme .blko-pdp-bundle-explainer ol{grid-template-columns:1fr;gap:1rem;margin-top:2rem}}
.blko-theme .blko-search-blog-result h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-search-blog-article-card h3{font:var(--weight-medium) var(--text-h4)/var(--leading-h3) var(--font-display);margin:.1rem 0}
.blko-theme .blko-balm-steps ol{list-style:none;margin:0 0 2rem;padding:0;display:grid;gap:1.5rem;counter-reset:balm-step}
.blko-theme .blko-balm-steps li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;align-items:start;padding-bottom:1.5rem;border-bottom:1px solid var(--color-border)}
.blko-theme .blko-balm-quiz-card h3{margin:0 0 .8rem;font-size:clamp(1.3rem,2.2vw,1.75rem);color:var(--color-button-text)}
.blko-theme .blko-brand-traits li{padding:.5rem 1rem;border:1px solid var(--color-border);border-radius:var(--kit-radius-button,999px);background:var(--color-bg-alt);font:var(--weight-medium) var(--text-label)/1 var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-rule p{margin:0;font-size:var(--text-small);color:var(--color-text-muted)}
.blko-theme .blko-brand-do h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-dont h3{margin:0 0 .75rem;font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:var(--kit-label-transform,uppercase)}
.blko-theme .blko-brand-do li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme .blko-brand-dont li{display:grid;grid-template-columns:1.25rem 1fr;gap:.5rem;line-height:var(--leading-body)}
.blko-theme .blko-brand-card h3{margin:0 0 .5rem;font:var(--kit-heading-weight,var(--weight-light)) var(--text-card-title)/var(--leading-card-title) var(--font-heading)}
.blko-theme .blko-brand-card p{margin:0;color:var(--color-text-muted)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme .blko-search-blog-comment p{margin:.25rem 0}
