{%- liquid
  assign collection = section.settings.collection | default: collection | default: collections.all
-%}
<div class="blko-theme"><blko-beauty-extras><section class="blko-beauty-extras-routine blko-beauty-extras-panel" data-beauty-extras-routine data-money-format="{{ shop.money_format | escape }}" data-beauty-extras-cart-url="{{ routes.cart_url | escape }}">
  <header><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.text | escape | newline_to_br }}</p></header>
  <div class="blko-beauty-extras-routine-grid">
    <div class="blko-beauty-extras-routine-steps">{% for product in collection.products limit: 3 %}<article class="blko-beauty-extras-routine-step" data-beauty-extras-routine-step><span>{{ forloop.index }}</span><div><p class="blko-eyebrow">{{ product.type | escape }}</p><h2>{{ product.title | escape }}</h2><p>{{ section.settings.step_text | escape }}</p><div class="blko-beauty-extras-routine-options"><button type="button" data-beauty-extras-routine-pick aria-pressed="true" data-price-cents="{{ product.variants.first.price | escape }}" data-beauty-extras-variant="{{ product.variants.first.id | escape }}">{{ section.settings.pick_label | escape }} · {{ product.variants.first.price | money_without_trailing_zeros }}</button>{% if product.variants.size > 1 %}<button type="button" data-beauty-extras-routine-pick aria-pressed="false" data-price-cents="{{ product.variants.last.price | escape }}" data-beauty-extras-variant="{{ product.variants.last.id | escape }}">{{ section.settings.alternate_label | escape }} · {{ product.variants.last.price | money_without_trailing_zeros }}</button>{% else %}{% endif %}</div></div>{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '270, 360', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}</article>{% endfor %}</div>
    <aside class="blko-beauty-extras-routine-summary"><p class="blko-eyebrow">{{ section.settings.summary_eyebrow | escape }}</p><ol data-beauty-extras-routine-list>{% for product in collection.products limit: 3 %}<li>{{ product.type | escape }} <strong>{{ product.variants.first.price | money_without_trailing_zeros }}</strong></li>{% endfor %}</ol><div><span>{{ section.settings.total_label | escape }}</span><strong data-beauty-extras-routine-total></strong></div><button class="blko-button" type="button" data-beauty-extras-routine-add>{{ section.settings.add_label | escape }}</button></aside>
  </div>
</section></blko-beauty-extras></div>
<script type="module" src="{{ 'blko-beauty-extras.js' | asset_url }}"></script>
