{% schema %}
{
  "name": "Three-step ritual",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Skincare ritual products"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three simple steps to a glowing complexion"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the ritual"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cleanse"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Melt away the day with a plant-rich cleansing cream."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Three-step ritual",
      "blocks": [
        {
          "type": "step",
          "settings": {}
        },
        {
          "type": "step",
          "settings": {
            "title": "Nourish",
            "text": "Press in radiance serum and velvet day cream."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Sculpt",
            "text": "Define cheekbones and lids with creamy organic sticks."
          }
        }
      ]
    }
  ]
}
{% endschema %}
