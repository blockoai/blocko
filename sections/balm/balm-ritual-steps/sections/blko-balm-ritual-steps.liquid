{%- comment -%} Generated by Blocko from tools/themes/balm/groups/balm-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-balm-steps">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250, 500, 750, 1000', alt: section.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><ol>{% for block in section.blocks %}<li {{ block.shopify_attributes }}><div><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></div></li>{% endfor %}</ol><a class="blko-button" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label | escape }}</a></div></section></div>
