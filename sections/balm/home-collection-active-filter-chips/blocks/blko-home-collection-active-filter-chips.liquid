-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-home-collection><div class="blko-home-collection-active-filters">{% for filter in collection.filters %}{% for active_value in filter.active_values %}<a href="{{ active_value.url_to_remove | escape }}">{{ active_value.label | escape }} <span aria-hidden="true">×</span></a>{% endfor %}{% endfor %}</div></blko-home-collection></div>
<script type="module" src="{{ 'blko-home-collection.js' | asset_url }}"></script>
