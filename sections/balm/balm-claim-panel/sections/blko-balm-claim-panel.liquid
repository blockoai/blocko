{%- comment -%} Generated by Blocko from tools/themes/balm/groups/balm-signature.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-balm-claim">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 800, 1200, 1600', alt: section.settings.image_alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><dl>{% for block in section.blocks %}<div {{ block.shopify_attributes }}><dt>{{ block.settings.value | escape }}</dt><dd>{{ block.settings.label | escape }}</dd></div>{% endfor %}</dl><small>{{ section.settings.note | escape }}</small></div></section></div>
{% stylesheet %}
:where(.blko-theme){--color-text-muted:CanvasText;--kit-heading-tracking:-0.01em;--kit-label-transform:uppercase;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--kit-radius-image:0;--leading-display:.9;--text-h2:2rem;--weight-light:300;--color-text:CanvasText;--font-display:var(--font-heading);--color-border:ButtonFace;--color-swatch-blush:ButtonFace;--tracking-label:.075rem;--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--tracking-h2:-.08rem;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--color-accent:GrayText;--color-ink:var(--color-text);--color-paper:var(--color-bg);--color-bg:Canvas}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-eyebrow{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-balm-claim{position:relative;display:grid;grid-template-columns:repeat(12,1fr);align-items:center;min-height:560px;padding:clamp(2rem,6vw,5rem) 5vw;overflow:hidden}
.blko-theme .blko-balm-claim>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.blko-theme .blko-balm-claim>div{position:relative;grid-column:1 / span 6;background:var(--color-swatch-blush);color:var(--color-text);padding:clamp(1.75rem,4vw,3.5rem);border:1px solid var(--color-border)}
.blko-theme .blko-balm-claim h2{margin:.4rem 0 1.5rem;font-size:clamp(1.75rem,3.4vw,2.75rem);line-height:1.15}
.blko-theme .blko-balm-claim dl{display:flex;flex-wrap:wrap;gap:1.5rem 2.5rem;margin:0}
.blko-theme .blko-balm-claim dt{font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);line-height:1;color:var(--color-text)}
.blko-theme .blko-balm-claim dd{margin:.35rem 0 0;font-size:.75rem;text-transform:uppercase;letter-spacing:.14em;color:var(--color-text-muted)}
.blko-theme .blko-balm-claim small{display:block;margin-top:1.5rem;color:var(--color-text-muted)}
.blko-theme .blko-balm-quiz h2{margin:.4rem auto 2.5rem;max-width:20ch}
.blko-theme .blko-balm-quiz-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.blko-theme .blko-balm-quiz-card div{position:absolute;z-index:1;left:1.25rem;right:1.25rem;bottom:1.25rem}
.blko-theme .blko-balm-press img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
@media(max-width:860px){.blko-theme .blko-balm-claim{display:block;padding:0;min-height:0}
.blko-theme .blko-balm-claim>img{position:static;height:340px}
.blko-theme .blko-balm-claim>div{margin:-3rem 5vw 3rem;padding:1.75rem}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-head h2{margin:0;font:var(--kit-heading-weight,var(--weight-light)) var(--text-h2)/var(--leading-display) var(--font-heading)}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-eyebrow{text-transform:var(--kit-label-transform)}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
