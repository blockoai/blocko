.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
.blko-theme .blko-home-collection-filter-option small{color:var(--color-text-muted)}
{% endstylesheet %}
{% schema %}
{
  "name": "Claim panel",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Portrait with glowing skin"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New: liquid lid color"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An eye color that treats the lid while it colors."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Wear and crease results come from a four-week in-use panel of thirty adults. Organic status refers to certified plant content."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "88%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "saw a visible glow"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Claim panel",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "12 hr",
            "label": "wear without fading"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "0",
            "label": "creasing on test lids"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Organic",
            "label": "certified plant base"
          }
        }
      ]
    }
  ]
}
{% endschema %}
