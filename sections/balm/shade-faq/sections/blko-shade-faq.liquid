{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shade help"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reading the codes"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "How do I choose a product?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Thoughtful, clear product information for everyday routines."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "label": "What do the number and letter mean?",
            "text": "The number is depth from 01 (fairest) to 10 (deepest). The letter is undertone: cool, neutral or warm."
          }
        },
        {
          "type": "question",
          "settings": {
            "label": "Can I mix two shades?",
            "text": "Yes. Blend a lighter and a deeper stick on the back of your hand to fine-tune."
          }
        },
        {
          "type": "question",
          "settings": {
            "label": "What if my shade changes in summer?",
            "text": "Retake the quiz or add a deeper stick to shape. Exchanges are open for thirty days."
          }
        }
      ]
    }
  ]
}
{% endschema %}
