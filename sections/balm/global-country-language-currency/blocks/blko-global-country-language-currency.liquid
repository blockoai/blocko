{%- comment -%} Generated by Blocko from tools/themes/balm/groups/global.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-global><section class="blko-global-locale" data-global-locale aria-label="Country, language, and currency">
  <p class="blko-global-kicker">{{ block.settings.kicker | escape }}</p>
  {% form 'localization', data-global-locale-form: '' %}<div class="blko-global-locale__fields"><label>{{ block.settings.country_label | escape }}<select name="country_code" data-global-setting="country">{% for country in localization.available_countries %}<option value="{{ country.iso_code | escape }}"{% if country.iso_code == localization.country.iso_code %} selected{% else %}{% endif %}>{{ country.name | escape }}</option>{% endfor %}</select></label><label>{{ block.settings.language_label | escape }}<select name="language_code" data-global-setting="language">{% for language in localization.available_languages %}<option value="{{ language.iso_code | escape }}"{% if language.iso_code == localization.language.iso_code %} selected{% else %}{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}</select></label><label>{{ block.settings.currency_label | escape }}<select data-global-setting="currency" disabled><option>{{ localization.country.currency.iso_code | escape }}</option></select></label></div><noscript><button class="blko-button" type="submit">{{ block.settings.update_label | escape }}</button></noscript>{% endform %}
  <p class="blko-global-setting-status" data-global-setting-status aria-live="polite">{{ localization.country.name | escape }} · {{ localization.language.endonym_name | escape }} · {{ localization.country.currency.iso_code | escape }}</p>
</section></blko-global></div>
<script type="module" src="{{ 'blko-global.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-bg:Canvas;--color-text:CanvasText;--kit-shadow:none;--kit-radius-card:0;--color-border:ButtonFace;--kit-border:1px;--kit-radius:0;--kit-radius-image:0;--kit-radius-button:0;--kit-label-transform:uppercase;--color-accent:GrayText;--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--weight-light:300;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--color-button:CanvasText;--color-button-text:Canvas;--color-ink:var(--color-text);--text-small:.75rem;--color-bg-alt:Canvas;--leading-display:.9;--text-title:2rem;--color-line:var(--color-border);--tracking-small:-.015rem;--color-text-muted:CanvasText;--tracking-button:.075rem;--leading-button:1.5;--text-button:.75rem;--weight-medium:500;--color-paper:var(--color-bg);--color-button-hover:CanvasText;--tracking-label:.075rem;--leading-label:1.5;--text-label:.75rem}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
.blko-theme :where(.blko-theme) button{color:inherit}
.blko-theme .blko-button{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-body);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:.8rem 1.2rem;border:1px solid var(--color-button);background:var(--color-button);color:var(--color-button-text);cursor:pointer;text-decoration:none}
.blko-theme .blko-button:hover{background:var(--color-button-hover);border-color:var(--color-button-hover)}
