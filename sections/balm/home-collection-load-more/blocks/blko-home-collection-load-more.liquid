{%- comment -%} Generated by Blocko from tools/themes/balm/groups/home-collection.ts. Edit the spec, not this file. {%- endcomment -%}
{%- liquid
  assign collection = block.settings.collection | default: collection | default: collections.all
-%}
<div class="blko-theme" {{ block.shopify_attributes }}><blko-home-collection>{% paginate collection.products by block.settings.products_per_page %}{% if paginate.pages > 1 %}<div class="blko-home-collection-load-more"><progress value="{{ paginate.current_offset | plus: collection.products.size }}" max="{{ paginate.items | escape }}" data-load-progress>{{ paginate.current_offset | plus: collection.products.size }} {{ 'blko.collection.of' | t }} {{ paginate.items | escape }}</progress><p data-load-label>{{ paginate.current_offset | plus: collection.products.size }} {{ 'blko.collection.of' | t }} {{ paginate.items | escape }} {{ 'blko.collection.products_shown' | t }}</p>{% if paginate.previous.url != blank %}<a class="blko-button" href="{{ paginate.previous.url | escape }}" rel="prev">{{ block.settings.previous_label | escape }}</a>{% else %}{% endif %}{% if paginate.next.url != blank %}<a class="blko-button" href="{{ paginate.next.url | escape }}" rel="next" data-load-more-link>{{ block.settings.load_more_label | escape }}</a>{% else %}{% endif %}</div>{% else %}{% endif %}{% endpaginate %}</blko-home-collection></div>
<script type="module" src="{{ 'blko-home-collection.js' | asset_url }}"></script>
{% stylesheet %}
:where(.blko-theme){--color-bg:Canvas;--color-text:CanvasText;--kit-shadow:none;--kit-radius-card:0;--color-border:ButtonFace;--kit-border:1px;--kit-radius:0;--kit-radius-image:0;--kit-radius-button:0;--kit-label-transform:uppercase;--color-button:CanvasText;--color-button-text:Canvas;--color-ink:var(--color-text);--text-small:.75rem;--color-bg-alt:Canvas;--tracking-label:.075rem;--font-mono:var(--font-accent);--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--leading-display:.9;--text-title:2rem;--tracking-button:.075rem;--leading-button:1.5;--text-button:.75rem;--color-paper:var(--color-bg);--color-accent:GrayText;--color-button-hover:CanvasText;--font-body:"Inter",Helvetica Neue,Arial,sans-serif}
@media (min-width:1024px){:where(.blko-theme){--text-title:2.5rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
