{%- comment -%} Generated by Blocko from tools/themes/balm/groups/core.ts. Edit the spec, not this file. {%- endcomment -%}
<div class="blko-theme"><section class="blko-catalog"><h2>{{ section.settings.heading | escape }}</h2><div class="blko-card-grid blko-category-grid">{% for block in section.blocks %}<a class="blko-category-card" href="{{ block.settings.url | default: '#complexion' }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', alt: block.settings.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<span>{{ block.settings.title | escape }}</span></a>{% endfor %}</div></section></div>
{% stylesheet %}
:where(.blko-theme){--kit-heading-tracking:-0.01em;--kit-radius-image:0;--kit-heading-transform:none;--kit-heading-weight:400;--font-heading:"Playfair Display",Georgia,serif;--color-button:CanvasText;--color-bg:Canvas;--font-mono:var(--font-accent);--font-accent:"Inter",Helvetica Neue,Arial,sans-serif;--leading-label:1.5;--text-label:.75rem;--weight-medium:500;--leading-body:1.5;--text-small:.75rem;--color-text-muted:CanvasText;--color-accent:GrayText;--tracking-label:.075rem;--font-display:var(--font-heading);--leading-display:.9;--text-h2:2rem;--color-footer-bg:CanvasText;--color-button-text:Canvas;--text-display:2.5rem;--color-overlay:rgb(0 0 0 / .4);--tracking-h2:-.08rem;--weight-light:300;--font-body:"Inter",Helvetica Neue,Arial,sans-serif;--color-border:ButtonFace;--color-ink:var(--color-text);--color-text:CanvasText;--color-paper:var(--color-bg)}
@media (min-width:1024px){:where(.blko-theme){--text-h2:2.5rem;--text-display:5rem;--tracking-h2:-.1rem}}
.blko-theme,.blko-theme *,.blko-theme *::before,.blko-theme *::after{box-sizing:border-box}.blko-theme{margin:0;background:var(--color-paper);color:var(--color-ink);font:400 1rem/1.5 var(--font-body)}.blko-theme img{display:block;max-width:100%;object-fit:cover}.blko-theme a{color:inherit}.blko-theme button,.blko-theme input,.blko-theme select{font:inherit}
:where(.blko-theme) img[height]{height:auto}
:where(.blko-theme) .blko-placeholder{display:block;width:100%;height:100%;min-height:10rem;background:var(--color-accent);fill:none;color:var(--color-border)}
.blko-theme h2{font-family:var(--font-body);font-size:var(--text-h2);font-weight:var(--weight-light);line-height:var(--leading-display);letter-spacing:var(--tracking-h2)}
.blko-theme .blko-category-card span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-accent);letter-spacing:var(--tracking-label);text-transform:uppercase}
.blko-theme .blko-catalog{padding:clamp(3rem,8vw,8rem) 5vw}
.blko-theme .blko-card-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.blko-theme .blko-category-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
.blko-theme .blko-category-card img{width:100%;aspect-ratio:.82;object-fit:cover}
.blko-theme .blko-category-card{position:relative;overflow:hidden;aspect-ratio:.82}
.blko-theme .blko-category-card span{position:absolute;left:1rem;bottom:1rem;color:var(--color-button-text);font-family:var(--font-accent);text-shadow:0 1px 8px var(--color-overlay)}
.blko-theme .blko-split>img{width:100%;height:100%;min-height:0;object-fit:cover}
.blko-theme .blko-product-detail>img{width:100%;height:100%;min-height:0;object-fit:cover}
.blko-theme .blko-cart-line img{width:90px;height:110px}
.blko-theme .blko-notice img{width:110px;height:130px}
.blko-theme .blko-ingredient img{width:100%;max-width:400px;aspect-ratio:1}
@media(max-width:760px){.blko-theme .blko-card-grid{grid-template-columns:1fr}
.blko-theme .blko-category-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.blko-theme .blko-split>img{height:auto;aspect-ratio:4/5}
.blko-theme .blko-product-detail>img{height:auto;aspect-ratio:4/5}}
.blko-theme .blko-global-password-art img{width:100%;height:100%;position:absolute}
.blko-theme .blko-global-gift-card>span{font-size:var(--text-display)}
.blko-theme .blko-home-collection-mega-menu__tiles img{width:100%;height:230px;object-fit:cover}
.blko-theme .blko-home-collection-mega-menu__tiles span{position:absolute;inset:auto 1rem 1rem;color:var(--color-button-text);font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);letter-spacing:var(--tracking-label);text-transform:uppercase;text-shadow:0 1px 8px var(--color-footer-bg)}
.blko-theme .blko-home-collection-product__media img{width:100%;aspect-ratio:.78;object-fit:cover}
.blko-theme .blko-home-collection-promo-tile img{position:absolute;width:100%;height:100%;object-fit:cover;opacity:.7}
.blko-theme .blko-home-collection-directory__grid img{width:100%;height:100%;position:absolute;object-fit:cover;transition:transform .35s}
.blko-theme .blko-home-collection-directory__grid span{position:absolute;left:1rem;text-shadow:0 1px 8px var(--color-footer-bg)}
.blko-theme .blko-home-collection-directory__grid span{bottom:2rem;font:var(--weight-medium) var(--text-h2)/var(--leading-display) var(--font-display)}
.blko-theme .blko-home-collection-quick-view__content>img{width:100%;height:100%;min-height:440px;object-fit:cover}
@media(max-width:760px){.blko-theme .blko-home-collection-quick-view__content>img{min-height:0;aspect-ratio:1}}
.blko-theme .blko-pdp-gallery__thumbs img{width:100%;height:100%;object-fit:cover}
.blko-theme .blko-pdp-gallery__stage>img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.blko-theme .blko-pdp-rating span{letter-spacing:var(--tracking-label);color:var(--color-accent)}
.blko-theme .blko-pdp-price span{color:var(--color-text-muted);font-size:var(--text-small)}
.blko-theme .blko-pdp-sticky-buy img{width:44px;height:50px}
.blko-theme .blko-pdp-sticky-buy span{display:block;font-size:var(--text-small)}
.blko-theme .blko-pdp-stat-grid span{font-size:var(--text-small);line-height:var(--leading-body)}
.blko-theme .blko-pdp-compare>img{width:100%;height:100%;object-fit:cover}
.blko-theme .blko-pdp-compare__before img{width:100%;height:100%;object-fit:cover}
.blko-theme .blko-pdp-compare__before img{width:auto;max-width:none;aspect-ratio:.9}
.blko-theme .blko-pdp-mini-product img{width:100%;aspect-ratio:.78}
.blko-theme .blko-pdp-bundle-item img{width:130px;height:150px}
@media(max-width:760px){.blko-theme .blko-pdp-bundle-item img{width:92px;height:112px}}
.blko-theme .blko-search-blog-predictive__dropdown span{font:var(--weight-medium) var(--text-label)/var(--leading-label) var(--font-mono);text-transform:uppercase}
.blko-theme .blko-search-blog-result img{width:100%;aspect-ratio:1.05;object-fit:cover}
.blko-theme .blko-search-blog-article-card img{width:100%;aspect-ratio:1.05;object-fit:cover}
.blko-theme .blko-search-blog-empty img{width:100%;height:100%;min-height:520px;object-fit:cover}
.blko-theme .blko-search-blog-journal-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-article-hero img{width:100%;height:100%;min-height:570px;object-fit:cover}
.blko-theme .blko-search-blog-featured-post img{width:100%;height:100%;min-height:520px;object-fit:cover}
@media(max-width:760px){.blko-theme .blko-search-blog-empty img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-journal-hero img{min-height:0;aspect-ratio:1}
.blko-theme .blko-search-blog-article-hero img{min-height:0;aspect-ratio:1}}
.blko-theme .blko-balm-steps img{width:100%;height:100%;max-height:640px;object-fit:cover;display:block}
.blko-theme .blko-balm-claim>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.blko-theme .blko-balm-quiz-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.blko-theme .blko-balm-quiz-card span{display:inline-block;background:var(--color-bg);color:var(--color-button);padding:.8rem 1.2rem;font-size:.7rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
.blko-theme .blko-balm-press img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
@media(max-width:860px){.blko-theme .blko-balm-claim>img{position:static;height:340px}}
.blko-theme .blko-brand-logo img{display:block;width:100%;height:auto}
.blko-theme .blko-brand-mood img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:var(--kit-radius-image,0)}
.blko-theme.blko-theme h2{font-family:var(--font-heading);font-weight:var(--kit-heading-weight);text-transform:var(--kit-heading-transform);overflow-wrap:anywhere}
.blko-theme.blko-theme .blko-category-card{border-radius:var(--kit-radius-image)}
.blko-theme.blko-theme .blko-category-card{overflow:hidden}
.blko-theme.blko-theme h2{letter-spacing:var(--kit-heading-tracking)}
.blko-theme.blko-theme .blko-catalog{padding-block:clamp(4.5rem,10vw,10rem)}
{% endstylesheet %}
