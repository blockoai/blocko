<div class="blko-theme"><blko-cart-checkout><blko-cart-drawer>{% if cart.item_count > 0 %}<section class="blko-cart-checkout-cart" data-cart-checkout-cart><header><p class="blko-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }} ({{ cart.item_count | escape }})</h1></header><section class="blko-cart-checkout-progress" aria-label="{{ section.settings.progress_label | escape }}" data-cart-checkout-progress data-goal="{{ section.settings.threshold | times: 100 }}"{% assign blko_calc_0 = section.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 %}{% if blko_calc_0 > 0 %} data-unlocked="false"{% else %} data-unlocked="true"{% endif %}><div>{% assign blko_calc_1 = section.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 %}{% if blko_calc_1 > 0 %}<p>{{ section.settings.before | escape }} <strong data-cart-checkout-remaining>{{ section.settings.threshold | times: 100 | minus: cart.total_price | at_least: 0 | money_without_trailing_zeros }}</strong> {{ section.settings.after | escape }}</p>{% else %}<p>{{ section.settings.unlocked | escape }}</p>{% endif %}<span aria-hidden="true"><i style="width:{% assign blko_calc_2 = section.settings.threshold | times: 100 %}{{ cart.total_price | times: 100 | divided_by: blko_calc_2 | at_most: 100 }}%"></i></span></div><p class="blko-cart-checkout-progress-label" data-cart-checkout-progress-label>{{ cart.total_price | money_without_trailing_zeros }} <b>{{ section.settings.threshold | times: 100 | money_without_trailing_zeros }}</b></p></section>{% form 'cart', cart, class: 'blko-cart-checkout-cart-form' %}<div class="blko-cart-checkout-cart-grid"><div>{% for item in cart.items %}<article class="blko-cart-checkout-line-item" data-cart-checkout-line-item data-cart-checkout-line data-key="{{ item.key | escape }}">{% if item.image != blank %}{{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '210, 315, 420', alt: item.image.alt }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div>{% if item.variant.title != blank and item.variant.title != 'Default Title' %}<p class="blko-eyebrow">{{ item.variant.title | escape }}</p>{% else %}{% endif %}<h2><a href="{{ item.url | escape }}">{{ item.product.title | escape }}</a></h2><p class="blko-cart-checkout-price">{{ item.final_price | money_without_trailing_zeros }}</p><div class="blko-cart-checkout-quantity" data-cart-checkout-line-quantity><button type="button" aria-label="{{ 'blko.cart.decrease' | t }}" data-cart-checkout-line-step="-1">−</button><output data-cart-checkout-line-qty>{{ item.quantity | escape }}</output><button type="button" aria-label="{{ 'blko.cart.increase' | t }}" data-cart-checkout-line-step="1">+</button><input type="hidden" name="updates[]" value="{{ item.quantity | escape }}"></div><a class="blko-cart-checkout-text-button" href="{{ item.url_to_remove | escape }}" data-cart-checkout-line-remove>{{ 'blko.cart.remove' | t }}</a></div><strong aria-label="{{ 'blko.cart.line_total' | t }}" data-cart-checkout-line-total>{{ item.final_line_price | money_without_trailing_zeros }}</strong></article>{% endfor %}<details class="blko-cart-checkout-gift-note"><summary>{{ section.settings.note_summary | escape }} <span>+</span></summary><label for="gift-note">{{ section.settings.note_label | escape }}</label><textarea id="gift-note" maxlength="200" placeholder="{{ section.settings.note_placeholder | escape }}" name="note">{{ cart.note | escape }}</textarea><p><output data-cart-checkout-note-count>{{ cart.note | size }}</output>/200</p></details>{% if collection.products != blank %}<section class="blko-cart-checkout-upsell"><div class="blko-cart-checkout-section-heading"><p class="blko-eyebrow">{{ section.settings.upsell_kicker | escape }}</p><h2>{{ section.settings.upsell_heading | escape }}</h2><div><button type="button" data-cart-checkout-carousel="previous" aria-label="Previous recommendation">←</button><button type="button" data-cart-checkout-carousel="next" aria-label="Next recommendation">→</button></div></div><div class="blko-cart-checkout-upsell-track" data-cart-checkout-carousel-track>{% for product in collection.products limit: 4 %}<article class="blko-cart-checkout-upsell-card">{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '280, 420, 560', alt: product.title }}{% else %}{{ 'image' | placeholder_svg_tag: 'blko-placeholder' }}{% endif %}<div><p class="blko-eyebrow">{{ section.settings.upsell_eyebrow | escape }}</p><h3>{{ product.title | escape }}</h3><strong>{{ product.price | money_without_trailing_zeros }}</strong><button type="button" data-cart-checkout-upsell-add data-cart-checkout-variant="{{ product.selected_or_first_available_variant.id | escape }}"{% if product.available == blank %} disabled{% else %}{% endif %}>{{ section.settings.upsell_button | escape }}</button></div></article>{% endfor %}</div></section>{% else %}{% endif %}</div><aside class="blko-cart-checkout-summary"><h2>{{ section.settings.summary_heading | escape }}</h2><dl><div><dt>{{ section.settings.subtotal_label | escape }}</dt><dd data-cart-checkout-subtotal>{{ cart.items_subtotal_price | money_without_trailing_zeros }}</dd></div><div><dt>{{ section.settings.shipping_label | escape }}</dt><dd>{{ section.settings.shipping_text | escape }}</dd></div><div class="blko-cart-checkout-total"><dt>{{ section.settings.total_label | escape }}</dt><dd data-cart-checkout-total>{{ cart.total_price | money_without_trailing_zeros }}</dd></div></dl><button class="blko-button" type="submit" name="checkout">{{ section.settings.checkout_label | escape }}</button><div class="blko-cart-checkout-payment-icons" aria-label="Accepted payment methods"><svg viewBox="0 0 44 28" aria-hidden="true"><rect width="44" height="28" rx="3"/><path d="M8 15h12M8 11h18"/></svg><svg viewBox="0 0 44 28" aria-hidden="true"><rect width="44" height="28" 